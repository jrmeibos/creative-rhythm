<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/onboarding.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content">

      <a href="/dashboard" class="cm-back-link" style="display:inline-block; margin: 1.5rem 0 1rem;">← Back to dashboard</a>

      <div class="ob-step is-active" style="position: static; padding: 1rem 0 4rem;">
        <div class="ob-content" style="margin: 0 auto; max-width: 720px;">

          <h2 class="ob-title">Closing Reflection</h2>
          <p class="ob-subtitle" style="line-height:1.6;">
            Three weeks in. A short reflection on how this has landed for you —
            and a question at the end about whether you'd like to continue with
            the full 12-week Creative's Garden.
          </p>

          <div class="ob-questions">
            <% questions.forEach(function(q, idx) { %>
              <div class="ob-question" id="q-block-<%= q.id %>">
                <div class="ob-q-num">0<%= idx + 1 %></div>
                <p class="ob-q-text">
                  <%= q.text %>
                  <% if (q.optional) { %><span style="opacity:0.5;font-weight:300"> (optional)</span><% } %>
                </p>

                <% if (q.type === 'multi') { %>
                  <p class="ob-multi-note">Choose any that apply<% if (q.max) { %> (up to <%= q.max %>)<% } %></p>
                  <div class="ob-choices">
                    <% q.choices.forEach(function(c) { %>
                      <button type="button"
                        class="ob-choice ob-multi"
                        data-group="<%= q.field %>"
                        data-value="<%= c.val %>"
                        <% if (q.max) { %>data-max="<%= q.max %>"<% } %>>
                        <span class="ob-choice-val"><%= c.val %></span>
                        <span class="ob-choice-label"><%= c.label %></span>
                      </button>
                    <% }); %>
                  </div>

                <% } else if (q.type === 'choice') { %>
                  <div class="ob-choices">
                    <% q.choices.forEach(function(c) { %>
                      <button type="button"
                        class="ob-choice"
                        data-group="<%= q.field %>"
                        data-value="<%= c.val %>">
                        <span class="ob-choice-val"><%= c.val %></span>
                        <span class="ob-choice-label"><%= c.label %></span>
                      </button>
                    <% }); %>
                  </div>

                <% } else if (q.type === 'rating') { %>
                  <% const _min = q.scaleMin != null ? q.scaleMin : 1; %>
                  <% const _max = q.scaleMax != null ? q.scaleMax : 10; %>
                  <p class="ob-rating-scale">
                    <span><%= q.low %></span>
                    <% if (q.mid) { %><span style="opacity:0.75"><%= q.mid %></span><% } %>
                    <span><%= q.high %></span>
                  </p>
                  <div class="ob-rating-row">
                    <% for (let i = _min; i <= _max; i++) { %>
                      <button type="button" class="ob-rating-btn"
                        data-group="<%= q.field %>" data-value="<%= i %>">
                        <%= i %>
                      </button>
                    <% } %>
                  </div>

                <% } else if (q.type === 'text') { %>
                  <textarea class="ob-textarea" data-field="<%= q.field %>"
                            rows="4" placeholder="<%= q.placeholder %>"></textarea>
                <% } %>
              </div>
            <% }); %>
          </div>

          <p class="ob-error" id="trial-error" hidden>Please answer the required questions before submitting.</p>
          <div class="ob-actions">
            <button class="ob-btn ob-btn--primary" id="trial-submit-btn" onclick="submitTrialClosing()">Submit reflection →</button>
          </div>

        </div>
      </div>

    </main>
  </div>

  <script>
    const QUESTIONS = <%- JSON.stringify(questions) %>;
    const answers = {};

    // Click handlers. `ob-multi` toggles into an array (respecting max);
    // `ob-choice` (single-select) acts like a radio; `ob-rating-btn` likewise.
    document.querySelectorAll('.ob-choice, .ob-rating-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const group   = btn.dataset.group;
        const value   = btn.dataset.value;
        const isMulti = btn.classList.contains('ob-multi');

        if (isMulti) {
          const list = answers[group] = answers[group] || [];
          const i = list.indexOf(value);
          if (i >= 0) {
            list.splice(i, 1);
            btn.classList.remove('is-selected');
          } else {
            // Cap at q.max if set — silently ignore extra clicks.
            const max = parseInt(btn.dataset.max, 10);
            if (Number.isFinite(max) && list.length >= max) return;
            list.push(value);
            btn.classList.add('is-selected');
          }
        } else {
          // Single-select (rating or choice): clear sibling state, set this one.
          document.querySelectorAll('[data-group="' + group + '"]').forEach(function (b) {
            if (!b.classList.contains('ob-multi')) b.classList.remove('is-selected');
          });
          btn.classList.add('is-selected');
          answers[group] = value;
        }
      });
    });

    document.querySelectorAll('.ob-textarea').forEach(function (ta) {
      ta.addEventListener('input', function () {
        answers[ta.dataset.field] = ta.value;
      });
    });

    async function submitTrialClosing() {
      const err  = document.getElementById('trial-error');
      const btn  = document.getElementById('trial-submit-btn');
      err.hidden = true;

      // Build payload + validate the required fields in-page so users see
      // the issue without round-tripping the server.
      const payload = {};
      for (const q of QUESTIONS) {
        const v = answers[q.field];
        if (q.type === 'rating')      payload[q.field] = v != null ? Number(v) : null;
        else if (q.type === 'multi')  payload[q.field] = Array.isArray(v) ? v : [];
        else if (q.type === 'choice') payload[q.field] = typeof v === 'string' ? v : '';
        else if (q.type === 'text')   payload[q.field] = typeof v === 'string' ? v.trim() : '';
      }
      const incomplete = QUESTIONS.some(q => {
        if (q.optional) return false;
        const v = payload[q.field];
        if (q.type === 'rating') return v == null;
        if (q.type === 'multi')  return !v.length;
        if (q.type === 'choice') return !v;
        if (q.type === 'text')   return !v;
        return false;
      });
      if (incomplete) { err.hidden = false; return; }

      btn.disabled = true;
      btn.textContent = 'Sending…';

      try {
        const res = await fetch('/api/trial-closing/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ answers: payload }),
        });
        const data = await res.json();
        if (!res.ok) {
          err.textContent = data.error || 'Something went wrong. Please try again.';
          err.hidden = false;
          btn.disabled = false;
          btn.textContent = 'Submit reflection →';
          return;
        }
        window.location.href = '/dashboard';
      } catch (e) {
        err.textContent = 'Network error. Please try again.';
        err.hidden = false;
        btn.disabled = false;
        btn.textContent = 'Submit reflection →';
      }
    }
  </script>
</body>
</html>
