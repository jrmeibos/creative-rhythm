<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/account.css">
</head>
<body class="app-body">

  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">

      <header class="dash-header">
        <div>
          <h1 class="acct-page-title">My Account</h1>
          <p class="acct-page-subtitle">Manage your personal details and preferences.</p>
        </div>
      </header>

      <!-- ── Daily Reminder ────────────────────────────────────────────────── -->
      <%
        // Pre-render the time picker options here so the inline JS doesn't
        // have to. Storing the hour as 0–23 keeps timezone math simple; the
        // display labels are the conventional 12-hour clock for legibility.
        const currentHour = (typeof profile.daily_reminder_hour === 'number') ? profile.daily_reminder_hour : 8;
        const reminderEnabled = profile.daily_reminder_enabled === 1;
        const HOURS = Array.from({ length: 24 }, (_, h) => {
          const ampm = h < 12 ? 'AM' : 'PM';
          const display = h === 0 ? 12 : (h > 12 ? h - 12 : h);
          return { value: h, label: `${display}:00 ${ampm}` };
        });
      %>
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Daily Reminder</h2>
        </div>
        <div class="acct-card">
          <p class="acct-section-subtitle">
            Get one gentle nudge per day to log your reflection — at a time you choose.
            You'll need to install <em>The Creative's Garden</em> to your home screen and turn on
            notifications for this device.
          </p>

          <!-- iOS install guidance: only visible on iPhone/iPad in non-installed mode -->
          <div class="acct-install-card" id="ios-install-card" hidden>
            <strong>One step first — install to your home screen.</strong>
            <p>iPhone only delivers notifications to installed apps. To install:</p>
            <ol>
              <li>Tap the <em>Share</em> button at the bottom of Safari</li>
              <li>Scroll down and tap <em>Add to Home Screen</em></li>
              <li>Tap <em>Add</em>, then open the app from your home screen</li>
              <li>Return here to enable notifications</li>
            </ol>
          </div>

          <!-- Master toggle: cron checks this column before sending -->
          <div class="acct-toggle-row">
            <div class="acct-toggle-text">
              <strong>Send me a daily reminder</strong>
              <span>You can turn this off any time.</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-daily_reminder" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-daily-reminder"
                      aria-pressed="<%= reminderEnabled ? 'true' : 'false' %>"
                      type="button" onclick="toggleDailyReminder(this)">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>

          <!-- Time picker: hidden when master toggle is off -->
          <div class="acct-reminder-time" id="reminder-time-row"<%= reminderEnabled ? '' : ' hidden' %>>
            <label class="acct-label" for="reminder-hour-select">Send it at</label>
            <select class="acct-input acct-select" id="reminder-hour-select" onchange="saveReminderHour(this)">
              <% for (const h of HOURS) { %>
                <option value="<%= h.value %>"<%= h.value === currentHour ? ' selected' : '' %>><%= h.label %></option>
              <% } %>
            </select>
            <span class="acct-reminder-tz">in your timezone (<%= profile.timezone || 'America/Denver' %>)</span>
          </div>

          <!-- Per-device enable: separate concept from the master toggle because -->
          <!-- browser push permission lives on the device, not the account.       -->
          <div class="acct-device-row">
            <div class="acct-device-state">
              <strong id="device-status-label">Not enabled on this device</strong>
              <span id="device-status-hint">Tap below to allow notifications in this browser.</span>
            </div>
            <button class="acct-save-btn" id="enable-device-btn" type="button" onclick="enableOnDevice()">Enable on this device</button>
            <button class="acct-text-btn" id="disable-device-btn" type="button" onclick="disableOnDevice()" hidden>Disable on this device</button>
          </div>
          <p class="acct-status acct-status--error" id="reminder-error" hidden></p>
        </div>
      </section>

      <!-- ── Profile Photo ─────────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your Photo</h2>
        </div>
        <div class="acct-card">
          <div class="acct-photo-layout">
            <div class="acct-avatar-wrap" id="acct-avatar-wrap">
              <% if (profile.profile_photo) { %>
                <img src="<%= profile.profile_photo %>" class="acct-avatar acct-avatar--photo" id="current-photo" alt="">
              <% } else { %>
                <div class="acct-avatar acct-avatar--initial<%= profile.current_season ? ' season-avatar--' + profile.current_season : '' %>" id="current-initial">
                  <%= profile.avatar_initial || profile.name.charAt(0).toUpperCase() %>
                </div>
              <% } %>
            </div>
            <div class="acct-photo-controls">
              <label class="acct-upload-label" for="photo-input">Upload a photo</label>
              <input type="file" id="photo-input" accept="image/jpeg,image/png,image/gif,image/webp" hidden>
              <% if (profile.profile_photo) { %>
                <button class="acct-remove-link" type="button" id="remove-photo-btn" onclick="removePhoto()">Remove photo</button>
              <% } %>
              <p class="acct-photo-hint">JPG, PNG, GIF, or WebP · Max 5MB</p>
            </div>
          </div>
          <div id="photo-preview-wrap" hidden>
            <div class="acct-preview-section">
              <img id="photo-preview" class="acct-preview-img" alt="Preview">
              <div class="acct-preview-actions">
                <button class="acct-save-btn" type="button" id="save-photo-btn" onclick="savePhoto()">Save Photo</button>
                <button class="acct-text-btn" type="button" onclick="cancelPhotoPreview()">Cancel</button>
              </div>
            </div>
          </div>
          <p class="acct-status acct-status--error" id="photo-error" hidden></p>
        </div>
      </section>

      <!-- ── Personal Details ──────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your Details</h2>
        </div>
        <div class="acct-card">
          <div class="acct-form">
            <div class="acct-field-group">
              <label class="acct-label" for="details-name">Full Name</label>
              <input class="acct-input" type="text" id="details-name" value="<%= profile.name %>" autocomplete="name">
            </div>
            <div class="acct-field-group">
              <label class="acct-label" for="details-email">Email</label>
              <input class="acct-input" type="email" id="details-email" value="<%= profile.email %>" autocomplete="email">
            </div>
            <div class="acct-form-footer">
              <button class="acct-save-btn" type="button" onclick="saveDetails()">Update Details</button>
              <span class="acct-status" id="details-status"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Change Password ───────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Change Password</h2>
        </div>
        <div class="acct-card">
          <div class="acct-form">
            <div class="acct-field-group">
              <label class="acct-label" for="pw-current">Current Password</label>
              <input class="acct-input" type="password" id="pw-current" autocomplete="current-password">
            </div>
            <div class="acct-field-group">
              <label class="acct-label" for="pw-new">New Password</label>
              <input class="acct-input" type="password" id="pw-new" autocomplete="new-password">
              <p class="acct-field-hint">At least 8 characters with one number or special character.</p>
            </div>
            <div class="acct-field-group">
              <label class="acct-label" for="pw-confirm">Confirm New Password</label>
              <input class="acct-input" type="password" id="pw-confirm" autocomplete="new-password">
            </div>
            <div class="acct-form-footer">
              <button class="acct-save-btn" type="button" onclick="savePassword()">Update Password</button>
              <span class="acct-status" id="pw-status"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Your Season ───────────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your Current Season</h2>
        </div>
        <div class="acct-card">
          <% if (locals.canPickSeason) { %>
          <div class="season-cards">
            <% const seasonMeta = {
              spring: { name: 'Spring',  category: 'Curiosity', desc: 'Feed your artist\'s soul' },
              summer: { name: 'Summer',  category: 'Create',    desc: 'Make the thing' },
              autumn: { name: 'Autumn',  category: 'Share',     desc: 'Put it into the world' },
              winter: { name: 'Winter',  category: 'Connect',   desc: 'Reach out (or in)' }
            }; %>
            <% for (const [s, meta] of Object.entries(seasonMeta)) { %>
              <button class="season-card season-card--<%= s %><%= profile.current_season === s ? ' is-selected' : '' %>"
                      data-season="<%= s %>" type="button">
                <span class="season-card-emoji">
                  <%- include('partials/season-icon', { season: s, size: 36 }) %>
                </span>
                <span class="season-card-category"><%= meta.category %></span>
                <span class="season-card-name"><%= meta.name %></span>
                <span class="season-card-desc"><%= meta.desc %></span>
                <span class="season-card-check" aria-hidden="true">✓</span>
              </button>
            <% } %>
          </div>
          <% } else { %>
            <p class="acct-hint">
              You're in Winter right now — the season of quiet, daily recording.
              Your other seasons open up as your journey continues.
            </p>
          <% } %>
        </div>
      </section>

      <!-- ── Timezone ──────────────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your Timezone</h2>
        </div>
        <div class="acct-card">
          <div class="acct-form acct-form--inline">
            <div class="acct-field-group">
              <label class="acct-label" for="timezone-select">Timezone</label>
              <select class="acct-input acct-select" id="timezone-select">
                <% for (const tz of timezones) { %>
                  <option value="<%= tz.value %>"<%= (profile.timezone || 'America/Denver') === tz.value ? ' selected' : '' %>>
                    <%= tz.label %>
                  </option>
                <% } %>
              </select>
            </div>
            <div class="acct-form-footer">
              <button class="acct-save-btn" type="button" onclick="saveTimezone()">Save Timezone</button>
              <span class="acct-status" id="tz-status"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Notifications ─────────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Notifications</h2>
        </div>
        <div class="acct-card">
          <p class="acct-section-subtitle">Choose what you'd like to hear about.</p>

          <div class="acct-toggle-row">
            <div class="acct-toggle-text">
              <strong>New Lessons</strong>
              <span>Get notified when new content is published</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-notify_new_fieldnotes" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-notify_new_fieldnotes"
                      aria-pressed="<%= profile.notify_new_fieldnotes !== 0 ? 'true' : 'false' %>"
                      type="button" onclick="togglePref(this, 'notify_new_fieldnotes')">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>

          <div class="acct-toggle-row">
            <div class="acct-toggle-text">
              <strong>Community Activity</strong>
              <span>Get notified when someone posts in the community</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-notify_community" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-notify_community"
                      aria-pressed="<%= profile.notify_community !== 0 ? 'true' : 'false' %>"
                      type="button" onclick="togglePref(this, 'notify_community')">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>

          <div class="acct-toggle-row acct-toggle-row--last">
            <div class="acct-toggle-text">
              <strong>Weekly Reminder</strong>
              <span>A gentle nudge to set your weekly intentions every Monday</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-notify_weekly_reminder" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-notify_weekly_reminder"
                      aria-pressed="<%= profile.notify_weekly_reminder !== 0 ? 'true' : 'false' %>"
                      type="button" onclick="togglePref(this, 'notify_weekly_reminder')">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Privacy ───────────────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Privacy</h2>
        </div>
        <div class="acct-card">
          <p class="acct-section-subtitle">Control what others in the course can see.</p>

          <div class="acct-toggle-row">
            <div class="acct-toggle-text">
              <strong>Show my weekly intentions to the community</strong>
              <span>Your goal status dots are visible on the community page</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-community_goals_public" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-community_goals_public"
                      aria-pressed="<%= profile.community_goals_public !== 0 ? 'true' : 'false' %>"
                      type="button" onclick="togglePref(this, 'community_goals_public')">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>

          <div class="acct-toggle-row acct-toggle-row--last">
            <div class="acct-toggle-text">
              <strong>Show my current season to the community</strong>
              <span>Your season icon appears next to your name on the community page</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-community_season_public" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-community_season_public"
                      aria-pressed="<%= profile.community_season_public !== 0 ? 'true' : 'false' %>"
                      type="button" onclick="togglePref(this, 'community_season_public')">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Sign Out ──────────────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="acct-card acct-card--danger">
          <h2 class="acct-danger-title">Sign Out</h2>
          <a href="/logout" class="acct-signout-btn">Sign Out</a>
        </div>
      </section>

      <!-- ── Data Note ─────────────────────────────────────────────────────── -->
      <p class="acct-data-note">
        Want a copy of your data or need to delete your account?
        Contact your curator.
      </p>

    </main>
  </div>

  <script>
    // ── Photo ──────────────────────────────────────────────────────────────────
    document.getElementById('photo-input').addEventListener('change', function() {
      const file = this.files[0];
      if (!file) return;
      const url = URL.createObjectURL(file);
      document.getElementById('photo-preview').src = url;
      document.getElementById('photo-preview-wrap').hidden = false;
    });

    async function savePhoto() {
      const file = document.getElementById('photo-input').files[0];
      if (!file) return;
      const btn = document.getElementById('save-photo-btn');
      btn.disabled = true;
      btn.textContent = 'Saving…';
      const errEl = document.getElementById('photo-error');
      errEl.hidden = true;

      const formData = new FormData();
      formData.append('photo', file);
      const res = await fetch('/api/account/photo', { method: 'POST', body: formData });
      const data = await res.json();
      if (res.ok) {
        window.location.reload();
      } else {
        btn.disabled = false;
        btn.textContent = 'Save Photo';
        errEl.textContent = data.error;
        errEl.hidden = false;
      }
    }

    async function removePhoto() {
      if (!confirm('Remove your profile photo?')) return;
      const res = await fetch('/api/account/photo', { method: 'DELETE' });
      if (res.ok) window.location.reload();
    }

    function cancelPhotoPreview() {
      document.getElementById('photo-input').value = '';
      document.getElementById('photo-preview-wrap').hidden = true;
    }

    // ── Personal Details ───────────────────────────────────────────────────────
    async function saveDetails() {
      const name  = document.getElementById('details-name').value.trim();
      const email = document.getElementById('details-email').value.trim();
      const statusEl = document.getElementById('details-status');
      if (!name || !email) {
        showStatus(statusEl, 'Name and email are required.', true);
        return;
      }
      const res = await fetch('/api/account/details', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email })
      });
      const data = await res.json();
      if (res.ok) {
        showStatus(statusEl, 'Details updated. ✓', false);
        // Update sidebar name immediately
        document.querySelectorAll('.sidebar-user-name').forEach(el => el.textContent = name);
      } else {
        showStatus(statusEl, data.error, true);
      }
    }

    // ── Password ───────────────────────────────────────────────────────────────
    async function savePassword() {
      const current  = document.getElementById('pw-current').value;
      const newPw    = document.getElementById('pw-new').value;
      const confirm  = document.getElementById('pw-confirm').value;
      const statusEl = document.getElementById('pw-status');
      const res = await fetch('/api/account/password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ current_password: current, new_password: newPw, confirm_password: confirm })
      });
      const data = await res.json();
      if (res.ok) {
        document.getElementById('pw-current').value = '';
        document.getElementById('pw-new').value = '';
        document.getElementById('pw-confirm').value = '';
        showStatus(statusEl, 'Password updated. ✓', false);
      } else {
        showStatus(statusEl, data.error, true);
      }
    }

    // ── Season ─────────────────────────────────────────────────────────────────
    document.querySelectorAll('.season-card').forEach(card => {
      card.addEventListener('click', async () => {
        const season = card.dataset.season;
        const already = card.classList.contains('is-selected');
        const newSeason = already ? null : season;
        // Commit to the server FIRST — only paint the UI if it accepted the
        // change. Optimistic-then-fetch left the UI lying when /api/season
        // 403'd (which it now does for ineligible students).
        let res;
        try {
          res = await fetch('/api/season', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ season: newSeason })
          });
        } catch (_) { return; }
        if (!res.ok) return;
        document.querySelectorAll('.season-card').forEach(c => c.classList.remove('is-selected'));
        if (!already) card.classList.add('is-selected');
        const seasonClasses = ['season-avatar--spring','season-avatar--summer','season-avatar--autumn','season-avatar--winter'];
        document.querySelectorAll('.sidebar-avatar, .sidebar-avatar-link .sidebar-avatar').forEach(el => {
          el.classList.remove(...seasonClasses);
          if (newSeason) el.classList.add(`season-avatar--${newSeason}`);
        });
      });
    });

    // ── Timezone ───────────────────────────────────────────────────────────────
    async function saveTimezone() {
      const timezone = document.getElementById('timezone-select').value;
      const statusEl = document.getElementById('tz-status');
      const res = await fetch('/api/account/timezone', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ timezone })
      });
      if (res.ok) {
        showStatus(statusEl, 'Saved. ✓', false);
      } else {
        const data = await res.json();
        showStatus(statusEl, data.error, true);
      }
    }

    // ── Preference toggles ────────────────────────────────────────────────────
    async function togglePref(btn, key) {
      const wasOn = btn.getAttribute('aria-pressed') === 'true';
      const nowOn = !wasOn;
      btn.setAttribute('aria-pressed', String(nowOn));
      const savedEl = document.getElementById(`saved-${key}`);
      const res = await fetch('/api/account/preference', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key, value: nowOn })
      });
      if (res.ok) {
        if (savedEl) {
          savedEl.hidden = false;
          setTimeout(() => { savedEl.hidden = true; }, 2000);
        }
      } else {
        btn.setAttribute('aria-pressed', String(wasOn));
      }
    }

    // ── Helpers ────────────────────────────────────────────────────────────────
    function showStatus(el, msg, isError) {
      el.textContent = msg;
      el.className = 'acct-status ' + (isError ? 'acct-status--error' : 'acct-status--ok');
      el.hidden = false;
      if (!isError) setTimeout(() => { el.hidden = true; el.textContent = ''; }, 3500);
    }

    // ── Daily Reminder ─────────────────────────────────────────────────────────
    // Two-axis state model:
    //   • Master toggle (`daily_reminder_enabled`) — server-side per-user flag
    //     the cron checks before sending. Persists across devices.
    //   • Per-device push subscription — browser-level permission + endpoint
    //     stored in push_subscriptions. One row per device/browser install.
    //
    // The UI lets you toggle them independently for clarity, but the "Enable
    // on this device" button is the one most students will use — it grants
    // permission, subscribes, AND turns on the master toggle in one tap.

    const reminderErrEl = document.getElementById('reminder-error');

    async function toggleDailyReminder(btn) {
      const wasOn = btn.getAttribute('aria-pressed') === 'true';
      const nowOn = !wasOn;
      btn.setAttribute('aria-pressed', String(nowOn));
      document.getElementById('reminder-time-row').hidden = !nowOn;
      const savedEl = document.getElementById('saved-daily_reminder');
      const res = await fetch('/api/account/daily-reminder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: nowOn })
      });
      if (res.ok) {
        if (savedEl) { savedEl.hidden = false; setTimeout(() => savedEl.hidden = true, 2000); }
      } else {
        btn.setAttribute('aria-pressed', String(wasOn));
        document.getElementById('reminder-time-row').hidden = !wasOn;
      }
    }

    async function saveReminderHour(sel) {
      await fetch('/api/account/daily-reminder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hour: parseInt(sel.value, 10) })
      });
    }

    // Standard helper for converting a base64url-encoded VAPID key into the
    // Uint8Array shape pushManager.subscribe() wants.
    function urlBase64ToUint8Array(s) {
      const padding = '='.repeat((4 - s.length % 4) % 4);
      const base64 = (s + padding).replace(/-/g, '+').replace(/_/g, '/');
      const raw = atob(base64);
      const out = new Uint8Array(raw.length);
      for (let i = 0; i < raw.length; ++i) out[i] = raw.charCodeAt(i);
      return out;
    }

    function showReminderError(msg) {
      reminderErrEl.textContent = msg;
      reminderErrEl.hidden = false;
    }

    function setDeviceUiEnabled(isEnabled) {
      document.getElementById('device-status-label').textContent =
        isEnabled ? 'Enabled on this device' : 'Not enabled on this device';
      document.getElementById('device-status-hint').textContent = isEnabled
        ? "You'll get the daily reminder here."
        : 'Tap below to allow notifications in this browser.';
      document.getElementById('enable-device-btn').hidden  = isEnabled;
      document.getElementById('disable-device-btn').hidden = !isEnabled;
    }

    async function enableOnDevice() {
      reminderErrEl.hidden = true;
      if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) {
        return showReminderError('This browser does not support push notifications.');
      }

      // Permission has to be requested from a user gesture — we are inside one.
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        return showReminderError('Permission denied. You can enable it in your browser settings.');
      }

      // Pull the VAPID public key fresh — handles the case where the server
      // rotated keys since the last visit.
      const keyRes = await fetch('/api/push/vapid-public-key');
      if (!keyRes.ok) {
        return showReminderError('Notifications are not configured on the server yet.');
      }
      const { key } = await keyRes.json();

      const reg = await navigator.serviceWorker.ready;
      let sub;
      try {
        sub = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(key),
        });
      } catch (e) {
        return showReminderError('Could not subscribe: ' + (e.message || e));
      }

      const res = await fetch('/api/push/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subscription: sub.toJSON() })
      });
      if (!res.ok) {
        return showReminderError('Could not save the subscription.');
      }

      // If the master toggle is off, flip it on — enabling a device but
      // having the cron skip you would be confusing.
      const masterBtn = document.getElementById('toggle-daily-reminder');
      if (masterBtn.getAttribute('aria-pressed') !== 'true') {
        masterBtn.setAttribute('aria-pressed', 'true');
        document.getElementById('reminder-time-row').hidden = false;
        await fetch('/api/account/daily-reminder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ enabled: true })
        });
      }
      setDeviceUiEnabled(true);
    }

    async function disableOnDevice() {
      reminderErrEl.hidden = true;
      if (!('serviceWorker' in navigator)) return;
      const reg = await navigator.serviceWorker.ready;
      const sub = await reg.pushManager.getSubscription();
      if (sub) {
        // Tell the server first, then unsubscribe locally — if the server
        // call fails the user can retry; if we unsubscribed first we'd lose
        // the endpoint we need to send.
        await fetch('/api/push/unsubscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: sub.endpoint })
        });
        await sub.unsubscribe();
      }
      setDeviceUiEnabled(false);
    }

    // On page load, reconcile UI with reality: does this browser have an
    // active subscription? + is this an iOS Safari that needs the install
    // guidance shown?
    (async () => {
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
      const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
      if (isIOS && !isStandalone) {
        document.getElementById('ios-install-card').hidden = false;
      }

      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        // Just leave the button visible — clicking it will show a friendly
        // unsupported message via showReminderError.
        return;
      }
      try {
        const reg = await navigator.serviceWorker.ready;
        const sub = await reg.pushManager.getSubscription();
        setDeviceUiEnabled(!!sub);
      } catch (_) { /* no-op */ }
    })();
  </script>

</body>
</html>
