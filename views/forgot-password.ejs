<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-body">

  <div class="login-layout">

    <div class="login-brand" aria-hidden="true">
      <img src="/images/brand/Stacked_Logo.png" alt="The Creative's Garden" class="login-brand-icon">
    </div>

    <div class="login-form-panel">
      <div class="login-form-inner">

        <img src="/images/brand/The Creative's Garden Icon with Text_1.svg"
             alt="The Creative's Garden" class="login-logo">

        <% if (sent) { %>

          <p class="login-form-eyebrow">Check your inbox</p>
          <h2 class="login-form-title">Email sent</h2>

          <p class="login-help" style="margin-bottom: 1.75rem;">
            If an account exists for that email address, we've sent a link to reset your password.
            The link expires in 1 hour. If you don't see it, check your spam folder.
          </p>

          <a href="/" class="btn btn-primary btn-full" style="text-align: center; text-decoration: none; display: block;">
            Back to sign in
          </a>

        <% } else { %>

          <p class="login-form-eyebrow">Reset your password</p>
          <h2 class="login-form-title">We'll send you a link</h2>

          <% if (error) { %>
            <div class="login-error" role="alert"><%= error %></div>
          <% } %>

          <form action="/forgot-password" method="POST" class="login-form" novalidate>
            <div class="form-group">
              <label for="email" class="form-label">Email address</label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                placeholder="you@example.com"
                autocomplete="email"
                required>
            </div>

            <button type="submit" class="btn btn-primary btn-full">
              Send reset link
            </button>
          </form>

          <p class="login-forgot">
            <a href="/" class="login-forgot-link">Back to sign in</a>
          </p>

        <% } %>

        <p class="login-attribution">A content creation course by <a href="https://www.meibostouch.com/the-creatives-garden" target="_blank" rel="noopener" class="login-attribution-link">The Meibos Touch</a>.</p>

      </div>
    </div>

  </div>

</body>
</html>
