<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/lessons.css">
</head>
<body class="app-body">

  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content" id="main">

      <a href="/lessons" class="lesson-back">← All lessons</a>

      <div class="lesson-layout">

        <!-- Category tag -->
        <%
          const catKey = (lesson.category_tag || '').toLowerCase();
          const tagClass = ['mindset','practical','perspective'].includes(catKey)
            ? `lesson-article-tag--${catKey}`
            : 'lesson-article-tag--default';
        %>
        <div class="lesson-article-tag <%= tagClass %>"><%= lesson.category_tag || 'Lesson' %></div>

        <!-- Title + subtitle -->
        <h1 class="lesson-article-title"><%= lesson.title %></h1>
        <p class="lesson-article-subtitle"><em><%= lesson.subtitle %></em></p>

        <!-- Meta -->
        <div class="lesson-article-meta">
          <span>~<%= lesson.estimated_read_time %> min read</span>
          <span class="lesson-article-meta-dot"></span>
          <span>Lesson <%= lessonNumber %> of 12</span>
          <% if (curricularSeasonLabel) { %>
          <span class="lesson-article-meta-dot"></span>
          <span class="curricular-season-label"><%= curricularSeasonLabel %></span>
          <% } %>
        </div>

        <!-- 1. Video (if available) -->
        <% if (lesson.video_url) { %>
        <div class="lesson-video-wrap">
          <iframe
            src="<%= lesson.video_url %>"
            title="<%= lesson.title %>"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="lesson-video"></iframe>
        </div>
        <% } %>

        <!-- 2. Write-up -->
        <div class="lesson-body">
          <%- lesson.content %>
        </div>

        <!-- Greenhouse CTA — Lesson 1 only -->
        <% if (lesson.slug === 'welcome-to-the-rhythm') { %>
        <div class="lesson-greenhouse-cta">
          <p class="lesson-greenhouse-cta-label">Ready to plant?</p>
          <button class="lesson-greenhouse-cta-btn" onclick="plantAndNavigate()">Plant your goals in the Greenhouse →</button>
        </div>
        <% } %>

        <!-- 3. Homework -->
        <% if (homework && homework.length > 0) { %>
        <section class="lesson-homework">
          <h2>Homework</h2>
          <p class="homework-intro">Mark these complete as you work through them. There's no rush.</p>

          <% homework.forEach(function(task) { %>
            <% const isExternal = task.link_url && !task.link_url.startsWith('/'); %>
            <div class="homework-item" id="hw-item-<%= task.id %>">
              <input
                type="checkbox"
                class="homework-checkbox"
                id="hw-<%= task.id %>"
                data-homework-id="<%= task.id %>"
                <%= homeworkDone.has(task.id) ? 'checked' : '' %>>
              <div class="homework-text">
                <label for="hw-<%= task.id %>"><p><%= task.title %></p></label>
                <% if (task.link_url) { %>
                  <a href="<%= task.link_url %>"
                     class="homework-link"
                     <%= isExternal ? 'target="_blank" rel="noopener"' : '' %>>
                    <%= task.link_label || 'Open link' %>
                  </a>
                <% } %>
              </div>
            </div>
          <% }); %>
        </section>
        <% } %>

        <!-- Footer: completion + navigation -->
        <footer class="lesson-footer">

          <div class="lesson-complete-section">
            <input
              type="checkbox"
              class="complete-checkbox"
              id="lessonComplete"
              <%= completed ? 'checked' : '' %>>
            <div>
              <label for="lessonComplete" class="lesson-complete-label <%= completed ? 'is-done' : '' %>" id="completeLabel">
                <%= completed ? 'Lesson complete ✓' : 'Mark as complete' %>
              </label>
              <p class="lesson-complete-sub">Your progress is saved automatically.</p>
            </div>
          </div>

          <nav class="lesson-nav" aria-label="Lesson navigation">
            <% if (prevLesson) { %>
              <a href="/lessons/<%= prevLesson.slug %>" class="lesson-nav-item lesson-nav-item--prev">
                <span class="lesson-nav-direction">← Previous</span>
                <span class="lesson-nav-title"><%= prevLesson.title %></span>
              </a>
            <% } else { %>
              <div></div>
            <% } %>

            <% if (nextLesson) { %>
              <a href="/lessons/<%= nextLesson.slug %>" class="lesson-nav-item lesson-nav-item--next">
                <span class="lesson-nav-direction">Next →</span>
                <span class="lesson-nav-title"><%= nextLesson.title %></span>
              </a>
            <% } else { %>
              <div></div>
            <% } %>
          </nav>

        </footer>

      </div><!-- /.lesson-layout -->

    </main>
  </div>

  <script>
    const lessonId = <%= lesson.id %>;

    // ── Mark lesson complete checkbox ─────────────────────────────────────────
    const checkbox = document.getElementById('lessonComplete');
    const label = document.getElementById('completeLabel');

    checkbox.addEventListener('change', async () => {
      const isComplete = checkbox.checked;
      label.textContent = isComplete ? 'Lesson complete ✓' : 'Mark as complete';
      label.classList.toggle('is-done', isComplete);
      await fetch(`/api/lessons/${lessonId}/complete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ completed: isComplete })
      });
    });

    // ── Greenhouse CTA (Lesson 1 only) ────────────────────────────────────────
    async function plantAndNavigate() {
      try {
        await fetch(`/api/lessons/${lessonId}/complete`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ completed: true })
        });
        // Sync the checkbox state
        if (!checkbox.checked) {
          checkbox.checked = true;
          label.textContent = 'Lesson complete ✓';
          label.classList.add('is-done');
        }
      } catch (e) { /* network hiccup — still navigate */ }
      window.location.href = '/greenhouse';
    }

    // ── Homework checkboxes ───────────────────────────────────────────────────
    document.querySelectorAll('.homework-checkbox').forEach(cb => {
      cb.addEventListener('change', async () => {
        const homeworkId = cb.dataset.homeworkId;
        const res = await fetch(`/api/lessons/${lessonId}/homework/${homeworkId}/toggle`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        if (!res.ok) {
          // Revert visual state on error
          cb.checked = !cb.checked;
        }
      });
    });
  </script>

</body>
</html>
