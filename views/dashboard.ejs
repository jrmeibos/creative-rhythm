<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="app-body">

  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content" id="main">

      <!-- Dashboard header -->
      <% if (typeof upgradeBanner !== 'undefined' && upgradeBanner) { %>
      <link rel="stylesheet" href="/css/upgrade.css">
      <section class="up-success-banner" id="up-success-banner">
        <div class="up-success-banner-copy">
          <strong>Welcome to <%= upgradeBanner.tierName %>.</strong>
          <span>
            Weeks 4–12 are now unlocked.
            <% if (upgradeBanner.discordUrl) { %>
              Join the community on
              <a href="<%= upgradeBanner.discordUrl %>" target="_blank" rel="noopener" class="up-success-banner-cta">Discord →</a>
            <% } %>
          </span>
        </div>
        <button type="button" class="up-success-banner-close" onclick="document.getElementById('up-success-banner').remove()" aria-label="Dismiss">×</button>
      </section>
      <% } %>

      <header class="dash-header">
        <div class="dash-greeting">
          <h1 class="dash-greeting-text">
            <%= greeting %>, <span class="dash-name"><%= user.name.split(' ')[0] %></span>
          </h1>
          <p class="dash-week-label">
            <% if (trialComplete) { %>
              <span class="integration-badge">Trial complete</span>
            <% } else if (weekNumber > courseLengthWeeks) { %>
              <%# Past the 12-week curriculum: keep the week counter climbing so
                  the practice stays evergreen instead of dead-ending at a
                  "Course complete" badge. %>
              Week <%= weekNumber %> · <%= weekLabel %>
            <% } else if (weekNumber >= 1) { %>
              Week <%= weekNumber %> of <%= courseLengthWeeks %> · <%= weekLabel %>
            <% } else { %>
              Week of <%= weekLabel %>
            <% } %>
          </p>
        </div>
        <%# Lessons hidden from students during the trial run. The completion
            pill stays visible to admin only; remove this guard to restore it. %>
        <% if (user && user.role === 'admin') { %>
        <div class="dash-progress-pill">
          <span class="dash-progress-count"><%= completedCount %> / <%= totalLessons %></span>
          <span class="dash-progress-label">lessons complete</span>
        </div>
        <% } %>
      </header>

      <!-- Day-view: per-day topic + reflection with back/forward day nav.
           Markup lives in views/partials/day-view.ejs (one source for both
           the full-page render and the GET /dashboard/day fragment). The
           outer #dayview-container is persistent — it stays in the DOM
           across day-to-day fetch-and-swap, and is what the inline
           controller below delegates events from. -->
      <% if (trialClosingCardVisible) { %>
      <section class="dash-section">
        <div class="mid-card" data-banner-key="trial_closing">
          <%- include('partials/card-dismiss', { snoozeLabel: 'Remind me later', removeLabel: "I'd rather not give feedback" }) %>
          <p class="mid-card-eyebrow">You've reached week <%= courseLengthWeeks %></p>
          <h2 class="mid-card-title">Closing Reflection</h2>
          <p class="mid-card-body">
            Three weeks in. A short, honest reflection on how this has landed for you —
            and whether you'd like to continue with the full 12-week course.
          </p>
          <a href="/trial-closing" class="mid-card-cta">Take the closing reflection →</a>
        </div>
      </section>
      <% } %>
      <% if (trialComplete) { %>
      <section class="dash-section">
        <div class="mid-card">
          <p class="mid-card-eyebrow">Your trial is complete</p>
          <h2 class="mid-card-title">Want to keep going?</h2>
          <p class="mid-card-body">
            You've finished your <%= courseLengthWeeks %>-week trial of The Creative's Garden.
            If this practice has felt useful, the full 12-week course goes deeper —
            mid-course check-in, harvest reflection, and the remaining seasons.
          </p>
          <a href="/upgrade" class="mid-card-cta">Continue with the full course →</a>
        </div>
      </section>
      <% } %>
      <% if (midcourseCardVisible) { %>
      <section class="dash-section">
        <div class="mid-card" data-banner-key="midcourse">
          <%- include('partials/card-dismiss', { snoozeLabel: 'Remind me later', removeLabel: "I'd rather not give feedback" }) %>
          <p class="mid-card-eyebrow">A Short, Anonymous Survey</p>
          <h2 class="mid-card-title">Mid-Course Check-In</h2>
          <p class="mid-card-body">
            We're about halfway through The Creative's Garden. I'd love to hear
            how this is going for you so far, including anything I can change to
            make the second half better.
          </p>
          <a href="/midcourse" class="mid-card-cta">Take the anonymous survey →</a>
        </div>
      </section>
      <% } %>

      <% if (springCardVisible) { %>
      <section class="dash-section">
        <div class="mid-card mid-card--season" data-banner-key="season_spring">
          <%- include('partials/card-dismiss', { snoozeLabel: 'Show this again later', removeLabel: 'Remove this reminder' }) %>
          <div class="mid-card-split">
            <img class="mid-card-season-art mid-card-season-art--tall" src="/images/seasons/spring.webp" alt="" width="563" height="800">
            <div class="mid-card-split-text">
              <p class="mid-card-eyebrow">Spring is here</p>
              <h2 class="mid-card-title">Tend what you've recorded</h2>
              <p class="mid-card-body">
                A weekly return to what you recorded — read what you noticed, and
                choose where each cutting goes.
              </p>
              <a href="/tending" class="mid-card-cta">Tend your cuttings →</a>
            </div>
          </div>
        </div>
      </section>
      <% } %>

      <% if (summerCardVisible) { %>
      <section class="dash-section">
        <div class="mid-card mid-card--season" data-banner-key="season_summer">
          <%- include('partials/card-dismiss', { snoozeLabel: 'Show this again later', removeLabel: 'Remove this reminder' }) %>
          <img class="mid-card-season-art" src="/images/seasons/summer.webp" alt="" width="800" height="268">
          <p class="mid-card-eyebrow">Summer is here</p>
          <h2 class="mid-card-title">Try making something this week</h2>
          <p class="mid-card-body">
            Pick a cutting from your Cultivate pile and turn it into content —
            a written post, a talk-to-camera video, a quote graphic, or
            anything else that fits. The same cutting can become more than
            one thing over time.
          </p>
          <a href="/summer" class="mid-card-cta">Make something →</a>
        </div>
      </section>
      <% } %>

      <% if (fallCardVisible) { %>
      <section class="dash-section">
        <div class="mid-card mid-card--season" data-banner-key="season_autumn">
          <%- include('partials/card-dismiss', { snoozeLabel: 'Show this again later', removeLabel: 'Remove this reminder' }) %>
          <div class="mid-card-split">
            <img class="mid-card-season-art mid-card-season-art--tall" src="/images/seasons/autumn.webp" alt="" width="757" height="800">
            <div class="mid-card-split-text">
              <p class="mid-card-eyebrow">Autumn is here</p>
              <h2 class="mid-card-title">Share what you've made</h2>
              <p class="mid-card-body">
                Bring what you've created out into the world. As you share — a post,
                a video, a note — come back and add the links.
              </p>
              <a href="/grove" class="mid-card-cta">Share the bounty →</a>
            </div>
          </div>
        </div>
      </section>
      <% } %>

      <% if (locals.showSeasonIntroCard) { %>
      <section class="dash-section" data-season-intro-card>
        <div class="mid-card">
          <p class="mid-card-eyebrow">Winter's behind you</p>
          <h2 class="mid-card-title">You've stepped into Spring</h2>
          <p class="mid-card-body">
            From here on, you can shape your season. The platform follows your
            lead — if you're in Spring, you get Spring's prompts; if you step
            back into Winter, everything quiets down again. There's no wrong
            answer, and no need to keep pace with the calendar.
          </p>
          <div class="mid-card-actions">
            <a href="/profile" class="mid-card-cta mid-card-cta--ghost">Adjust in Profile</a>
            <button type="button" class="mid-card-cta" data-season-intro-dismiss>Got it</button>
          </div>
        </div>
      </section>
      <script>
        (function () {
          var card = document.querySelector('[data-season-intro-card]');
          var btn  = document.querySelector('[data-season-intro-dismiss]');
          if (!card || !btn) return;
          btn.addEventListener('click', function () {
            btn.disabled = true;
            fetch('/api/season/intro-seen', {
              method: 'POST', credentials: 'same-origin',
            }).catch(function () {}).finally(function () {
              card.style.transition = 'opacity 0.22s ease';
              card.style.opacity = '0';
              setTimeout(function () { card.remove(); }, 240);
            });
          });
        })();
      </script>
      <% } %>

      <script>
        // Dismissible dashboard banners: ✕ reveals a menu (snooze / remove);
        // choosing an option POSTs the choice and removes the card. Delegated
        // so it covers whichever dismissible cards rendered.
        (function () {
          function closeMenus(except) {
            document.querySelectorAll('.mid-card-dismiss-menu').forEach(function (m) {
              if (m !== except) m.classList.add('is-hidden');
            });
            document.querySelectorAll('.mid-card-x').forEach(function (x) {
              if (!except || x.parentElement.querySelector('.mid-card-dismiss-menu') !== except) {
                x.setAttribute('aria-expanded', 'false');
              }
            });
          }
          document.addEventListener('click', function (e) {
            var x = e.target.closest('.mid-card-x');
            if (x) {
              var menu = x.parentElement.querySelector('.mid-card-dismiss-menu');
              var opening = menu.classList.contains('is-hidden');
              closeMenus(opening ? menu : null);
              menu.classList.toggle('is-hidden', !opening);
              x.setAttribute('aria-expanded', opening ? 'true' : 'false');
              return;
            }
            var opt = e.target.closest('.mid-card-dismiss-opt');
            if (opt) {
              var card = opt.closest('.mid-card');
              var key  = card && card.dataset.bannerKey;
              if (!key) return;
              opt.closest('.mid-card-dismiss-menu').classList.add('is-hidden');
              fetch('/api/banner/dismiss', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ key: key, action: opt.dataset.bannerAction })
              }).catch(function () {}).finally(function () {
                var section = card.closest('.dash-section') || card;
                section.style.transition = 'opacity 0.22s ease';
                section.style.opacity = '0';
                setTimeout(function () { section.remove(); }, 240);
              });
              return;
            }
            if (!e.target.closest('.mid-card-dismiss')) closeMenus(null);
          });
        })();
      </script>

      <section class="dash-section">
        <div id="dayview-container"
             class="recording-card"
             data-today="<%= today %>">
          <%- include('partials/day-view', { dayview, cuttingPrompts }) %>
        </div>
      </section>

      <% if (canJotIdea) { %>
      <!-- Quick idea capture — distinct from today's recording. Ideas land on
           the Workbench, and may already have material (writing, a voice note,
           photos, video) or none at all. -->
      <section class="dash-section">
        <div class="idea-capture" data-idea-capture>
          <button type="button" class="idea-capture-open" data-idea-capture-open>
            <span class="idea-capture-open-emoji" aria-hidden="true">💡</span>
            Jot an idea
            <span class="idea-capture-open-hint">— something you want to make (not today's recording)</span>
          </button>

          <div class="idea-capture-form" hidden data-idea-capture-form>
            <p class="idea-capture-help">
              This goes to your <a href="/workbench">Workbench</a>, separate from
              your daily recording. It doesn't have to be filmed — note what you
              already have, if anything.
            </p>
            <label class="idea-capture-label" for="dash-idea-title">Title</label>
            <input type="text" id="dash-idea-title" class="idea-capture-input" maxlength="120"
                   placeholder="e.g. Show my new branding in a carousel post">
            <label class="idea-capture-label" for="dash-idea-note">
              Note <span class="idea-capture-optional">(optional)</span>
            </label>
            <textarea id="dash-idea-note" class="idea-capture-textarea" rows="2"
                      placeholder="Anything to remember about this idea."></textarea>

            <p class="idea-capture-label">What do you already have for it?</p>
            <div class="idea-materials">
              <label class="idea-material"><input type="checkbox" value="writing"> <span>✍️ Writing / journal</span></label>
              <label class="idea-material"><input type="checkbox" value="audio"> <span>🎙️ Voice note</span></label>
              <label class="idea-material"><input type="checkbox" value="photos"> <span>📷 Photos</span></label>
              <label class="idea-material"><input type="checkbox" value="video"> <span>🎥 Video</span></label>
            </div>
            <p class="idea-capture-nothing">Leave all unchecked if it's just an idea for now.</p>

            <p class="idea-capture-error" data-idea-capture-error hidden></p>
            <div class="idea-capture-actions">
              <span class="idea-capture-saved" data-idea-capture-saved hidden>Saved to your Workbench ✓</span>
              <button type="button" class="idea-capture-cancel" data-idea-capture-cancel>Cancel</button>
              <button type="button" class="idea-capture-save" data-idea-capture-save>Add idea</button>
            </div>
          </div>
        </div>
      </section>

      <script>
        (function () {
          var wrap   = document.querySelector('[data-idea-capture]');
          if (!wrap) return;
          var openBtn = wrap.querySelector('[data-idea-capture-open]');
          var form    = wrap.querySelector('[data-idea-capture-form]');
          var cancel  = wrap.querySelector('[data-idea-capture-cancel]');
          var save    = wrap.querySelector('[data-idea-capture-save]');
          var errEl   = wrap.querySelector('[data-idea-capture-error]');
          var savedEl = wrap.querySelector('[data-idea-capture-saved]');
          var titleEl = wrap.querySelector('#dash-idea-title');
          var noteEl  = wrap.querySelector('#dash-idea-note');

          function reset() {
            titleEl.value = ''; noteEl.value = '';
            wrap.querySelectorAll('.idea-material input').forEach(function (c) { c.checked = false; });
            if (errEl) errEl.hidden = true;
            save.disabled = false;
          }
          openBtn.addEventListener('click', function () {
            form.hidden = false; openBtn.hidden = true;
            if (savedEl) savedEl.hidden = true;
            titleEl.focus();
          });
          cancel.addEventListener('click', function () {
            form.hidden = true; openBtn.hidden = false; reset();
          });
          save.addEventListener('click', function () {
            var title = titleEl.value.trim();
            var note  = noteEl.value.trim();
            if (!title && !note) {
              if (errEl) { errEl.textContent = 'Add a title or a note.'; errEl.hidden = false; }
              return;
            }
            var materials = [];
            wrap.querySelectorAll('.idea-material input:checked').forEach(function (c) { materials.push(c.value); });
            save.disabled = true;
            if (errEl) errEl.hidden = true;
            fetch('/summer/ideas', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ title: title, note: note, materials: materials }),
            }).then(function (r) {
              if (!r.ok) throw new Error('save failed');
              reset();
              form.hidden = true; openBtn.hidden = false;
              if (savedEl) { savedEl.hidden = false; setTimeout(function () { savedEl.hidden = true; }, 3500); }
            }).catch(function () {
              if (errEl) { errEl.textContent = 'Could not save. Try again.'; errEl.hidden = false; }
              save.disabled = false;
            });
          });
        })();
      </script>
      <% } %>

      <style>
        /* Day-view module — scoped via .dayview- prefix to avoid collisions
           with the legacy recording-card classes (which the day-view reuses
           for the season label / about-toggle / form). */
        .dayview-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 0.75rem;
          margin-bottom: 1.1rem;
        }
        .dayview-nav {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 2.25rem;
          height: 2.25rem;
          border-radius: 50%;
          font-family: var(--font-body);
          font-size: 1.4rem;
          line-height: 1;
          color: var(--color-bloem);
          text-decoration: none;
          background: rgba(112, 92, 108, 0.06);
          transition: background 0.15s;
        }
        .dayview-nav:hover { background: rgba(112, 92, 108, 0.14); }
        .dayview-nav--disabled {
          color: rgba(16, 15, 16, 0.18);
          background: transparent;
          cursor: default;
        }
        .dayview-day-label {
          flex: 1;
          text-align: center;
          font-family: var(--font-body);
          font-size: 0.92rem;
          font-weight: 400;
          color: var(--color-ink-stained);
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          flex-wrap: wrap;
        }
        .dayview-day-num {
          font-family: var(--font-body);
          font-weight: 700;
          letter-spacing: 0.02em;
          color: var(--color-bloem);
        }
        .dayview-date { font-weight: 300; color: rgba(16, 15, 16, 0.75); }
        .dayview-today-tag {
          font-family: var(--font-body);
          font-size: 0.62rem;
          font-weight: 600;
          letter-spacing: 0.12em;
          text-transform: uppercase;
          color: var(--color-bloem);
          background: rgba(246, 201, 92, 0.22);
          padding: 0.15rem 0.5rem;
          border-radius: 999px;
        }
        .dayview-season-row {
          display: flex;
          align-items: baseline;
          gap: 0.75rem 1rem;
          flex-wrap: wrap;
          margin-bottom: 0.4rem;
        }
        .dayview-entry { margin-top: 1rem; }
        .dayview-entry--stacked {
          margin-top: 1.1rem;
          padding-top: 1.1rem;
          border-top: 1px solid rgba(112, 92, 108, 0.12);
        }
        .dayview-field { margin-top: 0.75rem; }
        .dayview-field:first-child { margin-top: 0; }
        .dayview-field-label {
          font-family: var(--font-display);
          font-style: italic;
          font-size: 0.88rem;
          font-weight: 400;
          color: rgba(16, 15, 16, 0.55);
          margin: 0 0 0.2rem;
        }
        .dayview-field-text {
          font-family: var(--font-body);
          font-size: 1rem;
          font-weight: 300;
          line-height: 1.6;
          color: var(--color-ink-stained);
          margin: 0;
          white-space: pre-wrap;
        }
        /* Empty "slot" for a day with no recording yet — a dashed placeholder
           that reads as fillable and disappears once a cutting is added. */
        .dayview-empty-box {
          margin-top: 1.25rem;
          padding: 2rem 1.5rem;
          border: 1.5px dashed rgba(118, 133, 108, 0.5);
          border-radius: 14px;
          background: rgba(230, 235, 224, 0.35);
          display: flex;
          flex-direction: column;
          align-items: center;
          text-align: center;
          gap: 1rem;
        }
        .dayview-empty-icon {
          width: 34px;
          height: 34px;
          color: var(--color-understory);
          opacity: 0.75;
        }
        .dayview-empty {
          font-family: var(--font-body);
          font-size: 0.98rem;
          font-weight: 300;
          color: rgba(16, 15, 16, 0.6);
          margin: 0;
        }
        /* Clarifies the record-on-your-device-then-log-here model, right where
           new students land and get confused about where to record. */
        .dayview-empty-sub {
          font-family: var(--font-body);
          font-size: 0.85rem;
          font-weight: 300;
          line-height: 1.5;
          color: rgba(16, 15, 16, 0.5);
          max-width: 22rem;
          margin: -0.6rem 0 0;
        }
        .dayview-form-intro {
          font-family: var(--font-body);
          font-size: 0.85rem;
          font-weight: 300;
          font-style: italic;
          color: rgba(16, 15, 16, 0.55);
          margin: 0 0 0.85rem;
        }
        .dayview-empty-box .dayview-cta-row {
          margin-top: 0;
          justify-content: center;
        }
        .dayview-cta-row {
          margin-top: 1.1rem;
          display: flex;
          align-items: center;
          gap: 1rem;
          flex-wrap: wrap;
        }
        /* Sits inline to the right of the record button — drop its stacked margin. */
        .dayview-cta-row .recording-about-toggle { margin: 0; }
        .dayview-form { margin-top: 1.5rem; }
        .dayview-form.is-hidden { display: none; }

        /* Clickable camera in the empty box — the upload affordance for people
           who can actually upload (admin now, paid students later). */
        .dayview-empty-camera {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 0.6rem;
          background: none;
          border: none;
          padding: 0;
          cursor: pointer;
        }
        /* Filled bloem circle — reads as a tappable button, not decoration. */
        .dayview-empty-camera-circle {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 64px;
          height: 64px;
          border-radius: 50%;
          background: var(--color-bloem);
          box-shadow: 0 4px 14px rgba(112, 92, 108, 0.30);
          transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
        }
        .dayview-empty-camera:hover .dayview-empty-camera-circle {
          background: var(--color-bloem-mid);
          transform: translateY(-1px);
          box-shadow: 0 6px 18px rgba(112, 92, 108, 0.38);
        }
        .dayview-empty-camera:active .dayview-empty-camera-circle {
          transform: translateY(0);
          box-shadow: 0 3px 10px rgba(112, 92, 108, 0.32);
        }
        .dayview-empty-camera-icon {
          width: 28px;
          height: 28px;
          color: #fff;
        }
        .dayview-empty-camera-text {
          font-family: var(--font-body);
          font-size: 0.88rem;
          font-weight: 700;
          color: var(--color-bloem);
        }

        /* ── Video upload (admin-only experiment) ── */
        .dayview-video-upload {
          margin: 0 0 1.25rem;
          padding: 1rem 1.1rem;
          border: 1.5px dashed rgba(118, 133, 108, 0.5);
          border-radius: 12px;
          background: rgba(230, 235, 224, 0.35);
        }
        .dayview-video-label {
          display: block;
          font-family: var(--font-body);
          font-size: 0.9rem;
          font-weight: 700;
          color: var(--color-ink-stained);
          margin-bottom: 0.5rem;
        }
        .dayview-video-optional {
          font-weight: 300;
          color: rgba(16, 15, 16, 0.5);
        }
        .dayview-video-input {
          font-family: var(--font-body);
          font-size: 0.85rem;
          font-weight: 300;
          color: rgba(16, 15, 16, 0.75);
          max-width: 100%;
        }
        .dayview-video-progress {
          display: flex;
          align-items: center;
          gap: 0.6rem;
          margin-top: 0.75rem;
        }
        /* `display: flex` above beats the [hidden] attribute's UA display:none,
           so restate it — otherwise an empty progress bar shows at 0%. */
        .dayview-video-progress[hidden] { display: none; }
        .dayview-video-bar {
          flex: 1;
          height: 6px;
          border-radius: 3px;
          background: rgba(112, 92, 108, 0.15);
          overflow: hidden;
        }
        .dayview-video-bar span {
          display: block;
          height: 100%;
          width: 0%;
          background: var(--color-bloem);
          transition: width 0.2s ease;
        }
        .dayview-video-pct {
          font-family: var(--font-body);
          font-size: 0.78rem;
          font-weight: 400;
          color: rgba(16, 15, 16, 0.6);
          min-width: 2.6rem;
          text-align: right;
        }
        .dayview-video-status {
          margin: 0.6rem 0 0;
          font-family: var(--font-body);
          font-size: 0.82rem;
          font-weight: 300;
          line-height: 1.5;
          color: var(--color-understory);
        }
        .dayview-video-status.is-error { color: #8c4a45; }

        /* ── Video playback on a logged entry ── */
        .dayview-video { margin-bottom: 1rem; }
        .dayview-video-play {
          font-family: var(--font-body);
          font-size: 0.85rem;
          font-weight: 400;
          color: var(--color-bloem);
          background: none;
          border: 1px solid rgba(112, 92, 108, 0.35);
          border-radius: 999px;
          padding: 0.4rem 0.9rem;
          cursor: pointer;
        }
        .dayview-video-play:hover { background: rgba(112, 92, 108, 0.07); }
        .dayview-video-play:disabled { opacity: 0.6; cursor: default; }
        .dayview-video-frame {
          position: relative;
          width: 100%;
          aspect-ratio: 9 / 16;
          max-width: 320px;
          border-radius: 12px;
          overflow: hidden;
          background: #000;
        }
        .dayview-video-frame iframe {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          border: none;
        }
        .dayview-video-msg {
          margin: 0.5rem 0 0;
          font-family: var(--font-body);
          font-size: 0.82rem;
          font-weight: 300;
          font-style: italic;
          color: rgba(16, 15, 16, 0.6);
        }

        /* Fetch-and-swap loading state — calm fade + arrows go inert while
           the next day's fragment is on the wire. Brief enough that we don't
           need a spinner; just stops double-clicks and signals "working." */
        #dayview-container.is-loading .dayview-fragment {
          opacity: 0.55;
          transition: opacity 0.15s ease-out;
        }
        #dayview-container.is-loading .dayview-nav {
          pointer-events: none;
        }
      </style>

      <script>
        // Day-view controller. Uses event delegation on the persistent
        // #dayview-container so prev/next, About, Add/Save/Cancel keep
        // working after each fetch-and-swap without re-binding listeners.
        //
        // Progressive enhancement: the prev/next links still have real hrefs
        // (?day=...). If fetch fails or JS is off, the browser does a normal
        // full-page navigation and the page works the same.
        (function () {
          const container = document.getElementById('dayview-container');
          if (!container || typeof fetch !== 'function' || !window.history || !history.pushState) return;
          const todayStr = container.dataset.today || '';

          const viewedDate = () => {
            const frag = container.querySelector('[data-viewed-date]');
            return frag ? frag.dataset.viewedDate : todayStr;
          };

          // Fetch the day fragment and swap it into the container. skipPush=true
          // for popstate-driven swaps so we don't re-push the same URL.
          async function loadDay(dateStr, skipPush) {
            if (!dateStr) return;
            container.classList.add('is-loading');
            try {
              const res = await fetch('/dashboard/day?day=' + encodeURIComponent(dateStr), {
                headers: { 'Accept': 'text/html' },
                credentials: 'same-origin'
              });
              if (!res.ok) throw new Error('fetch failed');
              const html = await res.text();
              container.innerHTML = html;
              if (!skipPush) {
                const newUrl = location.pathname + '?day=' + encodeURIComponent(dateStr);
                history.pushState({ day: dateStr }, '', newUrl);
              }
            } catch (e) {
              // Fall back to the link's natural navigation so the user
              // still gets where they were going.
              window.location.href = '?day=' + encodeURIComponent(dateStr);
            } finally {
              container.classList.remove('is-loading');
            }
          }

          // ─── Click delegation: prev/next, About toggle, Add/Save/Cancel ──
          container.addEventListener('click', (e) => {
            const nav = e.target.closest('[data-day-nav]');
            if (nav && nav.dataset.dayNav) {
              e.preventDefault();
              loadDay(nav.dataset.dayNav);
              return;
            }
            const aboutBtn = e.target.closest('#dayview-about-toggle');
            if (aboutBtn) {
              const panel = container.querySelector('#dayview-about-panel');
              if (panel) {
                const opened = panel.classList.toggle('is-hidden') === false;
                aboutBtn.setAttribute('aria-expanded', opened ? 'true' : 'false');
                // Base label is set per-render (varies for the Winter/trial weeks).
                const aboutLabel = aboutBtn.dataset.label || 'About this season';
                aboutBtn.textContent = aboutLabel + (opened ? ' ↑' : ' ↓');
              }
              return;
            }
            const topicBtn = e.target.closest('#dayview-topic-toggle');
            if (topicBtn) {
              const panel = container.querySelector('#dayview-topic-panel');
              if (panel) {
                const opened = panel.classList.toggle('is-hidden') === false;
                topicBtn.setAttribute('aria-expanded', opened ? 'true' : 'false');
                topicBtn.textContent = opened
                  ? 'Want an idea of what to talk about today? ↑'
                  : 'Want an idea of what to talk about today? ↓';
              }
              return;
            }
            const howtoBtn = e.target.closest('#dayview-howto-toggle');
            if (howtoBtn) {
              const panel = container.querySelector('#dayview-howto-panel');
              if (panel) {
                const opened = panel.classList.toggle('is-hidden') === false;
                howtoBtn.setAttribute('aria-expanded', opened ? 'true' : 'false');
                howtoBtn.textContent = opened
                  ? 'How to do the daily recording ↑'
                  : 'How to do the daily recording ↓';
                // Lazy-load the YouTube iframe the first time it's opened.
                if (opened) {
                  const f = panel.querySelector('iframe[data-src]');
                  if (f && !f.src) f.src = f.getAttribute('data-src');
                }
              }
              return;
            }
            // Camera icon in the empty box → open the file picker.
            if (e.target.closest('#dayview-box-upload-btn')) {
              const fileEl = container.querySelector('#dayview-video-input');
              if (fileEl) fileEl.click();
              return;
            }
            if (e.target.closest('#dayview-add-btn'))    { showForm(); return; }
            if (e.target.closest('#dayview-cancel'))     { hideForm(true); return; }
            if (e.target.closest('#dayview-save'))       { saveReflection(); return; }
            const playBtn = e.target.closest('[data-video-play]');
            if (playBtn) { playVideo(playBtn); return; }
          });

          // Delegated because the fragment is replaced on day-nav.
          container.addEventListener('change', (e) => {
            if (e.target && e.target.id === 'dayview-video-input') uploadVideo(e.target);
          });

          // ─── Video ──────────────────────────────────────────────────────
          function showVideoStatus(msg, isError) {
            const el = container.querySelector('#dayview-video-status');
            if (!el) return;
            el.textContent = msg;
            el.classList.toggle('is-error', !!isError);
            el.hidden = false;
          }

          // Two steps: ask our server for a one-time Cloudflare upload URL,
          // then PUT the bytes straight to Cloudflare (never through us — a
          // 500MB file would not survive the trip). XHR, not fetch, because we
          // want an upload progress bar.
          async function uploadVideo(input) {
            const file = input.files && input.files[0];
            if (!file) return;
            const progress = container.querySelector('#dayview-video-progress');
            const fill     = container.querySelector('#dayview-video-bar-fill');
            const pct      = container.querySelector('#dayview-video-pct');
            const uidEl    = container.querySelector('#dayview-video-uid');
            const saveBtn  = container.querySelector('#dayview-save');

            showVideoStatus('Starting upload…', false);

            let uploadURL, uid;
            try {
              const r = await fetch('/api/video/upload-url', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ recorded_date: viewedDate() })
              });
              const d = await r.json();
              if (!r.ok || !d.ok) throw new Error(d.detail || d.error || 'could not start upload');
              uploadURL = d.uploadURL; uid = d.uid;
            } catch (err) {
              showVideoStatus('Could not start the upload: ' + err.message, true);
              return;
            }

            if (saveBtn)  saveBtn.disabled = true;
            if (progress) progress.hidden = false;
            if (fill)     fill.style.width = '0%';

            const fd = new FormData();
            fd.append('file', file);

            await new Promise((resolve) => {
              const xhr = new XMLHttpRequest();
              xhr.open('POST', uploadURL, true);
              xhr.upload.onprogress = (ev) => {
                if (!ev.lengthComputable) return;
                const p = Math.round((ev.loaded / ev.total) * 100);
                if (fill) fill.style.width = p + '%';
                if (pct)  pct.textContent  = p + '%';
              };
              xhr.onload = () => {
                if (xhr.status >= 200 && xhr.status < 300) {
                  if (uidEl) uidEl.value = uid;
                  showVideoStatus('Video attached ✓ Add a note if you like, then hit Save to log the day.', false);
                  // The video is only really "logged" once the entry saves, so
                  // open the notes form rather than leave them on a dead end.
                  showForm();
                } else {
                  showVideoStatus('Upload failed (HTTP ' + xhr.status + '). Please try again.', true);
                }
                resolve();
              };
              xhr.onerror = () => {
                showVideoStatus('Upload failed — check your connection and try again.', true);
                resolve();
              };
              xhr.send(fd);
            });

            if (progress) progress.hidden = true;
            if (saveBtn)  saveBtn.disabled = false;
          }

          // Playback is private: fetch a short-lived signed iframe URL, minted
          // only for the owner. Lazy — we don't mint tokens nobody watches.
          async function playVideo(btn) {
            const wrap = btn.closest('.dayview-video');
            if (!wrap) return;
            const uid   = wrap.dataset.videoUid;
            const frame = wrap.querySelector('.dayview-video-frame');
            const msg   = wrap.querySelector('.dayview-video-msg');
            const reset = () => { btn.disabled = false; btn.textContent = '▶ Watch this recording'; };
            btn.disabled = true; btn.textContent = 'Loading…';
            if (msg) msg.hidden = true;
            try {
              const r = await fetch('/api/video/' + encodeURIComponent(uid) + '/playback');
              const d = await r.json();
              if (!r.ok || !d.ok) throw new Error(d.detail || d.error || 'could not load');
              if (!d.ready) {
                if (msg) { msg.textContent = 'Still processing — give it a minute and try again.'; msg.hidden = false; }
                reset();
                return;
              }
              frame.innerHTML = '<iframe src="' + d.iframeUrl + '" loading="lazy" ' +
                'allow="accelerometer; gyroscope; encrypted-media; picture-in-picture;" allowfullscreen></iframe>';
              frame.hidden = false;
              btn.hidden = true;
            } catch (err) {
              if (msg) { msg.textContent = 'Could not load the video: ' + err.message; msg.hidden = false; }
              reset();
            }
          }

          // ─── popstate (browser back/forward) ────────────────────────────
          window.addEventListener('popstate', () => {
            const params = new URLSearchParams(location.search);
            const day = params.get('day') || todayStr;
            loadDay(day, true);
          });

          // ─── Form helpers — re-query the DOM each call because the
          //    fragment gets replaced on swap. ───────────────────────────
          function showForm() {
            const form = container.querySelector('#dayview-form');
            const addBtn = container.querySelector('#dayview-add-btn');
            if (!form || !addBtn) return;
            form.classList.remove('is-hidden');
            addBtn.style.display = 'none';
            const first = form.querySelector('textarea[data-cutting-key]');
            if (first) first.focus();
          }

          function hideForm(clearText) {
            const form     = container.querySelector('#dayview-form');
            const addBtn   = container.querySelector('#dayview-add-btn');
            const saveBtn  = container.querySelector('#dayview-save');
            const savedMsg = container.querySelector('#dayview-saved');
            if (!form || !addBtn) return;
            form.classList.add('is-hidden');
            addBtn.style.display = '';
            if (savedMsg) savedMsg.hidden = true;
            if (saveBtn)  saveBtn.disabled = false;
            if (clearText) {
              form.querySelectorAll('textarea[data-cutting-key]').forEach(t => { t.value = ''; });
              // Drop any staged video too, so a cancelled entry doesn't silently
              // attach its upload to the next one. Container-scoped — the upload
              // block sits in the empty box, not the form.
              const uidEl   = container.querySelector('#dayview-video-uid');
              const fileEl  = container.querySelector('#dayview-video-input');
              const statusEl= container.querySelector('#dayview-video-status');
              const progEl  = container.querySelector('#dayview-video-progress');
              if (uidEl)    uidEl.value = '';
              if (fileEl)   fileEl.value = '';
              if (statusEl) { statusEl.hidden = true; statusEl.textContent = ''; }
              if (progEl)   progEl.hidden = true;
            }
          }

          async function saveReflection() {
            const form     = container.querySelector('#dayview-form');
            const saveBtn  = container.querySelector('#dayview-save');
            const savedMsg = container.querySelector('#dayview-saved');
            if (!form || !saveBtn) return;
            const textEls = form.querySelectorAll('textarea[data-cutting-key]');
            const date = viewedDate();
            const payload = { recorded_date: date };
            let anyFilled = false;
            textEls.forEach(t => {
              const v = t.value.trim();
              payload[t.dataset.cuttingKey] = v;
              if (v) anyFilled = true;
            });
            // An attached video is content on its own — save even with no notes.
            // Queried from the container, not the form: when the empty box is
            // showing, the upload block (and this field) lives up there.
            const uidEl = container.querySelector('#dayview-video-uid');
            const videoUid = uidEl ? uidEl.value.trim() : '';
            if (videoUid) { payload.video_uid = videoUid; anyFilled = true; }
            if (!anyFilled) { hideForm(true); return; }
            saveBtn.disabled = true;
            try {
              const res = await fetch('/dashboard/cutting', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify(payload)
              });
              if (!res.ok) throw new Error('save failed');
              if (savedMsg) savedMsg.hidden = false;
              // Re-fetch the same day so the new entry appears in the stack.
              // skipPush — URL doesn't need to change for a refresh.
              setTimeout(() => loadDay(date, true), 600);
            } catch (e) {
              saveBtn.disabled = false;
              alert('Could not save. Please try again.');
            }
          }
        })();
      </script>

      <!-- Weekly intentions preview -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">This week's intentions</h2>
          <a href="/weekly-intentions" class="dash-section-link">View & edit all →</a>
        </div>

          <div class="goals-grid">
            <%
              const categories = [
                { key: 'curiosity', label: 'Curiosity', description: 'Feed your artist\'s soul' },
                { key: 'create', label: 'Create', description: 'Make the thing' },
                { key: 'share', label: 'Share', description: 'Put it into the world' },
                { key: 'connect', label: 'Connect', description: 'Reach out (or in)' }
              ];
            %>
            <% for (const cat of categories) { %>
              <% const goal = goals[cat.key]; %>
              <div class="goal-card goal-card--<%= cat.key %> <%= (goal && goal.completed) ? 'is-complete' : '' %>"
                   data-category="<%= cat.key %>"
                   data-description="<%= cat.description %>">

                <div class="goal-card-header">
                  <div class="goal-card-header-left">
                    <span class="goal-card-label"><%= cat.label %></span>
                    <span class="goal-card-desc"><%= cat.description %></span>
                  </div>
                  <label class="goal-card-check-wrap" title="Mark complete">
                    <input type="checkbox"
                           class="goal-card-checkbox"
                           data-week="<%= weekStart %>"
                           data-category="<%= cat.key %>"
                           <%= (goal && goal.completed) ? 'checked' : '' %>>
                    <span class="goal-card-check-visual" aria-hidden="true"></span>
                  </label>
                </div>

                <% const gd = goalsData[cat.key] || { mode: 'checklist', items: [] }; %>

                <div class="goal-checklist-always-edit" data-week="<%= weekStart %>" data-category="<%= cat.key %>">
                  <ul class="goal-checklist-input-list">
                    <% if (gd.items && gd.items.length) { %>
                      <% gd.items.forEach(function(item) { %>
                        <li class="goal-checklist-edit-row <%= item.checked ? 'is-checked' : '' %>">
                          <label class="goal-checklist-check-wrap">
                            <input type="checkbox" class="goal-checklist-checkbox goal-item-cb" <%= item.checked ? 'checked' : '' %>>
                            <span class="goal-checklist-check-visual"></span>
                          </label>
                          <input type="text" class="goal-checklist-edit-input" value="<%= item.text %>" placeholder="Add item...">
                        </li>
                      <% }); %>
                    <% } else { %>
                      <li class="goal-checklist-edit-row">
                        <label class="goal-checklist-check-wrap">
                          <input type="checkbox" class="goal-checklist-checkbox goal-item-cb">
                          <span class="goal-checklist-check-visual"></span>
                        </label>
                        <input type="text" class="goal-checklist-edit-input" placeholder="Add item...">
                      </li>
                    <% } %>
                  </ul>
                </div>

                <a href="/weekly-intentions" class="goal-card-arrow" aria-label="View goals">→</a>


              </div>
            <% } %>
          </div>

        <div style="margin-top: 1.5rem">
          <%- include('partials/share-intentions-toggle') %>
        </div>
      </section>

      <!-- Current Season — hidden entirely for pre-Week-4 trial students.
           The selector appears the moment they're eligible (Week 4 or an
           upgrade); the profile has the parallel picker for later edits. -->
      <% if (locals.canPickSeason) { %>
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your Current Season</h2>
        </div>
        <% if (!user.current_season) { %>
          <p class="season-first-prompt">What season are you in right now?</p>
        <% } %>
        <div class="season-cards" id="season-cards">
          <%
            const seasonDefs = [
              { key: 'winter', name: 'Winter', category: 'Connect to yourself',
                desc: "Strip things down to the basics. Record a daily video, log it, and get on with your day." },
              { key: 'spring', name: 'Spring', category: 'Review your recordings',
                desc: "Keep recording daily. Also watch past recordings and decide which thoughts are worth tending." },
              { key: 'summer', name: 'Summer', category: 'Creation Mode',
                desc: "Begin editing what you've filmed. See what your daily dumps and camera roll can become — you'd be surprised." },
              { key: 'autumn', name: 'Autumn', category: 'Sharing is Caring',
                desc: "Keep recording. Now decide what to share out and what stays just for you." }
            ];
          %>
          <% for (const s of seasonDefs) { %>
            <button class="season-card season-card--<%= s.key %> <%= user.current_season === s.key ? 'is-selected' : '' %>"
                    data-season="<%= s.key %>" type="button"
                    aria-pressed="<%= user.current_season === s.key %>">
              <span class="season-card-emoji"><%- include('partials/season-icon', { season: s.key, size: 48 }) %></span>
              <span class="season-card-name"><%= s.name %></span>
              <span class="season-card-category"><%= s.category %></span>
              <span class="season-card-desc"><%= s.desc %></span>
              <span class="season-card-check" aria-hidden="true">✓</span>
            </button>
          <% } %>
        </div>
      </section>
      <% } %>

      <!-- Continue learning -->
      <%# Lessons hidden from students during the trial run. Whole section is
          admin-only for now; remove this role guard to show students again. %>
      <% if (user && user.role === 'admin') { %>
      <% if (currentLesson) { %>
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Continue reading</h2>
          <a href="/lessons" class="dash-section-link">All lessons →</a>
        </div>

        <a href="/lessons/<%= currentLesson.slug %>" class="lesson-continue-card">
          <div class="lesson-continue-tag"><%= currentLesson.category_tag || 'Lesson' %></div>
          <h3 class="lesson-continue-title"><%= currentLesson.title %></h3>
          <p class="lesson-continue-subtitle"><em><%= currentLesson.subtitle %></em></p>
          <div class="lesson-continue-meta">
            <span>~<%= currentLesson.estimated_read_time %> min read</span>
            <span class="lesson-continue-arrow">Read now →</span>
          </div>
        </a>
      </section>
      <% } else { %>
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your lessons</h2>
        </div>
        <div class="all-complete-card">
          <p class="all-complete-text">You've read all available lessons. Beautiful work.</p>
          <a href="/lessons" class="dash-section-link">Browse lessons →</a>
        </div>
      </section>
      <% } %>
      <% } %>

      <!-- Daily quote -->
      <section class="dash-quote">
        <div class="dash-quote-mark">"</div>
        <blockquote class="dash-quote-text"><%= quote.text %></blockquote>
        <p class="dash-quote-source">— <%= quote.source %></p>
      </section>

    </main>
  </div>

  <script src="/js/dashboard-cards.js"></script>
  <script>
    document.querySelectorAll('.season-card').forEach(card => {
      card.addEventListener('click', async () => {
        const season = card.dataset.season;
        const already = card.classList.contains('is-selected');
        const res = await fetch('/api/season', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ season: already ? null : season })
        });
        if (!res.ok) return;
        document.querySelectorAll('.season-card').forEach(c => {
          c.classList.remove('is-selected');
          c.setAttribute('aria-pressed', 'false');
        });
        if (!already) {
          card.classList.add('is-selected');
          card.setAttribute('aria-pressed', 'true');
        }
        const seasonClasses = ['season-avatar--spring','season-avatar--summer','season-avatar--autumn','season-avatar--winter'];
        document.querySelectorAll('.sidebar-avatar').forEach(el => {
          el.classList.remove(...seasonClasses);
          if (!already) el.classList.add(`season-avatar--${season}`);
        });
        document.querySelector('.season-first-prompt')?.remove();
      });
    });

    // The day-view module has its own inline <style> + <script> embedded
    // alongside its markup above. The old rest/reflect/done recording-card
    // controller and the backdating controller were removed when the
    // markup was replaced — the day-view supersedes both.
  </script>
</body>
</html>
