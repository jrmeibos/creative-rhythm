<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="app-body">

  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content" id="main">

      <!-- Dashboard header -->
      <header class="dash-header">
        <div class="dash-greeting">
          <h1 class="dash-greeting-text">
            <%= greeting %>, <span class="dash-name"><%= user.name.split(' ')[0] %></span>
          </h1>
          <p class="dash-week-label">
            <% if (isIntegrationWeek) { %>
              <span class="integration-badge">Integration Week</span> · <%= weekLabel %>
            <% } else if (weekNumber >= 1) { %>
              Week <%= weekNumber %> of 12 · <%= weekLabel %>
            <% } else { %>
              Week of <%= weekLabel %>
            <% } %>
          </p>
        </div>
        <div class="dash-progress-pill">
          <span class="dash-progress-count"><%= completedCount %> / <%= totalLessons %></span>
          <span class="dash-progress-label">field notes complete</span>
        </div>
      </header>

      <!-- Current Season -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your Current Season</h2>
        </div>
        <% if (!user.current_season) { %>
          <p class="season-first-prompt">What season are you in right now?</p>
        <% } %>
        <div class="season-cards" id="season-cards">
          <%
            const seasonDefs = [
              { key: 'spring', name: 'Spring', category: 'Prioritizing Curiosity',
                desc: "You're in receptive mode — filling the cup, following whims, letting ideas germinate." },
              { key: 'summer', name: 'Summer', category: 'Creation Mode',
                desc: "You're in full creative flow — making, building, pouring energy into the work." },
              { key: 'autumn', name: 'Autumn', category: 'Sharing is Caring',
                desc: "You're ready to release — sharing your work with the world from a place of fullness." },
              { key: 'winter', name: 'Winter', category: 'Time to Connect',
                desc: "You're going deep — whether reaching outward to collaborate or retreating inward for perspective. Both are Winter." }
            ];
          %>
          <% for (const s of seasonDefs) { %>
            <button class="season-card season-card--<%= s.key %> <%= user.current_season === s.key ? 'is-selected' : '' %>"
                    data-season="<%= s.key %>" type="button" aria-pressed="<%= user.current_season === s.key %>">
              <span class="season-card-emoji"><%- include('partials/season-icon', { season: s.key, size: 48 }) %></span>
              <span class="season-card-name"><%= s.name %></span>
              <span class="season-card-category"><%= s.category %></span>
              <span class="season-card-desc"><%= s.desc %></span>
              <span class="season-card-check" aria-hidden="true">✓</span>
            </button>
          <% } %>
        </div>
      </section>

      <!-- Day-view: per-day topic + reflection with back/forward day nav.
           Replaces the old rest/reflect/done recording card and the separate
           backdating block. Uses the dayview payload from the route; all
           element IDs use a dayview- prefix to avoid colliding with anything
           else on the page. -->
      <section class="dash-section">
        <div class="recording-card" id="dayview-card">

          <header class="dayview-header">
            <% if (dayview.prevDate) { %>
              <a href="?day=<%= dayview.prevDate %>" class="dayview-nav" aria-label="Previous day">‹</a>
            <% } else { %>
              <span class="dayview-nav dayview-nav--disabled" aria-hidden="true">‹</span>
            <% } %>

            <div class="dayview-day-label">
              <% if (dayview.dayNumber) { %><span class="dayview-day-num">Day <%= dayview.dayNumber %></span> · <% } %>
              <span class="dayview-date"><%= dayview.dateLabel %></span>
              <% if (dayview.isToday) { %><span class="dayview-today-tag">today</span><% } %>
            </div>

            <% if (dayview.nextDate) { %>
              <a href="?day=<%= dayview.nextDate %>" class="dayview-nav" aria-label="Next day">›</a>
            <% } else { %>
              <span class="dayview-nav dayview-nav--disabled" aria-hidden="true">›</span>
            <% } %>
          </header>

          <% if (dayview.seasonLabel) { %>
            <div class="dayview-season-row">
              <span class="recording-card-season"><%= dayview.seasonLabel.toUpperCase() %></span>
              <% if (dayview.aboutText) { %>
                <button type="button"
                        class="recording-about-toggle"
                        id="dayview-about-toggle"
                        aria-controls="dayview-about-panel"
                        aria-expanded="false">About this season ↓</button>
              <% } %>
            </div>
            <% if (dayview.aboutText) { %>
              <div id="dayview-about-panel" class="recording-about-panel is-hidden">
                <p><%= dayview.aboutText %></p>
              </div>
            <% } %>
          <% } %>

          <% if (dayview.topic) { %>
            <p class="recording-card-prompt">"<%= dayview.topic %>"</p>
          <% } %>

          <% if (dayview.cuttings && dayview.cuttings.length) { %>
            <% dayview.cuttings.forEach(function (c, idx) { %>
              <% const populated = cuttingPrompts.filter(p => c[p.key] != null && String(c[p.key]).trim() !== ''); %>
              <article class="dayview-entry<%= idx > 0 ? ' dayview-entry--stacked' : '' %>">
                <% populated.forEach(function (p) { %>
                  <div class="dayview-field">
                    <p class="dayview-field-label"><%= p.label %></p>
                    <p class="dayview-field-text"><%= c[p.key] %></p>
                  </div>
                <% }); %>
              </article>
            <% }); %>

            <div class="dayview-cta-row">
              <button type="button" class="recording-card-btn-secondary" id="dayview-add-btn">+ Add another</button>
            </div>
          <% } else { %>
            <p class="dayview-empty">
              <% if (dayview.isToday) { %>
                Nothing here yet. Record when you're ready.
              <% } else { %>
                Nothing recorded for this day. You can still add one if you'd like.
              <% } %>
            </p>
            <div class="dayview-cta-row">
              <button type="button" class="recording-card-btn" id="dayview-add-btn">Add a recording for this day</button>
            </div>
          <% } %>

          <!-- Form revealed by the Add button. Saves backdated to the viewed
               date via the existing POST /dashboard/cutting, which validates
               range and computes season from the recorded_date itself. -->
          <div class="dayview-form is-hidden" id="dayview-form">
            <% cuttingPrompts.forEach(function (p) { %>
              <div class="recording-reflect-field">
                <label class="recording-reflect-q" for="dayview-input-<%= p.key %>"><%= p.label %></label>
                <% if (p.help) { %><p class="recording-reflect-help"><%= p.help %></p><% } %>
                <textarea id="dayview-input-<%= p.key %>"
                          class="recording-reflect-textarea"
                          data-cutting-key="<%= p.key %>"
                          rows="3"></textarea>
              </div>
            <% }); %>
            <div class="recording-reflect-actions">
              <button type="button" class="recording-card-btn" id="dayview-save">Save</button>
              <button type="button" class="recording-card-btn-secondary" id="dayview-cancel">Cancel</button>
              <span id="dayview-saved" class="recording-backdate-saved" hidden>Saved 🌿</span>
            </div>
          </div>

        </div>
      </section>

      <style>
        /* Day-view module — scoped via .dayview- prefix to avoid collisions
           with the legacy recording-card classes (which the day-view reuses
           for the season label / about-toggle / form). */
        .dayview-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 0.75rem;
          margin-bottom: 1.1rem;
        }
        .dayview-nav {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 2.25rem;
          height: 2.25rem;
          border-radius: 50%;
          font-family: var(--font-body);
          font-size: 1.4rem;
          line-height: 1;
          color: var(--color-bloem);
          text-decoration: none;
          background: rgba(112, 92, 108, 0.06);
          transition: background 0.15s;
        }
        .dayview-nav:hover { background: rgba(112, 92, 108, 0.14); }
        .dayview-nav--disabled {
          color: rgba(16, 15, 16, 0.18);
          background: transparent;
          cursor: default;
        }
        .dayview-day-label {
          flex: 1;
          text-align: center;
          font-family: var(--font-body);
          font-size: 0.92rem;
          font-weight: 400;
          color: var(--color-ink-stained);
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          flex-wrap: wrap;
        }
        .dayview-day-num {
          font-family: var(--font-body);
          font-weight: 700;
          letter-spacing: 0.02em;
          color: var(--color-bloem);
        }
        .dayview-date { font-weight: 300; color: rgba(16, 15, 16, 0.75); }
        .dayview-today-tag {
          font-family: var(--font-body);
          font-size: 0.62rem;
          font-weight: 600;
          letter-spacing: 0.12em;
          text-transform: uppercase;
          color: var(--color-bloem);
          background: rgba(246, 201, 92, 0.22);
          padding: 0.15rem 0.5rem;
          border-radius: 999px;
        }
        .dayview-season-row {
          display: flex;
          align-items: baseline;
          gap: 0.75rem;
          margin-bottom: 0.4rem;
        }
        .dayview-entry { margin-top: 1rem; }
        .dayview-entry--stacked {
          margin-top: 1.1rem;
          padding-top: 1.1rem;
          border-top: 1px solid rgba(112, 92, 108, 0.12);
        }
        .dayview-field { margin-top: 0.75rem; }
        .dayview-field:first-child { margin-top: 0; }
        .dayview-field-label {
          font-family: var(--font-display);
          font-style: italic;
          font-size: 0.88rem;
          font-weight: 400;
          color: rgba(16, 15, 16, 0.55);
          margin: 0 0 0.2rem;
        }
        .dayview-field-text {
          font-family: var(--font-body);
          font-size: 1rem;
          font-weight: 300;
          line-height: 1.6;
          color: var(--color-ink-stained);
          margin: 0;
          white-space: pre-wrap;
        }
        .dayview-empty {
          font-family: var(--font-display);
          font-style: italic;
          font-size: 1.02rem;
          color: rgba(16, 15, 16, 0.55);
          margin: 1.25rem 0 1rem;
        }
        .dayview-cta-row { margin-top: 1.1rem; }
        .dayview-form { margin-top: 1.5rem; }
        .dayview-form.is-hidden { display: none; }
      </style>

      <script>
        (function () {
          const card = document.getElementById('dayview-card');
          if (!card) return;

          // About-this-season toggle (single copy now; no rest/done duplicate).
          const aboutBtn   = card.querySelector('#dayview-about-toggle');
          const aboutPanel = card.querySelector('#dayview-about-panel');
          if (aboutBtn && aboutPanel) {
            aboutBtn.addEventListener('click', () => {
              const open = aboutPanel.classList.toggle('is-hidden') === false;
              aboutBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
              aboutBtn.textContent = open ? 'About this season ↑' : 'About this season ↓';
            });
          }

          // Add / save / cancel — POSTs to /dashboard/cutting with the viewed
          // date as recorded_date; the route already validates range and
          // computes season from the date. On success we reload so the new
          // entry appears stacked; the ?day=... param survives the reload.
          const viewedDate = <%- JSON.stringify(dayview.dateStr) %>;
          const addBtn    = card.querySelector('#dayview-add-btn');
          const form      = card.querySelector('#dayview-form');
          const saveBtn   = card.querySelector('#dayview-save');
          const cancelBtn = card.querySelector('#dayview-cancel');
          const savedMsg  = card.querySelector('#dayview-saved');
          const textEls   = form ? form.querySelectorAll('textarea[data-cutting-key]') : [];
          if (!addBtn || !form || !saveBtn || !cancelBtn) return;

          const showForm = () => {
            form.classList.remove('is-hidden');
            addBtn.style.display = 'none';
            if (textEls[0]) textEls[0].focus();
          };
          const hideForm = (clearText) => {
            form.classList.add('is-hidden');
            addBtn.style.display = '';
            if (savedMsg) savedMsg.hidden = true;
            saveBtn.disabled = false;
            if (clearText) textEls.forEach(t => { t.value = ''; });
          };

          addBtn.addEventListener('click', showForm);
          cancelBtn.addEventListener('click', () => hideForm(true));

          saveBtn.addEventListener('click', async () => {
            const payload = { recorded_date: viewedDate };
            let anyFilled = false;
            textEls.forEach(t => {
              const v = t.value.trim();
              payload[t.dataset.cuttingKey] = v;
              if (v) anyFilled = true;
            });
            if (!anyFilled) { hideForm(true); return; }
            saveBtn.disabled = true;
            try {
              const res = await fetch('/dashboard/cutting', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify(payload)
              });
              if (!res.ok) throw new Error('save failed');
              if (savedMsg) savedMsg.hidden = false;
              setTimeout(() => window.location.reload(), 600);
            } catch (e) {
              saveBtn.disabled = false;
              alert('Could not save. Please try again.');
            }
          });
        })();
      </script>

      <!-- Weekly intentions preview -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">This week's intentions</h2>
          <a href="/goals" class="dash-section-link">View & edit all →</a>
        </div>

        <% if (isIntegrationWeek) { %>
          <div class="integration-week-card">
            <div class="integration-week-icon">○</div>
            <div>
              <h3 class="integration-week-title">Integration Week</h3>
              <p class="integration-week-text">
                This is a week for letting things settle. No goals — just noticing what's alive in you from the past few weeks. What shifted? What wants to deepen?
              </p>
            </div>
          </div>
        <% } else { %>
          <div class="goals-grid">
            <%
              const categories = [
                { key: 'curiosity', label: 'Curiosity', description: 'Feed your artist\'s soul' },
                { key: 'create', label: 'Create', description: 'Make the thing' },
                { key: 'share', label: 'Share', description: 'Put it into the world' },
                { key: 'connect', label: 'Connect', description: 'Reach outward' }
              ];
            %>
            <% for (const cat of categories) { %>
              <% const goal = goals[cat.key]; %>
              <div class="goal-card goal-card--<%= cat.key %> <%= (goal && goal.completed) ? 'is-complete' : '' %>"
                   data-category="<%= cat.key %>"
                   data-description="<%= cat.description %>">

                <div class="goal-card-header">
                  <div class="goal-card-header-left">
                    <span class="goal-card-label"><%= cat.label %></span>
                    <span class="goal-card-desc"><%= cat.description %></span>
                  </div>
                  <label class="goal-card-check-wrap" title="Mark complete">
                    <input type="checkbox"
                           class="goal-card-checkbox"
                           data-week="<%= weekStart %>"
                           data-category="<%= cat.key %>"
                           <%= (goal && goal.completed) ? 'checked' : '' %>>
                    <span class="goal-card-check-visual" aria-hidden="true"></span>
                  </label>
                </div>

                <% const gd = goalsData[cat.key] || { mode: 'checklist', items: [] }; %>

                <div class="goal-checklist-always-edit" data-week="<%= weekStart %>" data-category="<%= cat.key %>">
                  <ul class="goal-checklist-input-list">
                    <% if (gd.items && gd.items.length) { %>
                      <% gd.items.forEach(function(item) { %>
                        <li class="goal-checklist-edit-row <%= item.checked ? 'is-checked' : '' %>">
                          <label class="goal-checklist-check-wrap">
                            <input type="checkbox" class="goal-checklist-checkbox goal-item-cb" <%= item.checked ? 'checked' : '' %>>
                            <span class="goal-checklist-check-visual"></span>
                          </label>
                          <input type="text" class="goal-checklist-edit-input" value="<%= item.text %>" placeholder="Add item...">
                        </li>
                      <% }); %>
                    <% } else { %>
                      <li class="goal-checklist-edit-row">
                        <label class="goal-checklist-check-wrap">
                          <input type="checkbox" class="goal-checklist-checkbox goal-item-cb">
                          <span class="goal-checklist-check-visual"></span>
                        </label>
                        <input type="text" class="goal-checklist-edit-input" placeholder="Add item...">
                      </li>
                    <% } %>
                  </ul>
                </div>

                <a href="/goals" class="goal-card-arrow" aria-label="View goals">→</a>


              </div>
            <% } %>
          </div>
        <% } %>
      </section>

      <!-- Continue learning -->
      <% if (currentLesson) { %>
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Continue reading</h2>
          <a href="/lessons" class="dash-section-link">All field notes →</a>
        </div>

        <a href="/lessons/<%= currentLesson.slug %>" class="lesson-continue-card">
          <div class="lesson-continue-tag"><%= currentLesson.category_tag || 'Field Note' %></div>
          <h3 class="lesson-continue-title"><%= currentLesson.title %></h3>
          <p class="lesson-continue-subtitle"><em><%= currentLesson.subtitle %></em></p>
          <div class="lesson-continue-meta">
            <span>~<%= currentLesson.estimated_read_time %> min read</span>
            <span class="lesson-continue-arrow">Read now →</span>
          </div>
        </a>
      </section>
      <% } else { %>
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your field notes</h2>
        </div>
        <div class="all-complete-card">
          <p class="all-complete-text">You've read all available field notes. Beautiful work.</p>
          <a href="/lessons" class="dash-section-link">Browse field notes →</a>
        </div>
      </section>
      <% } %>

      <!-- Daily quote -->
      <section class="dash-quote">
        <div class="dash-quote-mark">"</div>
        <blockquote class="dash-quote-text"><%= quote.text %></blockquote>
        <p class="dash-quote-source">— <%= quote.source %></p>
      </section>

    </main>
  </div>

  <script src="/js/dashboard-cards.js"></script>
  <script>
    document.querySelectorAll('.season-card').forEach(card => {
      card.addEventListener('click', async () => {
        const season = card.dataset.season;
        const already = card.classList.contains('is-selected');
        const res = await fetch('/api/season', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ season: already ? null : season })
        });
        if (!res.ok) return;
        document.querySelectorAll('.season-card').forEach(c => {
          c.classList.remove('is-selected');
          c.setAttribute('aria-pressed', 'false');
        });
        if (!already) {
          card.classList.add('is-selected');
          card.setAttribute('aria-pressed', 'true');
        }
        const seasonClasses = ['season-avatar--spring','season-avatar--summer','season-avatar--autumn','season-avatar--winter'];
        document.querySelectorAll('.sidebar-avatar').forEach(el => {
          el.classList.remove(...seasonClasses);
          if (!already) el.classList.add(`season-avatar--${season}`);
        });
        document.querySelector('.season-first-prompt')?.remove();
      });
    });

    // The day-view module has its own inline <style> + <script> embedded
    // alongside its markup above. The old rest/reflect/done recording-card
    // controller and the backdating controller were removed when the
    // markup was replaced — the day-view supersedes both.
  </script>
</body>
</html>
