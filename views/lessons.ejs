<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/lessons.css">
  <style>
    .videos-list { display: flex; flex-direction: column; gap: 2.25rem; max-width: 760px; }
    .video-item-title { font-family: 'Goldage', Georgia, serif; font-size: 1.35rem; font-weight: 600; margin: 0 0 .3rem; color: var(--color-ink-stained); }
    .video-item-sub { font-size: .95rem; color: rgba(16,15,16,.6); margin: 0 0 .85rem; font-style: italic; }
    .video-embed { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: #100F10; }
    .video-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .videos-empty { color: rgba(16,15,16,.5); font-style: italic; }
  </style>
</head>
<body class="app-body">

  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content" id="main">

      <header class="lessons-header">
        <div class="lessons-header-left">
          <h1 class="lessons-title">Videos</h1>
          <p class="lessons-sub">Watch at your own pace — return to anything, anytime.</p>
        </div>
      </header>

      <% if (!videos.length) { %>
        <p class="videos-empty">Videos are on their way. 🌿</p>
      <% } else { %>
        <div class="videos-list">
          <% for (const v of videos) { %>
            <div class="video-item">
              <h2 class="video-item-title"><%= v.title %></h2>
              <% if (v.subtitle) { %><p class="video-item-sub"><%= v.subtitle %></p><% } %>
              <div class="video-embed">
                <iframe src="<%= v.video_url %>" title="<%= v.title %>" frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen></iframe>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>

    </main>
  </div>

</body>
</html>
