<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/lessons.css">
  <style>
    .videos-section { margin-bottom: 2.75rem; }
    .videos-section-title { font-family: 'Goldage', Georgia, serif; font-size: 1.6rem; font-weight: 400; margin: 0 0 .3rem; color: var(--color-ink-stained); }
    .videos-section-sub { font-size: .95rem; color: rgba(16,15,16,.6); margin: 0 0 1.4rem; }
    /* Compact call cards — 3 across, each either a recording or a "coming soon"
       placeholder for a scheduled-but-not-yet-happened call. */
    .call-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; max-width: 920px; }
    .call-card { border: 1px solid rgba(16,15,16,.1); border-radius: 12px; overflow: hidden; background: var(--color-blank-page); display: flex; flex-direction: column; }
    .call-card--soon { border-style: dashed; }
    .call-media { position: relative; aspect-ratio: 16 / 9; background: #100F10; }
    .call-media iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .call-media--soon { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .35rem; background: var(--color-new-growth); color: var(--color-understory); }
    .call-meta { padding: .7rem .8rem .85rem; }
    .call-title { font-family: 'Goldage', Georgia, serif; font-size: 1rem; font-weight: 600; margin: 0; color: var(--color-ink-stained); line-height: 1.25; }
    .call-date { font-size: .8rem; color: rgba(16,15,16,.55); margin: .25rem 0 0; }
    .call-date--soon { color: var(--color-bloem); font-weight: 600; }
    @media (max-width: 640px) { .call-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 420px) { .call-grid { grid-template-columns: 1fr; } }
    /* Course videos — same card treatment as the call cards, just larger: the
       title sits in a white strip under the video so it doesn't compete with
       the "Course videos" section heading. */
    .videos-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; max-width: 920px; }
    @media (max-width: 640px) { .videos-list { grid-template-columns: 1fr; max-width: 448px; } }
    .video-card { border: 1px solid rgba(16,15,16,.1); border-radius: 14px; overflow: hidden; background: var(--color-blank-page); }
    .video-embed { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #100F10; }
    .video-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .video-card-meta { padding: .85rem 1.1rem 1rem; }
    .video-card-title { font-family: 'Goldage', Georgia, serif; font-size: 1.15rem; font-weight: 600; margin: 0; color: var(--color-ink-stained); line-height: 1.3; }
    .video-card-sub { font-size: .9rem; color: rgba(16,15,16,.6); margin: .25rem 0 0; font-style: italic; }
    .videos-empty { color: rgba(16,15,16,.5); font-style: italic; }
  </style>
</head>
<body class="app-body">

  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content" id="main">

      <header class="lessons-header">
        <div class="lessons-header-left">
          <h1 class="lessons-title">Videos</h1>
          <p class="lessons-sub">Watch at your own pace — return to anything, anytime.</p>
        </div>
      </header>

      <% const hasRecordings = locals.recordings && recordings.length; %>

      <% if (hasRecordings) { %>
        <section class="videos-section">
          <h2 class="videos-section-title">Call recordings</h2>
          <p class="videos-section-sub">Our group calls — watch or re-watch anytime. Upcoming calls appear here until their recording is ready.</p>
          <div class="call-grid">
            <% for (const rec of recordings) { %>
              <div class="call-card <%= rec.embedUrl ? '' : 'call-card--soon' %>">
                <% if (rec.embedUrl) { %>
                  <div class="call-media">
                    <iframe src="<%= rec.embedUrl %>" title="<%= rec.title %>" loading="lazy" frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen></iframe>
                  </div>
                <% } else { %>
                  <div class="call-media call-media--soon" aria-hidden="true">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="2.5" y="5.5" width="13.5" height="13" rx="2"/>
                      <path d="M16 10l5.5-3v10L16 14z"/>
                    </svg>
                  </div>
                <% } %>
                <div class="call-meta">
                  <h3 class="call-title"><%= rec.title %></h3>
                  <% if (!rec.embedUrl) { %>
                    <p class="call-date call-date--soon">Coming soon<% if (rec.scheduledLabel) { %> · <%= rec.scheduledLabel %><% } %></p>
                  <% } else if (rec.scheduledLabel) { %>
                    <p class="call-date"><%= rec.scheduledLabel %></p>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        </section>
      <% } %>

      <section class="videos-section">
        <% if (hasRecordings) { %><h2 class="videos-section-title">Course videos</h2><% } %>
        <% if (!videos.length) { %>
          <p class="videos-empty">Videos are on their way. 🌿</p>
        <% } else { %>
          <div class="videos-list">
            <% for (const v of videos) { %>
              <div class="video-card">
                <div class="video-embed">
                  <iframe src="<%= v.video_url %>" title="<%= v.title %>" frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
                </div>
                <div class="video-card-meta">
                  <h3 class="video-card-title"><%= v.title %></h3>
                  <% if (v.subtitle) { %><p class="video-card-sub"><%= v.subtitle %></p><% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </section>

    </main>
  </div>

</body>
</html>
