<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/seed-packets.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content">

      <a href="/seed-packets" class="cm-back-link">← Back to the Seed Packets</a>

      <div class="cm-synth-page">

        <header class="cm-synth-header">
          <h1 class="cm-synth-title">Your seeds</h1>
          <p class="cm-synth-subtitle">Not a final answer — just what's true right now. Return to revise whenever something shifts.</p>
        </header>

        <% if (lastUpdated) { %>
        <p class="cm-seeds-lastmod">Last updated: <%= lastUpdated %></p>
        <% } %>

        <div class="cm-seed-list" id="cm-seed-list">
          <% seeds.forEach(function(seed) { %>
          <div class="cm-seed-card" data-seed-id="<%= seed.id %>" data-sort-order="<%= seed.sort_order %>">
            <input type="text" class="cm-seed-name-input" value="<%= seed.name %>" placeholder="Name this seed...">
            <textarea class="cm-seed-desc" rows="3" placeholder="What's this seed about? In your own words."><%= seed.description %></textarea>
            <p class="cm-seed-bullets-label">Notes, examples, details (optional)</p>
            <div class="cm-seed-bullets">
              <% seed.bullets.forEach(function(b) { %>
              <div class="cm-seed-bullet-row">
                <input type="text" class="cm-seed-bullet-input" value="<%= b %>" placeholder="Add a note...">
                <button type="button" class="cm-seed-bullet-remove">×</button>
              </div>
              <% }); %>
            </div>
            <button type="button" class="cm-seed-add-bullet">+ Add note</button>
            <button type="button" class="cm-seed-remove">× Remove seed</button>
          </div>
          <% }); %>
        </div>

        <button type="button" class="cm-add-seed-btn" id="cm-add-seed-btn">+ Add a seed</button>

        <% if (highlights.length > 0) { %>
        <div class="cm-highlights-bank cm-highlights-bank--collapsible" style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid rgba(118,133,108,0.15);">
          <button type="button" class="cm-highlights-toggle" id="cm-highlights-toggle">
            ▶ Your highlights (<%= highlights.length %>)
          </button>
          <div class="cm-highlights-chips" id="cm-highlights-chips" style="display:none; margin-top: 0.75rem;">
            <% highlights.forEach(function(h) { %>
            <span class="cm-highlight-chip"><%= h.highlighted_text %></span>
            <% }); %>
          </div>
        </div>
        <% } %>

      </div>

    </main>
  </div>

  <script>
    function debounce(fn, ms) {
      let t;
      return function() {
        const args = arguments;
        clearTimeout(t);
        t = setTimeout(function() { fn.apply(this, args); }, ms);
      };
    }

    function escHtml(str) {
      return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function getSeedData(card) {
      return {
        name: (card.querySelector('.cm-seed-name-input').value || '').trim(),
        description: card.querySelector('.cm-seed-desc').value || '',
        bullets: Array.from(card.querySelectorAll('.cm-seed-bullet-input'))
                      .map(function(i) { return i.value; })
                      .filter(function(v) { return v.trim(); }),
        sortOrder: parseInt(card.dataset.sortOrder) || 0,
      };
    }

    async function saveSeed(card) {
      const seedId = card.dataset.seedId;
      if (!seedId) return;
      const data = getSeedData(card);
      if (!data.name) return;
      try {
        await fetch('/api/seed-packets/seeds/' + seedId, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
      } catch(e) {}
    }

    const debouncedSave = debounce(saveSeed, 800);

    function attachCardListeners(card) {
      card.querySelectorAll('.cm-seed-name-input, .cm-seed-desc').forEach(function(el) {
        el.addEventListener('input', function() { debouncedSave(card); });
      });
      refreshBulletListeners(card);
    }

    function refreshBulletListeners(card) {
      card.querySelectorAll('.cm-seed-bullet-input').forEach(function(input) {
        input.addEventListener('input', function() { debouncedSave(card); });
      });
      card.querySelectorAll('.cm-seed-bullet-remove').forEach(function(btn) {
        const fresh = btn.cloneNode(true);
        btn.parentNode.replaceChild(fresh, btn);
        fresh.addEventListener('click', function() {
          fresh.closest('.cm-seed-bullet-row').remove();
          debouncedSave(card);
        });
      });
    }

    function attachRemoveListener(card) {
      const btn = card.querySelector('.cm-seed-remove');
      if (!btn) return;
      btn.addEventListener('click', async function() {
        if (!confirm('Remove this seed?')) return;
        const seedId = card.dataset.seedId;
        if (seedId) {
          try { await fetch('/api/seed-packets/seeds/' + seedId, { method: 'DELETE' }); } catch(e) {}
        }
        card.remove();
      });
    }

    function attachAddBulletListener(card) {
      const btn = card.querySelector('.cm-seed-add-bullet');
      if (!btn) return;
      btn.addEventListener('click', function() { addBulletToCard(card, ''); });
    }

    function addBulletToCard(card, text) {
      const bulletsDiv = card.querySelector('.cm-seed-bullets');
      const row = document.createElement('div');
      row.className = 'cm-seed-bullet-row';
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'cm-seed-bullet-input';
      input.value = text || '';
      input.placeholder = 'Add a note...';
      input.addEventListener('input', function() { debouncedSave(card); });
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'cm-seed-bullet-remove';
      removeBtn.textContent = '×';
      removeBtn.addEventListener('click', function() {
        row.remove();
        debouncedSave(card);
      });
      row.appendChild(input);
      row.appendChild(removeBtn);
      bulletsDiv.appendChild(row);
      if (!text) input.focus();
      debouncedSave(card);
    }

    // ── Attach listeners to existing cards ────────────────────────────────────

    document.querySelectorAll('.cm-seed-card').forEach(function(card) {
      attachCardListeners(card);
      attachRemoveListener(card);
      attachAddBulletListener(card);
    });

    // ── Add a new seed ────────────────────────────────────────────────────────

    document.getElementById('cm-add-seed-btn').addEventListener('click', async function() {
      const sortOrder = document.querySelectorAll('.cm-seed-card').length;
      try {
        const res = await fetch('/api/seed-packets/seeds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: 'New seed', description: '', bullets: [], sortOrder }),
        });
        const seed = await res.json();
        const card = buildCard(seed);
        document.getElementById('cm-seed-list').appendChild(card);
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const nameInput = card.querySelector('.cm-seed-name-input');
        nameInput.focus();
        nameInput.select();
      } catch(e) {}
    });

    function buildCard(seed) {
      const div = document.createElement('div');
      div.className = 'cm-seed-card';
      div.dataset.seedId = String(seed.id);
      div.dataset.sortOrder = String(seed.sort_order || 0);
      const bullets = Array.isArray(seed.bullets) ? seed.bullets : [];
      div.innerHTML = `
        <input type="text" class="cm-seed-name-input" value="${escHtml(seed.name || '')}" placeholder="Name this seed...">
        <textarea class="cm-seed-desc" rows="3" placeholder="What's this seed about? In your own words.">${escHtml(seed.description || '')}</textarea>
        <p class="cm-seed-bullets-label">Notes, examples, details (optional)</p>
        <div class="cm-seed-bullets">${bullets.map(function(b) {
          return '<div class="cm-seed-bullet-row">'
            + '<input type="text" class="cm-seed-bullet-input" value="' + escHtml(b) + '" placeholder="Add a note...">'
            + '<button type="button" class="cm-seed-bullet-remove">×</button>'
            + '</div>';
        }).join('')}</div>
        <button type="button" class="cm-seed-add-bullet">+ Add note</button>
        <button type="button" class="cm-seed-remove">× Remove seed</button>
      `;
      attachCardListeners(div);
      attachRemoveListener(div);
      attachAddBulletListener(div);
      return div;
    }

    // ── Highlights bank toggle ────────────────────────────────────────────────

    const toggleBtn = document.getElementById('cm-highlights-toggle');
    const chipsEl = document.getElementById('cm-highlights-chips');
    if (toggleBtn && chipsEl) {
      toggleBtn.addEventListener('click', function() {
        const open = chipsEl.style.display !== 'none';
        chipsEl.style.display = open ? 'none' : 'flex';
        toggleBtn.textContent = toggleBtn.textContent.replace(open ? '▼' : '▶', open ? '▶' : '▼');
      });
    }
  </script>
</body>
</html>
