<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/seed-packets.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content">

      <a href="/seed-packets" class="cm-back-link">← Back to the Seed Packets</a>
      <a href="/seed-packets/synthesize" class="cm-back-link">← Re-read and highlight your answers</a>

      <div class="cm-synth-page">

        <header class="cm-synth-header">
          <h1 class="cm-synth-title">Your seeds</h1>
          <p class="cm-synth-subtitle">Not a final answer — just what's true right now. Tap any packet to open it. Return to revise whenever something shifts.</p>
        </header>

        <% if (lastUpdated) { %>
        <p class="cm-seeds-lastmod">Last updated: <%= lastUpdated %></p>
        <% } %>

        <div class="cm-seed-list cm-seed-list--packets" id="cm-seed-list">
          <% seeds.forEach(function(seed) { %>
          <article class="cm-seed-packet" data-seed-id="<%= seed.id %>" data-sort-order="<%= seed.sort_order %>" aria-expanded="false">
            <header class="cm-seed-packet-header">
              <span class="cm-seed-packet-sprout" aria-hidden="true">
                <svg viewBox="0 0 24 28" width="22" height="26" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 26 L12 14" fill="none" stroke="#76856C" stroke-width="1.6" stroke-linecap="round"/>
                  <path d="M12 18 Q4 16 4 8 Q12 8 12 18 Z" fill="#76856C" opacity="0.85"/>
                  <path d="M12 15 Q20 13 20 6 Q12 6 12 15 Z" fill="#76856C"/>
                </svg>
              </span>
              <h2 class="cm-seed-packet-title"><%= seed.name || 'Untitled seed' %></h2>
              <span class="cm-seed-packet-caret" aria-hidden="true">↓</span>
            </header>

            <p class="cm-seed-packet-blurb"><%= seed.description || 'No description yet — tap to add one.' %></p>

            <div class="cm-seed-packet-body" hidden>
              <label class="cm-seed-packet-label">Name</label>
              <input type="text" class="cm-seed-name-input" value="<%= seed.name %>" placeholder="Name this seed...">

              <label class="cm-seed-packet-label">In your own words</label>
              <textarea class="cm-seed-desc" rows="3" placeholder="What's this seed about?"><%= seed.description %></textarea>

              <label class="cm-seed-packet-label">How this shows up in my content</label>
              <p class="cm-seed-packet-help">Posts, projects, conversations — concrete examples.</p>
              <textarea class="cm-seed-application" rows="3" placeholder="If this seed sprouted into something you made, what would it be?"><%= seed.application || '' %></textarea>

              <label class="cm-seed-packet-label">Notes, examples, details (optional)</label>
              <div class="cm-seed-bullets">
                <% (seed.bullets || []).forEach(function(b) { %>
                <div class="cm-seed-bullet-row">
                  <input type="text" class="cm-seed-bullet-input" value="<%= b %>" placeholder="Add a note...">
                  <button type="button" class="cm-seed-bullet-remove" aria-label="Remove note">×</button>
                </div>
                <% }); %>
              </div>
              <button type="button" class="cm-seed-add-bullet">+ Add note</button>

              <div class="cm-seed-packet-footer">
                <button type="button" class="cm-seed-remove">× Remove seed</button>
              </div>
            </div>
          </article>
          <% }); %>
        </div>

        <button type="button" class="cm-add-seed-btn" id="cm-add-seed-btn">+ Add a seed</button>

        <% if (highlights.length > 0) { %>
        <div class="cm-highlights-bank cm-highlights-bank--collapsible" style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid rgba(118,133,108,0.15);">
          <button type="button" class="cm-highlights-toggle" id="cm-highlights-toggle">
            ▶ Your highlights (<%= highlights.length %>)
          </button>
          <div class="cm-highlights-chips" id="cm-highlights-chips" style="display:none; margin-top: 0.75rem;">
            <% highlights.forEach(function(h) { %>
            <span class="cm-highlight-chip"><%= h.highlighted_text %></span>
            <% }); %>
          </div>
        </div>
        <% } %>

        <footer class="cm-export-footer">
          <a href="/seed-packets/seeds/export" class="cm-export-link">
            Download your seeds as a PDF ↓
          </a>
        </footer>

      </div>

    </main>
  </div>

  <script>
    function debounce(fn, ms) {
      let t;
      return function() {
        const args = arguments;
        clearTimeout(t);
        t = setTimeout(function() { fn.apply(this, args); }, ms);
      };
    }

    function escHtml(str) {
      return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function getSeedData(packet) {
      return {
        name: (packet.querySelector('.cm-seed-name-input').value || '').trim(),
        description: packet.querySelector('.cm-seed-desc').value || '',
        application: packet.querySelector('.cm-seed-application').value || '',
        bullets: Array.from(packet.querySelectorAll('.cm-seed-bullet-input'))
                      .map(function(i) { return i.value; })
                      .filter(function(v) { return v.trim(); }),
        sortOrder: parseInt(packet.dataset.sortOrder) || 0,
      };
    }

    async function saveSeed(packet) {
      const seedId = packet.dataset.seedId;
      if (!seedId) return;
      const data = getSeedData(packet);
      if (!data.name) return;
      try {
        await fetch('/api/seed-packets/seeds/' + seedId, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        // Sync collapsed-view text from the saved fields without re-fetching.
        const titleEl = packet.querySelector('.cm-seed-packet-title');
        if (titleEl) titleEl.textContent = data.name || 'Untitled seed';
        const blurbEl = packet.querySelector('.cm-seed-packet-blurb');
        if (blurbEl) blurbEl.textContent = data.description || 'No description yet — tap to add one.';
      } catch(e) {}
    }

    const debouncedSave = debounce(saveSeed, 800);

    function attachPacketListeners(packet) {
      packet.querySelectorAll('.cm-seed-name-input, .cm-seed-desc, .cm-seed-application').forEach(function(el) {
        el.addEventListener('input', function() { debouncedSave(packet); });
      });
      refreshBulletListeners(packet);
    }

    function refreshBulletListeners(packet) {
      packet.querySelectorAll('.cm-seed-bullet-input').forEach(function(input) {
        const fresh = input.cloneNode(true);
        input.parentNode.replaceChild(fresh, input);
        fresh.addEventListener('input', function() { debouncedSave(packet); });
      });
      packet.querySelectorAll('.cm-seed-bullet-remove').forEach(function(btn) {
        const fresh = btn.cloneNode(true);
        btn.parentNode.replaceChild(fresh, btn);
        fresh.addEventListener('click', function() {
          fresh.closest('.cm-seed-bullet-row').remove();
          debouncedSave(packet);
        });
      });
    }

    function attachRemoveListener(packet) {
      const btn = packet.querySelector('.cm-seed-remove');
      if (!btn) return;
      btn.addEventListener('click', async function(e) {
        e.stopPropagation();
        if (!confirm('Remove this seed?')) return;
        const seedId = packet.dataset.seedId;
        if (seedId) {
          try { await fetch('/api/seed-packets/seeds/' + seedId, { method: 'DELETE' }); } catch(e) {}
        }
        packet.remove();
      });
    }

    function attachAddBulletListener(packet) {
      const btn = packet.querySelector('.cm-seed-add-bullet');
      if (!btn) return;
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        addBulletToPacket(packet, '');
      });
    }

    function addBulletToPacket(packet, text) {
      const bulletsDiv = packet.querySelector('.cm-seed-bullets');
      const row = document.createElement('div');
      row.className = 'cm-seed-bullet-row';
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'cm-seed-bullet-input';
      input.value = text || '';
      input.placeholder = 'Add a note...';
      input.addEventListener('input', function() { debouncedSave(packet); });
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'cm-seed-bullet-remove';
      removeBtn.setAttribute('aria-label', 'Remove note');
      removeBtn.textContent = '×';
      removeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        row.remove();
        debouncedSave(packet);
      });
      row.appendChild(input);
      row.appendChild(removeBtn);
      bulletsDiv.appendChild(row);
      if (!text) input.focus();
      debouncedSave(packet);
    }

    // ── Expand/collapse on header click ───────────────────────────────────────

    function setExpanded(packet, open) {
      const body = packet.querySelector('.cm-seed-packet-body');
      const caret = packet.querySelector('.cm-seed-packet-caret');
      if (open) {
        packet.classList.add('cm-seed-packet--open');
        packet.setAttribute('aria-expanded', 'true');
        body.hidden = false;
        if (caret) caret.textContent = '↑';
      } else {
        packet.classList.remove('cm-seed-packet--open');
        packet.setAttribute('aria-expanded', 'false');
        body.hidden = true;
        if (caret) caret.textContent = '↓';
      }
    }

    function attachToggleListener(packet) {
      const header = packet.querySelector('.cm-seed-packet-header');
      const blurb  = packet.querySelector('.cm-seed-packet-blurb');
      [header, blurb].forEach(function(el) {
        if (!el) return;
        el.addEventListener('click', function() {
          setExpanded(packet, !packet.classList.contains('cm-seed-packet--open'));
        });
      });
    }

    // ── Attach listeners to existing packets ─────────────────────────────────

    document.querySelectorAll('.cm-seed-packet').forEach(function(packet) {
      attachPacketListeners(packet);
      attachRemoveListener(packet);
      attachAddBulletListener(packet);
      attachToggleListener(packet);
    });

    // ── Add a new seed ────────────────────────────────────────────────────────

    document.getElementById('cm-add-seed-btn').addEventListener('click', async function() {
      const sortOrder = document.querySelectorAll('.cm-seed-packet').length;
      try {
        const res = await fetch('/api/seed-packets/seeds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: 'New seed', description: '', application: '', bullets: [], sortOrder }),
        });
        const seed = await res.json();
        const packet = buildPacket(seed);
        document.getElementById('cm-seed-list').appendChild(packet);
        setExpanded(packet, true);
        packet.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const nameInput = packet.querySelector('.cm-seed-name-input');
        nameInput.focus();
        nameInput.select();
      } catch(e) {}
    });

    function buildPacket(seed) {
      const article = document.createElement('article');
      article.className = 'cm-seed-packet';
      article.dataset.seedId = String(seed.id);
      article.dataset.sortOrder = String(seed.sort_order || 0);
      article.setAttribute('aria-expanded', 'false');
      const bullets = Array.isArray(seed.bullets) ? seed.bullets : [];
      const bulletsHtml = bullets.map(function(b) {
        return '<div class="cm-seed-bullet-row">'
          + '<input type="text" class="cm-seed-bullet-input" value="' + escHtml(b) + '" placeholder="Add a note...">'
          + '<button type="button" class="cm-seed-bullet-remove" aria-label="Remove note">×</button>'
          + '</div>';
      }).join('');
      article.innerHTML = ''
        + '<header class="cm-seed-packet-header">'
        +   '<span class="cm-seed-packet-sprout" aria-hidden="true">'
        +     '<svg viewBox="0 0 24 28" width="22" height="26" xmlns="http://www.w3.org/2000/svg">'
        +       '<path d="M12 26 L12 14" fill="none" stroke="#76856C" stroke-width="1.6" stroke-linecap="round"/>'
        +       '<path d="M12 18 Q4 16 4 8 Q12 8 12 18 Z" fill="#76856C" opacity="0.85"/>'
        +       '<path d="M12 15 Q20 13 20 6 Q12 6 12 15 Z" fill="#76856C"/>'
        +     '</svg>'
        +   '</span>'
        +   '<h2 class="cm-seed-packet-title">' + escHtml(seed.name || 'Untitled seed') + '</h2>'
        +   '<span class="cm-seed-packet-caret" aria-hidden="true">↓</span>'
        + '</header>'
        + '<p class="cm-seed-packet-blurb">' + escHtml(seed.description || 'No description yet — tap to add one.') + '</p>'
        + '<div class="cm-seed-packet-body" hidden>'
        +   '<label class="cm-seed-packet-label">Name</label>'
        +   '<input type="text" class="cm-seed-name-input" value="' + escHtml(seed.name || '') + '" placeholder="Name this seed...">'
        +   '<label class="cm-seed-packet-label">In your own words</label>'
        +   '<textarea class="cm-seed-desc" rows="3" placeholder="What’s this seed about?">' + escHtml(seed.description || '') + '</textarea>'
        +   '<label class="cm-seed-packet-label">How this shows up in my content</label>'
        +   '<p class="cm-seed-packet-help">Posts, projects, conversations — concrete examples.</p>'
        +   '<textarea class="cm-seed-application" rows="3" placeholder="If this seed sprouted into something you made, what would it be?">' + escHtml(seed.application || '') + '</textarea>'
        +   '<label class="cm-seed-packet-label">Notes, examples, details (optional)</label>'
        +   '<div class="cm-seed-bullets">' + bulletsHtml + '</div>'
        +   '<button type="button" class="cm-seed-add-bullet">+ Add note</button>'
        +   '<div class="cm-seed-packet-footer">'
        +     '<button type="button" class="cm-seed-remove">× Remove seed</button>'
        +   '</div>'
        + '</div>';
      attachPacketListeners(article);
      attachRemoveListener(article);
      attachAddBulletListener(article);
      attachToggleListener(article);
      return article;
    }

    // ── Highlights bank toggle ────────────────────────────────────────────────

    const toggleBtn = document.getElementById('cm-highlights-toggle');
    const chipsEl = document.getElementById('cm-highlights-chips');
    if (toggleBtn && chipsEl) {
      toggleBtn.addEventListener('click', function() {
        const open = chipsEl.style.display !== 'none';
        chipsEl.style.display = open ? 'none' : 'flex';
        toggleBtn.textContent = toggleBtn.textContent.replace(open ? '▼' : '▶', open ? '▶' : '▼');
      });
    }
  </script>
</body>
</html>
