<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-body">

  <div class="login-layout">

    <!-- Left brand panel -->
    <div class="login-brand" aria-hidden="true">
      <img
        src="/images/brand/Circle_Text_Icon_White.png"
        alt="The Creative's Garden"
        class="login-brand-icon">
    </div>

    <!-- Right form panel -->
    <div class="login-form-panel">
      <div class="login-form-inner">

        <img
          src="/images/brand/The Creative's Garden Icon with Text_1.svg"
          alt="The Creative's Garden"
          class="login-logo">

        <p class="login-form-eyebrow">Welcome back</p>
        <h2 class="login-form-title">Sign in to your studio</h2>

        <% if (error) { %>
          <div class="login-error" role="alert">
            <%= error %>
          </div>
        <% } %>

        <form action="/login" method="POST" class="login-form" novalidate>
          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder="you@example.com"
              autocomplete="email"
              required>
          </div>

          <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              class="form-input"
              placeholder="••••••••"
              autocomplete="current-password"
              required>
          </div>

          <button type="submit" class="btn btn-primary btn-full">
            Enter the studio
          </button>
        </form>

        <p class="login-help">
          Trouble signing in? Reach out to Julia directly.
        </p>

        <p class="login-attribution">A course by The Meibos Touch</p>

      </div>
    </div>

  </div>

</body>
</html>
