<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-body">

  <div class="login-layout">

    <!-- Left brand panel -->
    <div class="login-brand">
      <a href="https://www.meibostouch.com/the-creatives-garden"
         target="_blank" rel="noopener"
         class="login-brand-link"
         aria-label="The Creative's Garden — visit the course page on meibostouch.com">
        <img
          src="/images/brand/Stacked_Logo.png"
          alt=""
          class="login-brand-icon">
      </a>
      <p class="login-attribution login-attribution--on-brand">
        <a href="https://www.meibostouch.com/the-creatives-garden"
           target="_blank" rel="noopener"
           class="login-attribution-link">A course by The Meibos Touch</a>
      </p>
    </div>

    <!-- Right form panel -->
    <div class="login-form-panel">
      <div class="login-form-inner">

        <a href="https://www.meibostouch.com/the-creatives-garden"
           target="_blank" rel="noopener"
           class="login-logo-link"
           aria-label="The Creative's Garden — visit the course page on meibostouch.com">
          <img
            src="/images/brand/The Creative's Garden Icon with Text_1.svg"
            alt=""
            class="login-logo">
        </a>

        <p class="login-form-eyebrow">Welcome back</p>
        <h2 class="login-form-title">Sign in to your studio</h2>

        <% if (error) { %>
          <div class="login-error" role="alert">
            <%= error %>
          </div>
        <% } %>

        <form action="/login" method="POST" class="login-form" novalidate>
          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder="you@example.com"
              autocomplete="email"
              required>
          </div>

          <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              class="form-input"
              placeholder="••••••••"
              autocomplete="current-password"
              required>
          </div>

          <button type="submit" class="btn btn-primary btn-full">
            Enter the studio
          </button>
        </form>

        <p class="login-forgot">
          <a href="/forgot-password" class="login-forgot-link">Forgot your password?</a>
        </p>

        <p class="login-help">
          Trouble signing in? <a href="mailto:julia@meibostouch.com" class="login-help-link">Reach out to Julia directly</a>.
        </p>

      </div>
    </div>

  </div>

</body>
</html>
