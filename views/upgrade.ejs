<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/upgrade.css">
  <% if (locals.user && stripeConfigured) { %>
  <!-- Stripe.js MUST be loaded from js.stripe.com per Stripe policy (PCI +
       fingerprinting guarantees). Not bundled locally. Only pulled in when
       the /upgrade page renders for a signed-in student who can actually
       start a checkout — anon visitors don't need it. -->
  <script src="https://js.stripe.com/v3/"></script>
  <% } %>
</head>
<body class="app-body<%= locals.user ? '' : ' up-body--anon' %>">
  <div class="app-layout">
    <% if (locals.user) { %>
      <%- include('partials/sidebar') %>
    <% } else { %>
      <!-- Anonymous top bar. Sits above the pricing so returning visitors
           can sign in without hunting for a link. -->
      <nav class="up-anon-nav" aria-label="Sign in or sign up">
        <a href="https://www.meibostouch.com/the-creatives-garden"
           target="_blank" rel="noopener" class="up-anon-brand"
           aria-label="The Creative's Garden — course page">
          <img src="/images/brand/The Creative's Garden Icon with Text_1.svg"
               alt="The Creative's Garden" class="up-anon-brand-logo">
        </a>
        <div class="up-anon-nav-actions">
          <a href="/?returnTo=%2Fupgrade" class="up-anon-nav-link">Sign in</a>
          <a href="/signup" class="up-anon-nav-cta">Start free →</a>
        </div>
      </nav>
    <% } %>

    <main class="main-content<%= locals.user ? '' : ' main-content--anon' %>">

      <% if (locals.user) { %>
        <a href="/dashboard" class="cm-back-link" style="display:inline-block; margin: 1.5rem 0 1rem;">← Back to dashboard</a>
      <% } %>

      <header class="up-header">
        <h1 class="up-title">Continue with the full Creative's Garden</h1>
        <p class="up-subtitle">
          Three paths through the rest of the course. All three unlock every
          week of the material — the difference is how much of me comes with
          it.
        </p>
      </header>

      <!-- ─── Free-trial callout ─────────────────────────────────────────── -->
      <!-- Signed-in students on trial already know they have the free weeks;
           the callout is really for anon visitors deciding whether to try
           the course. We render for both so the pricing story stays
           consistent, but the CTA changes based on session state. -->
      <section class="up-trial-banner" aria-labelledby="up-trial-title">
        <div class="up-trial-copy">
          <p class="up-trial-eyebrow">New here?</p>
          <h2 class="up-trial-title" id="up-trial-title">Start for free</h2>
          <p class="up-trial-body">
            Let's start with the basics — three weeks of daily recording to
            see what unblocks. Continue into the full 12-week program when
            you're ready. No card required, and no pressure. (ever)
          </p>
        </div>
        <div class="up-trial-cta-wrap">
          <% if (!locals.user) { %>
            <a href="/signup" class="up-btn up-btn--primary up-btn--trial">Start the free 3 weeks →</a>
          <% } else { %>
            <span class="up-trial-chip">You're on the free trial now</span>
            <p class="up-trial-fineprint">Continue below to unlock the rest of the course.</p>
          <% } %>
        </div>
      </section>

      <!-- ─── Step 1: Tier selection ─────────────────────────────────────── -->
      <section class="up-step" id="up-step-tier" data-step="tier">
        <div class="up-tier-grid">
          <% tiers.forEach(function(t, idx) {
            const includes = new Set(t.includes);
          %>
            <label class="up-tier<%= idx === 1 ? ' up-tier--recommended' : '' %>" data-tier="<%= t.id %>">
              <input type="radio" name="tier" value="<%= t.id %>" class="up-tier-radio">
              <div class="up-tier-inner">
                <% if (idx === 1) { %>
                  <span class="up-tier-badge">Most popular</span>
                <% } %>

                <div class="up-tier-headline">
                  <h2 class="up-tier-name"><%= t.name %></h2>
                  <p class="up-tier-tagline"><%= t.tagline %></p>
                </div>

                <div class="up-tier-price-block<%= t.originalPriceLabel ? ' up-tier-price-block--discounted' : '' %>">
                  <% if (t.originalPriceLabel) { %>
                    <span class="up-tier-price-original"><%= t.originalPriceLabel %></span>
                  <% } %>
                  <span class="up-tier-price-amount"><%= t.priceLabel %></span>
                  <span class="up-tier-price-once">one-time</span>
                  <% if (t.priceNote) { %>
                    <span class="up-tier-price-note">
                      <% if (t.savingsLabel) { %><strong>Save <%= t.savingsLabel %></strong> · <% } %>
                      <%= t.priceNote %>
                    </span>
                  <% } %>
                </div>

                <ul class="up-features">
                  <% features.forEach(function(f) {
                    const has   = includes.has(f.id);
                    const label = (t.labelOverrides && t.labelOverrides[f.id]) || f.label;
                  %>
                    <li class="up-feature <%= has ? 'is-included' : 'is-excluded' %>">
                      <span class="up-feature-mark" aria-hidden="true">
                        <% if (has) { %>
                          <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                            <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        <% } else { %>
                          <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                            <path d="M5 10h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                          </svg>
                        <% } %>
                      </span>
                      <span class="up-feature-label"><%= label %></span>
                    </li>
                  <% }); %>
                </ul>

                <div class="up-tier-cta">
                  <span class="up-tier-cta-label">Choose <%= t.name %></span>
                </div>
              </div>
            </label>
          <% }); %>
        </div>

        <div class="up-actions">
          <button type="button" class="up-btn up-btn--primary" id="up-continue-btn" disabled>Continue →</button>
        </div>
      </section>

      <!-- ─── Step 2: Card form (signed-in only) ─────────────────────────── -->
      <% if (locals.user) { %>
      <section class="up-step is-hidden" id="up-step-pay" data-step="pay">
        <div class="up-summary">
          <button type="button" class="up-back-inline" id="up-back-to-tier">← Change tier</button>
          <div class="up-summary-row">
            <span class="up-summary-label">You selected</span>
            <span class="up-summary-tier" id="up-summary-tier-name">—</span>
          </div>
          <div class="up-summary-row">
            <span class="up-summary-label">Total</span>
            <span class="up-summary-price" id="up-summary-price">—</span>
          </div>
        </div>

        <div class="up-card-panel">
          <label class="up-card-label">Card information</label>
          <!-- Stripe Payment Element mounts here (single element covers card
               fields + wallets like Apple Pay when configured). -->
          <div id="up-payment-element" class="up-payment-element"></div>

          <p class="up-error" id="up-pay-error" hidden></p>

          <button type="button" class="up-btn up-btn--primary up-btn--full" id="up-pay-btn">
            Pay <span id="up-pay-btn-amount">—</span>
          </button>

          <% if (!stripeConfigured) { %>
            <p class="up-note up-note--warn" style="margin-top:1rem">
              Payments aren't configured yet. Reach out to Julia directly.
            </p>
          <% } %>

          <p class="up-note">
            Secure checkout powered by Stripe. We never see or store your card
            details.
          </p>
        </div>
      </section>
      <% } %>

    </main>
  </div>

  <script>
    // Server-serialized tier catalog so the client can look up name/price on
    // selection without another round-trip. Same source as the API validator.
    const TIERS = <%- JSON.stringify(tiers) %>;
    const IS_AUTHED = <%= locals.user ? 'true' : 'false' %>;
    const STRIPE_CONFIGURED = <%= stripeConfigured ? 'true' : 'false' %>;

    let selectedTierId = null;
    let stripe = null;
    let paymentElement = null;
    let elements = null;
    let currentClientSecret = null;

    // ── Step 1: tier selection ────────────────────────────────────────────
    document.querySelectorAll('.up-tier').forEach(function (label) {
      label.addEventListener('click', function () {
        const tierId = label.dataset.tier;
        selectedTierId = tierId;
        document.querySelectorAll('.up-tier').forEach(function (l) {
          l.classList.toggle('is-selected', l.dataset.tier === tierId);
        });
        document.getElementById('up-continue-btn').disabled = false;
      });
    });

    document.getElementById('up-continue-btn').addEventListener('click', async function () {
      if (!selectedTierId) return;

      // Anon visitors: bounce to signup and come back to /upgrade with the
      // tier preselected via the URL. Keeps Stripe.js out of the anon path.
      if (!IS_AUTHED) {
        const rt = '/upgrade?tier=' + encodeURIComponent(selectedTierId);
        window.location.href = '/signup?returnTo=' + encodeURIComponent(rt);
        return;
      }

      if (!STRIPE_CONFIGURED) {
        alert('Payments are not configured yet. Please reach out to Julia directly.');
        return;
      }
      const tier = TIERS.find(function (t) { return t.id === selectedTierId; });
      if (!tier) return;

      // Fill the summary panel
      document.getElementById('up-summary-tier-name').textContent = tier.name;
      document.getElementById('up-summary-price').textContent      = tier.priceLabel;
      document.getElementById('up-pay-btn-amount').textContent     = tier.priceLabel;

      // Swap steps
      document.getElementById('up-step-tier').classList.add('is-hidden');
      document.getElementById('up-step-pay').classList.remove('is-hidden');

      // Create the PaymentIntent + mount the Payment Element (lazy — only
      // when the user actually reaches step 2, so a bounce off step 1 costs
      // nothing on our Stripe account).
      try {
        const res = await fetch('/api/checkout/create-payment-intent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tier: tier.id }),
        });
        const data = await res.json();
        if (!res.ok) {
          document.getElementById('up-pay-error').textContent = data.error || 'Could not start checkout.';
          document.getElementById('up-pay-error').hidden = false;
          return;
        }
        currentClientSecret = data.clientSecret;

        stripe   = Stripe(data.publishableKey);
        elements = stripe.elements({ clientSecret: data.clientSecret, appearance: { theme: 'stripe' } });
        paymentElement = elements.create('payment', { layout: 'tabs' });
        paymentElement.mount('#up-payment-element');
      } catch (err) {
        document.getElementById('up-pay-error').textContent = 'Network error. Please try again.';
        document.getElementById('up-pay-error').hidden = false;
      }
    });

    // Signed-in only: back-to-tier + payment submit handlers.
    if (IS_AUTHED) {
      // ── Back to tier selection (Change tier) ─────────────────────────────
      document.getElementById('up-back-to-tier').addEventListener('click', function () {
        document.getElementById('up-step-pay').classList.add('is-hidden');
        document.getElementById('up-step-tier').classList.remove('is-hidden');
        // Tear down the mounted Payment Element so a re-continue starts fresh.
        if (paymentElement) { try { paymentElement.unmount(); } catch (_) {} }
        paymentElement = null;
        elements = null;
        stripe = null;
        currentClientSecret = null;
      });

      // ── Submit payment ───────────────────────────────────────────────────
      document.getElementById('up-pay-btn').addEventListener('click', async function () {
        const errEl = document.getElementById('up-pay-error');
        const btn   = document.getElementById('up-pay-btn');
        errEl.hidden = true;

        if (!stripe || !elements || !currentClientSecret) {
          errEl.textContent = 'Something went wrong loading the payment form. Please refresh and try again.';
          errEl.hidden = false;
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Processing…';

        // confirmPayment triggers Stripe's confirmation. On 3DS challenge,
        // Stripe handles the redirect and comes back to return_url. On
        // immediate success/failure with no redirect needed, we get { error }
        // or { paymentIntent } here directly.
        const { error, paymentIntent } = await stripe.confirmPayment({
          elements,
          confirmParams: {
            return_url: window.location.origin + '/upgrade/return',
          },
          redirect: 'if_required',
        });

        if (error) {
          errEl.textContent = error.message || 'Payment failed. Please try again.';
          errEl.hidden = false;
          btn.disabled = false;
          const tier = TIERS.find(function (t) { return t.id === selectedTierId; });
          btn.innerHTML = 'Pay <span id="up-pay-btn-amount">' + (tier ? tier.priceLabel : '') + '</span>';
          return;
        }

        if (paymentIntent && paymentIntent.status === 'succeeded') {
          // Webhook will flip the user's course_length_weeks server-side; the
          // dashboard banner detection uses ?upgraded=1&tier=... query params.
          window.location.href = '/dashboard?upgraded=1&tier=' + encodeURIComponent(selectedTierId);
        } else {
          // Rare — status like 'processing' or 'requires_action'. Land them on
          // the return page which polls / renders their final state.
          window.location.href = '/upgrade/return';
        }
      });
    }

    // Preselect a tier if ?tier=X is present (from signup returnTo). Runs
    // after the click handlers so the "selected" state renders.
    (function preselectFromQuery() {
      const params = new URLSearchParams(window.location.search);
      const tierId = params.get('tier');
      if (!tierId) return;
      const label = document.querySelector('.up-tier[data-tier="' + tierId + '"]');
      if (label) label.click();
    })();
  </script>

</body>
</html>
