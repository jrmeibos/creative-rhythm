<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Greenhouse Goals</title>
<style>
  <%- fontFaceCss %>

  :root {
    --color-bloem:       #705C6C;
    --color-understory:  #76856C;
    --color-pearl:       #F2EEE3;
    --color-blank-page:  #FAFAFA;
    --color-ink-stained: #100F10;
    --font-display: 'Goldage', Georgia, serif;
    --font-body:    'Jost', system-ui, sans-serif;
  }

  @page { size: Letter; margin: 0.85in; }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: #fff;
    color: var(--color-ink-stained);
    font-family: var(--font-body);
    font-weight: 300;
    line-height: 1.7;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .cover {
    page-break-after: always;
    text-align: center;
    min-height: calc(11in - 1.7in);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
  }
  .cover-logo-img {
    display: block;
    width: 140px;
    height: 140px;
    margin: 0 auto 1.25rem;
  }
  .cover-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 3.4rem;
    line-height: 1.1;
    color: var(--color-bloem);
  }
  .cover-range {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    color: rgba(16, 15, 16, 0.75);
    margin-top: 0.5rem;
  }
  .cover-source {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-understory);
    margin-top: 2rem;
  }

  .bed {
    page-break-before: always;
    page-break-inside: avoid;
  }
  .bed-header {
    margin-bottom: 1.25rem;
  }
  .bed-number {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-understory);
    margin: 0 0 0.4rem;
  }
  .bed-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.4rem;
    color: var(--color-bloem);
    line-height: 1.15;
  }
  .bed-rule {
    border: 0;
    border-top: 1px solid rgba(112, 92, 108, 0.25);
    margin: 1.1rem 0 1.6rem;
  }

  .facet {
    margin-bottom: 1.4rem;
    page-break-inside: avoid;
  }
  .facet-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(16, 15, 16, 0.55);
    margin: 0 0 0.35rem;
  }
  .facet-prompt {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 300;
    font-size: 0.85rem;
    color: rgba(16, 15, 16, 0.5);
    margin: 0 0 0.4rem;
  }
  .facet-text {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--color-ink-stained);
    white-space: pre-wrap;
  }

  .bed-fallow-note {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--color-understory);
    margin-top: 2rem;
    text-align: center;
  }
</style>
</head>
<body>

  <section class="cover">
    <div class="cover-logo">
      <img src="data:image/png;base64,<%= badgePngBase64 %>"
           alt=""
           class="cover-logo-img">
    </div>
    <h1 class="cover-title">Greenhouse: <%= studentName %></h1>
    <p class="cover-range"><%= generatedLabel %></p>
    <p class="cover-source">From The Creative's Garden</p>
  </section>

  <%
    const FACETS = [
      { key: 'soil',  label: 'Soil',  prompt: 'What conditions does this goal need?' },
      { key: 'seed',  label: 'Seed',  prompt: 'What is the actual practice or work?' },
      { key: 'water', label: 'Water', prompt: 'How will you tend it consistently?' },
      { key: 'bloom', label: 'Bloom', prompt: 'What does the result look like?' },
    ];
  %>

  <% beds.forEach(function (bed) { %>
    <section class="bed">
      <header class="bed-header">
        <p class="bed-number">Bed <%= bed.number %></p>
        <h2 class="bed-title">
          <% if (bed.status === 'fallow') { %>
            Resting this season
          <% } else if (bed.goal && (bed.goal.seed || bed.goal.bloom)) { %>
            <%= bed.goal.seed || bed.goal.bloom %>
          <% } else { %>
            Planted goal
          <% } %>
        </h2>
        <hr class="bed-rule">
      </header>

      <% if (bed.status === 'fallow') { %>
        <p class="bed-fallow-note">This bed was left fallow this season.</p>
      <% } else { %>
        <% FACETS.forEach(function (f) {
          const v = bed.goal && bed.goal[f.key] ? String(bed.goal[f.key]).trim() : '';
          if (!v) return;
        %>
          <div class="facet">
            <p class="facet-label"><%= f.label %></p>
            <p class="facet-prompt"><%= f.prompt %></p>
            <p class="facet-text"><%= bed.goal[f.key] %></p>
          </div>
        <% }); %>
      <% } %>
    </section>
  <% }); %>

</body>
</html>
