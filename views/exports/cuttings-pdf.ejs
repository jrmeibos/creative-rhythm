<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Your Cuttings</title>
<style>
  /* ───── Web fonts: base64-embedded by the route so the rendered HTML is
     self-contained — no dependency on the Express static mount being
     reachable from Puppeteer at render time. ───── */
  <%- fontFaceCss %>

  /* ───── Design tokens (keep in sync with public/css/main.css). ───── */
  :root {
    --color-bloem:       #705C6C;
    --color-understory:  #76856C;
    --color-pearl:       #F2EEE3;
    --color-blank-page:  #FAFAFA;
    --color-ink-stained: #100F10;
    --font-display: 'Goldage', Georgia, serif;
    --font-body:    'Jost', system-ui, sans-serif;
  }

  /* ───── Page setup. Generous margins, no headers/footers. ───── */
  @page { size: Letter; margin: 0.85in; }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: #fff;
    color: var(--color-ink-stained);
    font-family: var(--font-body);
    font-weight: 300;
    line-height: 1.7;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* ───── Cover page. ───── */
  .cover {
    page-break-after: always;
    text-align: center;
    /* Fill the page so cover content sits in the optical center. */
    min-height: calc(11in - 1.7in); /* page height minus top+bottom margins */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
  }
  .cover-logo {
    margin: 0 auto 1.25rem;
    text-align: center;
  }
  .cover-logo-img {
    display: block;
    width: 140px;
    height: 140px;
    margin: 0 auto;
  }
  .cover-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 3.4rem;
    line-height: 1.1;
    color: var(--color-bloem);
    margin: 0;
  }
  .cover-range {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    color: rgba(16, 15, 16, 0.75);
    margin-top: 0.5rem;
  }
  .cover-source {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-understory);
    margin-top: 2rem;
  }

  /* ───── Section (one season per page break). ───── */
  .season {
    page-break-before: always;
  }
  .season-header {
    margin-bottom: 1.5rem;
  }
  .season-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.4rem;
    color: var(--color-bloem);
    line-height: 1.1;
    margin: 0;
  }
  .season-weeks {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: rgba(16, 15, 16, 0.55);
    margin-top: 0.35rem;
  }
  .season-rule {
    border: 0;
    border-top: 1px solid rgba(112, 92, 108, 0.25);
    margin: 1.1rem 0 1.8rem;
  }

  /* ───── Entry. The .entry is the per-day group; each individual cutting
     within it sits in its own .cutting-card so they're easy to scan. ───── */
  .entry {
    margin-bottom: 1.75rem;
  }
  .entry-date {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-understory);
    margin: 0 0 0.55rem;
  }
  /* Each cutting gets a pearl rounded rectangle so individual entries
     don't visually blur together inside a day group. page-break-inside
     prevents a card from splitting across pages. */
  .cutting-card {
    background: var(--color-pearl);
    border-radius: 14px;
    padding: 1.1rem 1.4rem 0.95rem;
    margin-bottom: 0.85rem;
    page-break-inside: avoid;
  }
  .cutting-card:last-child {
    margin-bottom: 0;
  }
  .entry-prompt {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 300;
    font-size: 0.95rem;
    color: rgba(16, 15, 16, 0.6);
    margin: 0 0 0.5rem;
  }
  /* Second and subsequent prompts inside the same cutting get extra top
     margin so the labelled sections within one entry breathe. */
  .entry-prompt--subsequent {
    margin-top: 1.1rem;
  }
  .entry-text {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--color-ink-stained);
    margin: 0 0 0.2rem;
    white-space: pre-wrap;
  }
</style>
</head>
<body>

  <!-- ───── Cover page. ───── -->
  <section class="cover">
    <div class="cover-logo">
      <img src="data:image/png;base64,<%= badgePngBase64 %>"
           alt=""
           class="cover-logo-img">
    </div>
    <h1 class="cover-title"><%= locals.coverTitle || 'Your Cuttings' %></h1>
    <p class="cover-range"><%= dateRangeLabel %></p>
    <p class="cover-source">From The Creative's Garden</p>
  </section>

  <!-- ───── One season per page. ───── -->
  <% seasonGroups.forEach(function (group) { %>
    <section class="season">
      <header class="season-header">
        <h2 class="season-name"><%= group.label %></h2>
        <p class="season-weeks"><%= group.weeksLabel %></p>
        <hr class="season-rule">
      </header>

      <%
        // Group entries by recorded_date so multiple cuttings on the same
        // day stack under one date label. Within-day order is preserved
        // from the chronological SELECT (created_at ASC).
        const dayBuckets = [];
        const dayIndex   = {};
        group.entries.forEach(function (e) {
          const dayKey = e.recorded_date || (e.created_at ? e.created_at.slice(0, 10) : '?');
          if (dayIndex[dayKey] == null) {
            let dayLabel = dayKey;
            try {
              const d = new Date(dayKey + 'T00:00:00');
              dayLabel = d.toLocaleDateString('en-US', {
                weekday: 'long', month: 'long', day: 'numeric',
              });
            } catch (_) {}
            dayIndex[dayKey] = dayBuckets.length;
            dayBuckets.push({ dayKey, dayLabel, items: [] });
          }
          dayBuckets[dayIndex[dayKey]].items.push(e);
        });
      %>
      <% dayBuckets.forEach(function (day) { %>
        <div class="entry">
          <p class="entry-date"><%= day.dayLabel %></p>
          <% day.items.forEach(function (entry) { %>
            <%
              const populatedFields = cuttingPrompts.filter(function (p) {
                const v = entry[p.key];
                return v != null && String(v).trim() !== '';
              });
            %>
            <article class="cutting-card">
              <% populatedFields.forEach(function (p, fi) { %>
                <p class="entry-prompt<%= fi > 0 ? ' entry-prompt--subsequent' : '' %>"><%= p.label %></p>
                <p class="entry-text"><%= entry[p.key] %></p>
              <% }); %>
            </article>
          <% }); %>
        </div>
      <% }); %>
    </section>
  <% }); %>

</body>
</html>
