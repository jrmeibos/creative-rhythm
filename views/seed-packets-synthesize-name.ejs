<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/seed-packets.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content">

      <a href="/seed-packets/synthesize" class="cm-back-link">← Back to reading your answers</a>

      <div class="cm-synth-page">

        <header class="cm-synth-header">
          <h1 class="cm-synth-title">Name your seeds</h1>
          <p class="cm-synth-subtitle">What keeps showing up? Give each thread a name. Start anywhere — you can rename and add more any time.</p>
        </header>

        <% if (highlights.length > 0) { %>
        <div class="cm-highlights-bank">
          <p class="cm-highlights-bank-label">Your highlights — click one to pick a seed, or drag it onto a seed card</p>
          <div class="cm-highlights-chips" id="cm-highlights-chips">
            <% highlights.forEach(function(h) { %>
            <span class="cm-highlight-chip" draggable="true" data-text="<%= h.highlighted_text.replace(/"/g, '&quot;') %>"><%= h.highlighted_text %></span>
            <% }); %>
          </div>
        </div>
        <% } %>

        <div class="cm-seed-list" id="cm-seed-list">
          <% if (existingSeeds.length > 0) { %>
            <% existingSeeds.forEach(function(seed) { %>
            <div class="cm-seed-card" data-seed-id="<%= seed.id %>" data-sort-order="<%= seed.sort_order %>">
              <input type="text" class="cm-seed-name-input" value="<%= seed.name %>" placeholder="Name this seed...">
              <textarea class="cm-seed-desc" rows="3" placeholder="What's this seed about? In your own words."><%= seed.description %></textarea>
              <p class="cm-seed-bullets-label">Notes, examples, details (optional)</p>
              <div class="cm-seed-bullets">
                <% seed.bullets.forEach(function(b) { %>
                <div class="cm-seed-bullet-row">
                  <input type="text" class="cm-seed-bullet-input" value="<%= b %>" placeholder="Add a note...">
                  <button type="button" class="cm-seed-bullet-remove">×</button>
                </div>
                <% }); %>
              </div>
              <button type="button" class="cm-seed-add-bullet">+ Add note</button>
              <button type="button" class="cm-seed-remove">× Remove seed</button>
            </div>
            <% }); %>
          <% } else { %>
            <!-- One empty unsaved card to get started -->
            <div class="cm-seed-card cm-seed-card--unsaved">
              <input type="text" class="cm-seed-name-input" placeholder="Name this seed...">
              <textarea class="cm-seed-desc" rows="3" placeholder="What's this seed about? In your own words."></textarea>
              <p class="cm-seed-bullets-label">Notes, examples, details (optional)</p>
              <div class="cm-seed-bullets"></div>
              <button type="button" class="cm-seed-add-bullet">+ Add note</button>
            </div>
          <% } %>
        </div>

        <button type="button" class="cm-add-seed-btn" id="cm-add-seed-btn">+ Name another seed</button>

        <div class="cm-synth-nav">
          <a href="/seed-packets/seeds" class="cm-synth-btn">View your seeds →</a>
          <a href="/seed-packets/synthesize" class="cm-back-link" style="margin-bottom:0">← Back to reading your answers</a>
        </div>

      </div>

    </main>
  </div>

  <script>
    function debounce(fn, ms) {
      let t;
      return function() {
        const args = arguments;
        clearTimeout(t);
        t = setTimeout(function() { fn.apply(this, args); }, ms);
      };
    }

    function escHtml(str) {
      return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function getSeedData(card) {
      return {
        name: (card.querySelector('.cm-seed-name-input').value || '').trim(),
        description: card.querySelector('.cm-seed-desc').value || '',
        bullets: Array.from(card.querySelectorAll('.cm-seed-bullet-input'))
                      .map(function(i) { return i.value; })
                      .filter(function(v) { return v.trim(); }),
        sortOrder: parseInt(card.dataset.sortOrder) || 0,
      };
    }

    async function saveSeed(card) {
      const seedId = card.dataset.seedId;
      const data = getSeedData(card);
      if (!data.name) return;

      // Card has an id — update it
      if (seedId) {
        try {
          await fetch('/api/seed-packets/seeds/' + seedId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
        } catch(e) {}
        return;
      }

      // Unsaved card — create it
      try {
        const res = await fetch('/api/seed-packets/seeds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const seed = await res.json();
        card.dataset.seedId = String(seed.id);
        card.classList.remove('cm-seed-card--unsaved');
        // Attach remove button now that we have an id
        attachRemoveListener(card);
      } catch(e) {}
    }

    const debouncedSave = debounce(saveSeed, 800);

    function attachCardListeners(card) {
      card.querySelectorAll('.cm-seed-name-input, .cm-seed-desc').forEach(function(el) {
        el.addEventListener('input', function() { debouncedSave(card); });
      });
      refreshBulletListeners(card);
      attachDropListeners(card);
    }

    function refreshBulletListeners(card) {
      card.querySelectorAll('.cm-seed-bullet-input').forEach(function(input) {
        input.addEventListener('input', function() { debouncedSave(card); });
      });
      card.querySelectorAll('.cm-seed-bullet-remove').forEach(function(btn) {
        const fresh = btn.cloneNode(true);
        btn.parentNode.replaceChild(fresh, btn);
        fresh.addEventListener('click', function() {
          fresh.closest('.cm-seed-bullet-row').remove();
          debouncedSave(card);
          refreshUsedChips();
        });
      });
    }

    function attachRemoveListener(card) {
      const btn = card.querySelector('.cm-seed-remove');
      if (!btn || btn.dataset.listenerAttached) return;
      btn.dataset.listenerAttached = '1';
      btn.addEventListener('click', async function() {
        if (!confirm('Remove this seed?')) return;
        const seedId = card.dataset.seedId;
        if (seedId) {
          try { await fetch('/api/seed-packets/seeds/' + seedId, { method: 'DELETE' }); } catch(e) {}
        }
        card.remove();
      });
    }

    function attachAddBulletListener(card) {
      const btn = card.querySelector('.cm-seed-add-bullet');
      if (!btn || btn.dataset.listenerAttached) return;
      btn.dataset.listenerAttached = '1';
      btn.addEventListener('click', function() { addBulletToCard(card, ''); });
    }

    function addBulletToCard(card, text) {
      const bulletsDiv = card.querySelector('.cm-seed-bullets');
      const row = document.createElement('div');
      row.className = 'cm-seed-bullet-row';
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'cm-seed-bullet-input';
      input.value = text || '';
      input.placeholder = 'Add a note...';
      input.addEventListener('input', function() { debouncedSave(card); });
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'cm-seed-bullet-remove';
      removeBtn.textContent = '×';
      removeBtn.addEventListener('click', function() {
        row.remove();
        debouncedSave(card);
        refreshUsedChips();
      });
      row.appendChild(input);
      row.appendChild(removeBtn);
      bulletsDiv.appendChild(row);
      if (!text) input.focus();
      debouncedSave(card);
      refreshUsedChips();
    }

    // ── Drag highlight chips → drop onto seed card ────────────────────────────

    function attachDropListeners(card) {
      card.addEventListener('dragover', function(e) {
        if (!e.dataTransfer.types.includes('text/plain')) return;
        e.preventDefault();
        card.classList.add('cm-seed-card--drop-over');
      });
      card.addEventListener('dragleave', function(e) {
        if (!card.contains(e.relatedTarget)) card.classList.remove('cm-seed-card--drop-over');
      });
      card.addEventListener('drop', function(e) {
        e.preventDefault();
        card.classList.remove('cm-seed-card--drop-over');
        const text = e.dataTransfer.getData('text/plain').trim();
        if (!text) return;
        addBulletToCard(card, text);
      });
    }

    document.querySelectorAll('.cm-highlight-chip').forEach(function(chip) {
      chip.addEventListener('dragstart', function(e) {
        e.dataTransfer.setData('text/plain', chip.dataset.text || chip.textContent.trim());
        chip.classList.add('cm-highlight-chip--dragging');
      });
      chip.addEventListener('dragend', function() {
        chip.classList.remove('cm-highlight-chip--dragging');
      });
      // Click-to-add: open a small popover with the list of current seeds.
      chip.addEventListener('click', function(e) {
        e.stopPropagation();
        openChipPopover(chip);
      });
    });

    // ── Click-to-add popover ──────────────────────────────────────────────────

    function closeChipPopover() {
      document.querySelectorAll('.cm-chip-popover').forEach(function(p) { p.remove(); });
    }

    function openChipPopover(chip) {
      closeChipPopover();
      const popover = document.createElement('div');
      popover.className = 'cm-chip-popover';
      popover.addEventListener('click', function(e) { e.stopPropagation(); });

      const label = document.createElement('p');
      label.className = 'cm-chip-popover-label';
      label.textContent = 'Add to:';
      popover.appendChild(label);

      const cards = document.querySelectorAll('.cm-seed-card');
      if (cards.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'cm-chip-popover-empty';
        empty.textContent = 'Add a seed first, then come back.';
        popover.appendChild(empty);
      } else {
        cards.forEach(function(card) {
          const nameInput = card.querySelector('.cm-seed-name-input');
          const name = (nameInput && nameInput.value || '').trim() || '(unnamed seed)';
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cm-chip-popover-option';
          btn.textContent = name;
          btn.addEventListener('click', function() {
            const text = chip.dataset.text || chip.textContent.trim();
            addBulletToCard(card, text);
            closeChipPopover();
          });
          popover.appendChild(btn);
        });
      }

      // Position right after the chip in its parent so it flows naturally
      // beneath the wrapped row the chip lives in.
      chip.insertAdjacentElement('afterend', popover);
    }

    // Close popover on outside click or Escape.
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.cm-chip-popover') && !e.target.closest('.cm-highlight-chip')) {
        closeChipPopover();
      }
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeChipPopover();
    });

    // ── Used-chip tracking ────────────────────────────────────────────────────

    function refreshUsedChips() {
      const usedTexts = new Set();
      document.querySelectorAll('.cm-seed-bullet-input').forEach(function(input) {
        const v = (input.value || '').trim();
        if (v) usedTexts.add(v);
      });
      document.querySelectorAll('.cm-highlight-chip').forEach(function(chip) {
        const t = chip.dataset.text || chip.textContent.trim();
        chip.classList.toggle('cm-highlight-chip--used', usedTexts.has(t));
      });
    }

    // ── Attach listeners to existing saved cards ──────────────────────────────

    document.querySelectorAll('.cm-seed-card[data-seed-id]').forEach(function(card) {
      attachCardListeners(card);
      attachRemoveListener(card);
      attachAddBulletListener(card);
    });

    // ── Attach listeners to the initial unsaved card (if present) ─────────────

    const unsavedCard = document.querySelector('.cm-seed-card--unsaved');
    if (unsavedCard) {
      attachCardListeners(unsavedCard);
      attachAddBulletListener(unsavedCard);
    }

    // ── Initial "used" pass: scan existing seed bullets so chips matching ─────
    //    saved content stay dimmed across refreshes.
    refreshUsedChips();

    // ── Add a new seed ────────────────────────────────────────────────────────

    document.getElementById('cm-add-seed-btn').addEventListener('click', async function() {
      const sortOrder = document.querySelectorAll('.cm-seed-card').length;
      try {
        const res = await fetch('/api/seed-packets/seeds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: 'New seed', description: '', bullets: [], sortOrder }),
        });
        const seed = await res.json();
        const card = buildCard(seed);
        document.getElementById('cm-seed-list').appendChild(card);
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const nameInput = card.querySelector('.cm-seed-name-input');
        nameInput.focus();
        nameInput.select();
      } catch(e) {}
    });

    function buildCard(seed) {
      const div = document.createElement('div');
      div.className = 'cm-seed-card';
      div.dataset.seedId = String(seed.id);
      div.dataset.sortOrder = String(seed.sort_order || 0);
      const bullets = Array.isArray(seed.bullets) ? seed.bullets : [];
      div.innerHTML = `
        <input type="text" class="cm-seed-name-input" value="${escHtml(seed.name || '')}" placeholder="Name this seed...">
        <textarea class="cm-seed-desc" rows="3" placeholder="What's this seed about? In your own words.">${escHtml(seed.description || '')}</textarea>
        <p class="cm-seed-bullets-label">Notes, examples, details (optional)</p>
        <div class="cm-seed-bullets">${bullets.map(function(b) {
          return '<div class="cm-seed-bullet-row">'
            + '<input type="text" class="cm-seed-bullet-input" value="' + escHtml(b) + '" placeholder="Add a note...">'
            + '<button type="button" class="cm-seed-bullet-remove">×</button>'
            + '</div>';
        }).join('')}</div>
        <button type="button" class="cm-seed-add-bullet">+ Add note</button>
        <button type="button" class="cm-seed-remove">× Remove seed</button>
      `;
      attachCardListeners(div);
      attachRemoveListener(div);
      attachAddBulletListener(div);
      return div;
    }
  </script>
</body>
</html>
