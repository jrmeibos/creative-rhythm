<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/onboarding.css">
</head>
<body class="ob-body">

  <% if (typeof adminPreview !== 'undefined' && adminPreview) { %>
    <div class="ob-preview-banner">
      Admin preview — students won't see this bar. Nothing you do here is saved.
      <a href="/dashboard">Exit preview →</a>
    </div>
  <% } %>

  <!-- Progress bar -->
  <div class="ob-progress" id="ob-progress">
    <div class="ob-progress-inner">
      <% for (let i = 1; i <= 4; i++) { %>
        <div class="ob-dot <%= i === 1 ? 'is-active' : '' %>" id="ob-dot-<%= i %>">
          <span class="ob-dot-num"><%= i %></span>
        </div>
        <% if (i < 4) { %><div class="ob-progress-line" id="ob-line-<%= i %>"></div><% } %>
      <% } %>
    </div>
  </div>

  <!-- ── Step 1: Welcome ───────────────────────────────────────────────── -->
  <div class="ob-step is-active" id="step-1">
    <div class="ob-center">
      <h1 class="ob-title ob-title--hero">Welcome to<br>The Creative's Garden.</h1>
      <div class="ob-body-text ob-welcome-body">
        <p>Before we start this three-week challenge, let's take a snapshot of where you are right now.</p>
        <p>You'll answer a short self-assessment. At the end of the challenge, we'll return to it.<br>The before and after will help tell your story.</p>
      </div>

      <button class="ob-btn ob-btn--primary" onclick="goToStep(2)">Let's begin →</button>
    </div>
  </div>

  <!-- ── Step 2: Self-Assessment ───────────────────────────────────────── -->
  <div class="ob-step" id="step-2">
    <div class="ob-content">
      <h2 class="ob-title">Where are you right now?</h2>
      <p class="ob-subtitle">There are no right answers. Honest is the point.<br>You'll return to these questions at the end of the course — and see how much has shifted.</p>

      <div class="ob-questions">

        <% questions.forEach(function(q, idx) { %>
          <div class="ob-question" id="q-block-<%= q.id %>">
            <div class="ob-q-num">0<%= idx + 1 %></div>
            <p class="ob-q-text"><%= q.text %></p>

            <% if (q.type === 'choice' || q.type === 'multi') { %>
              <% if (q.type === 'multi') { %>
                <p class="ob-multi-note">Choose up to <%= q.max %></p>
              <% } %>
              <div class="ob-choices">
                <% q.choices.forEach(function(c) { %>
                  <button type="button"
                    class="ob-choice <%= q.type === 'multi' ? 'ob-multi' : '' %>"
                    data-group="<%= q.field %>"
                    data-value="<%= c.val %>">
                    <span class="ob-choice-val"><%= c.val %></span>
                    <span class="ob-choice-label"><%= c.label %></span>
                  </button>
                <% }); %>
              </div>

            <% } else if (q.type === 'rating') { %>
              <p class="ob-rating-scale"><span><%= q.low %></span><span><%= q.high %></span></p>
              <div class="ob-rating-row">
                <% for (let i = 1; i <= 10; i++) { %>
                  <button type="button" class="ob-rating-btn"
                    data-group="<%= q.field %>" data-value="<%= i %>">
                    <%= i %>
                  </button>
                <% } %>
              </div>

            <% } else if (q.type === 'text') { %>
              <textarea class="ob-textarea" data-field="<%= q.field %>"
                        rows="4" placeholder="<%= q.placeholder %>"></textarea>
            <% } %>
          </div>
        <% }); %>

      </div>

      <p class="ob-error" id="assess-error" hidden>Please answer all questions before continuing.</p>
      <div class="ob-actions">
        <button class="ob-btn ob-btn--primary" onclick="submitAssessment()">Continue →</button>
      </div>
    </div>
  </div>

  <!-- ── Step 3: Mailing address (optional) ────────────────────────────── -->
  <div class="ob-step" id="step-3">
    <div class="ob-content">
      <h2 class="ob-title">What's your mailing address?</h2>
      <p class="ob-subtitle">As a lover of snail mail, I'd love to send you a little something to thank you for being here. This is completely optional, and you can always add it later in your profile.</p>

      <div class="ob-address-form">
        <label class="ob-field">
          <span class="ob-field-label">Full name <span class="ob-field-hint">(for the envelope)</span></span>
          <input type="text" class="ob-input" id="addr-name" autocomplete="name" maxlength="120">
        </label>
        <label class="ob-field">
          <span class="ob-field-label">Street address</span>
          <input type="text" class="ob-input" id="addr-street" autocomplete="address-line1" maxlength="200">
        </label>
        <label class="ob-field">
          <span class="ob-field-label">Apt / unit <span class="ob-field-hint">(optional)</span></span>
          <input type="text" class="ob-input" id="addr-unit" autocomplete="address-line2" maxlength="80">
        </label>
        <div class="ob-field-row">
          <label class="ob-field">
            <span class="ob-field-label">City</span>
            <input type="text" class="ob-input" id="addr-city" autocomplete="address-level2" maxlength="120">
          </label>
          <label class="ob-field">
            <span class="ob-field-label">State / province</span>
            <input type="text" class="ob-input" id="addr-state" autocomplete="address-level1" maxlength="120">
          </label>
        </div>
        <div class="ob-field-row">
          <label class="ob-field">
            <span class="ob-field-label">ZIP / postal code</span>
            <input type="text" class="ob-input" id="addr-zip" autocomplete="postal-code" maxlength="40">
          </label>
          <label class="ob-field">
            <span class="ob-field-label">Country</span>
            <input type="text" class="ob-input" id="addr-country" autocomplete="country-name" maxlength="120">
          </label>
        </div>
      </div>

      <p class="ob-error" id="addr-error" hidden>Couldn't save that — you can add it later in your profile.</p>
      <div class="ob-actions ob-actions--split">
        <button class="ob-btn ob-btn--ghost" type="button" onclick="skipAddress()">Skip for now</button>
        <button class="ob-btn ob-btn--primary" type="button" id="addr-save-btn" onclick="saveAddress()">Save &amp; continue →</button>
      </div>
    </div>
  </div>

  <!-- ── Step 4: Done ───────────────────────────────────────────────────── -->
  <div class="ob-step" id="step-4">
    <div class="ob-center">
      <div class="ob-done-icon">🌿</div>
      <h2 class="ob-title ob-title--hero">Your snapshot is saved</h2>
      <p class="ob-body-text">Now, here's an introduction to your new practice: the daily talk-to-camera video. Here's what to do each day.</p>

      <!-- Daily-recording how-to. Facade: a crisp maxres poster + play button
           that swaps in the autoplay player on click — sharper than YouTube's
           default poster, and the player isn't loaded until it's asked for. -->
      <div class="ob-welcome-video">
        <button type="button" class="ob-video-facade"
                aria-label="Play: the daily recording practice"
                data-embed="https://www.youtube.com/embed/HEsdCWNT7bM?autoplay=1&rel=0"
                onclick="playOnboardingVideo(this)">
          <img src="https://i.ytimg.com/vi/HEsdCWNT7bM/maxresdefault.jpg" alt="" loading="lazy">
          <span class="ob-video-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </button>
      </div>

      <button class="ob-btn ob-btn--primary" id="enter-btn" onclick="completeOnboarding()">Enter the Garden</button>
    </div>
  </div>

  <script>
    let currentStep = 1;
    const assessmentData = {};

    // ── Step navigation ────────────────────────────────────────────────────
    const TOTAL_STEPS = 4;
    function goToStep(n) {
      document.getElementById(`step-${currentStep}`).classList.remove('is-active');
      document.getElementById(`step-${n}`).classList.add('is-active');
      for (let i = 1; i <= TOTAL_STEPS; i++) {
        const dot = document.getElementById(`ob-dot-${i}`);
        dot.classList.toggle('is-active', i === n);
        dot.classList.toggle('is-done', i < n);
      }
      for (let i = 1; i < TOTAL_STEPS; i++) {
        document.getElementById(`ob-line-${i}`).classList.toggle('is-done', i < n);
      }
      currentStep = n;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ── Mailing address (step 2) — optional ─────────────────────────────────
    function skipAddress() { goToStep(4); }

    async function saveAddress() {
      const btn = document.getElementById('addr-save-btn');
      const err = document.getElementById('addr-error');
      err.hidden = true;
      const payload = {
        mail_name:    document.getElementById('addr-name').value.trim(),
        mail_street:  document.getElementById('addr-street').value.trim(),
        mail_unit:    document.getElementById('addr-unit').value.trim(),
        mail_city:    document.getElementById('addr-city').value.trim(),
        mail_state:   document.getElementById('addr-state').value.trim(),
        mail_zip:     document.getElementById('addr-zip').value.trim(),
        mail_country: document.getElementById('addr-country').value.trim(),
      };
      // Everything's optional — if they left it all blank, just move on.
      const anything = Object.values(payload).some(v => v);
      if (!anything) { goToStep(4); return; }

      btn.disabled = true;
      btn.textContent = 'Saving…';
      try {
        const res = await fetch('/api/onboarding/address', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          goToStep(4);
        } else {
          err.hidden = false;
          btn.disabled = false;
          btn.textContent = 'Save & continue →';
        }
      } catch (_) {
        err.hidden = false;
        btn.disabled = false;
        btn.textContent = 'Save & continue →';
      }
    }

    // ── Choice buttons ──────────────────────────────────────────────────────
    document.querySelectorAll('.ob-choice:not(.ob-multi)').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.group;
        document.querySelectorAll(`.ob-choice[data-group="${group}"]`)
          .forEach(b => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        assessmentData[group] = btn.dataset.value;
      });
    });

    document.querySelectorAll('.ob-choice.ob-multi').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.group;
        const maxSel = 2;
        const selected = document.querySelectorAll(`.ob-choice[data-group="${group}"].is-selected`);
        if (btn.classList.contains('is-selected')) {
          btn.classList.remove('is-selected');
        } else if (selected.length < maxSel) {
          btn.classList.add('is-selected');
        }
        assessmentData[group] = [...document.querySelectorAll(`.ob-choice[data-group="${group}"].is-selected`)]
          .map(b => b.dataset.value).join(',');
      });
    });

    // ── Rating buttons ──────────────────────────────────────────────────────
    document.querySelectorAll('.ob-rating-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.group;
        document.querySelectorAll(`.ob-rating-btn[data-group="${group}"]`)
          .forEach(b => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        assessmentData[group] = parseInt(btn.dataset.value);
      });
    });

    // ── Text areas ──────────────────────────────────────────────────────────
    document.querySelectorAll('.ob-textarea').forEach(ta => {
      ta.addEventListener('input', () => {
        assessmentData[ta.dataset.field] = ta.value;
      });
    });

    // ── Validate & submit assessment ────────────────────────────────────────
    async function submitAssessment() {
      const errEl = document.getElementById('assess-error');
      errEl.hidden = true;

      const required = [
        'q1_choice','q2_rating','q3_choice','q4_rating',
        'q5_choice','q6_rating','q7_choices','q8_choice',
        'q9_text','q10_text'
      ];
      document.querySelectorAll('.ob-textarea').forEach(ta => {
        assessmentData[ta.dataset.field] = ta.value.trim();
      });

      for (const key of required) {
        const val = assessmentData[key];
        if (!val && val !== 0) {
          errEl.hidden = false;
          const fieldId = key.replace('_choice','').replace('_rating','').replace('_choices','').replace('_text','');
          document.getElementById(`q-block-${fieldId}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
      }

      try {
        const res = await fetch('/api/onboarding/assessment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(assessmentData)
        });
        if (res.ok) {
          goToStep(3);
        } else {
          errEl.textContent = 'Something went wrong. Please try again.';
          errEl.hidden = false;
        }
      } catch (_) {
        // Network failure — surface it instead of leaving the student stuck
        // on a silent no-op.
        errEl.textContent = 'Connection issue. Check your network and try again.';
        errEl.hidden = false;
      }
    }

    // ── Complete onboarding ─────────────────────────────────────────────────
    async function completeOnboarding() {
      const btn = document.getElementById('enter-btn');
      btn.disabled = true;
      btn.textContent = 'Starting…';
      const reset = () => { btn.disabled = false; btn.textContent = 'Enter the Garden'; };
      try {
        const res = await fetch('/api/onboarding/complete', { method: 'POST' });
        if (res.ok) {
          let dest = '/dashboard';
          try { const data = await res.json(); if (data && data.redirect) dest = data.redirect; } catch (_) {}
          window.location.href = dest;
        } else {
          reset();
        }
      } catch (_) {
        // Don't strand the student on a disabled "Starting…" button when the
        // network hiccups — re-enable so they can retry.
        reset();
      }
    }

    // ── Daily-recording video: crisp poster → load the player on click ───────
    function playOnboardingVideo(el) {
      const iframe = document.createElement('iframe');
      iframe.src = el.dataset.embed;
      iframe.title = 'The daily recording practice';
      iframe.setAttribute('frameborder', '0');
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceWith(iframe);
    }
  </script>

</body>
</html>
