<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/onboarding.css">
</head>
<body class="ob-body">

  <% if (typeof adminPreview !== 'undefined' && adminPreview) { %>
    <div class="ob-preview-banner">
      Admin preview — students won't see this bar. Nothing you do here is saved.
      <a href="/dashboard">Exit preview →</a>
    </div>
  <% } %>

  <!-- Progress bar -->
  <div class="ob-progress" id="ob-progress">
    <div class="ob-progress-inner">
      <% for (let i = 1; i <= 3; i++) { %>
        <div class="ob-dot <%= i === 1 ? 'is-active' : '' %>" id="ob-dot-<%= i %>">
          <span class="ob-dot-num"><%= i %></span>
        </div>
        <% if (i < 3) { %><div class="ob-progress-line" id="ob-line-<%= i %>"></div><% } %>
      <% } %>
    </div>
  </div>

  <!-- ── Step 1: Welcome ───────────────────────────────────────────────── -->
  <div class="ob-step is-active" id="step-1">
    <div class="ob-center">
      <h1 class="ob-title ob-title--hero">Welcome to<br>The Creative's Garden.</h1>
      <div class="ob-body-text ob-welcome-body">
        <p>Before we start this three-week challenge, let's take a snapshot of where you are right now.</p>
        <p>You'll answer a short self-assessment. At the end of the challenge, we'll return to it.<br>The before and after will help tell your story.</p>
      </div>

      <button class="ob-btn ob-btn--primary" onclick="goToStep(2)">Let's begin →</button>
    </div>
  </div>

  <!-- ── Step 2: Self-Assessment ───────────────────────────────────────── -->
  <div class="ob-step" id="step-2">
    <div class="ob-content">
      <h2 class="ob-title">Where are you right now?</h2>
      <p class="ob-subtitle">There are no right answers. Honest is the point.<br>You'll return to these questions at the end of the course — and see how much has shifted.</p>

      <div class="ob-questions">

        <% questions.forEach(function(q, idx) { %>
          <div class="ob-question" id="q-block-<%= q.id %>">
            <div class="ob-q-num">0<%= idx + 1 %></div>
            <p class="ob-q-text"><%= q.text %></p>

            <% if (q.type === 'choice' || q.type === 'multi') { %>
              <% if (q.type === 'multi') { %>
                <p class="ob-multi-note">Choose up to <%= q.max %></p>
              <% } %>
              <div class="ob-choices">
                <% q.choices.forEach(function(c) { %>
                  <button type="button"
                    class="ob-choice <%= q.type === 'multi' ? 'ob-multi' : '' %>"
                    data-group="<%= q.field %>"
                    data-value="<%= c.val %>">
                    <span class="ob-choice-val"><%= c.val %></span>
                    <span class="ob-choice-label"><%= c.label %></span>
                  </button>
                <% }); %>
              </div>

            <% } else if (q.type === 'rating') { %>
              <p class="ob-rating-scale"><span><%= q.low %></span><span><%= q.high %></span></p>
              <div class="ob-rating-row">
                <% for (let i = 1; i <= 10; i++) { %>
                  <button type="button" class="ob-rating-btn"
                    data-group="<%= q.field %>" data-value="<%= i %>">
                    <%= i %>
                  </button>
                <% } %>
              </div>

            <% } else if (q.type === 'text') { %>
              <textarea class="ob-textarea" data-field="<%= q.field %>"
                        rows="4" placeholder="<%= q.placeholder %>"></textarea>
            <% } %>
          </div>
        <% }); %>

      </div>

      <p class="ob-error" id="assess-error" hidden>Please answer all questions before continuing.</p>
      <div class="ob-actions">
        <button class="ob-btn ob-btn--primary" onclick="submitAssessment()">Continue →</button>
      </div>
    </div>
  </div>

  <!-- ── Step 3: Done ───────────────────────────────────────────────────── -->
  <div class="ob-step" id="step-3">
    <div class="ob-center">
      <div class="ob-done-icon">🌿</div>
      <h2 class="ob-title ob-title--hero">You're ready.<br>Let's begin.</h2>
      <p class="ob-body-text">Your snapshot is saved.<br>Now — let's start growing.</p>

      <!-- Welcome video: the daily-recording practice + how to log it. -->
      <div class="ob-welcome-video">
        <iframe
          src="https://www.youtube.com/embed/_eZRUVOSv4Q"
          title="Welcome — the daily recording practice"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>

      <button class="ob-btn ob-btn--primary" id="enter-btn" onclick="completeOnboarding()">Enter The Creative's Garden →</button>
    </div>
  </div>

  <script>
    let currentStep = 1;
    const assessmentData = {};

    // ── Step navigation ────────────────────────────────────────────────────
    function goToStep(n) {
      document.getElementById(`step-${currentStep}`).classList.remove('is-active');
      document.getElementById(`step-${n}`).classList.add('is-active');
      for (let i = 1; i <= 3; i++) {
        const dot = document.getElementById(`ob-dot-${i}`);
        dot.classList.toggle('is-active', i === n);
        dot.classList.toggle('is-done', i < n);
      }
      for (let i = 1; i <= 2; i++) {
        document.getElementById(`ob-line-${i}`).classList.toggle('is-done', i < n);
      }
      currentStep = n;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ── Choice buttons ──────────────────────────────────────────────────────
    document.querySelectorAll('.ob-choice:not(.ob-multi)').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.group;
        document.querySelectorAll(`.ob-choice[data-group="${group}"]`)
          .forEach(b => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        assessmentData[group] = btn.dataset.value;
      });
    });

    document.querySelectorAll('.ob-choice.ob-multi').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.group;
        const maxSel = 2;
        const selected = document.querySelectorAll(`.ob-choice[data-group="${group}"].is-selected`);
        if (btn.classList.contains('is-selected')) {
          btn.classList.remove('is-selected');
        } else if (selected.length < maxSel) {
          btn.classList.add('is-selected');
        }
        assessmentData[group] = [...document.querySelectorAll(`.ob-choice[data-group="${group}"].is-selected`)]
          .map(b => b.dataset.value).join(',');
      });
    });

    // ── Rating buttons ──────────────────────────────────────────────────────
    document.querySelectorAll('.ob-rating-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.group;
        document.querySelectorAll(`.ob-rating-btn[data-group="${group}"]`)
          .forEach(b => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        assessmentData[group] = parseInt(btn.dataset.value);
      });
    });

    // ── Text areas ──────────────────────────────────────────────────────────
    document.querySelectorAll('.ob-textarea').forEach(ta => {
      ta.addEventListener('input', () => {
        assessmentData[ta.dataset.field] = ta.value;
      });
    });

    // ── Validate & submit assessment ────────────────────────────────────────
    async function submitAssessment() {
      const errEl = document.getElementById('assess-error');
      errEl.hidden = true;

      const required = [
        'q1_choice','q2_rating','q3_choice','q4_rating',
        'q5_choice','q6_rating','q7_choices','q8_choice',
        'q9_text','q10_text'
      ];
      document.querySelectorAll('.ob-textarea').forEach(ta => {
        assessmentData[ta.dataset.field] = ta.value.trim();
      });

      for (const key of required) {
        const val = assessmentData[key];
        if (!val && val !== 0) {
          errEl.hidden = false;
          const fieldId = key.replace('_choice','').replace('_rating','').replace('_choices','').replace('_text','');
          document.getElementById(`q-block-${fieldId}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
      }

      try {
        const res = await fetch('/api/onboarding/assessment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(assessmentData)
        });
        if (res.ok) {
          goToStep(3);
        } else {
          errEl.textContent = 'Something went wrong. Please try again.';
          errEl.hidden = false;
        }
      } catch (_) {
        // Network failure — surface it instead of leaving the student stuck
        // on a silent no-op.
        errEl.textContent = 'Connection issue. Check your network and try again.';
        errEl.hidden = false;
      }
    }

    // ── Complete onboarding ─────────────────────────────────────────────────
    async function completeOnboarding() {
      const btn = document.getElementById('enter-btn');
      btn.disabled = true;
      btn.textContent = 'Starting…';
      const reset = () => { btn.disabled = false; btn.textContent = 'Enter The Creative\'s Garden →'; };
      try {
        const res = await fetch('/api/onboarding/complete', { method: 'POST' });
        if (res.ok) {
          let dest = '/dashboard';
          try { const data = await res.json(); if (data && data.redirect) dest = data.redirect; } catch (_) {}
          window.location.href = dest;
        } else {
          reset();
        }
      } catch (_) {
        // Don't strand the student on a disabled "Starting…" button when the
        // network hiccups — re-enable so they can retry.
        reset();
      }
    }
  </script>

</body>
</html>
