<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="app-body">

  <% if (user) { %>
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content">
      <div class="coming-soon">
        <div class="coming-soon-icon">—</div>
        <h1 class="coming-soon-title"><%= title || 'Something went wrong' %></h1>
        <p class="coming-soon-text"><%= message || 'An unexpected error occurred.' %></p>
        <a href="/dashboard" class="btn btn-secondary">← Back to dashboard</a>
      </div>
    </main>
  </div>
  <% } else { %>
  <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;background:var(--color-pearl);flex-direction:column;gap:1rem;font-family:'Jost',sans-serif;">
    <h1 style="font-family:var(--font-display);color:var(--color-bloem);font-size:2rem;font-weight:400;"><%= title || 'Error' %></h1>
    <p style="color:var(--color-ink-stained);opacity:0.7;"><%= message %></p>
    <a href="/" style="color:var(--color-bloem);">← Back to login</a>
  </div>
  <% } %>

</body>
</html>
