<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/curiosity-map.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content">

      <a href="/curiosity-map/<%= angle.id %>" class="cm-back-link">← Back to <%= angle.name %></a>

      <div class="cm-question-page">

        <p class="cm-question-display"><%= question.text %></p>

        <form action="/curiosity-map/<%= angle.id %>/<%= question.id %>" method="POST" class="cm-answer-form">
          <textarea
            name="answer_text"
            class="cm-answer-textarea"
            rows="10"
            placeholder="Take your time. No one else will read this."
          ><%= existingAnswer ? existingAnswer.answer_text : '' %></textarea>

          <div class="cm-answer-actions">
            <button type="submit" class="cm-save-btn">Save & return</button>
          </div>

          <p class="cm-answer-note">Your answer saves when you click Save. You can edit it anytime.</p>
        </form>

      </div>

    </main>
  </div>
</body>
</html>
