    async function deleteResource(id, title) {
      if (!confirm(`Delete "${title}"?`)) return;
      const res = await fetch(`/api/admin/resources/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) return alert(data.error);
      document.getElementById(`resource-row-${id}`)?.remove();
    }

    // ── Quotes ──────────────────────────────────────────────────────────────
    // One dialog handles both add and edit. editId === null => POST creates;
    // editId === <number> => PUT updates. Simpler than two near-identical
    // forms, and the JSON.stringify'd quote payload from openEditQuote means
    // the edit path doesn't have to look up the row by id.
    let editingQuoteId = null;

    function openAddQuote() {
      editingQuoteId = null;
      document.getElementById('quote-dialog-title').textContent = 'Add Quote';
      document.getElementById('quote-text').value = '';
      document.getElementById('quote-source').value = '';
      document.getElementById('quote-season').value = '';
      document.getElementById('quote-error').hidden = true;
      openDialog('dialog-quote');
    }

    function openEditQuote(q) {
      editingQuoteId = q.id;
      document.getElementById('quote-dialog-title').textContent = 'Edit Quote';
      document.getElementById('quote-text').value = q.text || '';
      document.getElementById('quote-source').value = q.source || '';
      document.getElementById('quote-season').value = q.season || '';
      document.getElementById('quote-error').hidden = true;
      openDialog('dialog-quote');
    }

    async function saveQuote() {
      const text   = document.getElementById('quote-text').value.trim();
      const source = document.getElementById('quote-source').value.trim();
      const season = document.getElementById('quote-season').value;
      const errEl  = document.getElementById('quote-error');
      if (!text) {
        errEl.textContent = 'Quote text is required.';
        errEl.hidden = false;
        return;
      }
      const url    = editingQuoteId ? `/api/admin/quotes/${editingQuoteId}` : '/api/admin/quotes';
      const method = editingQuoteId ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text, source, season }),
      });
      if (!res.ok) {
        const data = await res.json();
        errEl.textContent = data.error || 'Failed to save.';
        errEl.hidden = false;
        return;
      }
      // Cheap reload — keeps the list ordering rule in sync with the server
      // (any-season first, then by season, then by id) without rebuilding it
      // on the client.
      window.location.reload();
    }

    async function deleteQuote(id, text) {
      const preview = text.length > 60 ? text.slice(0, 60) + '…' : text;
      if (!confirm(`Delete "${preview}"?`)) return;
      const res = await fetch(`/api/admin/quotes/${id}`, { method: 'DELETE' });
      if (!res.ok) return alert('Failed to delete.');
      document.getElementById(`quote-row-${id}`)?.remove();
    }

    function buildResourceRow(id, title, category_tag, description, url) {
      const shortUrl = url && url.length > 40 ? url.slice(0, 40) + '…' : (url || '');
      const tagHtml = category_tag ? `<span class="admin-lesson-tag">${category_tag}</span>` : '';
      const descHtml = description ? `<span class="admin-resource-desc">${description}</span>` : '';
      const urlHtml = url ? `<a class="admin-resource-url" href="${url}" target="_blank" rel="noopener">${shortUrl}</a>` : '';
      return `
        <div class="admin-resource-row" id="resource-row-${id}">
          <div class="admin-resource-info">
            <span class="admin-resource-title">${title}</span>
            ${tagHtml}
            ${descHtml}
          </div>
          ${urlHtml}
          <div class="admin-row-actions">
            <button class="admin-btn-icon" type="button" title="Edit"
              onclick="openEditResource(${id})">✎</button>
            <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
              onclick="deleteResource(${id}, ${JSON.stringify(title)})">✕</button>
          </div>
        </div>`;
    }
  </script>

  <script>
    // Admin tabs: show one group of sections at a time. Sections are tagged
    // with data-tab; nothing is moved, so every existing dialog/handler still
    // works. The active tab is mirrored to the URL hash so a reload stays put.
    (function () {
      var tabs = Array.prototype.slice.call(document.querySelectorAll('.admin-tab'));
      var panels = Array.prototype.slice.call(document.querySelectorAll('section[data-tab]'));
      var valid = { overview: 1, cohorts: 1, people: 1, course: 1 };
      function show(tab) {
        if (!valid[tab]) tab = 'overview';
        tabs.forEach(function (t) { t.setAttribute('aria-current', t.dataset.tab === tab ? 'true' : 'false'); });
        panels.forEach(function (p) { p.hidden = (p.dataset.tab !== tab); });
        try { history.replaceState(null, '', '#' + tab); } catch (e) {}
      }
      tabs.forEach(function (t) {
        t.addEventListener('click', function () { show(t.dataset.tab); window.scrollTo({ top: 0 }); });
      });
      var init = (location.hash || '').replace('#', '');
      show(valid[init] ? init : 'overview');
    })();
  </script>

</body>
</html>
