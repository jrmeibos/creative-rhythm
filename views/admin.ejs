    // ── Lessons ──────────────────────────────────────────────────────────────
    function autoSlug(title) {
      const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      document.getElementById('add-lesson-slug').value = slug;
    }

    // ── Homework editor state ────────────────────────────────────────────────
    let editHomework = [];

    function renderHomeworkList() {
      const list = document.getElementById('edit-homework-list');
      if (!list) return;
      if (editHomework.length === 0) {
        list.innerHTML = '<p class="admin-form-hint" style="margin:0.25rem 0 0">No homework tasks yet.</p>';
        return;
      }
      list.innerHTML = editHomework.map((item, i) => `
        <div class="admin-hw-item" data-index="${i}">
          <div class="admin-hw-item-header">
            <span class="admin-hw-item-num">Task ${i + 1}</span>
            <div class="admin-hw-item-controls">
              <button type="button" class="admin-hw-move" onclick="moveHomework(${i}, -1)" ${i === 0 ? 'disabled' : ''}>↑</button>
              <button type="button" class="admin-hw-move" onclick="moveHomework(${i}, 1)" ${i === editHomework.length - 1 ? 'disabled' : ''}>↓</button>
              <button type="button" class="admin-hw-remove" onclick="removeHomework(${i})">✕</button>
            </div>
          </div>
          <textarea class="admin-input admin-textarea admin-hw-title" rows="2"
            placeholder="Task description (required)"
            oninput="editHomework[${i}].title = this.value">${escHtml(item.title)}</textarea>
          <div class="admin-hw-link-row">
            <input class="admin-input" type="text" placeholder="Link URL (optional)"
              value="${escHtml(item.link_url || '')}"
              oninput="editHomework[${i}].link_url = this.value; updateLinkLabel(${i})">
            <input class="admin-input" type="text" placeholder="Button label (default: Open link)"
              value="${escHtml(item.link_label || '')}"
              oninput="editHomework[${i}].link_label = this.value"
              id="hw-label-${i}">
          </div>
        </div>
      `).join('');
    }

    function escHtml(str) {
      return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function updateLinkLabel(i) {
      // no-op — label field is always visible, just a helper
    }

    function addHomeworkItem() {
      editHomework.push({ id: null, title: '', link_url: '', link_label: '' });
      renderHomeworkList();
      // Focus the new textarea
      const items = document.querySelectorAll('.admin-hw-title');
      if (items.length) items[items.length - 1].focus();
    }

    function removeHomework(i) {
      editHomework.splice(i, 1);
      renderHomeworkList();
    }

    function moveHomework(i, dir) {
      const j = i + dir;
      if (j < 0 || j >= editHomework.length) return;
      [editHomework[i], editHomework[j]] = [editHomework[j], editHomework[i]];
      renderHomeworkList();
    }

