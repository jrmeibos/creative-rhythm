<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="app-body">

  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">

      <header class="dash-header">
        <div class="dash-greeting">
          <h1 class="dash-greeting-text">Admin</h1>
          <p class="dash-week-label">Platform settings and management</p>
        </div>
      </header>

      <!-- ── Course Settings ──────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Course Settings</h2>
        </div>
        <div class="admin-card">
          <div class="admin-card-row">
            <div class="admin-field-group">
              <label class="admin-field-label" for="course-start-date">Course Start Date</label>
              <p class="admin-field-hint">The Monday that Week 1 begins. Auto-unlock dates calculate from this.</p>
              <div class="admin-field-input-row">
                <input type="date" id="course-start-date" class="admin-date-input"
                       value="<%= courseStartDate %>" aria-label="Course start date">
                <button class="admin-save-btn" id="save-start-date" type="button">Save</button>
                <span class="admin-save-status" id="start-date-status"></span>
              </div>
            </div>
          </div>

          <div class="admin-unlock-status-grid">
            <div class="admin-unlock-row">
              <div>
                <strong>Mid-course check-in</strong>
                <span class="admin-unlock-hint">Unlocks Week 6<% if (midcourseUnlockDate) { %> · <%= midcourseUnlockDate %><% } %></span>
                <span class="admin-unlock-hint"><%= midcourseSubmittedCount.done %> / <%= midcourseSubmittedCount.total %> students submitted</span>
              </div>
              <div style="display:flex;align-items:center;gap:0.6rem">
                <span class="admin-unlock-badge <%= midcourseUnlocked ? 'admin-unlock-badge--on' : 'admin-unlock-badge--off' %>">
                  <%= midcourseUnlocked ? '✓ Unlocked' : 'Locked' %>
                </span>
                <% if (midcourseSubmittedCount.done > 0) { %>
                  <button type="button" class="admin-btn-sm" onclick="viewAllMidcourseResponses()">View all responses</button>
                <% } %>
              </div>
            </div>
            <div class="admin-unlock-row">
              <div>
                <strong>Harvest (closing assessment)</strong>
                <span class="admin-unlock-hint">Unlocks Week 12<% if (closingUnlockDate) { %> · <%= closingUnlockDate %><% } %></span>
              </div>
              <span class="admin-unlock-badge <%= harvestUnlocked ? 'admin-unlock-badge--on' : 'admin-unlock-badge--off' %>">
                <%= harvestUnlocked ? '✓ Unlocked' : 'Locked' %>
              </span>
            </div>
          </div>
          <p class="admin-unlock-note">Both unlock automatically based on course start date. No manual action needed.</p>
        </div>
      </section>

      <!-- ── Time Travel ──────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-timetravel">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Time Travel <span class="admin-tt-label">⚠️ Testing Only</span></h2>
        </div>

        <div class="admin-card">
          <div class="admin-field-group">
            <label class="admin-field-label">Simulated date</label>
            <p class="admin-field-hint">
              <% if (simulatedToday) { %>
                Active — admin sees <strong><%= simulatedToday %></strong> for all unlock calculations. Students always see real time.
              <% } else { %>
                Not active — using real time.
              <% } %>
            </p>
          </div>
          <div class="admin-tt-row">
            <div class="admin-field-input-row">
              <input type="date" id="tt-date-input" class="admin-date-input" value="<%= simulatedToday || '' %>">
              <button class="admin-save-btn" type="button" onclick="setSimulatedDate()">Set date</button>
              <span class="admin-save-status" id="tt-status"></span>
            </div>
          </div>
          <div class="admin-tt-quick-btns">
            <span class="admin-field-hint" style="flex-shrink:0">Quick jumps:</span>
            <button class="admin-btn-sm" type="button" onclick="jumpToWeek(36)">Jump to Week 6</button>
            <button class="admin-btn-sm" type="button" onclick="jumpToWeek(50)">Jump to Week 8</button>
            <button class="admin-btn-sm" type="button" onclick="jumpToWeek(78)">Jump to Week 12</button>
            <button class="admin-btn-sm admin-btn-sm--danger" type="button" onclick="clearTimeTravel()">Return to real time</button>
          </div>
        </div>
      </section>

      <!-- ── Students ─────────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-students">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Gardeners</h2>
          <div class="admin-section-actions">
            <span class="admin-count" id="student-count">
              <%= users.filter(u => u.role === 'student').length %> enrolled
            </span>
            <button class="admin-add-btn" type="button" onclick="openDialog('dialog-add-student')">
              + Add Gardener
            </button>
          </div>
        </div>
        <div class="admin-card" id="student-list">
          <% for (const u of users) { %>
            <% const userStart = u.course_start_date ? String(u.course_start_date).slice(0, 10) : ''; %>
            <div class="admin-user-row" id="user-row-<%= u.id %>">
              <div class="sidebar-avatar" style="width:32px;height:32px;font-size:0.85rem;flex-shrink:0">
                <%= u.avatar_initial || u.name.charAt(0) %>
              </div>
              <div class="admin-user-info">
                <span class="admin-user-name"><%= u.name %></span>
                <span class="admin-user-email"><%= u.email %></span>
                <span class="admin-user-start-date">
                  <label for="user-start-<%= u.id %>" style="font-size:0.7rem;color:rgba(16,15,16,0.5);letter-spacing:0.08em;text-transform:uppercase;font-weight:600">Course start</label>
                  <input type="date" id="user-start-<%= u.id %>" class="admin-user-start-input"
                         value="<%= userStart %>"
                         data-user-id="<%= u.id %>"
                         title="<%= userStart ? '' : 'Blank = uses the global default' %>">
                  <% if (!userStart) { %>
                    <span class="admin-user-start-fallback" title="No override set; uses the global default course start date.">— uses default</span>
                  <% } %>
                </span>
              </div>
              <span class="admin-user-role <%= u.role === 'admin' ? 'admin-role--admin' : '' %>">
                <%= u.role === 'admin' ? 'Curator' : 'Gardener' %>
              </span>
              <% if (typeof u.course_length_weeks === 'number' && u.course_length_weeks < 12) { %>
                <span class="admin-lesson-tag" title="<%= u.course_length_weeks %>-week trial cohort">Trial · <%= u.course_length_weeks %>w</span>
              <% } %>
              <div class="admin-row-actions">
                <button class="admin-btn-icon" type="button" title="Edit"
                  onclick='openEditStudent(<%- JSON.stringify({ id: u.id, name: u.name, email: u.email, role: u.role, course_length_weeks: u.course_length_weeks || 12 }) %>)'>
                  ✎
                </button>
                <% if (u.id !== user.id) { %>
                  <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                    onclick="deleteUser(<%= u.id %>, <%= JSON.stringify(u.name) %>)">
                    ✕
                  </button>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </section>

      <!-- ── Lessons ──────────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-lessons">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Lessons</h2>
          <div class="admin-section-actions">
            <span class="admin-count"><%= lessons.length %> lesson<%= lessons.length !== 1 ? 's' : '' %></span>
            <button class="admin-add-btn" type="button" onclick="openDialog('dialog-add-lesson')">
              + Add Lesson
            </button>
          </div>
        </div>
        <div class="admin-card" id="lesson-list">
          <% for (let i = 0; i < lessons.length; i++) { %>
            <% const l = lessons[i]; %>
            <div class="admin-lesson-row" id="lesson-row-<%= l.id %>">
              <div class="admin-move-btns">
                <% if (i > 0) { %>
                  <button class="admin-move-btn" type="button" title="Move up"
                    onclick="moveLesson(<%= l.id %>, 'up')">↑</button>
                <% } else { %>
                  <span class="admin-move-btn admin-move-btn--ghost"></span>
                <% } %>
                <% if (i < lessons.length - 1) { %>
                  <button class="admin-move-btn" type="button" title="Move down"
                    onclick="moveLesson(<%= l.id %>, 'down')">↓</button>
                <% } else { %>
                  <span class="admin-move-btn admin-move-btn--ghost"></span>
                <% } %>
              </div>
              <div class="admin-lesson-info">
                <span class="admin-lesson-title"><%= l.title %></span>
                <% if (l.category_tag) { %>
                  <span class="admin-lesson-tag"><%= l.category_tag %></span>
                <% } %>
              </div>
              <span class="admin-lesson-count"><%= l.estimated_read_time %> min</span>
              <div class="admin-row-actions">
                <button class="admin-btn-icon" type="button" title="Edit"
                  onclick="openEditLesson(<%= l.id %>)">✎</button>
                <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                  onclick="deleteLesson(<%= l.id %>, <%= JSON.stringify(l.title) %>)">✕</button>
              </div>
            </div>
          <% } %>
          <% if (!lessons.length) { %>
            <p class="admin-empty">No lessons yet.</p>
          <% } %>
        </div>
      </section>

      <!-- ── Resources ────────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-resources">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Resources</h2>
          <div class="admin-section-actions">
            <span class="admin-count"><%= resources.length %> resource<%= resources.length !== 1 ? 's' : '' %></span>
            <button class="admin-add-btn" type="button" onclick="openDialog('dialog-add-resource')">
              + Add Resource
            </button>
          </div>
        </div>
        <div class="admin-card" id="resource-list">
          <% for (const r of resources) { %>
            <div class="admin-resource-row" id="resource-row-<%= r.id %>">
              <div class="admin-resource-info">
                <span class="admin-resource-title"><%= r.title %></span>
                <% if (r.category_tag) { %><span class="admin-lesson-tag"><%= r.category_tag %></span><% } %>
                <% if (r.description) { %>
                  <span class="admin-resource-desc"><%= r.description %></span>
                <% } %>
              </div>
              <% if (r.url) { %>
                <a class="admin-resource-url" href="<%= r.url %>" target="_blank" rel="noopener">
                  <%= r.url.length > 40 ? r.url.slice(0, 40) + '…' : r.url %>
                </a>
              <% } %>
              <div class="admin-row-actions">
                <button class="admin-btn-icon" type="button" title="Edit"
                  onclick="openEditResource(<%= r.id %>)">✎</button>
                <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                  onclick="deleteResource(<%= r.id %>, <%= JSON.stringify(r.title) %>)">✕</button>
              </div>
            </div>
          <% } %>
          <% if (!resources.length) { %>
            <p class="admin-empty">No resources yet.</p>
          <% } %>
        </div>
      </section>

      <!-- ── Quotes ───────────────────────────────────────────────────────── -->
      <%
        const SEASON_LABELS = { spring: 'Spring · Curiosity', summer: 'Summer · Create', autumn: 'Autumn · Share', winter: 'Winter · Connect' };
      %>
      <section class="dash-section" id="section-quotes">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Dashboard Quotes</h2>
          <div class="admin-section-actions">
            <span class="admin-count"><%= quotes.length %> quote<%= quotes.length !== 1 ? 's' : '' %></span>
            <button class="admin-add-btn" type="button" onclick="openAddQuote()">+ Add Quote</button>
          </div>
        </div>
        <div class="admin-card" id="quote-list">
          <p class="acct-section-subtitle" style="margin-bottom:1rem">
            Shown in the purple box on each student's dashboard. Each day, one quote is picked from the pool of
            <em>any-season</em> quotes plus the ones tagged with the student's current season.
          </p>
          <% for (const q of quotes) { %>
            <div class="admin-resource-row" id="quote-row-<%= q.id %>">
              <div class="admin-resource-info">
                <span class="admin-resource-title">"<%= q.text %>"</span>
                <% if (q.source) { %><span class="admin-resource-desc">— <%= q.source %></span><% } %>
              </div>
              <span class="admin-lesson-tag"><%= q.season ? SEASON_LABELS[q.season] : 'Any season' %></span>
              <div class="admin-row-actions">
                <button class="admin-btn-icon" type="button" title="Edit"
                  onclick='openEditQuote(<%- JSON.stringify(q) %>)'>✎</button>
                <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                  onclick="deleteQuote(<%= q.id %>, <%= JSON.stringify(q.text) %>)">✕</button>
              </div>
            </div>
          <% } %>
          <% if (!quotes.length) { %>
            <p class="admin-empty">No quotes yet. Add the first one above.</p>
          <% } %>
        </div>
      </section>

      <!-- ── Student Assessments ──────────────────────────────────────────── -->
      <section class="dash-section" id="section-assessments">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Gardener Assessments</h2>
        </div>
        <div class="admin-card" style="overflow:hidden">
          <table class="admin-assess-table">
            <thead>
              <tr>
                <th>Gardener</th>
                <th>Opening</th>
                <th>Goals</th>
                <th>Mid-course</th>
                <th>Closing</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% for (const s of studentAssessments) { %>
                <tr id="assess-row-<%= s.id %>">
                  <td class="assess-name-cell">
                    <div class="sidebar-avatar" style="width:28px;height:28px;font-size:0.75rem;flex-shrink:0;display:inline-flex">
                      <%= s.avatar_initial || s.name.charAt(0) %>
                    </div>
                    <%= s.name %>
                  </td>
                  <td>
                    <% if (s.opening_at) { %>
                      <span class="assess-status assess-status--done">✓ <%= new Date(s.opening_at).toLocaleDateString('en-US', {month:'short',day:'numeric'}) %></span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.goals_count >= 3) { %>
                      <span class="assess-status assess-status--done">✓ Planted</span>
                    <% } else if (s.goals_count > 0) { %>
                      <span class="assess-status assess-status--partial"><%= s.goals_count %>/3</span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.midcourse_at) { %>
                      <span class="assess-status assess-status--done">✓ <%= new Date(s.midcourse_at).toLocaleDateString('en-US', {month:'short',day:'numeric'}) %></span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.closing_at) { %>
                      <span class="assess-status assess-status--done">✓ <%= new Date(s.closing_at).toLocaleDateString('en-US', {month:'short',day:'numeric'}) %></span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <button class="admin-btn-icon" type="button" title="View responses"
                      onclick="viewStudentData(<%= s.id %>, <%= JSON.stringify(s.name) %>)">View</button>
                  </td>
                </tr>
              <% } %>
              <% if (!studentAssessments.length) { %>
                <tr><td colspan="6" class="admin-empty">No gardeners enrolled yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ── Lesson Completions ────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Lesson Completions</h2>
        </div>
        <div class="admin-card">
          <% for (const stat of lessonStats) { %>
            <div class="admin-lesson-row">
              <div class="admin-lesson-info">
                <span class="admin-lesson-title"><%= stat.title %></span>
              </div>
              <span class="admin-lesson-count"><%= stat.completion_count %> completed</span>
            </div>
          <% } %>
          <% if (!lessonStats.length) { %>
            <p class="admin-empty">No lessons found.</p>
          <% } %>
        </div>
      </section>

    </main>
  </div>

  <!-- ══ Dialogs ═══════════════════════════════════════════════════════════ -->

  <!-- Add Gardener -->
  <dialog class="admin-dialog" id="dialog-add-student">
    <h3 class="admin-dialog-title">Add Gardener</h3>
    <div class="admin-form-field">
      <label class="admin-form-label">Name</label>
      <input class="admin-input" type="text" id="add-student-name" placeholder="Full name" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Email</label>
      <input class="admin-input" type="email" id="add-student-email" placeholder="email@example.com" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Password</label>
      <input class="admin-input" type="password" id="add-student-password" placeholder="Temporary password">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Role</label>
      <select class="admin-input admin-select" id="add-student-role">
        <option value="student">Gardener</option>
        <option value="admin">Curator</option>
      </select>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Cohort</label>
      <select class="admin-input admin-select" id="add-student-length">
        <option value="12">Full course · 12 weeks</option>
        <option value="3">Trial · 3 weeks</option>
      </select>
    </div>
    <p class="admin-dialog-error" id="add-student-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-add-student')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitAddStudent()">Add Gardener</button>
    </div>
  </dialog>

  <!-- Edit Gardener -->
  <dialog class="admin-dialog" id="dialog-edit-student">
    <h3 class="admin-dialog-title">Edit Gardener</h3>
    <input type="hidden" id="edit-student-id">
    <div class="admin-form-field">
      <label class="admin-form-label">Name</label>
      <input class="admin-input" type="text" id="edit-student-name" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Email</label>
      <input class="admin-input" type="email" id="edit-student-email" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">New Password <span class="admin-form-hint">(leave blank to keep existing)</span></label>
      <input class="admin-input" type="password" id="edit-student-password" placeholder="Optional">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Role</label>
      <select class="admin-input admin-select" id="edit-student-role">
        <option value="student">Gardener</option>
        <option value="admin">Curator</option>
      </select>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Cohort</label>
      <select class="admin-input admin-select" id="edit-student-length">
        <option value="12">Full course · 12 weeks</option>
        <option value="3">Trial · 3 weeks</option>
      </select>
    </div>
    <p class="admin-dialog-error" id="edit-student-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-edit-student')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitEditStudent()">Save Changes</button>
    </div>
  </dialog>

  <!-- Add Lesson -->
  <dialog class="admin-dialog admin-dialog--wide" id="dialog-add-lesson">
    <h3 class="admin-dialog-title">Add Lesson</h3>
    <div class="admin-form-row">
      <div class="admin-form-field">
        <label class="admin-form-label">Title</label>
        <input class="admin-input" type="text" id="add-lesson-title" placeholder="Lesson title"
               oninput="autoSlug(this.value)">
      </div>
      <div class="admin-form-field">
        <label class="admin-form-label">Slug <span class="admin-form-hint">(URL identifier)</span></label>
        <input class="admin-input" type="text" id="add-lesson-slug" placeholder="lesson-url-slug">
      </div>
    </div>
    <div class="admin-form-row">
      <div class="admin-form-field">
        <label class="admin-form-label">Subtitle</label>
        <input class="admin-input" type="text" id="add-lesson-subtitle" placeholder="One-line tagline">
      </div>
      <div class="admin-form-field">
        <label class="admin-form-label">Category Tag</label>
        <input class="admin-input" type="text" id="add-lesson-category" placeholder="Mindset, Practical…">
      </div>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Est. Read Time <span class="admin-form-hint">(minutes)</span></label>
      <input class="admin-input admin-input--short" type="number" id="add-lesson-readtime" value="5" min="1">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Content <span class="admin-form-hint">(HTML accepted)</span></label>
      <textarea class="admin-input admin-textarea" id="add-lesson-content" rows="10"
                placeholder="<p>Lesson content here…</p>"></textarea>
    </div>
    <p class="admin-dialog-error" id="add-lesson-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-add-lesson')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitAddLesson()">Add Lesson</button>
    </div>
  </dialog>

  <!-- Edit Lesson -->
  <dialog class="admin-dialog admin-dialog--wide" id="dialog-edit-lesson">
    <h3 class="admin-dialog-title">Edit Lesson</h3>
    <input type="hidden" id="edit-lesson-id">
    <div class="admin-form-row">
      <div class="admin-form-field">
        <label class="admin-form-label">Title</label>
        <input class="admin-input" type="text" id="edit-lesson-title">
      </div>
      <div class="admin-form-field">
        <label class="admin-form-label">Subtitle</label>
        <input class="admin-input" type="text" id="edit-lesson-subtitle">
      </div>
    </div>
    <div class="admin-form-row">
      <div class="admin-form-field">
        <label class="admin-form-label">Category Tag</label>
        <input class="admin-input" type="text" id="edit-lesson-category">
      </div>
      <div class="admin-form-field">
        <label class="admin-form-label">Est. Read Time <span class="admin-form-hint">(minutes)</span></label>
        <input class="admin-input admin-input--short" type="number" id="edit-lesson-readtime" min="1">
      </div>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Video URL <span class="admin-form-hint">Paste a YouTube or Vimeo URL. Leave blank if no video.</span></label>
      <input class="admin-input" type="text" id="edit-lesson-video" placeholder="https://www.youtube.com/watch?v=...">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Content <span class="admin-form-hint">(HTML accepted)</span></label>
      <textarea class="admin-input admin-textarea" id="edit-lesson-content" rows="10"></textarea>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Homework</label>
      <div id="edit-homework-list"></div>
      <button class="admin-add-btn" type="button" onclick="addHomeworkItem()" style="margin-top:0.5rem">+ Add task</button>
    </div>
    <p class="admin-dialog-error" id="edit-lesson-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-edit-lesson')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitEditLesson()">Save Changes</button>
    </div>
  </dialog>

  <!-- Add Resource -->
  <dialog class="admin-dialog" id="dialog-add-resource">
    <h3 class="admin-dialog-title">Add Resource</h3>
    <div class="admin-form-field">
      <label class="admin-form-label">Title</label>
      <input class="admin-input" type="text" id="add-resource-title" placeholder="Resource title">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Description</label>
      <input class="admin-input" type="text" id="add-resource-desc" placeholder="Brief description">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Category</label>
      <input class="admin-input" type="text" id="add-resource-category" placeholder="e.g. Templates, Reading…">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">URL</label>
      <input class="admin-input" type="url" id="add-resource-url" placeholder="https://…">
    </div>
    <p class="admin-dialog-error" id="add-resource-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-add-resource')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitAddResource()">Add Resource</button>
    </div>
  </dialog>

  <!-- Edit Resource -->
  <dialog class="admin-dialog" id="dialog-edit-resource">
    <h3 class="admin-dialog-title">Edit Resource</h3>
    <input type="hidden" id="edit-resource-id">
    <div class="admin-form-field">
      <label class="admin-form-label">Title</label>
      <input class="admin-input" type="text" id="edit-resource-title">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Description</label>
      <input class="admin-input" type="text" id="edit-resource-desc">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Category</label>
      <input class="admin-input" type="text" id="edit-resource-category">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">URL</label>
      <input class="admin-input" type="url" id="edit-resource-url">
    </div>
    <p class="admin-dialog-error" id="edit-resource-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-edit-resource')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitEditResource()">Save Changes</button>
    </div>
  </dialog>

  <!-- View Gardener Assessment -->
  <dialog class="admin-dialog admin-dialog--wide" id="dialog-student-data">
    <h3 class="admin-dialog-title" id="student-data-title">Gardener Responses</h3>
    <div id="student-data-body" style="max-height:60vh;overflow-y:auto;font-size:0.85rem;font-weight:300;line-height:1.6"></div>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-student-data')">Close</button>
    </div>
  </dialog>

  <!-- Add / Edit Quote -->
  <dialog class="admin-dialog" id="dialog-quote">
    <h3 class="admin-dialog-title" id="quote-dialog-title">Add Quote</h3>
    <div class="admin-form-field">
      <label class="admin-form-label">Quote text</label>
      <textarea class="admin-textarea" id="quote-text" rows="3" placeholder="Visibility that feels like a return to self."></textarea>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Source <span style="color:rgba(16,15,16,0.4);font-weight:300">(optional)</span></label>
      <input class="admin-input" id="quote-source" type="text" placeholder="The Meibos Touch">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Season</label>
      <select class="admin-input" id="quote-season">
        <option value="">Any season (shown to everyone)</option>
        <option value="spring">Spring · Curiosity</option>
        <option value="summer">Summer · Create</option>
        <option value="autumn">Autumn · Share</option>
        <option value="winter">Winter · Connect</option>
      </select>
    </div>
    <p class="admin-dialog-error" id="quote-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-quote')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="saveQuote()">Save</button>
    </div>
  </dialog>

  <!-- All anonymous mid-course responses -->
  <dialog class="admin-dialog admin-dialog--wide" id="dialog-midcourse-all">
    <h3 class="admin-dialog-title">All Mid-course Responses</h3>
    <div id="midcourse-all-body" style="max-height:60vh;overflow-y:auto;font-size:0.85rem;font-weight:300;line-height:1.6"></div>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-midcourse-all')">Close</button>
    </div>
  </dialog>

  <script>
    // ── Lesson data for edit dialog ──────────────────────────────────────────
    const LESSON_DATA = {};
    <% for (const l of lessons) { %>
      LESSON_DATA[<%= l.id %>] = <%- JSON.stringify({
        title:               l.title,
        subtitle:            l.subtitle  || '',
        category_tag:        l.category_tag || '',
        content:             l.content   || '',
        estimated_read_time: l.estimated_read_time,
        video_url:           l.video_url || '',
        homework:            lessonHomework[l.id] || []
      }) %>;
    <% } %>

    // ── Resource data for edit dialog ────────────────────────────────────────
    const RESOURCE_DATA = {};
    <% for (const r of resources) { %>
      RESOURCE_DATA[<%= r.id %>] = <%- JSON.stringify({
        title:        r.title,
        description:  r.description  || '',
        category_tag: r.category_tag || '',
        url:          r.url          || ''
      }) %>;
    <% } %>

    // ── Dialog helpers ───────────────────────────────────────────────────────
    function openDialog(id) {
      document.getElementById(id).showModal();
    }
    function closeDialog(id) {
      const el = document.getElementById(id);
      el.close();
      el.querySelectorAll('input:not([type=hidden]),textarea,select').forEach(i => { i.value = ''; });
      el.querySelectorAll('.admin-dialog-error').forEach(e => { e.hidden = true; e.textContent = ''; });
    }
    function showError(id, msg) {
      const el = document.getElementById(id);
      el.textContent = msg;
      el.hidden = false;
    }


    // ── View student data ─────────────────────────────────────────────────────
    // Seed Packet angles are surfaced by the route once for the whole page so
    // the View dialog can join answers ↔ questions without a second fetch.
    const SEED_PACKET_ANGLES = <%- JSON.stringify(seedPacketAngles) %>;

    const esc = v => String(v == null ? '' : v)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    const fmtDate = iso => new Date(iso).toLocaleDateString('en-US',
      { month: 'short', day: 'numeric', year: 'numeric' });

    async function viewStudentData(id, name) {
      document.getElementById('student-data-title').textContent = name + ' — Responses';
      const body = document.getElementById('student-data-body');
      body.textContent = 'Loading…';
      openDialog('dialog-student-data');

      const res = await fetch(`/api/admin/student-data/${id}`);
      const data = await res.json();

      let html = '';

      // ─── Greenhouse goals ─────────────────────────────────────────────────
      if (data.goals && data.goals.length) {
        html += '<h4 style="font-weight:700;margin:0.75rem 0 0.5rem;color:var(--color-bloem)">Greenhouse Goals</h4>';
        for (const s of data.goals) {
          const status = s.status === 'replaced' ? ' <em style="color:#D4956A">(replaced)</em>' : '';
          const hasFacets = s.soil || s.seed || s.water || s.bloom;
          html += `<div style="margin-bottom:0.75rem"><strong>Bed ${s.seed_number}${status}:</strong>`;
          if (hasFacets) {
            html += '<div style="margin-left:1rem;margin-top:0.25rem">';
            html += `<div><strong>Soil:</strong> ${esc(s.soil)  || '—'}</div>`;
            html += `<div><strong>Seed:</strong> ${esc(s.seed)  || '—'}</div>`;
            html += `<div><strong>Water:</strong> ${esc(s.water) || '—'}</div>`;
            html += `<div><strong>Bloom:</strong> ${esc(s.bloom) || '—'}</div>`;
            html += '</div>';
          } else {
            html += ` ${esc(s.feeling) || '—'} / ${esc(s.looks_like) || '—'}`;
          }
          if (s.status === 'replaced' && (s.updated_feeling || s.updated_looks_like)) {
            html += `<br><span style="color:#D4956A">↳ New: ${esc(s.updated_feeling) || '—'} / ${esc(s.updated_looks_like) || '—'}</span>`;
          }
          html += '</div>';
        }
      }

      // ─── Seed Packet answers ──────────────────────────────────────────────
      // Group by angle using the SEED_PACKET_ANGLES catalog injected above.
      // Skip empty angles so the dialog only shows what the student actually
      // worked on.
      if (data.seedPacketAnswers && data.seedPacketAnswers.length) {
        const answerByQid = {};
        for (const a of data.seedPacketAnswers) answerByQid[a.question_id] = a;

        let sectionOpen = false;
        for (const angle of SEED_PACKET_ANGLES) {
          const answered = angle.questions.filter(q => answerByQid[q.id]);
          if (!answered.length) continue;
          if (!sectionOpen) {
            html += '<h4 style="font-weight:700;margin:1rem 0 0.5rem;color:var(--color-bloem)">Seed Packet Answers</h4>';
            sectionOpen = true;
          }
          html += `<div style="margin:0.5rem 0 0.75rem;padding-left:0.5rem;border-left:2px solid rgba(112,92,108,0.2)">`;
          html += `<div style="font-weight:700;color:var(--color-understory)">${esc(angle.name)}</div>`;
          for (const q of answered) {
            const ans = answerByQid[q.id];
            html += `<div style="margin:0.4rem 0">`;
            html += `<div style="font-style:italic;color:rgba(16,15,16,0.6)">${esc(q.text)}</div>`;
            html += `<div>${esc(ans.answer_text)}</div>`;
            html += `</div>`;
          }
          html += `</div>`;
        }
      }

      // ─── Seed Packet seeds (named seeds) ──────────────────────────────────
      if (data.seedPacketSeeds && data.seedPacketSeeds.length) {
        html += '<h4 style="font-weight:700;margin:1rem 0 0.5rem;color:var(--color-bloem)">Seed Packets — Your Seeds</h4>';
        for (const seed of data.seedPacketSeeds) {
          html += `<div style="margin-bottom:0.75rem;padding:0.6rem 0.75rem;background:rgba(112,92,108,0.05);border-radius:6px">`;
          html += `<div style="font-weight:700">${esc(seed.name) || '(untitled seed)'}</div>`;
          if (seed.description) html += `<div style="font-style:italic;color:rgba(16,15,16,0.6);margin-top:0.2rem">${esc(seed.description)}</div>`;
          if (seed.bullets && seed.bullets.length) {
            html += '<ul style="margin:0.4rem 0 0 1.2rem;padding:0">';
            for (const b of seed.bullets) html += `<li>${esc(b)}</li>`;
            html += '</ul>';
          }
          if (seed.application) {
            html += `<div style="margin-top:0.4rem"><strong>How it shows up:</strong> ${esc(seed.application)}</div>`;
          }
          html += `</div>`;
        }
      }

      // ─── Opening assessment ───────────────────────────────────────────────
      if (data.opening) {
        html += '<h4 style="font-weight:700;margin:1rem 0 0.5rem;color:var(--color-bloem)">Opening Assessment</h4>';
        const q = data.opening;
        html += `<p>Q1: ${esc(q.q1_choice)} | Q2: ${q.q2_rating}/10 | Q3: ${esc(q.q3_choice)} | Q4: ${q.q4_rating}/10</p>`;
        html += `<p>Q5: ${esc(q.q5_choice)} | Q6: ${q.q6_rating}/10</p>`;
        if (q.q9_text)  html += `<p><em>Vision:</em> ${esc(q.q9_text)}</p>`;
        if (q.q10_text) html += `<p><em>Promise:</em> ${esc(q.q10_text)}</p>`;
      }

      // ─── Mid-course check-in (per-student: only the submission flag) ──────
      if (data.midcourseSubmittedAt) {
        html += `<h4 style="font-weight:700;margin:1rem 0 0.5rem;color:var(--color-understory)">Mid-course Check-in ✓</h4>`;
        html += `<p style="color:rgba(16,15,16,0.5)">Submitted on ${fmtDate(data.midcourseSubmittedAt)}</p>`;
        html += `<p style="color:rgba(16,15,16,0.5);font-size:0.78rem;font-style:italic">Responses are stored anonymously — view all of them via "All mid-course responses" on the main admin page.</p>`;
      }

      // ─── Closing assessment ───────────────────────────────────────────────
      if (data.closing) {
        html += '<h4 style="font-weight:700;margin:1rem 0 0.5rem;color:var(--color-understory)">Closing Assessment</h4>';
        const q = data.closing;
        const ratingDiff = (field) => {
          if (!data.opening) return '';
          const diff = (q[field] || 0) - (data.opening[field] || 0);
          if (diff > 0) return ` <span style="color:var(--color-understory)">↑${diff}</span>`;
          if (diff < 0) return ` <span style="color:#D4956A">↓${Math.abs(diff)}</span>`;
          return ' →';
        };
        html += `<p>Q1: ${esc(q.q1_choice)} | Q2: ${q.q2_rating}/10${ratingDiff('q2_rating')} | Q3: ${esc(q.q3_choice)} | Q4: ${q.q4_rating}/10${ratingDiff('q4_rating')}</p>`;
        html += `<p>Q5: ${esc(q.q5_choice)} | Q6: ${q.q6_rating}/10${ratingDiff('q6_rating')}</p>`;
        if (q.q7_choices) html += `<p><em>What surprised them:</em> ${esc(q.q7_choices)}</p>`;
        if (q.q8_choice)  html += `<p><em>Season they spent most time in:</em> ${esc(q.q8_choice)}</p>`;
        if (q.q9_text)    html += `<p><em>Showing up feels like:</em> ${esc(q.q9_text)}</p>`;
        if (q.q10_text)   html += `<p><em>Will keep doing:</em> ${esc(q.q10_text)}</p>`;
        if (q.q11_text)   html += `<p><em>To someone starting out:</em> ${esc(q.q11_text)}</p>`;
        if (q.q12_text)   html += `<p><em>Feedback:</em> ${esc(q.q12_text)}</p>`;
      }

      // ─── Cuttings (daily reflections) ─────────────────────────────────────
      // Collapsed by default — a 12-week course can produce 80+ entries and
      // we don't want them dominating the dialog.
      if (data.cuttings && data.cuttings.length) {
        html += '<h4 style="font-weight:700;margin:1rem 0 0.5rem;color:var(--color-bloem)">Cuttings (Daily Reflections)</h4>';
        html += `<details><summary style="cursor:pointer;color:rgba(16,15,16,0.6)">Show ${data.cuttings.length} entr${data.cuttings.length === 1 ? 'y' : 'ies'}</summary>`;
        for (const c of data.cuttings) {
          html += `<div style="margin:0.6rem 0;padding:0.5rem 0.7rem;background:rgba(112,92,108,0.04);border-radius:6px">`;
          html += `<div style="font-weight:700;color:var(--color-bloem)">${fmtDate(c.recorded_date)}${c.season ? ' · <span style="font-weight:300;color:rgba(16,15,16,0.5)">' + esc(c.season) + '</span>' : ''}</div>`;
          if (c.prompt)          html += `<div style="font-style:italic;color:rgba(16,15,16,0.55);font-size:0.8rem;margin-top:0.2rem">${esc(c.prompt)}</div>`;
          if (c.reflection_text) html += `<div style="margin-top:0.3rem">${esc(c.reflection_text)}</div>`;
          if (c.talked_about)    html += `<div style="margin-top:0.3rem"><strong>Talked about:</strong> ${esc(c.talked_about)}</div>`;
          if (c.how_it_felt)     html += `<div><strong>How it felt:</strong> ${esc(c.how_it_felt)}</div>`;
          if (c.takeaway)        html += `<div><strong>Takeaway:</strong> ${esc(c.takeaway)}</div>`;
          html += `</div>`;
        }
        html += `</details>`;
      }

      body.innerHTML = html || '<p>No data yet.</p>';
    }

    // ── All mid-course responses (aggregate, anonymous) ──────────────────────
    async function viewAllMidcourseResponses() {
      const body = document.getElementById('midcourse-all-body');
      body.textContent = 'Loading…';
      openDialog('dialog-midcourse-all');

      const res = await fetch('/api/admin/midcourse-responses');
      const data = await res.json();
      const rows = (data && data.responses) || [];

      if (!rows.length) {
        body.innerHTML = '<p>No mid-course responses yet.</p>';
        return;
      }

      let html = `<p style="color:rgba(16,15,16,0.55);font-size:0.82rem;font-style:italic;margin:0 0 1rem">Stored anonymously — no link to student identity. Shown in submission order.</p>`;
      let i = 1;
      for (const r of rows) {
        html += `<div style="margin-bottom:1rem;padding:0.75rem 0.9rem;background:rgba(112,92,108,0.05);border-radius:8px">`;
        html += `<div style="font-weight:700;color:var(--color-bloem)">Response #${i++} <span style="font-weight:300;color:rgba(16,15,16,0.5);font-size:0.8rem">· submitted ${esc(r.submitted_at_day)}</span></div>`;
        if (r.q1_rating != null) html += `<div style="margin-top:0.3rem"><strong>How it's going (1–10):</strong> ${r.q1_rating}</div>`;
        if (r.q2_working)        html += `<div><strong>What's working:</strong> ${esc(r.q2_working)}</div>`;
        if (r.q3_resistance)     html += `<div><strong>Where there's resistance:</strong> ${esc(r.q3_resistance)}</div>`;
        if (r.q4_improvement)    html += `<div><strong>What could change:</strong> ${esc(r.q4_improvement)}</div>`;
        if (r.q5_other)          html += `<div><strong>Anything else:</strong> ${esc(r.q5_other)}</div>`;
        html += `</div>`;
      }
      body.innerHTML = html;
    }

    // ── Manual unlock toggles ────────────────────────────────────────────────
    async function setFlag(key, value) {
      const res = await fetch('/api/admin/settings', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ key, value })
      });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Failed to update setting.');
      }
    }

    // ── Time Travel ──────────────────────────────────────────────────────────
    const TT_COURSE_START = '<%= courseStartDate %>';

    async function setSimulatedDate(dateStr) {
      const date = dateStr || document.getElementById('tt-date-input').value;
      if (!date) return;
      const status = document.getElementById('tt-status');
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'simulated_today', value: date })
      });
      if (res.ok) {
        status.textContent = 'Saved ✓';
        status.style.color = 'var(--color-understory)';
        setTimeout(() => location.reload(), 700);
      } else {
        status.textContent = 'Error saving';
        status.style.color = '#c0392b';
      }
    }

    function jumpToWeek(offsetDays) {
      if (!TT_COURSE_START) {
        alert('Set a course start date first.');
        return;
      }
      const start = new Date(TT_COURSE_START + 'T00:00:00');
      const target = new Date(start.getTime() + offsetDays * 86400000);
      const dateStr = target.toISOString().split('T')[0];
      document.getElementById('tt-date-input').value = dateStr;
      setSimulatedDate(dateStr);
    }

    async function clearTimeTravel() {
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'simulated_today', value: '' })
      });
      if (res.ok) location.reload();
    }

    // ── Course start date ────────────────────────────────────────────────────
    document.getElementById('save-start-date')?.addEventListener('click', async () => {
      const val    = document.getElementById('course-start-date').value;
      const status = document.getElementById('start-date-status');
      const res = await fetch('/api/admin/settings', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ key: 'course_start_date', value: val })
      });
      if (res.ok) {
        status.textContent = 'Saved ✓';
        status.style.color = 'var(--color-understory)';
      } else {
        status.textContent = 'Error saving';
        status.style.color = '#c0392b';
      }
      setTimeout(() => { status.textContent = ''; }, 2500);
    });

    // ── Students ─────────────────────────────────────────────────────────────
    function openEditStudent(u) {
      document.getElementById('edit-student-id').value   = u.id;
      document.getElementById('edit-student-name').value  = u.name;
      document.getElementById('edit-student-email').value = u.email;
      document.getElementById('edit-student-role').value  = u.role;
      document.getElementById('edit-student-length').value = String(u.course_length_weeks || 12);
      document.getElementById('edit-student-password').value = '';
      document.getElementById('edit-student-error').hidden = true;
      openDialog('dialog-edit-student');
    }

    async function submitAddStudent() {
      const name     = document.getElementById('add-student-name').value.trim();
      const email    = document.getElementById('add-student-email').value.trim();
      const password = document.getElementById('add-student-password').value;
      const role     = document.getElementById('add-student-role').value;
      const courseLengthWeeks = parseInt(document.getElementById('add-student-length').value, 10) || 12;
      if (!name || !email || !password) {
        return showError('add-student-error', 'Name, email, and password are required.');
      }
      const res = await fetch('/api/admin/users', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ name, email, password, role, course_length_weeks: courseLengthWeeks })
      });
      const data = await res.json();
      if (!res.ok) return showError('add-student-error', data.error);

      // Cheap full reload to keep the inline buildUserRow markup honest
      // — easier than threading the new Trial chip into the row builder.
      window.location.reload();
    }

    async function submitEditStudent() {
      const id       = parseInt(document.getElementById('edit-student-id').value);
      const name     = document.getElementById('edit-student-name').value.trim();
      const email    = document.getElementById('edit-student-email').value.trim();
      const password = document.getElementById('edit-student-password').value;
      const role     = document.getElementById('edit-student-role').value;
      const courseLengthWeeks = parseInt(document.getElementById('edit-student-length').value, 10) || 12;
      if (!name || !email) return showError('edit-student-error', 'Name and email are required.');

      const res = await fetch(`/api/admin/users/${id}`, {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ name, email, role, password: password || undefined, course_length_weeks: courseLengthWeeks })
      });
      const data = await res.json();
      if (!res.ok) return showError('edit-student-error', data.error);

      // Cohort toggle is visible in the row chip — easier to reload than
      // surgically swap the chip in place.
      window.location.reload();
      return;
    }

    async function deleteUser(id, name) {
      if (!confirm(`Delete ${name}? This removes their account and all their data.`)) return;
      const res = await fetch(`/api/admin/users/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) return alert(data.error);
      document.getElementById(`user-row-${id}`)?.remove();
      updateStudentCount(-1);
    }

    // Auto-save course start date on change. Empty value clears the override
    // and falls back to the global default (server stores NULL).
    document.querySelectorAll('.admin-user-start-input').forEach(input => {
      input.addEventListener('change', async () => {
        const id = input.dataset.userId;
        const date = input.value || null;
        input.disabled = true;
        try {
          const res = await fetch(`/api/admin/users/${id}/course-start-date`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ date }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Save failed');
          // Toggle the "uses default" hint based on whether a date is now set.
          const row = input.closest('.admin-user-row');
          const fallback = row.querySelector('.admin-user-start-fallback');
          if (date && fallback) fallback.remove();
          if (!date && !fallback) {
            const hint = document.createElement('span');
            hint.className = 'admin-user-start-fallback';
            hint.textContent = '— uses default';
            input.parentNode.appendChild(hint);
          }
        } catch (err) {
          alert(err.message);
        } finally {
          input.disabled = false;
        }
      });
    });

    function updateStudentCount(delta) {
      const el = document.getElementById('student-count');
      const n = parseInt(el.textContent) + delta;
      el.textContent = `${n} enrolled`;
    }

    function buildUserRow(u) {
      const initial = u.avatar_initial || u.name.charAt(0).toUpperCase();
      const roleLabel = u.role === 'admin' ? 'Curator' : 'Gardener';
      const roleClass = u.role === 'admin' ? 'admin-role--admin' : '';
      return `
        <div class="admin-user-row" id="user-row-${u.id}">
          <div class="sidebar-avatar" style="width:32px;height:32px;font-size:0.85rem;flex-shrink:0">
            ${initial}
          </div>
          <div class="admin-user-info">
            <span class="admin-user-name">${u.name}</span>
            <span class="admin-user-email">${u.email}</span>
          </div>
          <span class="admin-user-role ${roleClass}">${roleLabel}</span>
          <div class="admin-row-actions">
            <button class="admin-btn-icon" type="button" title="Edit"
              onclick="openEditStudent(${u.id}, ${JSON.stringify(u.name)}, ${JSON.stringify(u.email || '')}, ${JSON.stringify(u.role)})">✎</button>
            <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
              onclick="deleteUser(${u.id}, ${JSON.stringify(u.name)})">✕</button>
          </div>
        </div>`;
    }

    // ── Lessons ──────────────────────────────────────────────────────────────
    function autoSlug(title) {
      const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      document.getElementById('add-lesson-slug').value = slug;
    }

    // ── Homework editor state ────────────────────────────────────────────────
    let editHomework = [];

    function renderHomeworkList() {
      const list = document.getElementById('edit-homework-list');
      if (!list) return;
      if (editHomework.length === 0) {
        list.innerHTML = '<p class="admin-form-hint" style="margin:0.25rem 0 0">No homework tasks yet.</p>';
        return;
      }
      list.innerHTML = editHomework.map((item, i) => `
        <div class="admin-hw-item" data-index="${i}">
          <div class="admin-hw-item-header">
            <span class="admin-hw-item-num">Task ${i + 1}</span>
            <div class="admin-hw-item-controls">
              <button type="button" class="admin-hw-move" onclick="moveHomework(${i}, -1)" ${i === 0 ? 'disabled' : ''}>↑</button>
              <button type="button" class="admin-hw-move" onclick="moveHomework(${i}, 1)" ${i === editHomework.length - 1 ? 'disabled' : ''}>↓</button>
              <button type="button" class="admin-hw-remove" onclick="removeHomework(${i})">✕</button>
            </div>
          </div>
          <textarea class="admin-input admin-textarea admin-hw-title" rows="2"
            placeholder="Task description (required)"
            oninput="editHomework[${i}].title = this.value">${escHtml(item.title)}</textarea>
          <div class="admin-hw-link-row">
            <input class="admin-input" type="text" placeholder="Link URL (optional)"
              value="${escHtml(item.link_url || '')}"
              oninput="editHomework[${i}].link_url = this.value; updateLinkLabel(${i})">
            <input class="admin-input" type="text" placeholder="Button label (default: Open link)"
              value="${escHtml(item.link_label || '')}"
              oninput="editHomework[${i}].link_label = this.value"
              id="hw-label-${i}">
          </div>
        </div>
      `).join('');
    }

    function escHtml(str) {
      return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function updateLinkLabel(i) {
      // no-op — label field is always visible, just a helper
    }

    function addHomeworkItem() {
      editHomework.push({ id: null, title: '', link_url: '', link_label: '' });
      renderHomeworkList();
      // Focus the new textarea
      const items = document.querySelectorAll('.admin-hw-title');
      if (items.length) items[items.length - 1].focus();
    }

    function removeHomework(i) {
      editHomework.splice(i, 1);
      renderHomeworkList();
    }

    function moveHomework(i, dir) {
      const j = i + dir;
      if (j < 0 || j >= editHomework.length) return;
      [editHomework[i], editHomework[j]] = [editHomework[j], editHomework[i]];
      renderHomeworkList();
    }

    function openEditLesson(id) {
      const l = LESSON_DATA[id];
      if (!l) return;
      document.getElementById('edit-lesson-id').value       = id;
      document.getElementById('edit-lesson-title').value    = l.title;
      document.getElementById('edit-lesson-subtitle').value = l.subtitle;
      document.getElementById('edit-lesson-category').value = l.category_tag;
      document.getElementById('edit-lesson-readtime').value = l.estimated_read_time;
      document.getElementById('edit-lesson-video').value    = l.video_url || '';
      document.getElementById('edit-lesson-content').value  = l.content;
      document.getElementById('edit-lesson-error').hidden   = true;
      editHomework = (l.homework || []).map(h => ({ id: h.id, title: h.title || '', link_url: h.link_url || '', link_label: h.link_label || '' }));
      renderHomeworkList();
      openDialog('dialog-edit-lesson');
    }

    async function submitAddLesson() {
      const title    = document.getElementById('add-lesson-title').value.trim();
      const slug     = document.getElementById('add-lesson-slug').value.trim();
      const subtitle = document.getElementById('add-lesson-subtitle').value.trim();
      const category_tag = document.getElementById('add-lesson-category').value.trim();
      const estimated_read_time = parseInt(document.getElementById('add-lesson-readtime').value) || 5;
      const content  = document.getElementById('add-lesson-content').value;
      if (!title || !slug) return showError('add-lesson-error', 'Title and slug are required.');

      const res = await fetch('/api/admin/lessons', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ slug, title, subtitle, category_tag, content, estimated_read_time })
      });
      const data = await res.json();
      if (!res.ok) return showError('add-lesson-error', data.error);
      closeDialog('dialog-add-lesson');
      window.location.reload();
    }

    async function submitEditLesson() {
      const id       = parseInt(document.getElementById('edit-lesson-id').value);
      const title    = document.getElementById('edit-lesson-title').value.trim();
      const subtitle = document.getElementById('edit-lesson-subtitle').value.trim();
      const category_tag = document.getElementById('edit-lesson-category').value.trim();
      const estimated_read_time = parseInt(document.getElementById('edit-lesson-readtime').value) || 5;
      const video_url = document.getElementById('edit-lesson-video').value.trim();
      const content  = document.getElementById('edit-lesson-content').value;
      if (!title) return showError('edit-lesson-error', 'Title is required.');

      // Collect current homework values from DOM
      const homeworkItems = editHomework.map(h => ({
        id: h.id || undefined,
        title: h.title,
        link_url: h.link_url || null,
        link_label: h.link_label || null
      }));

      const res = await fetch(`/api/admin/lessons/${id}`, {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ title, subtitle, category_tag, content, estimated_read_time, video_url, homework: homeworkItems })
      });
      const data = await res.json();
      if (!res.ok) return showError('edit-lesson-error', data.error);

      const row = document.getElementById(`lesson-row-${id}`);
      if (row) {
        row.querySelector('.admin-lesson-title').textContent = title;
        row.querySelector('.admin-lesson-count').textContent = `${estimated_read_time} min`;
        const tagEl = row.querySelector('.admin-lesson-tag');
        if (tagEl) tagEl.textContent = category_tag;
      }
      LESSON_DATA[id] = { title, subtitle, category_tag, content, estimated_read_time, video_url, homework: editHomework };
      closeDialog('dialog-edit-lesson');
    }

    async function deleteLesson(id, title) {
      if (!confirm(`Delete "${title}"? This also removes all gardener completion records for this lesson.`)) return;
      const res = await fetch(`/api/admin/lessons/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) return alert(data.error);
      document.getElementById(`lesson-row-${id}`)?.remove();
    }

    async function moveLesson(id, direction) {
      const res = await fetch(`/api/admin/lessons/${id}/move`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ direction })
      });
      if (res.ok) window.location.reload();
    }

    // ── Resources ────────────────────────────────────────────────────────────
    function openEditResource(id) {
      const r = RESOURCE_DATA[id];
      if (!r) return;
      document.getElementById('edit-resource-id').value       = id;
      document.getElementById('edit-resource-title').value    = r.title;
      document.getElementById('edit-resource-desc').value     = r.description;
      document.getElementById('edit-resource-category').value = r.category_tag;
      document.getElementById('edit-resource-url').value      = r.url;
      document.getElementById('edit-resource-error').hidden   = true;
      openDialog('dialog-edit-resource');
    }

    async function submitAddResource() {
      const title       = document.getElementById('add-resource-title').value.trim();
      const description = document.getElementById('add-resource-desc').value.trim();
      const category_tag = document.getElementById('add-resource-category').value.trim();
      const url         = document.getElementById('add-resource-url').value.trim();
      if (!title) return showError('add-resource-error', 'Title is required.');

      const res = await fetch('/api/admin/resources', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ title, description, category_tag, url })
      });
      const data = await res.json();
      if (!res.ok) return showError('add-resource-error', data.error);

      const id = data.id;
      RESOURCE_DATA[id] = { title, description, category_tag, url };
      document.getElementById('resource-list').insertAdjacentHTML('beforeend', buildResourceRow(id, title, category_tag, description, url));
      closeDialog('dialog-add-resource');
    }

    async function submitEditResource() {
      const id          = parseInt(document.getElementById('edit-resource-id').value);
      const title       = document.getElementById('edit-resource-title').value.trim();
      const description = document.getElementById('edit-resource-desc').value.trim();
      const category_tag = document.getElementById('edit-resource-category').value.trim();
      const url         = document.getElementById('edit-resource-url').value.trim();
      if (!title) return showError('edit-resource-error', 'Title is required.');

      const res = await fetch(`/api/admin/resources/${id}`, {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ title, description, category_tag, url })
      });
      const data = await res.json();
      if (!res.ok) return showError('edit-resource-error', data.error);

      const row = document.getElementById(`resource-row-${id}`);
      if (row) {
        row.querySelector('.admin-resource-title').textContent = title;
        const tagEl = row.querySelector('.admin-lesson-tag');
        if (tagEl) tagEl.textContent = category_tag;
        const descEl = row.querySelector('.admin-resource-desc');
        if (descEl) descEl.textContent = description;
        const urlEl = row.querySelector('.admin-resource-url');
        if (urlEl) { urlEl.textContent = url.length > 40 ? url.slice(0, 40) + '…' : url; urlEl.href = url; }
      }
      RESOURCE_DATA[id] = { title, description, category_tag, url };
      closeDialog('dialog-edit-resource');
    }

    async function deleteResource(id, title) {
      if (!confirm(`Delete "${title}"?`)) return;
      const res = await fetch(`/api/admin/resources/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) return alert(data.error);
      document.getElementById(`resource-row-${id}`)?.remove();
    }

    // ── Quotes ──────────────────────────────────────────────────────────────
    // One dialog handles both add and edit. editId === null => POST creates;
    // editId === <number> => PUT updates. Simpler than two near-identical
    // forms, and the JSON.stringify'd quote payload from openEditQuote means
    // the edit path doesn't have to look up the row by id.
    let editingQuoteId = null;

    function openAddQuote() {
      editingQuoteId = null;
      document.getElementById('quote-dialog-title').textContent = 'Add Quote';
      document.getElementById('quote-text').value = '';
      document.getElementById('quote-source').value = '';
      document.getElementById('quote-season').value = '';
      document.getElementById('quote-error').hidden = true;
      openDialog('dialog-quote');
    }

    function openEditQuote(q) {
      editingQuoteId = q.id;
      document.getElementById('quote-dialog-title').textContent = 'Edit Quote';
      document.getElementById('quote-text').value = q.text || '';
      document.getElementById('quote-source').value = q.source || '';
      document.getElementById('quote-season').value = q.season || '';
      document.getElementById('quote-error').hidden = true;
      openDialog('dialog-quote');
    }

    async function saveQuote() {
      const text   = document.getElementById('quote-text').value.trim();
      const source = document.getElementById('quote-source').value.trim();
      const season = document.getElementById('quote-season').value;
      const errEl  = document.getElementById('quote-error');
      if (!text) {
        errEl.textContent = 'Quote text is required.';
        errEl.hidden = false;
        return;
      }
      const url    = editingQuoteId ? `/api/admin/quotes/${editingQuoteId}` : '/api/admin/quotes';
      const method = editingQuoteId ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text, source, season }),
      });
      if (!res.ok) {
        const data = await res.json();
        errEl.textContent = data.error || 'Failed to save.';
        errEl.hidden = false;
        return;
      }
      // Cheap reload — keeps the list ordering rule in sync with the server
      // (any-season first, then by season, then by id) without rebuilding it
      // on the client.
      window.location.reload();
    }

    async function deleteQuote(id, text) {
      const preview = text.length > 60 ? text.slice(0, 60) + '…' : text;
      if (!confirm(`Delete "${preview}"?`)) return;
      const res = await fetch(`/api/admin/quotes/${id}`, { method: 'DELETE' });
      if (!res.ok) return alert('Failed to delete.');
      document.getElementById(`quote-row-${id}`)?.remove();
    }

    function buildResourceRow(id, title, category_tag, description, url) {
      const shortUrl = url && url.length > 40 ? url.slice(0, 40) + '…' : (url || '');
      const tagHtml = category_tag ? `<span class="admin-lesson-tag">${category_tag}</span>` : '';
      const descHtml = description ? `<span class="admin-resource-desc">${description}</span>` : '';
      const urlHtml = url ? `<a class="admin-resource-url" href="${url}" target="_blank" rel="noopener">${shortUrl}</a>` : '';
      return `
        <div class="admin-resource-row" id="resource-row-${id}">
          <div class="admin-resource-info">
            <span class="admin-resource-title">${title}</span>
            ${tagHtml}
            ${descHtml}
          </div>
          ${urlHtml}
          <div class="admin-row-actions">
            <button class="admin-btn-icon" type="button" title="Edit"
              onclick="openEditResource(${id})">✎</button>
            <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
              onclick="deleteResource(${id}, ${JSON.stringify(title)})">✕</button>
          </div>
        </div>`;
    }
  </script>

</body>
</html>
