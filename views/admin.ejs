    function copyTempPassword() {
      const val = document.getElementById('temp-pw-value').textContent;
      navigator.clipboard?.writeText(val).then(() => {
        const btn = event.target;
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = prev; }, 1500);
      });
    }

    // Auto-save course start date on change. Empty value clears the override
    // and falls back to the global default (server stores NULL).
    document.querySelectorAll('.admin-user-start-input').forEach(input => {
      input.addEventListener('change', async () => {
        const id = input.dataset.userId;
        const date = input.value || null;
        input.disabled = true;
        try {
          const res = await fetch(`/api/admin/users/${id}/course-start-date`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ date }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Save failed');
          // Toggle the "uses default" hint based on whether a date is now set.
          const row = input.closest('.admin-user-row');
          const fallback = row.querySelector('.admin-user-start-fallback');
          if (date && fallback) fallback.remove();
          if (!date && !fallback) {
            const hint = document.createElement('span');
            hint.className = 'admin-user-start-fallback';
            hint.textContent = '— uses default';
            input.parentNode.appendChild(hint);
          }
        } catch (err) {
          alert(err.message);
        } finally {
          input.disabled = false;
        }
      });
    });

    function updateStudentCount(delta) {
      const el = document.getElementById('student-count');
