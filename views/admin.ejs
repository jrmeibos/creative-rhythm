<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <style>
    /* Admin tabbed layout (Overview / Cohorts / People / Course) */
    .admin-tabnav{display:flex;gap:.2rem;flex-wrap:wrap;margin:0 0 1.75rem;border-bottom:1px solid rgba(112,92,108,0.18)}
    .admin-tab{appearance:none;border:none;background:none;font:inherit;font-size:.95rem;color:var(--color-ink-stained);opacity:.5;padding:.6rem .9rem;border-bottom:2px solid transparent;margin-bottom:-1px;cursor:pointer}
    .admin-tab:hover{opacity:.85}
    .admin-tab[aria-current="true"]{opacity:1;color:var(--color-bloem);border-bottom-color:var(--color-bloem)}
    section[data-tab][hidden]{display:none}
    .admin-desk{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
    @media(max-width:820px){.admin-desk{grid-template-columns:1fr}}
    .admin-desk-card{background:var(--color-blank-page);border:1px solid rgba(112,92,108,0.16);border-radius:14px;padding:1.1rem 1.2rem}
    .admin-desk-card h3{font:inherit;font-size:1rem;font-weight:500;margin:0 0 .9rem;display:flex;align-items:center;gap:.4rem}
    .admin-tally{display:flex;gap:1.6rem;flex-wrap:wrap}
    .admin-tally .n{font-family:'Goldage',Georgia,serif;font-size:2rem;line-height:1}
    .admin-tally .l{font-size:.78rem;color:rgba(16,15,16,.56);margin-top:.15rem}
    .admin-desk-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.5rem}
    .admin-desk-row{display:flex;align-items:center;gap:.6rem;padding:.5rem .6rem;border-radius:9px;background:var(--color-pearl)}
    .admin-desk-row .grow{flex:1 1 auto;min-width:0}
    .admin-desk-note{font-size:.75rem;color:rgba(16,15,16,.42);margin:.85rem 0 0}
    .admin-desk-empty{color:rgba(16,15,16,.42);font-size:.88rem;font-style:italic;padding:.3rem .2rem}
  </style>
</head>
<body class="app-body">

  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">

      <header class="dash-header">
        <div class="dash-greeting">
          <h1 class="dash-greeting-text">Admin</h1>
          <p class="dash-week-label">Platform settings and management</p>
        </div>
      </header>

      <nav class="admin-tabnav" aria-label="Admin sections">
        <button class="admin-tab" type="button" data-tab="overview" aria-current="true">Overview</button>
        <button class="admin-tab" type="button" data-tab="cohorts">Cohorts</button>
        <button class="admin-tab" type="button" data-tab="people">People</button>
        <button class="admin-tab" type="button" data-tab="course">Course</button>
      </nav>

      <%
        // Split off challenge signups who never finished the $299 checkout
        // (challenge_payment_status === 'pending') so the "Gardeners" roster
        // shows actual students. Pending accounts get their own section below.
        const pendingSignups = users.filter(u => u.role === 'student' && u.challenge_payment_status === 'pending');
        const rosterUsers    = users.filter(u => !(u.role === 'student' && u.challenge_payment_status === 'pending'));
      %>

      <!-- ── Cohorts ──────────────────────────────────────────────────────── -->
      <%
        const cohortList = (typeof cohorts !== 'undefined' && cohorts) ? cohorts : [];
        const studentUsers = users.filter(u => u.role === 'student');
        const membersByCohort = new Map();
        for (const c of cohortList) membersByCohort.set(c.id, []);
        const unassignedEnrolled = [];
        for (const u of studentUsers) {
          if (u.cohort_id && membersByCohort.has(u.cohort_id)) {
            membersByCohort.get(u.cohort_id).push(u);
          } else if (u.challenge_payment_status !== 'pending') {
            // Paid/comped/legacy students not yet placed — the stragglers worth
            // slotting in. Pending-unpaid sign-ups live in their own section and
            // aren't cohort members yet.
            unassignedEnrolled.push(u);
          }
        }
        const cohortStatusLabel = { upcoming: 'Upcoming', active: 'Active', ended: 'Ended' };
        const fmtCohortStart = (s) => {
          if (!s) return 'No start date';
          const d = new Date(String(s).slice(0, 10) + 'T00:00:00');
          return isNaN(d) ? 'No start date'
            : 'Starts ' + d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        };
      %>
      <!-- ── Overview · action desk ───────────────────────────────────────── -->
      <%
        const paidStudents  = studentUsers.filter(u => u.challenge_payment_status === 'paid');
        const stayingList   = studentUsers.filter(u => u.continuation_choice === 'continue');
        const refundList    = studentUsers.filter(u => u.continuation_choice === 'refund');
        const decidingList  = paidStudents.filter(u => u.cohort_id && !u.continuation_choice);
      %>
      <section class="dash-section" data-tab="overview">
        <div class="dash-section-header">
          <h2 class="dash-section-title">What needs you</h2>
          <% if (continuationOfferOpen) { %><span class="admin-lesson-tag" style="background:#e4ead9;color:#5f7256" title="The refund & continue offer is open">🌿 Refund offer open</span><% } %>
        </div>
        <div class="admin-desk">
          <div class="admin-desk-card">
            <h3>🌿 Refund &amp; continue decisions</h3>
            <div class="admin-tally">
              <div><div class="n" style="color:#5f7256"><%= stayingList.length %></div><div class="l">staying</div></div>
              <div><div class="n" style="color:#9a6a1e"><%= refundList.length %></div><div class="l">want refund</div></div>
              <div><div class="n"><%= decidingList.length %></div><div class="l">still deciding</div></div>
            </div>
          </div>
          <div class="admin-desk-card">
            <h3>Refunds to issue in Stripe</h3>
            <ul class="admin-desk-list">
              <% if (refundList.length) { refundList.forEach(function(u){ %>
                <li class="admin-desk-row">
                  <div class="sidebar-avatar" style="width:26px;height:26px;font-size:.72rem"><%= u.avatar_initial || u.name.charAt(0) %></div>
                  <div class="grow"><div style="font-size:.9rem"><%= u.name %></div><div style="font-size:.74rem;color:rgba(16,15,16,.5)"><%= u.email %></div></div>
                  <span class="admin-lesson-tag" style="background:#f7e6c4;color:#9a6a1e">Wants refund</span>
                </li>
              <% }); } else { %>
                <li class="admin-desk-empty">No open refund requests. 🌿</li>
              <% } %>
            </ul>
            <p class="admin-desk-note">You issue the money in Stripe; the choice is only recorded here.</p>
          </div>
        </div>
      </section>

      <!-- ── Cohorts ──────────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-cohorts" data-tab="cohorts">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Cohorts</h2>
          <div class="admin-section-actions">
            <span class="admin-count"><%= cohortList.length %> cohort<%= cohortList.length === 1 ? '' : 's' %></span>
            <button class="admin-add-btn" type="button" onclick="openNewCohort()">+ New cohort</button>
          </div>
        </div>
        <p class="admin-field-hint" style="margin:0 0 0.9rem">
          A cohort is a group that goes through the course together — its own start date, its own
          room, its own emails. Move anyone with the dropdown on their row.
        </p>

        <% if (!cohortList.length) { %>
          <div class="admin-card"><p class="admin-user-email" style="margin:0">No cohorts yet. Create one to get started.</p></div>
        <% } %>

        <% for (const c of cohortList) { const members = membersByCohort.get(c.id) || []; %>
          <div class="admin-card" style="margin-bottom:1rem">
            <div class="dash-section-header" style="margin-bottom:0.6rem">
              <div>
                <span class="admin-user-name" style="font-size:1rem"><%= c.name %></span>
                <div class="admin-user-email">
                  <%= fmtCohortStart(c.start_date) %> · <%= c.length_weeks %> weeks · <%= cohortStatusLabel[c.status] || c.status %><% if (c.comped) { %> · <span title="This whole cohort has full access without paying.">comped</span><% } %> · <span title="Whether members can see their cohort room (feed + progress)."><%= c.room_open ? '🟢 room open' : '🔒 room closed' %></span>
                </div>
              </div>
              <div class="admin-section-actions">
                <span class="admin-count"><%= members.length %> member<%= members.length === 1 ? '' : 's' %></span>
                <button class="admin-btn-icon" type="button" title="Edit cohort"
                  onclick="openEditCohort(<%= JSON.stringify({ id: c.id, name: c.name, start_date: c.start_date ? String(c.start_date).slice(0,10) : '', length_weeks: c.length_weeks, status: c.status, comped: !!c.comped, room_open: !!c.room_open }) %>)">✎</button>
                <% if (!members.length) { %>
                  <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete cohort"
                    onclick="deleteCohort(<%= c.id %>, <%= JSON.stringify(c.name) %>)">✕</button>
                <% } %>
              </div>
            </div>
            <% if (members.length) { %>
              <% for (const m of members) { %>
                <div class="admin-user-row">
                  <div class="sidebar-avatar" style="width:32px;height:32px;font-size:0.85rem;flex-shrink:0"><%= m.avatar_initial || m.name.charAt(0) %></div>
                  <div class="admin-user-info">
                    <span class="admin-user-name"><%= m.name %></span>
                    <span class="admin-user-email"><%= m.email %></span>
                  </div>
                  <% if (m.challenge_payment_status === 'refunded') { %><span class="admin-lesson-tag" title="Paid then refunded on completion">Refunded</span>
                  <% } else if (m.challenge_payment_status === 'paid') { %><span class="admin-lesson-tag" title="Paid the challenge fee">Paid</span><% } %>
                  <% if (m.continuation_choice === 'continue') { %><span class="admin-lesson-tag" title="Chose to stay in the garden">🌿 Staying</span>
                  <% } else if (m.continuation_choice === 'refund') { %><span class="admin-lesson-tag" title="Chose the refund — issue it in Stripe">Wants refund</span><% } %>
                  <select class="admin-input admin-select" style="width:auto;max-width:230px" onchange="assignCohort(<%= m.id %>, this.value)">
                    <option value="">— Unassigned</option>
                    <% for (const oc of cohortList) { %>
                      <option value="<%= oc.id %>" <%= oc.id === c.id ? 'selected' : '' %>><%= oc.name %></option>
                    <% } %>
                  </select>
                </div>
              <% } %>
            <% } else { %>
              <p class="admin-user-email" style="margin:0.2rem 0 0">No members yet.</p>
            <% } %>
          </div>
        <% } %>

        <% if (unassignedEnrolled.length) { %>
          <div class="admin-card" style="margin-bottom:0.25rem;border:1px dashed rgba(112,92,108,0.4)">
            <div class="dash-section-header" style="margin-bottom:0.6rem">
              <div>
                <span class="admin-user-name" style="font-size:1rem">Not in a cohort</span>
                <div class="admin-user-email">Enrolled gardeners the payment-status backfill didn't place. Drop them into a cohort.</div>
              </div>
              <span class="admin-count"><%= unassignedEnrolled.length %></span>
            </div>
            <% for (const m of unassignedEnrolled) { %>
              <div class="admin-user-row">
                <div class="sidebar-avatar" style="width:32px;height:32px;font-size:0.85rem;flex-shrink:0"><%= m.avatar_initial || m.name.charAt(0) %></div>
                <div class="admin-user-info">
                  <span class="admin-user-name"><%= m.name %></span>
                  <span class="admin-user-email"><%= m.email %></span>
                </div>
                <% if (m.challenge_payment_status === 'refunded') { %><span class="admin-lesson-tag">Refunded</span>
                <% } else if (m.challenge_payment_status === 'paid') { %><span class="admin-lesson-tag">Paid</span><% } %>
                <select class="admin-input admin-select" style="width:auto;max-width:230px" onchange="assignCohort(<%= m.id %>, this.value)">
                  <option value="" selected>— Unassigned</option>
                  <% for (const oc of cohortList) { %>
                    <option value="<%= oc.id %>"><%= oc.name %></option>
                  <% } %>
                </select>
              </div>
            <% } %>
          </div>
        <% } %>
      </section>

      <!-- ── Students ─────────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-students" data-tab="people">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Gardeners</h2>
          <div class="admin-section-actions">
            <span class="admin-count" id="student-count">
              <%= rosterUsers.filter(u => u.role === 'student').length %> enrolled
            </span>
            <button class="admin-add-btn" type="button" onclick="openDialog('dialog-add-student')">
              + Add Gardener
            </button>
          </div>
        </div>
        <div class="admin-card" id="student-list">
          <% for (const u of rosterUsers) { %>
            <% const userStart = u.course_start_date ? String(u.course_start_date).slice(0, 10) : ''; %>
            <div class="admin-user-row" id="user-row-<%= u.id %>">
              <div class="sidebar-avatar" style="width:32px;height:32px;font-size:0.85rem;flex-shrink:0">
                <%= u.avatar_initial || u.name.charAt(0) %>
              </div>
              <div class="admin-user-info">
                <span class="admin-user-name"><%= u.name %></span>
                <span class="admin-user-email"><%= u.email %></span>
                <span class="admin-user-start-date">
                  <label for="user-start-<%= u.id %>" style="font-size:0.7rem;color:rgba(16,15,16,0.5);letter-spacing:0.08em;text-transform:uppercase;font-weight:600">Course start</label>
                  <input type="date" id="user-start-<%= u.id %>" class="admin-user-start-input"
                         value="<%= userStart %>"
                         data-user-id="<%= u.id %>"
                         title="<%= userStart ? '' : 'Blank = uses the global default' %>">
                  <% if (!userStart) { %>
                    <span class="admin-user-start-fallback" title="No override set; uses the global default course start date.">— uses default</span>
                  <% } %>
                </span>
                <% if (u.role === 'student') {
                  const act = recordingSummary[u.id] || { everRecorded: false, quiet: true, recentCount: 0, daysSince: null, lastRecordedDate: null };
                  const fmtDate = (s) => new Date(s + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                  let lastLabel;
                  if (!act.everRecorded) lastLabel = 'No cuttings yet';
                  else if (act.daysSince === 0) lastLabel = 'Last cutting today';
                  else if (act.daysSince === 1) lastLabel = 'Last cutting yesterday';
                  else lastLabel = 'Last cutting ' + fmtDate(act.lastRecordedDate) + ' · ' + act.daysSince + 'd ago';
                %>
                  <span class="admin-user-activity <%= act.quiet ? 'admin-user-activity--quiet' : '' %>"
                        title="<%= act.everRecorded ? ('Last recording: ' + act.lastRecordedDate) : 'This gardener has never recorded a cutting.' %>">
                    <% if (act.quiet) { %><span class="admin-activity-flag" aria-hidden="true">●</span><% } %>
                    <span class="admin-activity-last"><%= lastLabel %></span>
                    <span class="admin-activity-recent"><%= act.recentCount %> in last 7 days</span>
                  </span>
                <% } %>
                <% if (u.notes && u.notes.trim()) { %>
                  <span class="admin-user-note" title="<%= u.notes %>">
                    <span aria-hidden="true">✎</span> Private note
                  </span>
                <% } %>
              </div>
              <span class="admin-user-role <%= u.role === 'admin' ? 'admin-role--admin' : '' %>">
                <%= u.role === 'admin' ? 'Curator' : 'Gardener' %>
              </span>
              <% if (typeof u.course_length_weeks === 'number' && u.course_length_weeks < 12) { %>
                <span class="admin-lesson-tag" title="<%= u.course_length_weeks %>-week challenge cohort"><%= u.course_length_weeks %>w Challenge</span>
              <% } %>
              <% if (u.enrollment_tier) {
                const tierLabels = { solo: 'Grow Solo', community: 'Grow in Community', coaching: 'Grow with Me' };
              %>
                <span class="admin-lesson-tag" title="Paid tier"><%= tierLabels[u.enrollment_tier] || u.enrollment_tier %></span>
              <% } %>
              <div class="admin-row-actions">
                <button class="admin-btn-icon" type="button" title="Edit"
                  onclick="openEditStudent(<%= JSON.stringify({ id: u.id, name: u.name, email: u.email, role: u.role, course_length_weeks: u.course_length_weeks || 12, notes: u.notes || '', enrollment_tier: u.enrollment_tier || '' }) %>)">
                  ✎
                </button>
                <button class="admin-btn-icon" type="button" title="Reset password"
                  onclick="resetStudentPassword(<%= u.id %>, <%= JSON.stringify(u.name) %>)">
                  ⚿
                </button>
                <% if (u.id !== user.id) { %>
                  <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                    onclick="deleteUser(<%= u.id %>, <%= JSON.stringify(u.name) %>)">
                    ✕
                  </button>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </section>

      <!-- ── Pending signups (started, never paid) ────────────────────────── -->
      <% if (pendingSignups.length) { %>
      <section class="dash-section" id="section-pending" data-tab="overview">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Pending signups</h2>
          <span class="admin-count"><%= pendingSignups.length %> haven't paid</span>
        </div>
        <p class="admin-field-hint" style="margin:0 0 0.9rem">
          These people created an account but didn't finish the $299 payment, so they're
          <strong>not in the cohort</strong> and don't take a spot. They can still pay and
          join until it fills — warm leads worth a nudge, or you can remove them.
        </p>
        <div class="admin-card">
          <% for (const u of pendingSignups) { %>
            <%
              let signedUpLabel = '';
              if (u.created_at) {
                const c = new Date(String(u.created_at).replace(' ', 'T'));
                if (!isNaN(c)) {
                  const days = Math.max(0, Math.floor((Date.now() - c.getTime()) / 86400000));
                  const dateStr = c.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                  signedUpLabel = 'Signed up ' + dateStr + (days === 0 ? ' · today' : ' · ' + days + 'd ago');
                }
              }
            %>
            <div class="admin-user-row" id="user-row-<%= u.id %>">
              <div class="sidebar-avatar" style="width:32px;height:32px;font-size:0.85rem;flex-shrink:0">
                <%= u.avatar_initial || u.name.charAt(0) %>
              </div>
              <div class="admin-user-info">
                <span class="admin-user-name"><%= u.name %></span>
                <span class="admin-user-email"><%= u.email %></span>
                <% if (signedUpLabel) { %><span class="admin-user-activity admin-user-activity--quiet"><%= signedUpLabel %></span><% } %>
              </div>
              <span class="admin-lesson-tag" title="Created an account but hasn't paid the $299">Unpaid</span>
              <div class="admin-row-actions">
                <a class="admin-btn-icon" title="Email this person" href="mailto:<%= u.email %>?subject=Your%20spot%20in%20The%20Creative%27s%20Garden">✉</a>
                <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                  onclick="deleteUser(<%= u.id %>, <%= JSON.stringify(u.name) %>)">✕</button>
              </div>
            </div>
          <% } %>
        </div>
      </section>
      <% } %>

      <!-- ── The 3-Week Challenge (the current offering) ──────────────────── -->
      <section class="dash-section" id="section-challenge" data-tab="overview">
        <div class="dash-section-header">
          <h2 class="dash-section-title">The 3-Week Challenge</h2>
          <div class="admin-section-actions">
            <% if (challengeStats.signupsClosed) { %>
              <span class="admin-count" title="New public sign-ups are closed; people are sent to the Mailchimp waitlist. Existing students are unaffected.">🔒 Sign-ups closed · waitlist on</span>
            <% } else if (challengeStats.signupCloseLabel) { %>
              <span class="admin-count" title="Registration is open and auto-closes at this time.">🟢 Registration open · closes <%= challengeStats.signupCloseLabel %></span>
            <% } %>
            <span class="admin-count">
              <%= challengeStats.spotsTaken %> / <%= challengeStats.capacity %> spots filled<% if (challengeStats.spotsLeft === 0) { %> · full<% } else { %> · <%= challengeStats.spotsLeft %> left<% } %>
            </span>
          </div>
        </div>

        <!-- Overview -->
        <div class="admin-card admin-settings-block">
          <div class="admin-enroll-grid">
            <div class="admin-enroll-tier">
              <span class="admin-enroll-tier-name">Joined</span>
              <span class="admin-enroll-tier-price"><%= challengeStats.priceLabel %></span>
              <span class="admin-enroll-tier-count"><%= challengeStats.paid %> paid</span>
            </div>
            <div class="admin-enroll-tier">
              <span class="admin-enroll-tier-name">Pending</span>
              <span class="admin-enroll-tier-price">—</span>
              <span class="admin-enroll-tier-count"><%= challengeStats.pending %> not paid yet</span>
            </div>
            <div class="admin-enroll-tier">
              <span class="admin-enroll-tier-name">Refunded</span>
              <span class="admin-enroll-tier-price">—</span>
              <span class="admin-enroll-tier-count"><%= challengeStats.refunded %> refunded</span>
            </div>
          </div>
          <div class="admin-enroll-total">
            <span class="admin-enroll-total-label">Net revenue (est.)</span>
            <span class="admin-enroll-total-value"><%= challengeStats.netRevenueLabel %></span>
          </div>
          <p class="admin-field-hint" style="margin-top:0.6rem">
            Net = paid gardeners × <%= challengeStats.priceLabel %> (refunded students net to zero).
            <strong>Stripe is the source of truth</strong> for exact amounts, refunds, and dates.
            <% if (challengeStats.stripeConfigured) { %>
              Stripe is connected (<%= challengeStats.stripeMode %> mode).
            <% } else { %>
              Stripe is not configured in this environment.
            <% } %>
          </p>
        </div>

        <!-- Full course — parked until it launches -->
        <details class="admin-collapse" style="margin-top:1rem">
          <summary class="admin-collapse-summary">Full course (not selling yet)</summary>
          <div class="admin-card admin-settings-block" style="margin-top:0.6rem">
            <div class="admin-enroll-grid">
              <% for (const t of enrollments.tiers) { %>
                <div class="admin-enroll-tier">
                  <span class="admin-enroll-tier-name"><%= t.name %></span>
                  <span class="admin-enroll-tier-price"><%= t.priceLabel %></span>
                  <span class="admin-enroll-tier-count"><%= t.count %> enrolled</span>
                </div>
              <% } %>
            </div>
            <p class="admin-field-hint" style="margin-top:0.6rem">
              The 12-week course isn't on sale during the beta — shown here for when it launches.
            </p>
          </div>
        </details>

        <!-- Refund progress -->
        <% if (challengeParticipants && challengeParticipants.length) { %>
        <p class="admin-settings-block-label" style="margin:1.25rem 0 0.5rem">Refund progress
          <span class="admin-count" style="font-weight:400"><%= challengeParticipants.filter(p => p.completion.qualifies).length %> qualify</span>
        </p>
        <div class="admin-card" style="overflow-x:auto">
          <table class="admin-assess-table">
            <thead>
              <tr>
                <th>Gardener</th>
                <th>Days recorded</th>
                <th>Feedback</th>
                <th>Refund</th>
              </tr>
            </thead>
            <tbody>
              <% for (const p of challengeParticipants) { %>
                <% const c = p.completion; %>
                <tr>
                  <td class="assess-name-cell">
                    <div class="sidebar-avatar" style="width:28px;height:28px;font-size:0.75rem;flex-shrink:0;display:inline-flex">
                      <%= p.avatar_initial || p.name.charAt(0) %>
                    </div>
                    <%= p.name %>
                  </td>
                  <td>
                    <span class="assess-status <%= c.daysRecorded >= c.refundThreshold ? 'assess-status--done' : 'assess-status--partial' %>">
                      <%= c.daysRecorded %> / <%= c.totalDays %>
                    </span>
                    <span class="admin-field-hint">(needs <%= c.refundThreshold %>)</span>
                  </td>
                  <td>
                    <% if (c.feedbackSubmitted) { %>
                      <span class="assess-status assess-status--done">✓ Given</span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Not yet</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (p.status === 'refunded') { %>
                      <span class="assess-status assess-status--done">Refunded ✓</span>
                    <% } else if (c.qualifies) { %>
                      <span class="admin-unlock-badge admin-unlock-badge--on">Owed — refund in Stripe</span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Not yet</span>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
          <p class="admin-field-hint" style="margin-top:0.6rem">
            Qualifying = recorded on at least the threshold number of days <strong>and</strong> submitted closing feedback.
            You issue the actual refunds in Stripe; mark someone "refunded" by setting their status once done.
          </p>
        </div>
        <% } %>
      </section>

      <!-- ── Lessons ──────────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-lessons" data-tab="course">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Lessons</h2>
          <div class="admin-section-actions">
            <span class="admin-count"><%= lessons.length %> lesson<%= lessons.length !== 1 ? 's' : '' %></span>
            <button class="admin-add-btn" type="button" onclick="openDialog('dialog-add-lesson')">
              + Add Lesson
            </button>
          </div>
        </div>
        <div class="admin-card" id="lesson-list">
          <% for (let i = 0; i < lessons.length; i++) { %>
            <% const l = lessons[i]; %>
            <div class="admin-lesson-row" id="lesson-row-<%= l.id %>">
              <div class="admin-move-btns">
                <% if (i > 0) { %>
                  <button class="admin-move-btn" type="button" title="Move up"
                    onclick="moveLesson(<%= l.id %>, 'up')">↑</button>
                <% } else { %>
                  <span class="admin-move-btn admin-move-btn--ghost"></span>
                <% } %>
                <% if (i < lessons.length - 1) { %>
                  <button class="admin-move-btn" type="button" title="Move down"
                    onclick="moveLesson(<%= l.id %>, 'down')">↓</button>
                <% } else { %>
                  <span class="admin-move-btn admin-move-btn--ghost"></span>
                <% } %>
              </div>
              <div class="admin-lesson-info">
                <span class="admin-lesson-title"><%= l.title %></span>
                <% if (l.category_tag) { %>
                  <span class="admin-lesson-tag"><%= l.category_tag %></span>
                <% } %>
              </div>
              <span class="admin-lesson-count"><%= l.estimated_read_time %> min</span>
              <div class="admin-row-actions">
                <button class="admin-btn-icon" type="button" title="Edit"
                  onclick="openEditLesson(<%= l.id %>)">✎</button>
                <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                  onclick="deleteLesson(<%= l.id %>, <%= JSON.stringify(l.title) %>)">✕</button>
              </div>
            </div>
          <% } %>
          <% if (!lessons.length) { %>
            <p class="admin-empty">No lessons yet.</p>
          <% } %>
        </div>
      </section>

      <!-- ── Resources ────────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-resources" data-tab="course">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Resources</h2>
          <div class="admin-section-actions">
            <span class="admin-count"><%= resources.length %> resource<%= resources.length !== 1 ? 's' : '' %></span>
            <button class="admin-add-btn" type="button" onclick="openDialog('dialog-add-resource')">
              + Add Resource
            </button>
          </div>
        </div>
        <div class="admin-card" id="resource-list">
          <% for (const r of resources) { %>
            <div class="admin-resource-row" id="resource-row-<%= r.id %>">
              <div class="admin-resource-info">
                <span class="admin-resource-title"><%= r.title %></span>
                <% if (r.category_tag) { %><span class="admin-lesson-tag"><%= r.category_tag %></span><% } %>
                <% if (r.description) { %>
                  <span class="admin-resource-desc"><%= r.description %></span>
                <% } %>
              </div>
              <% if (r.url) { %>
                <a class="admin-resource-url" href="<%= r.url %>" target="_blank" rel="noopener">
                  <%= r.url.length > 40 ? r.url.slice(0, 40) + '…' : r.url %>
                </a>
              <% } %>
              <div class="admin-row-actions">
                <button class="admin-btn-icon" type="button" title="Edit"
                  onclick="openEditResource(<%= r.id %>)">✎</button>
                <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                  onclick="deleteResource(<%= r.id %>, <%= JSON.stringify(r.title) %>)">✕</button>
              </div>
            </div>
          <% } %>
          <% if (!resources.length) { %>
            <p class="admin-empty">No resources yet.</p>
          <% } %>
        </div>
      </section>

      <!-- ── Five days in — check-in responses ─────────────────────────────── -->
      <section class="dash-section" id="section-checkins" data-tab="people">
        <div class="dash-section-header">
          <h2 class="dash-section-title"><%= checkinTitle %> — check-in responses</h2>
          <span class="admin-count"><%= checkins.length %> in</span>
        </div>
        <% if (!checkins.length) { %>
          <div class="admin-card"><p class="admin-empty">No check-ins yet.</p></div>
        <% } else { %>
          <% for (const c of checkins) { %>
            <div class="admin-card ci-admin-card">
              <div class="ci-admin-head">
                <span class="ci-admin-name"><%= c.name %></span>
                <% if (c.practice_rating) { %><span class="ci-admin-rating">Practice <%= c.practice_rating %>/5</span><% } %>
              </div>
              <% if (c.resistance)   { %><p class="ci-admin-q">Resistance</p><p class="ci-admin-a"><%= c.resistance %></p><% } %>
              <% if (c.surprised)    { %><p class="ci-admin-q">Surprised / felt good</p><p class="ci-admin-a"><%= c.surprised %></p><% } %>
              <% if (c.self_insight) { %><p class="ci-admin-q">Learned about themselves</p><p class="ci-admin-a"><%= c.self_insight %></p><% } %>
              <% if (c.for_the_call) { %><p class="ci-admin-q">For the first call</p><p class="ci-admin-a"><%= c.for_the_call %></p><% } %>
            </div>
          <% } %>
        <% } %>
      </section>

      <!-- ── Student Assessments ──────────────────────────────────────────── -->
      <section class="dash-section" id="section-assessments" data-tab="people">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Gardener Assessments</h2>
        </div>
        <div class="admin-card" style="overflow:hidden">
          <table class="admin-assess-table">
            <thead>
              <tr>
                <th>Gardener</th>
                <th>Opening</th>
                <th>Goals</th>
                <th>Mid-course</th>
                <th>Closing</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% for (const s of studentAssessments) { %>
                <tr id="assess-row-<%= s.id %>">
                  <td class="assess-name-cell">
                    <div class="sidebar-avatar" style="width:28px;height:28px;font-size:0.75rem;flex-shrink:0;display:inline-flex">
                      <%= s.avatar_initial || s.name.charAt(0) %>
                    </div>
                    <%= s.name %>
                  </td>
                  <td>
                    <% if (s.opening_at) { %>
                      <span class="assess-status assess-status--done">✓ <%= new Date(s.opening_at).toLocaleDateString('en-US', {month:'short',day:'numeric'}) %></span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.goals_count >= 3) { %>
                      <span class="assess-status assess-status--done">✓ Planted</span>
                    <% } else if (s.goals_count > 0) { %>
                      <span class="assess-status assess-status--partial"><%= s.goals_count %>/3</span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.midcourse_at) { %>
                      <span class="assess-status assess-status--done">✓ <%= new Date(s.midcourse_at).toLocaleDateString('en-US', {month:'short',day:'numeric'}) %></span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.closing_at) { %>
                      <span class="assess-status assess-status--done">✓ <%= new Date(s.closing_at).toLocaleDateString('en-US', {month:'short',day:'numeric'}) %></span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <button class="admin-btn-icon" type="button" title="View responses"
                      onclick="viewStudentData(<%= s.id %>, <%= JSON.stringify(s.name) %>)">View</button>
                  </td>
                </tr>
              <% } %>
              <% if (!studentAssessments.length) { %>
                <tr><td colspan="6" class="admin-empty">No gardeners enrolled yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ── Lesson Completions ────────────────────────────────────────────── -->
      <section class="dash-section" data-tab="people">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Lesson Completions</h2>
        </div>
        <div class="admin-card">
          <% for (const stat of lessonStats) { %>
            <div class="admin-lesson-row">
              <div class="admin-lesson-info">
                <span class="admin-lesson-title"><%= stat.title %></span>
              </div>
              <span class="admin-lesson-count"><%= stat.completion_count %> completed</span>
            </div>
          <% } %>
          <% if (!lessonStats.length) { %>
            <p class="admin-empty">No lessons found.</p>
          <% } %>
        </div>
      </section>

      <!-- ══ Settings & tools (kept at the bottom — used rarely) ═══════════════ -->

      <!-- ── Course Settings ──────────────────────────────────────────────── -->
      <section class="dash-section" data-tab="course">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Course Settings</h2>
        </div>
        <div class="admin-card admin-settings">

          <!-- Course start date is now per-gardener — set it on each row in
               the Gardeners section above. -->

          <!-- Automatic unlocks -->
          <div class="admin-settings-block" style="border-top:none;padding-top:0">
            <span class="admin-settings-block-label">Automatic unlocks</span>
            <p class="admin-field-hint">These open on their own, based on each gardener's start date — set per gardener in the Gardeners section above. Dates below preview the earliest-started gardener. No action needed.</p>
            <div class="admin-unlock-status-grid">
              <div class="admin-unlock-row">
                <div>
                  <strong>Mid-course check-in</strong>
                  <span class="admin-unlock-hint">Week 6<% if (midcourseUnlockDate) { %> · <%= midcourseUnlockDate %><% } %></span>
                  <span class="admin-unlock-hint"><%= midcourseSubmittedCount.done %> / <%= midcourseSubmittedCount.total %> submitted</span>
                </div>
                <div style="display:flex;align-items:center;gap:0.6rem">
                  <span class="admin-unlock-badge <%= midcourseUnlocked ? 'admin-unlock-badge--on' : 'admin-unlock-badge--off' %>">
                    <%= midcourseUnlocked ? '✓ Unlocked' : 'Locked' %>
                  </span>
                  <% if (midcourseSubmittedCount.done > 0) { %>
                    <button type="button" class="admin-btn-sm" onclick="viewAllMidcourseResponses()">View responses</button>
                  <% } %>
                </div>
              </div>
              <div class="admin-unlock-row">
                <div>
                  <strong>Harvest (closing assessment)</strong>
                  <span class="admin-unlock-hint">Week 12<% if (closingUnlockDate) { %> · <%= closingUnlockDate %><% } %></span>
                </div>
                <span class="admin-unlock-badge <%= harvestUnlocked ? 'admin-unlock-badge--on' : 'admin-unlock-badge--off' %>">
                  <%= harvestUnlocked ? '✓ Unlocked' : 'Locked' %>
                </span>
              </div>
            </div>
          </div>

          <!-- End-of-challenge refund / continue offer -->
          <div class="admin-settings-block">
            <span class="admin-settings-block-label">Refund &amp; continue offer</span>
            <p class="admin-field-hint">
              Opens the <code>/continue-offer</code> page (and a dashboard card) to your paid
              challenge members, where each person privately chooses their <strong>refund</strong>
              or to <strong>stay in the garden</strong>. Flip it on after your final call, then send
              them the link. It auto-closes after the <strong>Nov 3</strong> deadline. Staying opens
              their full garden; you issue any refunds in Stripe.
            </p>
            <div class="admin-unlock-row" style="margin-top:0.5rem">
              <div>
                <strong>Currently: <%= continuationOfferOpen ? 'Open to members' : 'Closed' %></strong>
                <span class="admin-unlock-hint">
                  <% if (continuationOfferOpen) { %>
                    Members can see it and choose. Preview: <a href="/continue-offer" target="_blank" rel="noopener">/continue-offer</a>
                  <% } else { %>
                    Hidden from everyone until you open it.
                  <% } %>
                </span>
              </div>
              <div style="display:flex;align-items:center;gap:0.6rem">
                <span class="admin-unlock-badge <%= continuationOfferOpen ? 'admin-unlock-badge--on' : 'admin-unlock-badge--off' %>">
                  <%= continuationOfferOpen ? '✓ Open' : 'Closed' %>
                </span>
                <% if (continuationOfferOpen) { %>
                  <button type="button" class="admin-btn-sm" onclick="setFlag('continuation_offer_open', 'false')">Close offer</button>
                <% } else { %>
                  <button type="button" class="admin-btn-sm" onclick="setFlag('continuation_offer_open', 'true')">Open offer</button>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Upgrade / pricing page mode -->
          <div class="admin-settings-block">
            <span class="admin-settings-block-label">Upgrade page (/upgrade)</span>
            <p class="admin-field-hint">
              While the full course is still being built, <code>/upgrade</code> shows a temporary
              page: the 3-week challenge + a “coming soon, notify me” form for the full course.
              Flip to <strong>Live pricing</strong> the day you’re ready to sell the full course —
              your real pricing page returns instantly, unchanged.
            </p>
            <div class="admin-unlock-row" style="margin-top:0.5rem">
              <div>
                <strong>Currently showing:
                  <%= upgradeMode === 'live' ? 'Live pricing page' : 'Coming-soon page' %>
                </strong>
                <span class="admin-unlock-hint">
                  <% if (upgradeMode === 'live') { %>
                    Visitors see the real tiers + Stripe checkout.
                  <% } else { %>
                    Visitors see the free-trial + newsletter signup. Preview the real page:
                    <a href="/upgrade?preview=full" target="_blank" rel="noopener">/upgrade?preview=full</a>
                  <% } %>
                </span>
              </div>
              <div style="display:flex;align-items:center;gap:0.6rem">
                <span class="admin-unlock-badge <%= upgradeMode === 'live' ? 'admin-unlock-badge--on' : 'admin-unlock-badge--off' %>">
                  <%= upgradeMode === 'live' ? 'Live' : 'Coming soon' %>
                </span>
                <% if (upgradeMode === 'live') { %>
                  <button type="button" class="admin-btn-sm" onclick="setUpgradeMode('coming_soon')">Switch to coming-soon</button>
                <% } else { %>
                  <button type="button" class="admin-btn-sm" onclick="setUpgradeMode('live')">Go live with pricing</button>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Backup -->
          <div class="admin-settings-block">
            <span class="admin-settings-block-label">Database backup</span>
            <p class="admin-field-hint">
              A complete snapshot — students, cuttings, reflections, goals, assessments.
              A copy is saved automatically each night; grab one manually before any big change.
            </p>
            <a href="/admin/download-backup" class="admin-save-btn" style="display:inline-block; text-decoration:none">
              Download full backup
            </a>
          </div>
        </div>
      </section>

      <!-- ── Quotes (collapsed — the list can get long) ───────────────────── -->
      <%
        const SEASON_LABELS = { spring: 'Spring · Curiosity', summer: 'Summer · Create', autumn: 'Autumn · Share', winter: 'Winter · Connect' };
      %>
      <section class="dash-section" id="section-quotes" data-tab="course">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Dashboard Quotes</h2>
          <div class="admin-section-actions">
            <span class="admin-count"><%= quotes.length %> quote<%= quotes.length !== 1 ? 's' : '' %></span>
            <button class="admin-add-btn" type="button" onclick="openAddQuote()">+ Add Quote</button>
          </div>
        </div>
        <div class="admin-card">
          <p class="acct-section-subtitle" style="margin:0">
            Shown in the purple box on each student's dashboard. Each day, one quote is picked from the pool of
            <em>any-season</em> quotes plus the ones tagged with the student's current season.
          </p>
          <% if (quotes.length) { %>
            <details class="admin-collapse">
              <summary class="admin-collapse-summary">View all <%= quotes.length %> quote<%= quotes.length !== 1 ? 's' : '' %></summary>
              <div id="quote-list" style="margin-top:0.75rem">
                <% for (const q of quotes) { %>
                  <div class="admin-resource-row" id="quote-row-<%= q.id %>">
                    <div class="admin-resource-info">
                      <span class="admin-resource-title">"<%= q.text %>"</span>
                      <% if (q.source) { %><span class="admin-resource-desc">— <%= q.source %></span><% } %>
                    </div>
                    <span class="admin-lesson-tag"><%= q.season ? SEASON_LABELS[q.season] : 'Any season' %></span>
                    <div class="admin-row-actions">
                      <button class="admin-btn-icon" type="button" title="Edit"
                        onclick="openEditQuote(<%= JSON.stringify(q) %>)">✎</button>
                      <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                        onclick="deleteQuote(<%= q.id %>, <%= JSON.stringify(q.text) %>)">✕</button>
                    </div>
                  </div>
                <% } %>
              </div>
            </details>
          <% } else { %>
            <p class="admin-empty" style="margin-top:0.75rem">No quotes yet. Add the first one above.</p>
          <% } %>
        </div>
      </section>

    </main>
  </div>

  <!-- ══ Dialogs ═══════════════════════════════════════════════════════════ -->

  <!-- Add Gardener -->
  <dialog class="admin-dialog" id="dialog-add-student">
    <h3 class="admin-dialog-title">Add Gardener</h3>
    <div class="admin-form-field">
      <label class="admin-form-label">Name</label>
      <input class="admin-input" type="text" id="add-student-name" placeholder="Full name" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Email</label>
      <input class="admin-input" type="email" id="add-student-email" placeholder="email@example.com" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Password</label>
      <input class="admin-input" type="password" id="add-student-password" placeholder="Temporary password">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Role</label>
      <select class="admin-input admin-select" id="add-student-role">
        <option value="student">Gardener</option>
        <option value="admin">Curator</option>
      </select>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Course length</label>
      <select class="admin-input admin-select" id="add-student-length">
        <option value="12">Full course · 12 weeks</option>
        <option value="3">3-week challenge</option>
      </select>
    </div>
    <p class="admin-dialog-error" id="add-student-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-add-student')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitAddStudent()">Add Gardener</button>
    </div>
  </dialog>

  <!-- Edit Gardener -->
  <dialog class="admin-dialog" id="dialog-edit-student">
    <h3 class="admin-dialog-title">Edit Gardener</h3>
    <input type="hidden" id="edit-student-id">
    <div class="admin-form-field">
      <label class="admin-form-label">Name</label>
      <input class="admin-input" type="text" id="edit-student-name" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Email</label>
      <input class="admin-input" type="email" id="edit-student-email" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">New Password <span class="admin-form-hint">(leave blank to keep existing)</span></label>
      <input class="admin-input" type="password" id="edit-student-password" placeholder="Optional">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Role</label>
      <select class="admin-input admin-select" id="edit-student-role">
        <option value="student">Gardener</option>
        <option value="admin">Curator</option>
      </select>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Course length</label>
      <select class="admin-input admin-select" id="edit-student-length">
        <option value="12">Full course · 12 weeks</option>
        <option value="3">3-week challenge</option>
      </select>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Enrollment tier <span class="admin-form-hint">(gift a paid tier · grants full access)</span></label>
      <select class="admin-input admin-select" id="edit-student-tier">
        <option value="">None (no tier gifted)</option>
        <% for (const t of enrollments.tiers) { %>
          <option value="<%= t.id %>"><%= t.name %> · <%= t.priceLabel %></option>
        <% } %>
      </select>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Private notes <span class="admin-form-hint">(admin-only · never shown to gardeners)</span></label>
      <textarea class="admin-input" id="edit-student-notes" rows="3" placeholder="e.g. prefers gentle accountability"></textarea>
    </div>
    <p class="admin-dialog-error" id="edit-student-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-edit-student')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitEditStudent()">Save Changes</button>
    </div>
  </dialog>

  <!-- Add / edit cohort -->
  <dialog class="admin-dialog" id="dialog-cohort">
    <h3 class="admin-dialog-title" id="cohort-dialog-title">New cohort</h3>
    <input type="hidden" id="cohort-id">
    <div class="admin-form-field">
      <label class="admin-form-label">Name</label>
      <input class="admin-input" type="text" id="cohort-name" placeholder="e.g. January Challenge" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Start date</label>
      <input class="admin-input" type="date" id="cohort-start">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Length (weeks)</label>
      <input class="admin-input admin-input--short" type="number" id="cohort-length" min="1" value="3">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Status</label>
      <select class="admin-input admin-select" id="cohort-status">
        <option value="upcoming">Upcoming</option>
        <option value="active">Active</option>
        <option value="ended">Ended</option>
      </select>
    </div>
    <div class="admin-form-field">
