<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="app-body">

  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">

      <header class="dash-header">
        <div class="dash-greeting">
          <h1 class="dash-greeting-text">Admin</h1>
          <p class="dash-week-label">Platform settings and management</p>
        </div>
      </header>

      <!-- ── Course Settings ──────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Course Settings</h2>
        </div>
        <div class="admin-card">
          <div class="admin-card-row">
            <div class="admin-field-group">
              <label class="admin-field-label" for="course-start-date">Course Start Date</label>
              <p class="admin-field-hint">The Monday that Week 1 begins. Auto-unlock dates calculate from this.</p>
              <div class="admin-field-input-row">
                <input type="date" id="course-start-date" class="admin-date-input"
                       value="<%= courseStartDate %>" aria-label="Course start date">
                <button class="admin-save-btn" id="save-start-date" type="button">Save</button>
                <span class="admin-save-status" id="start-date-status"></span>
              </div>
            </div>
          </div>

          <div class="admin-unlock-status-grid">
            <div class="admin-unlock-row">
              <div>
                <strong>Mid-course check-in</strong>
                <span class="admin-unlock-hint">Unlocks Week 6<% if (midcourseUnlockDate) { %> · <%= midcourseUnlockDate %><% } %></span>
              </div>
              <span class="admin-unlock-badge <%= midcourseUnlocked ? 'admin-unlock-badge--on' : 'admin-unlock-badge--off' %>">
                <%= midcourseUnlocked ? '✓ Unlocked' : 'Locked' %>
              </span>
            </div>
            <div class="admin-unlock-row">
              <div>
                <strong>Harvest (closing assessment)</strong>
                <span class="admin-unlock-hint">Unlocks Week 12<% if (closingUnlockDate) { %> · <%= closingUnlockDate %><% } %></span>
              </div>
              <span class="admin-unlock-badge <%= harvestUnlocked ? 'admin-unlock-badge--on' : 'admin-unlock-badge--off' %>">
                <%= harvestUnlocked ? '✓ Unlocked' : 'Locked' %>
              </span>
            </div>
          </div>
          <p class="admin-unlock-note">Both unlock automatically based on course start date. No manual action needed.</p>
        </div>
      </section>

      <!-- ── Students ─────────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-students">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Gardeners</h2>
          <div class="admin-section-actions">
            <span class="admin-count" id="student-count">
              <%= users.filter(u => u.role === 'student').length %> enrolled
            </span>
            <button class="admin-add-btn" type="button" onclick="openDialog('dialog-add-student')">
              + Add Gardener
            </button>
          </div>
        </div>
        <div class="admin-card" id="student-list">
          <% for (const u of users) { %>
            <div class="admin-user-row" id="user-row-<%= u.id %>">
              <div class="sidebar-avatar" style="width:32px;height:32px;font-size:0.85rem;flex-shrink:0">
                <%= u.avatar_initial || u.name.charAt(0) %>
              </div>
              <div class="admin-user-info">
                <span class="admin-user-name"><%= u.name %></span>
                <span class="admin-user-email"><%= u.email %></span>
              </div>
              <span class="admin-user-role <%= u.role === 'admin' ? 'admin-role--admin' : '' %>">
                <%= u.role === 'admin' ? 'Curator' : 'Gardener' %>
              </span>
              <div class="admin-row-actions">
                <button class="admin-btn-icon" type="button" title="Edit"
                  onclick="openEditStudent(<%= u.id %>, <%= JSON.stringify(u.name) %>, <%= JSON.stringify(u.email) %>, <%= JSON.stringify(u.role) %>)">
                  ✎
                </button>
                <% if (u.id !== user.id) { %>
                  <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                    onclick="deleteUser(<%= u.id %>, <%= JSON.stringify(u.name) %>)">
                    ✕
                  </button>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </section>

      <!-- ── Lessons ──────────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-lessons">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Field Notes</h2>
          <div class="admin-section-actions">
            <span class="admin-count"><%= lessons.length %> field note<%= lessons.length !== 1 ? 's' : '' %></span>
            <button class="admin-add-btn" type="button" onclick="openDialog('dialog-add-lesson')">
              + Add Field Note
            </button>
          </div>
        </div>
        <div class="admin-card" id="lesson-list">
          <% for (let i = 0; i < lessons.length; i++) { %>
            <% const l = lessons[i]; %>
            <div class="admin-lesson-row" id="lesson-row-<%= l.id %>">
              <div class="admin-move-btns">
                <% if (i > 0) { %>
                  <button class="admin-move-btn" type="button" title="Move up"
                    onclick="moveLesson(<%= l.id %>, 'up')">↑</button>
                <% } else { %>
                  <span class="admin-move-btn admin-move-btn--ghost"></span>
                <% } %>
                <% if (i < lessons.length - 1) { %>
                  <button class="admin-move-btn" type="button" title="Move down"
                    onclick="moveLesson(<%= l.id %>, 'down')">↓</button>
                <% } else { %>
                  <span class="admin-move-btn admin-move-btn--ghost"></span>
                <% } %>
              </div>
              <div class="admin-lesson-info">
                <span class="admin-lesson-title"><%= l.title %></span>
                <% if (l.category_tag) { %>
                  <span class="admin-lesson-tag"><%= l.category_tag %></span>
                <% } %>
              </div>
              <span class="admin-lesson-count"><%= l.estimated_read_time %> min</span>
              <div class="admin-row-actions">
                <button class="admin-btn-icon" type="button" title="Edit"
                  onclick="openEditLesson(<%= l.id %>)">✎</button>
                <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                  onclick="deleteLesson(<%= l.id %>, <%= JSON.stringify(l.title) %>)">✕</button>
              </div>
            </div>
          <% } %>
          <% if (!lessons.length) { %>
            <p class="admin-empty">No field notes yet.</p>
          <% } %>
        </div>
      </section>

      <!-- ── Resources ────────────────────────────────────────────────────── -->
      <section class="dash-section" id="section-resources">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Resources</h2>
          <div class="admin-section-actions">
            <span class="admin-count"><%= resources.length %> resource<%= resources.length !== 1 ? 's' : '' %></span>
            <button class="admin-add-btn" type="button" onclick="openDialog('dialog-add-resource')">
              + Add Resource
            </button>
          </div>
        </div>
        <div class="admin-card" id="resource-list">
          <% for (const r of resources) { %>
            <div class="admin-resource-row" id="resource-row-<%= r.id %>">
              <div class="admin-resource-info">
                <span class="admin-resource-title"><%= r.title %></span>
                <% if (r.category_tag) { %><span class="admin-lesson-tag"><%= r.category_tag %></span><% } %>
                <% if (r.description) { %>
                  <span class="admin-resource-desc"><%= r.description %></span>
                <% } %>
              </div>
              <% if (r.url) { %>
                <a class="admin-resource-url" href="<%= r.url %>" target="_blank" rel="noopener">
                  <%= r.url.length > 40 ? r.url.slice(0, 40) + '…' : r.url %>
                </a>
              <% } %>
              <div class="admin-row-actions">
                <button class="admin-btn-icon" type="button" title="Edit"
                  onclick="openEditResource(<%= r.id %>)">✎</button>
                <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
                  onclick="deleteResource(<%= r.id %>, <%= JSON.stringify(r.title) %>)">✕</button>
              </div>
            </div>
          <% } %>
          <% if (!resources.length) { %>
            <p class="admin-empty">No resources yet.</p>
          <% } %>
        </div>
      </section>

      <!-- ── Student Assessments ──────────────────────────────────────────── -->
      <section class="dash-section" id="section-assessments">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Gardener Assessments</h2>
        </div>
        <div class="admin-card" style="overflow:hidden">
          <table class="admin-assess-table">
            <thead>
              <tr>
                <th>Gardener</th>
                <th>Opening</th>
                <th>Seeds</th>
                <th>Mid-course</th>
                <th>Closing</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% for (const s of studentAssessments) { %>
                <tr id="assess-row-<%= s.id %>">
                  <td class="assess-name-cell">
                    <div class="sidebar-avatar" style="width:28px;height:28px;font-size:0.75rem;flex-shrink:0;display:inline-flex">
                      <%= s.avatar_initial || s.name.charAt(0) %>
                    </div>
                    <%= s.name %>
                  </td>
                  <td>
                    <% if (s.opening_at) { %>
                      <span class="assess-status assess-status--done">✓ <%= new Date(s.opening_at).toLocaleDateString('en-US', {month:'short',day:'numeric'}) %></span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.seeds_count >= 3) { %>
                      <span class="assess-status assess-status--done">✓ Planted</span>
                    <% } else if (s.seeds_count > 0) { %>
                      <span class="assess-status assess-status--partial"><%= s.seeds_count %>/3</span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.midcourse_at) { %>
                      <span class="assess-status assess-status--done">✓ <%= new Date(s.midcourse_at).toLocaleDateString('en-US', {month:'short',day:'numeric'}) %></span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.closing_at) { %>
                      <span class="assess-status assess-status--done">✓ <%= new Date(s.closing_at).toLocaleDateString('en-US', {month:'short',day:'numeric'}) %></span>
                    <% } else { %>
                      <span class="assess-status assess-status--pending">Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <button class="admin-btn-icon" type="button" title="View responses"
                      onclick="viewStudentData(<%= s.id %>, <%= JSON.stringify(s.name) %>)">View</button>
                  </td>
                </tr>
              <% } %>
              <% if (!studentAssessments.length) { %>
                <tr><td colspan="6" class="admin-empty">No gardeners enrolled yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ── Lesson Completions ────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Lesson Completions</h2>
        </div>
        <div class="admin-card">
          <% for (const stat of lessonStats) { %>
            <div class="admin-lesson-row">
              <div class="admin-lesson-info">
                <span class="admin-lesson-title"><%= stat.title %></span>
              </div>
              <span class="admin-lesson-count"><%= stat.completion_count %> completed</span>
            </div>
          <% } %>
          <% if (!lessonStats.length) { %>
            <p class="admin-empty">No lessons found.</p>
          <% } %>
        </div>
      </section>

    </main>
  </div>

  <!-- ══ Dialogs ═══════════════════════════════════════════════════════════ -->

  <!-- Add Gardener -->
  <dialog class="admin-dialog" id="dialog-add-student">
    <h3 class="admin-dialog-title">Add Gardener</h3>
    <div class="admin-form-field">
      <label class="admin-form-label">Name</label>
      <input class="admin-input" type="text" id="add-student-name" placeholder="Full name" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Email</label>
      <input class="admin-input" type="email" id="add-student-email" placeholder="email@example.com" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Password</label>
      <input class="admin-input" type="password" id="add-student-password" placeholder="Temporary password">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Role</label>
      <select class="admin-input admin-select" id="add-student-role">
        <option value="student">Gardener</option>
        <option value="admin">Curator</option>
      </select>
    </div>
    <p class="admin-dialog-error" id="add-student-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-add-student')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitAddStudent()">Add Gardener</button>
    </div>
  </dialog>

  <!-- Edit Gardener -->
  <dialog class="admin-dialog" id="dialog-edit-student">
    <h3 class="admin-dialog-title">Edit Gardener</h3>
    <input type="hidden" id="edit-student-id">
    <div class="admin-form-field">
      <label class="admin-form-label">Name</label>
      <input class="admin-input" type="text" id="edit-student-name" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Email</label>
      <input class="admin-input" type="email" id="edit-student-email" autocomplete="off">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">New Password <span class="admin-form-hint">(leave blank to keep existing)</span></label>
      <input class="admin-input" type="password" id="edit-student-password" placeholder="Optional">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Role</label>
      <select class="admin-input admin-select" id="edit-student-role">
        <option value="student">Gardener</option>
        <option value="admin">Curator</option>
      </select>
    </div>
    <p class="admin-dialog-error" id="edit-student-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-edit-student')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitEditStudent()">Save Changes</button>
    </div>
  </dialog>

  <!-- Add Lesson -->
  <dialog class="admin-dialog admin-dialog--wide" id="dialog-add-lesson">
    <h3 class="admin-dialog-title">Add Lesson</h3>
    <div class="admin-form-row">
      <div class="admin-form-field">
        <label class="admin-form-label">Title</label>
        <input class="admin-input" type="text" id="add-lesson-title" placeholder="Lesson title"
               oninput="autoSlug(this.value)">
      </div>
      <div class="admin-form-field">
        <label class="admin-form-label">Slug <span class="admin-form-hint">(URL identifier)</span></label>
        <input class="admin-input" type="text" id="add-lesson-slug" placeholder="lesson-url-slug">
      </div>
    </div>
    <div class="admin-form-row">
      <div class="admin-form-field">
        <label class="admin-form-label">Subtitle</label>
        <input class="admin-input" type="text" id="add-lesson-subtitle" placeholder="One-line tagline">
      </div>
      <div class="admin-form-field">
        <label class="admin-form-label">Category Tag</label>
        <input class="admin-input" type="text" id="add-lesson-category" placeholder="Mindset, Practical…">
      </div>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Est. Read Time <span class="admin-form-hint">(minutes)</span></label>
      <input class="admin-input admin-input--short" type="number" id="add-lesson-readtime" value="5" min="1">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Content <span class="admin-form-hint">(HTML accepted)</span></label>
      <textarea class="admin-input admin-textarea" id="add-lesson-content" rows="10"
                placeholder="<p>Lesson content here…</p>"></textarea>
    </div>
    <p class="admin-dialog-error" id="add-lesson-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-add-lesson')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitAddLesson()">Add Lesson</button>
    </div>
  </dialog>

  <!-- Edit Lesson -->
  <dialog class="admin-dialog admin-dialog--wide" id="dialog-edit-lesson">
    <h3 class="admin-dialog-title">Edit Lesson</h3>
    <input type="hidden" id="edit-lesson-id">
    <div class="admin-form-row">
      <div class="admin-form-field">
        <label class="admin-form-label">Title</label>
        <input class="admin-input" type="text" id="edit-lesson-title">
      </div>
      <div class="admin-form-field">
        <label class="admin-form-label">Subtitle</label>
        <input class="admin-input" type="text" id="edit-lesson-subtitle">
      </div>
    </div>
    <div class="admin-form-row">
      <div class="admin-form-field">
        <label class="admin-form-label">Category Tag</label>
        <input class="admin-input" type="text" id="edit-lesson-category">
      </div>
      <div class="admin-form-field">
        <label class="admin-form-label">Est. Read Time <span class="admin-form-hint">(minutes)</span></label>
        <input class="admin-input admin-input--short" type="number" id="edit-lesson-readtime" min="1">
      </div>
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Content <span class="admin-form-hint">(HTML accepted)</span></label>
      <textarea class="admin-input admin-textarea" id="edit-lesson-content" rows="10"></textarea>
    </div>
    <p class="admin-dialog-error" id="edit-lesson-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-edit-lesson')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitEditLesson()">Save Changes</button>
    </div>
  </dialog>

  <!-- Add Resource -->
  <dialog class="admin-dialog" id="dialog-add-resource">
    <h3 class="admin-dialog-title">Add Resource</h3>
    <div class="admin-form-field">
      <label class="admin-form-label">Title</label>
      <input class="admin-input" type="text" id="add-resource-title" placeholder="Resource title">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Description</label>
      <input class="admin-input" type="text" id="add-resource-desc" placeholder="Brief description">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Category</label>
      <input class="admin-input" type="text" id="add-resource-category" placeholder="e.g. Templates, Reading…">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">URL</label>
      <input class="admin-input" type="url" id="add-resource-url" placeholder="https://…">
    </div>
    <p class="admin-dialog-error" id="add-resource-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-add-resource')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitAddResource()">Add Resource</button>
    </div>
  </dialog>

  <!-- Edit Resource -->
  <dialog class="admin-dialog" id="dialog-edit-resource">
    <h3 class="admin-dialog-title">Edit Resource</h3>
    <input type="hidden" id="edit-resource-id">
    <div class="admin-form-field">
      <label class="admin-form-label">Title</label>
      <input class="admin-input" type="text" id="edit-resource-title">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Description</label>
      <input class="admin-input" type="text" id="edit-resource-desc">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">Category</label>
      <input class="admin-input" type="text" id="edit-resource-category">
    </div>
    <div class="admin-form-field">
      <label class="admin-form-label">URL</label>
      <input class="admin-input" type="url" id="edit-resource-url">
    </div>
    <p class="admin-dialog-error" id="edit-resource-error" hidden></p>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-edit-resource')">Cancel</button>
      <button class="admin-save-btn" type="button" onclick="submitEditResource()">Save Changes</button>
    </div>
  </dialog>

  <!-- View Gardener Assessment -->
  <dialog class="admin-dialog admin-dialog--wide" id="dialog-student-data">
    <h3 class="admin-dialog-title" id="student-data-title">Gardener Responses</h3>
    <div id="student-data-body" style="max-height:60vh;overflow-y:auto;font-size:0.85rem;font-weight:300;line-height:1.6"></div>
    <div class="admin-dialog-footer">
      <button class="admin-dialog-cancel" type="button" onclick="closeDialog('dialog-student-data')">Close</button>
    </div>
  </dialog>

  <script>
    // ── Lesson data for edit dialog ──────────────────────────────────────────
    const LESSON_DATA = {};
    <% for (const l of lessons) { %>
      LESSON_DATA[<%= l.id %>] = <%- JSON.stringify({
        title:               l.title,
        subtitle:            l.subtitle  || '',
        category_tag:        l.category_tag || '',
        content:             l.content   || '',
        estimated_read_time: l.estimated_read_time
      }) %>;
    <% } %>

    // ── Resource data for edit dialog ────────────────────────────────────────
    const RESOURCE_DATA = {};
    <% for (const r of resources) { %>
      RESOURCE_DATA[<%= r.id %>] = <%- JSON.stringify({
        title:        r.title,
        description:  r.description  || '',
        category_tag: r.category_tag || '',
        url:          r.url          || ''
      }) %>;
    <% } %>

    // ── Dialog helpers ───────────────────────────────────────────────────────
    function openDialog(id) {
      document.getElementById(id).showModal();
    }
    function closeDialog(id) {
      const el = document.getElementById(id);
      el.close();
      el.querySelectorAll('input:not([type=hidden]),textarea,select').forEach(i => { i.value = ''; });
      el.querySelectorAll('.admin-dialog-error').forEach(e => { e.hidden = true; e.textContent = ''; });
    }
    function showError(id, msg) {
      const el = document.getElementById(id);
      el.textContent = msg;
      el.hidden = false;
    }


    // ── View student data ─────────────────────────────────────────────────────
    async function viewStudentData(id, name) {
      document.getElementById('student-data-title').textContent = name + ' — Responses';
      const body = document.getElementById('student-data-body');
      body.textContent = 'Loading…';
      openDialog('dialog-student-data');

      const res = await fetch(`/api/admin/student-data/${id}`);
      const data = await res.json();

      let html = '';

      if (data.seeds && data.seeds.length) {
        html += '<h4 style="font-weight:700;margin:0.75rem 0 0.5rem;color:var(--color-bloem)">Seeds</h4>';
        for (const s of data.seeds) {
          const status = s.status === 'replaced' ? ' <em style="color:#D4956A">(replaced)</em>' : '';
          html += `<div style="margin-bottom:0.5rem"><strong>Seed ${s.seed_number}${status}:</strong> ${s.feeling || '—'} / ${s.looks_like || '—'}`;
          if (s.status === 'replaced' && (s.updated_feeling || s.updated_looks_like)) {
            html += `<br><span style="color:#D4956A">↳ New: ${s.updated_feeling || '—'} / ${s.updated_looks_like || '—'}</span>`;
          }
          html += '</div>';
        }
      }

      if (data.midcourse) {
        html += `<h4 style="font-weight:700;margin:1rem 0 0.5rem;color:var(--color-understory)">Mid-course Check-in ✓</h4>`;
        html += `<p style="color:rgba(16,15,16,0.5)">Tended on ${new Date(data.midcourse.completed_at).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</p>`;
      }

      if (data.opening) {
        html += '<h4 style="font-weight:700;margin:1rem 0 0.5rem;color:var(--color-bloem)">Opening Assessment</h4>';
        const q = data.opening;
        html += `<p>Q1: ${q.q1_choice} | Q2: ${q.q2_rating}/10 | Q3: ${q.q3_choice} | Q4: ${q.q4_rating}/10</p>`;
        html += `<p>Q5: ${q.q5_choice} | Q6: ${q.q6_rating}/10</p>`;
        if (q.q9_text) html += `<p><em>Vision:</em> ${q.q9_text}</p>`;
        if (q.q10_text) html += `<p><em>Promise:</em> ${q.q10_text}</p>`;
      }

      if (data.closing) {
        html += '<h4 style="font-weight:700;margin:1rem 0 0.5rem;color:var(--color-understory)">Closing Assessment</h4>';
        const q = data.closing;
        const ratingDiff = (field) => {
          if (!data.opening) return '';
          const diff = (q[field] || 0) - (data.opening[field] || 0);
          if (diff > 0) return ` <span style="color:var(--color-understory)">↑${diff}</span>`;
          if (diff < 0) return ` <span style="color:#D4956A">↓${Math.abs(diff)}</span>`;
          return ' →';
        };
        html += `<p>Q1: ${q.q1_choice} | Q2: ${q.q2_rating}/10${ratingDiff('q2_rating')} | Q3: ${q.q3_choice} | Q4: ${q.q4_rating}/10${ratingDiff('q4_rating')}</p>`;
        html += `<p>Q5: ${q.q5_choice} | Q6: ${q.q6_rating}/10${ratingDiff('q6_rating')}</p>`;
        if (q.q7_choices) html += `<p><em>What surprised them:</em> ${q.q7_choices}</p>`;
        if (q.q8_choice)  html += `<p><em>Season they spent most time in:</em> ${q.q8_choice}</p>`;
        if (q.q9_text)    html += `<p><em>Showing up feels like:</em> ${q.q9_text}</p>`;
        if (q.q10_text)   html += `<p><em>Will keep doing:</em> ${q.q10_text}</p>`;
        if (q.q11_text)   html += `<p><em>To someone starting out:</em> ${q.q11_text}</p>`;
        if (q.q12_text)   html += `<p><em>Feedback:</em> ${q.q12_text}</p>`;
      }

      body.innerHTML = html || '<p>No data yet.</p>';
    }

    // ── Manual unlock toggles ────────────────────────────────────────────────
    async function setFlag(key, value) {
      const res = await fetch('/api/admin/settings', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ key, value })
      });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Failed to update setting.');
      }
    }

    // ── Course start date ────────────────────────────────────────────────────
    document.getElementById('save-start-date')?.addEventListener('click', async () => {
      const val    = document.getElementById('course-start-date').value;
      const status = document.getElementById('start-date-status');
      const res = await fetch('/api/admin/settings', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ key: 'course_start_date', value: val })
      });
      if (res.ok) {
        status.textContent = 'Saved ✓';
        status.style.color = 'var(--color-understory)';
      } else {
        status.textContent = 'Error saving';
        status.style.color = '#c0392b';
      }
      setTimeout(() => { status.textContent = ''; }, 2500);
    });

    // ── Students ─────────────────────────────────────────────────────────────
    function openEditStudent(id, name, email, role) {
      document.getElementById('edit-student-id').value   = id;
      document.getElementById('edit-student-name').value  = name;
      document.getElementById('edit-student-email').value = email;
      document.getElementById('edit-student-role').value  = role;
      document.getElementById('edit-student-password').value = '';
      document.getElementById('edit-student-error').hidden = true;
      openDialog('dialog-edit-student');
    }

    async function submitAddStudent() {
      const name     = document.getElementById('add-student-name').value.trim();
      const email    = document.getElementById('add-student-email').value.trim();
      const password = document.getElementById('add-student-password').value;
      const role     = document.getElementById('add-student-role').value;
      if (!name || !email || !password) {
        return showError('add-student-error', 'Name, email, and password are required.');
      }
      const res = await fetch('/api/admin/users', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ name, email, password, role })
      });
      const data = await res.json();
      if (!res.ok) return showError('add-student-error', data.error);

      const u = data.user;
      const list = document.getElementById('student-list');
      list.insertAdjacentHTML('beforeend', buildUserRow(u));
      updateStudentCount(1);
      closeDialog('dialog-add-student');
    }

    async function submitEditStudent() {
      const id       = parseInt(document.getElementById('edit-student-id').value);
      const name     = document.getElementById('edit-student-name').value.trim();
      const email    = document.getElementById('edit-student-email').value.trim();
      const password = document.getElementById('edit-student-password').value;
      const role     = document.getElementById('edit-student-role').value;
      if (!name || !email) return showError('edit-student-error', 'Name and email are required.');

      const res = await fetch(`/api/admin/users/${id}`, {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ name, email, role, password: password || undefined })
      });
      const data = await res.json();
      if (!res.ok) return showError('edit-student-error', data.error);

      const row = document.getElementById(`user-row-${id}`);
      if (row) {
        row.querySelector('.admin-user-name').textContent  = name;
        row.querySelector('.admin-user-email').textContent = email;
        const roleEl = row.querySelector('.admin-user-role');
        roleEl.textContent = role === 'admin' ? 'Curator' : 'Gardener';
        roleEl.classList.toggle('admin-role--admin', role === 'admin');
        const initial = row.querySelector('.sidebar-avatar');
        if (initial) initial.textContent = name.charAt(0).toUpperCase();
      }
      closeDialog('dialog-edit-student');
    }

    async function deleteUser(id, name) {
      if (!confirm(`Delete ${name}? This removes their account and all their data.`)) return;
      const res = await fetch(`/api/admin/users/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) return alert(data.error);
      document.getElementById(`user-row-${id}`)?.remove();
      updateStudentCount(-1);
    }

    function updateStudentCount(delta) {
      const el = document.getElementById('student-count');
      const n = parseInt(el.textContent) + delta;
      el.textContent = `${n} enrolled`;
    }

    function buildUserRow(u) {
      const initial = u.avatar_initial || u.name.charAt(0).toUpperCase();
      const roleLabel = u.role === 'admin' ? 'Curator' : 'Gardener';
      const roleClass = u.role === 'admin' ? 'admin-role--admin' : '';
      return `
        <div class="admin-user-row" id="user-row-${u.id}">
          <div class="sidebar-avatar" style="width:32px;height:32px;font-size:0.85rem;flex-shrink:0">
            ${initial}
          </div>
          <div class="admin-user-info">
            <span class="admin-user-name">${u.name}</span>
            <span class="admin-user-email">${u.email}</span>
          </div>
          <span class="admin-user-role ${roleClass}">${roleLabel}</span>
          <div class="admin-row-actions">
            <button class="admin-btn-icon" type="button" title="Edit"
              onclick="openEditStudent(${u.id}, ${JSON.stringify(u.name)}, ${JSON.stringify(u.email || '')}, ${JSON.stringify(u.role)})">✎</button>
            <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
              onclick="deleteUser(${u.id}, ${JSON.stringify(u.name)})">✕</button>
          </div>
        </div>`;
    }

    // ── Lessons ──────────────────────────────────────────────────────────────
    function autoSlug(title) {
      const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      document.getElementById('add-lesson-slug').value = slug;
    }

    function openEditLesson(id) {
      const l = LESSON_DATA[id];
      if (!l) return;
      document.getElementById('edit-lesson-id').value       = id;
      document.getElementById('edit-lesson-title').value    = l.title;
      document.getElementById('edit-lesson-subtitle').value = l.subtitle;
      document.getElementById('edit-lesson-category').value = l.category_tag;
      document.getElementById('edit-lesson-readtime').value = l.estimated_read_time;
      document.getElementById('edit-lesson-content').value  = l.content;
      document.getElementById('edit-lesson-error').hidden   = true;
      openDialog('dialog-edit-lesson');
    }

    async function submitAddLesson() {
      const title    = document.getElementById('add-lesson-title').value.trim();
      const slug     = document.getElementById('add-lesson-slug').value.trim();
      const subtitle = document.getElementById('add-lesson-subtitle').value.trim();
      const category_tag = document.getElementById('add-lesson-category').value.trim();
      const estimated_read_time = parseInt(document.getElementById('add-lesson-readtime').value) || 5;
      const content  = document.getElementById('add-lesson-content').value;
      if (!title || !slug) return showError('add-lesson-error', 'Title and slug are required.');

      const res = await fetch('/api/admin/lessons', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ slug, title, subtitle, category_tag, content, estimated_read_time })
      });
      const data = await res.json();
      if (!res.ok) return showError('add-lesson-error', data.error);
      closeDialog('dialog-add-lesson');
      window.location.reload();
    }

    async function submitEditLesson() {
      const id       = parseInt(document.getElementById('edit-lesson-id').value);
      const title    = document.getElementById('edit-lesson-title').value.trim();
      const subtitle = document.getElementById('edit-lesson-subtitle').value.trim();
      const category_tag = document.getElementById('edit-lesson-category').value.trim();
      const estimated_read_time = parseInt(document.getElementById('edit-lesson-readtime').value) || 5;
      const content  = document.getElementById('edit-lesson-content').value;
      if (!title) return showError('edit-lesson-error', 'Title is required.');

      const res = await fetch(`/api/admin/lessons/${id}`, {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ title, subtitle, category_tag, content, estimated_read_time })
      });
      const data = await res.json();
      if (!res.ok) return showError('edit-lesson-error', data.error);

      const row = document.getElementById(`lesson-row-${id}`);
      if (row) {
        row.querySelector('.admin-lesson-title').textContent = title;
        row.querySelector('.admin-lesson-count').textContent = `${estimated_read_time} min`;
        const tagEl = row.querySelector('.admin-lesson-tag');
        if (tagEl) tagEl.textContent = category_tag;
      }
      LESSON_DATA[id] = { title, subtitle, category_tag, content, estimated_read_time };
      closeDialog('dialog-edit-lesson');
    }

    async function deleteLesson(id, title) {
      if (!confirm(`Delete "${title}"? This also removes all gardener completion records for this field note.`)) return;
      const res = await fetch(`/api/admin/lessons/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) return alert(data.error);
      document.getElementById(`lesson-row-${id}`)?.remove();
    }

    async function moveLesson(id, direction) {
      const res = await fetch(`/api/admin/lessons/${id}/move`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ direction })
      });
      if (res.ok) window.location.reload();
    }

    // ── Resources ────────────────────────────────────────────────────────────
    function openEditResource(id) {
      const r = RESOURCE_DATA[id];
      if (!r) return;
      document.getElementById('edit-resource-id').value       = id;
      document.getElementById('edit-resource-title').value    = r.title;
      document.getElementById('edit-resource-desc').value     = r.description;
      document.getElementById('edit-resource-category').value = r.category_tag;
      document.getElementById('edit-resource-url').value      = r.url;
      document.getElementById('edit-resource-error').hidden   = true;
      openDialog('dialog-edit-resource');
    }

    async function submitAddResource() {
      const title       = document.getElementById('add-resource-title').value.trim();
      const description = document.getElementById('add-resource-desc').value.trim();
      const category_tag = document.getElementById('add-resource-category').value.trim();
      const url         = document.getElementById('add-resource-url').value.trim();
      if (!title) return showError('add-resource-error', 'Title is required.');

      const res = await fetch('/api/admin/resources', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ title, description, category_tag, url })
      });
      const data = await res.json();
      if (!res.ok) return showError('add-resource-error', data.error);

      const id = data.id;
      RESOURCE_DATA[id] = { title, description, category_tag, url };
      document.getElementById('resource-list').insertAdjacentHTML('beforeend', buildResourceRow(id, title, category_tag, description, url));
      closeDialog('dialog-add-resource');
    }

    async function submitEditResource() {
      const id          = parseInt(document.getElementById('edit-resource-id').value);
      const title       = document.getElementById('edit-resource-title').value.trim();
      const description = document.getElementById('edit-resource-desc').value.trim();
      const category_tag = document.getElementById('edit-resource-category').value.trim();
      const url         = document.getElementById('edit-resource-url').value.trim();
      if (!title) return showError('edit-resource-error', 'Title is required.');

      const res = await fetch(`/api/admin/resources/${id}`, {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ title, description, category_tag, url })
      });
      const data = await res.json();
      if (!res.ok) return showError('edit-resource-error', data.error);

      const row = document.getElementById(`resource-row-${id}`);
      if (row) {
        row.querySelector('.admin-resource-title').textContent = title;
        const tagEl = row.querySelector('.admin-lesson-tag');
        if (tagEl) tagEl.textContent = category_tag;
        const descEl = row.querySelector('.admin-resource-desc');
        if (descEl) descEl.textContent = description;
        const urlEl = row.querySelector('.admin-resource-url');
        if (urlEl) { urlEl.textContent = url.length > 40 ? url.slice(0, 40) + '…' : url; urlEl.href = url; }
      }
      RESOURCE_DATA[id] = { title, description, category_tag, url };
      closeDialog('dialog-edit-resource');
    }

    async function deleteResource(id, title) {
      if (!confirm(`Delete "${title}"?`)) return;
      const res = await fetch(`/api/admin/resources/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) return alert(data.error);
      document.getElementById(`resource-row-${id}`)?.remove();
    }

    function buildResourceRow(id, title, category_tag, description, url) {
      const shortUrl = url && url.length > 40 ? url.slice(0, 40) + '…' : (url || '');
      const tagHtml = category_tag ? `<span class="admin-lesson-tag">${category_tag}</span>` : '';
      const descHtml = description ? `<span class="admin-resource-desc">${description}</span>` : '';
      const urlHtml = url ? `<a class="admin-resource-url" href="${url}" target="_blank" rel="noopener">${shortUrl}</a>` : '';
      return `
        <div class="admin-resource-row" id="resource-row-${id}">
          <div class="admin-resource-info">
            <span class="admin-resource-title">${title}</span>
            ${tagHtml}
            ${descHtml}
          </div>
          ${urlHtml}
          <div class="admin-row-actions">
            <button class="admin-btn-icon" type="button" title="Edit"
              onclick="openEditResource(${id})">✎</button>
            <button class="admin-btn-icon admin-btn-icon--danger" type="button" title="Delete"
              onclick="deleteResource(${id}, ${JSON.stringify(title)})">✕</button>
          </div>
        </div>`;
    }
  </script>

</body>
</html>
