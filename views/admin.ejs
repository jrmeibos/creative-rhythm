    // Admin password help: set a fresh temporary password and show it once so
    // the admin can relay it to a locked-out gardener.
    async function resetStudentPassword(id, name) {
      if (!confirm(`Set a new temporary password for ${name}?\n\nTheir current password will stop working immediately.`)) return;
      const res = await fetch(`/api/admin/users/${id}/reset-password`, { method: 'POST' });
      const data = await res.json();
      if (!res.ok) return alert(data.error || 'Could not reset password.');
      document.getElementById('temp-pw-name').textContent = data.name;
      document.getElementById('temp-pw-value').textContent = data.tempPassword;
      openDialog('dialog-temp-password');
