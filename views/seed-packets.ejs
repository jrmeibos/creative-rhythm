<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/seed-packets.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content">

      <div class="cm-header">
        <h1 class="cm-title">Seed Packets</h1>
        <p class="cm-subtitle">Five different angles. Thirty-five questions. Gather what's already alive in you.</p>
      </div>

      <div class="cm-map-wrap">
        <svg viewBox="0 0 920 560" width="100%" preserveAspectRatio="xMidYMid meet"
             class="seed-packets-svg" xmlns="http://www.w3.org/2000/svg">
          <title>Seed Packets</title>
          <desc>Five seed packets on a shelf, each representing an angle of self-inquiry. Click a packet to explore its questions.</desc>

          <defs>
            <!-- Sparse seeds (count 2–3) -->
            <pattern id="seeds-3of7" patternUnits="userSpaceOnUse" width="28" height="18">
              <ellipse cx="7"  cy="7"  rx="3.5" ry="1.8" transform="rotate(-30  7  7)" fill="#705C6C" opacity="0.65"/>
              <ellipse cx="21" cy="13" rx="3.5" ry="1.8" transform="rotate( 25 21 13)" fill="#705C6C" opacity="0.65"/>
            </pattern>
            <!-- Medium seeds (count 4–6) -->
            <pattern id="seeds-many" patternUnits="userSpaceOnUse" width="18" height="13">
              <ellipse cx="5"  cy="5"  rx="3"   ry="1.6" transform="rotate(-20  5  5)" fill="#705C6C" opacity="0.72"/>
              <ellipse cx="14" cy="9"  rx="3"   ry="1.6" transform="rotate( 30 14  9)" fill="#705C6C" opacity="0.72"/>
            </pattern>
            <!-- Dense seeds (count 7) -->
            <pattern id="seeds-full" patternUnits="userSpaceOnUse" width="11" height="8">
              <ellipse cx="3" cy="3" rx="2.5" ry="1.3" transform="rotate(-15  3  3)" fill="#705C6C" opacity="0.78"/>
              <ellipse cx="8" cy="6" rx="2.5" ry="1.3" transform="rotate( 35  8  6)" fill="#705C6C" opacity="0.78"/>
            </pattern>
            <!-- Soft shadow under each packet -->
            <radialGradient id="packet-shadow" cx="50%" cy="50%" r="50%">
              <stop offset="0%"   stop-color="#705C6C" stop-opacity="0.18"/>
              <stop offset="100%" stop-color="#705C6C" stop-opacity="0"/>
            </radialGradient>
          </defs>

          <!-- Background -->
          <rect width="920" height="560" fill="#F2EEE3"/>

          <!-- Shadows (before shelf so line renders on top) -->
          <ellipse cx="155" cy="465" rx="68" ry="6" fill="url(#packet-shadow)"/>
          <ellipse cx="315" cy="465" rx="68" ry="6" fill="url(#packet-shadow)"/>
          <ellipse cx="475" cy="465" rx="68" ry="6" fill="url(#packet-shadow)"/>
          <ellipse cx="635" cy="465" rx="68" ry="6" fill="url(#packet-shadow)"/>
          <ellipse cx="795" cy="465" rx="68" ry="6" fill="url(#packet-shadow)"/>

          <!-- Shelf -->
          <line x1="60" y1="465" x2="860" y2="465" stroke="#705C6C" stroke-width="1" opacity="0.35"/>

          <!-- ── Five packets ──────────────────────────────────────────── -->
          <%
          const packetSlots = [
            { id: 'remembering', tx: 85  },
            { id: 'noticing',    tx: 245 },
            { id: 'allowing',    tx: 405 },
            { id: 'imagining',   tx: 565 },
            { id: 'knowing',     tx: 725 },
          ];
          const dotDX = [-36, -24, -12, 0, 12, 24, 36];
          const PACKET_TY = 225;
          %>

          <% packetSlots.forEach(function(slot) {
            const angle = angles.find(function(a) { return a.id === slot.id; });
            if (!angle) return;
            const count   = counts[angle.id] || 0;
            const isFull  = count === 7;
            const shortSub = angle.subtitle.split(' — ')[0];
          %>
          <a href="/seed-packets/<%= angle.id %>" class="packet-link">
            <g transform="translate(<%= slot.tx %>, <%= PACKET_TY %>)">
              <g class="packet-group">

                <% if (isFull) { %>
                <!-- Apricity completion ring — drawn before rect so it sits behind -->
                <rect x="-6" y="-24" width="152" height="270" rx="5"
                      fill="none" stroke="#F6C95C" stroke-width="2.5" opacity="0.7"/>
                <% } %>

                <!-- Packet body -->
                <rect x="0" y="0" width="140" height="240" rx="3"
                      fill="#FAFAFA" stroke="#705C6C" stroke-width="1.2"/>

                <!-- Flap -->
                <path d="M 0 0 L 70 -18 L 140 0 L 140 22 L 0 22 Z"
                      fill="#FAFAFA" stroke="#705C6C" stroke-width="1.2"/>

                <!-- Shadow under flap fold -->
                <line x1="0" y1="22" x2="140" y2="22"
                      stroke="#705C6C" stroke-width="0.5" opacity="0.4"/>

                <!-- Seeds through opening -->
                <% if (count === 1) { %>
                <ellipse cx="70" cy="12" rx="2.5" ry="1.5" fill="#705C6C" opacity="0.7"/>
                <% } else if (count >= 2 && count <= 3) { %>
                <rect x="4" y="14" width="132" height="22" fill="url(#seeds-3of7)"/>
                <% } else if (count >= 4 && count <= 6) { %>
                <rect x="4" y="12" width="132" height="22" fill="url(#seeds-many)"/>
                <% } else if (count === 7) { %>
                <rect x="4" y="12" width="132" height="22" fill="url(#seeds-full)"/>
                <% } %>

                <!-- Angle name -->
                <text x="70" y="95" text-anchor="middle"
                      font-family="Goldage, Georgia, serif"
                      font-size="18" font-weight="400"
                      fill="#100F10"><%= angle.name %></text>

                <!-- Thin separator -->
                <line x1="30" y1="112" x2="110" y2="112"
                      stroke="#76856C" stroke-width="0.5" opacity="0.5"/>

                <!-- Short subtitle (text before the em dash) -->
                <text x="70" y="130" text-anchor="middle"
                      font-family="Goldage, Georgia, serif"
                      font-style="italic" font-size="9"
                      textLength="120" lengthAdjust="spacingAndGlyphs"
                      fill="#76856C"><%= shortSub %></text>

                <!-- 7 progress dots -->
                <g transform="translate(70, 200)">
                  <% dotDX.forEach(function(dx, i) { %>
                  <circle cx="<%= dx %>" cy="0" r="3"
                          fill="#705C6C"
                          opacity="<%= i < count ? '1' : '0.2' %>"/>
                  <% }); %>
                </g>

              </g>
            </g>
          </a>
          <% }); %>

        </svg>
      </div>

      <!-- ── Bottom hint ──────────────────────────────────────────────────── -->
      <div class="cm-hint-wrap" style="margin-top: 1.25rem;">
        <% if (totalAnswered === 0) { %>
          <p class="cm-hint-text">Begin anywhere — answer at least 10 questions. The more the better.</p>
        <% } else if (totalAnswered < 10) { %>
          <p class="cm-hint-text">
            <%= totalAnswered %> of 35 questions answered — answer <%= 10 - totalAnswered %> more to identify your seeds
          </p>
        <% } else if (!synthesisState.has_completed_synthesis) { %>
          <p class="cm-hint-text"><%= totalAnswered %> of 35 questions answered</p>
          <a href="/seed-packets/synthesize" class="cm-synth-start-btn" style="margin-top:0.75rem;">Ready to identify your seeds →</a>
        <% } else { %>
          <a href="/seed-packets/threads" class="cm-synth-start-btn">Your threads are mapped. Tend to them →</a>
          <% if (userThreads.length > 0) { %>
            <p class="cm-threads-tagline">
              Your threads right now:
              <% userThreads.forEach(function(t, i) { %>
                <a href="/seed-packets/threads" class="cm-threads-tagline-name"><%= t.name %></a><% if (i < userThreads.length - 1) { %> · <% } %>
              <% }); %>
            </p>
          <% } %>
        <% } %>
      </div>

    </main>
  </div>
</body>
</html>
