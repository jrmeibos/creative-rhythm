<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/greenhouse.css">
  <link rel="stylesheet" href="/css/onboarding.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content" id="main">

      <% if (state === 'welcome') { %>
      <!-- ══ WELCOME (first visit) ═════════════════════════════════════════ -->
      <div class="gh-locked">
        <div class="gh-locked-icon" aria-hidden="true">
          <svg viewBox="0 0 80 96" width="72" height="86" fill="none">
            <line x1="40" y1="88" x2="40" y2="52" stroke="#76856C" stroke-width="3" stroke-linecap="round"/>
            <path d="M40 68 C40 68 24 62 22 46 C34 44 40 58 40 68Z" fill="#76856C" opacity="0.65"/>
            <path d="M40 60 C40 60 56 54 58 38 C46 36 40 52 40 60Z" fill="#76856C"/>
            <line x1="26" y1="88" x2="54" y2="88" stroke="#D8B0AB" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        <h1 class="gh-locked-title">The Greenhouse</h1>
        <div class="gh-welcome-body">
          <p>Here is your greenhouse.</p>
          <p>In the coming weeks, we will plant goals here — intentions for what you want to work on during our time together.</p>
          <p>But for now, this season is about figuring out what you want to plant. We will start with reflecting, knowing that this intentionality will set us up for success in the rest of the course.</p>
        </div>
        <form method="POST" action="/greenhouse/enter" style="margin-top:2rem">
          <button type="submit" class="ob-btn ob-btn--primary">Enter Your Greenhouse →</button>
        </form>
      </div>

      <% } else if (state === 'beds-empty') { %>
      <!-- ══ BEDS EMPTY STATE ═══════════════════════════════════════════════ -->
      <header class="dash-header">
        <div class="dash-greeting">
          <h1 class="dash-greeting-text">The Greenhouse</h1>
        </div>
        <% if (isWinterLocked) { %>
        <p class="gh-subtitle">A quiet greenhouse. Beds wait for Spring.</p>
        <% } else { %>
        <p class="gh-subtitle">Plant three goals. What do you hope to grow?</p>
        <% } %>
      </header>

      <section class="dash-section">
        <div class="gh-beds">
          <% for (let n = 1; n <= 3; n++) { %>
            <% const isBedEmpty = emptyBedPositions.includes(n); %>
            <div class="gh-bed">
              <span class="gh-bed-label">Bed <%= n %></span>
              <% if (!isBedEmpty) { %>
                <span class="gh-bed-filled-note">Planted</span>
              <% } else if (isWinterLocked) { %>
                <p class="gh-bed-winter-note">It's currently Winter. Come back in Spring to plant your goals.</p>
              <% } else { %>
                <a href="/greenhouse/plant?bed=<%= n %>" class="gh-bed-cta">+ plant a goal</a>
              <% } %>
            </div>
          <% } %>
        </div>
        <p class="gh-beds-caption">You can plant up to three goals here. Plant them one at a time, in whatever order feels right.</p>
      </section>

      <!-- ── Your Cuttings — full section, in beds-empty state ───────────── -->
      <%- include('partials/greenhouse-cuttings-section') %>

      <% } else { %>
      <!-- ══ TENDING STATE ════════════════════════════════════════════════ -->
      <header class="dash-header">
        <div class="dash-greeting">
          <h1 class="dash-greeting-text">The Greenhouse</h1>
        </div>
        <p class="gh-subtitle">Tend what you planted. Watch what grows.</p>
      </header>

      <% if (gardenStage) { %>
      <section class="garden-visual">
        <div class="garden-visual-illustration">
          <img src="/images/greenhouse/stage-<%= gardenStage %>-<%= stageSlug %>.svg"
               alt="Your garden — <%= stageLabel %>"
               class="plant-svg" />
        </div>
        <% if (weekNumber) { %>
        <p class="garden-visual-caption">
          <span class="caption-week">Week <%= weekNumber %> of 12</span><% if (curricularSeason) { %> · <span class="curricular-season-label"><%= curricularSeason.charAt(0).toUpperCase() + curricularSeason.slice(1) %></span><% } %>
        </p>
        <% } %>
      </section>
      <% } %>

      <% if (closing) { %>
      <!-- ── Growth Check: Then & Now (above goals) ────────────────────────── -->
      <section class="dash-section">
        <div class="gh-growth-check">
          <h2 class="gh-growth-check-title">Growth Check</h2>
          <div class="harvest-reveal">
            <p class="harvest-reveal-sub">Here is where you started — and where you are now.</p>

            <div class="harvest-questions">
              <% questions.slice(0, 6).forEach(function(q, qi) { %>
                <div class="harvest-q-item">
                  <div class="harvest-q-header">
                    <span class="harvest-q-num">0<%= qi + 1 %></span>
                    <p class="harvest-q-text"><%= q.text %></p>
                  </div>

                  <div class="harvest-q-body">
                    <% if (q.type === 'rating') { %>
                      <%
                        const rThen = opening ? (parseInt(opening[q.field]) || 0) : 0;
                        const rNow  = parseInt(closing[q.field]) || 0;
                        const rDiff = (rThen > 0 && rNow > 0) ? rNow - rThen : null;
                        const rThenPct = rThen ? ((rThen - 1) / 9 * 100).toFixed(1) : 0;
                        const rNowPct  = rNow  ? ((rNow  - 1) / 9 * 100).toFixed(1) : 0;
                      %>
                      <div class="harvest-rating-row">
                        <span class="harvest-rating-epoch">Then</span>
                        <div class="harvest-rating-track">
                          <div class="harvest-rating-dot" style="left:<%= rThenPct %>%"></div>
                        </div>
                        <span class="harvest-rating-score"><%= rThen || '—' %></span>
                      </div>
                      <div class="harvest-rating-row">
                        <span class="harvest-rating-epoch harvest-rating-epoch--now">Now</span>
                        <div class="harvest-rating-track">
                          <div class="harvest-rating-dot harvest-rating-dot--now" style="left:<%= rNowPct %>%"></div>
                        </div>
                        <span class="harvest-rating-score harvest-rating-score--now"><%= rNow || '—' %></span>
                        <% if (rDiff !== null) { %>
                          <span class="harvest-rating-badge harvest-rating-badge--<%= rDiff > 0 ? 'up' : rDiff < 0 ? 'down' : 'same' %>"><%= rDiff > 0 ? '+' : '' %><%= rDiff %> pts</span>
                        <% } %>
                      </div>
                      <p class="harvest-rating-scale"><span><%= q.low %></span><span><%= q.high %></span></p>

                    <% } else { %>
                      <%
                        const cThen = opening ? (opening[q.field] || '') : '';
                        const cNow  = closing[q.field] || '';
                        const cThenLabel = cThen ? q.choices.find(c => c.val === cThen) : null;
                        const cNowLabel  = cNow  ? q.choices.find(c => c.val === cNow)  : null;
                        const cSame = !!(cThen && cNow && cThen === cNow);
                      %>
                      <% if (cSame) { %>
                        <div class="harvest-choice-same">
                          <span class="harvest-consistent">Consistent 🌿</span>
                          <p class="harvest-choice-answer"><%= cThenLabel ? cThenLabel.label : cThen %></p>
                        </div>
                      <% } else { %>
                        <div class="harvest-choice-cols">
                          <div class="harvest-choice-col">
                            <span class="harvest-choice-epoch">Then</span>
                            <p class="harvest-choice-answer"><%= cThenLabel ? cThenLabel.label : (cThen || '—') %></p>
                          </div>
                          <div class="harvest-choice-col harvest-choice-col--now">
                            <span class="harvest-choice-epoch harvest-choice-epoch--now">Now</span>
                            <p class="harvest-choice-answer"><%= cNowLabel ? cNowLabel.label : (cNow || '—') %></p>
                          </div>
                        </div>
                      <% } %>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>

            <div class="harvest-closing">
              <h3 class="harvest-closing-title">You showed up. 🌿</h3>
              <p class="harvest-closing-body">That's the whole thing.<br>That's always been the whole thing.</p>
            </div>

            <button class="gh-harvest-link" id="gh-full-answers-toggle" type="button">
              Read my full harvest answers →
            </button>
          </div>

          <div id="gh-full-answers" class="gh-full-answers is-hidden">
            <h3 class="gh-full-answers-title">Your harvest answers.</h3>
            <div class="harvest-questions">
              <% closingQuestions.forEach(function(q, qi) { %>
                <% const faVal = closing[q.field]; %>
                <% if (faVal) { %>
                  <div class="harvest-q-item">
                    <div class="harvest-q-header">
                      <span class="harvest-q-num"><%= (qi + 7) < 10 ? '0' + (qi + 7) : (qi + 7) %></span>
                      <p class="harvest-q-text"><%= q.text %></p>
                    </div>
                    <div class="harvest-q-body">
                      <% if (q.type === 'choice') { %>
                        <% const faChoiceLabel = q.choices.find(c => c.val === faVal); %>
                        <div class="harvest-open-answer"><%= faChoiceLabel ? faChoiceLabel.label : faVal %></div>
                      <% } else { %>
                        <div class="harvest-open-answer"><%= faVal %></div>
                      <% } %>
                    </div>
                  </div>
                <% } %>
              <% }); %>
            </div>
          </div>
        </div>
      </section>
      <% } %>

      <%
        // Render a goal's facets:
        //   - 4-facet goals: Seed always visible; Soil/Water/Bloom collapsed
        //     behind a "See more ↓" toggle. Toggling is handled by a single
        //     delegated click listener at the bottom of this view.
        //   - Legacy 2-field goals: feeling + looks_like, always visible.
        //   - No goal / no content: gentle "Not yet planted" placeholder.
        function renderFacets(g, faded) {
          const labelCls = faded ? 'gh-col-label gh-col-label--faded' : 'gh-col-label';
          const textCls  = faded ? 'gh-col-text gh-col-text--faded'   : 'gh-col-text';
          const esc = s => String(s == null ? '' : s)
            .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
          if (!g) {
            return '<p class="' + textCls + '"><em class="gh-empty">Not yet planted</em></p>';
          }
          const hasFacets = g.soil || g.seed || g.water || g.bloom;
          const hasLegacy = g.feeling || g.looks_like;
          if (!hasFacets && !hasLegacy) {
            return '<p class="' + textCls + '"><em class="gh-empty">Not yet planted</em></p>';
          }
          const facetBlock = (label, descriptor, val) =>
            '<div>' +
              '<span class="' + labelCls + '">' + label + '</span>' +
              (descriptor ? '<p class="gh-col-descriptor">' + descriptor + '</p>' : '') +
              '<p class="' + textCls + '">' + esc(val) + '</p>' +
            '</div>';

          if (hasFacets) {
            const seed   = facetBlock('🌱 The Seed',  "what you're growing",     g.seed);
            const soil   = facetBlock('🪴 The Soil',  "where you're starting",   g.soil);
            const water  = facetBlock('💧 The Water', "how you'll tend it",      g.water);
            const bloom  = facetBlock('🌸 The Bloom', 'what success looks like', g.bloom);
            return '<div class="gh-seed-stack">' + seed +
                     '<button type="button" class="gh-facets-toggle" aria-expanded="false">' +
                       '<span class="gh-facets-toggle-text">See more</span> ' +
                       '<span class="gh-facets-toggle-arrow" aria-hidden="true">↓</span>' +
                     '</button>' +
                     '<div class="gh-facets-extra is-hidden">' + soil + water + bloom + '</div>' +
                   '</div>';
          }

          // Legacy 2-field — render both rows directly, no toggle.
          return '<div class="gh-seed-stack">' +
                   facetBlock('The feeling',        null, g.feeling) +
                   facetBlock('What it looks like', null, g.looks_like) +
                 '</div>';
        }
      %>

      <section class="dash-section">
        <div class="gh-seeds">
          <% for (let n = 1; n <= 3; n++) { %>
            <% const entry = goals[n] || { original: null, replacement: null }; %>
            <% const orig = entry.original; %>
            <% const repl = entry.replacement; %>
            <% const seedLabel = ['One', 'Two', 'Three'][n - 1]; %>
            <% const isKept = orig && !!orig.kept_at; %>

            <div class="gh-seed-card" id="gh-card-<%= n %>">
              <div class="gh-seed-num">Goal <%= seedLabel %></div>

              <% if (repl) { %>
                <!-- ── Replaced: show original greyed, replacement active ── -->
                <div class="gh-original-block">
                  <span class="gh-original-label">Originally planted</span>
                  <%- renderFacets(orig, true) %>
                </div>

                <div class="gh-active-block" id="gh-active-<%= n %>">
                  <div class="gh-active-header">
                    <span class="gh-updated-tag">New goal planted</span>
                    <button class="gh-pencil-btn" type="button"
                            aria-label="Edit this goal"
                            onclick="openEdit(<%= JSON.stringify({id: repl.id, n: n, soil: repl.soil || '', seed: repl.seed || '', water: repl.water || '', bloom: repl.bloom || '', feeling: repl.feeling || '', looks_like: repl.looks_like || ''}) %>)">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M9.5 2.5L11.5 4.5L4.5 11.5H2.5v-2L9.5 2.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                  <div id="gh-view-<%= n %>">
                    <%- renderFacets(repl, false) %>
                  </div>
                  <div class="gh-edit-form is-hidden" id="gh-edit-<%= n %>">
                    <%- include('partials/greenhouse-facet-fields', { n: n, prefix: 'gh-ef' }) %>
                    <div class="gh-edit-footer">
                      <button class="gh-save-btn" type="button" onclick="saveEdit(<%= repl.id %>, <%= n %>)">Save</button>
                      <button class="gh-cancel-btn" type="button" onclick="cancelEdit(<%= n %>)">Cancel</button>
                    </div>
                  </div>
                </div>

              <% } else { %>
                <!-- ── Original only: show with keep/replace buttons ── -->
                <div class="gh-active-block" id="gh-active-<%= n %>">
                  <div class="gh-active-header">
                    <% if (orig) { %>
                    <button class="gh-pencil-btn" type="button"
                            aria-label="Edit this goal"
                            onclick="openEdit(<%= JSON.stringify({id: orig.id, n: n, soil: orig.soil || '', seed: orig.seed || '', water: orig.water || '', bloom: orig.bloom || '', feeling: orig.feeling || '', looks_like: orig.looks_like || ''}) %>)">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M9.5 2.5L11.5 4.5L4.5 11.5H2.5v-2L9.5 2.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <% } %>
                  </div>
                  <div id="gh-view-<%= n %>">
                    <%- renderFacets(orig, false) %>
                    <% if (!orig) { %>
                      <!-- Empty bed in tending state: surface the same plant CTA
                           the beds-empty template uses, so students can plant
                           goals 2 and 3 after planting goal 1. No Winter gate
                           here — once tending starts, the "wait for Spring"
                           gate has been crossed. -->
                      <a href="/greenhouse/plant?bed=<%= n %>" class="gh-bed-cta">+ plant a goal</a>
                    <% } %>
                  </div>
                  <div class="gh-edit-form is-hidden" id="gh-edit-<%= n %>">
                    <%- include('partials/greenhouse-facet-fields', { n: n, prefix: 'gh-ef' }) %>
                    <div class="gh-edit-footer">
                      <button class="gh-save-btn" type="button" onclick="saveEdit(<%= orig ? orig.id : 0 %>, <%= n %>)">Save</button>
                      <button class="gh-cancel-btn" type="button" onclick="cancelEdit(<%= n %>)">Cancel</button>
                    </div>
                  </div>
                </div>

                <div class="gh-actions<%= (isKept || !orig) ? ' is-hidden' : '' %>" id="gh-actions-<%= n %>">
                  <% if (orig) { %>
                    <button class="gh-keep-btn" type="button" onclick="keepGoal(<%= orig.id %>, <%= n %>)">Keep growing 🌿</button>
                  <% } %>
                  <button class="gh-replace-btn" type="button" onclick="openReplace(<%= n %>)">Plant something new 🌱</button>
                </div>

                <div class="gh-kept-confirm<%= isKept ? '' : ' is-hidden' %>" id="gh-kept-<%= n %>">
                  <span class="gh-kept-badge">Still growing 🌿</span>
                  <% if (orig) { %>
                    <button class="gh-undo-keep" type="button" onclick="unkeepGoal(<%= orig.id %>, <%= n %>)">Undo</button>
                  <% } %>
                </div>

                <div class="gh-replace-form is-hidden" id="gh-replace-<%= n %>">
                  <p class="gh-replace-label">What are you planting now?</p>
                  <%- include('partials/greenhouse-facet-fields', { n: n, prefix: 'gh-rf' }) %>
                  <div class="gh-edit-footer">
                    <button class="gh-save-btn" type="button" onclick="saveReplace(<%= n %>)">Plant this goal 🌱</button>
                    <button class="gh-cancel-btn" type="button" onclick="cancelReplace(<%= n %>)">Cancel</button>
                  </div>
                </div>

              <% } %>
            </div>
          <% } %>
        </div>
      </section>

      <!-- ── Your Cuttings — full section, in tending state ──────────────── -->
      <%- include('partials/greenhouse-cuttings-section') %>

      <!-- ── Growth Check (locked / form — hidden once completed) ────────── -->
      <% if (!closing) { %>
      <section class="dash-section">
        <div class="gh-growth-check">
          <% if (!growthCheckUnlocked) { %>
            <div class="gh-growth-check-locked">
              <h2 class="gh-growth-check-title">Growth Check 🌾</h2>
              <p class="gh-growth-check-body">At the end of the course, you'll return here to see how far you've grown. This reflection unlocks on <%= growthCheckDate || 'Week 11' %>.</p>
              <button class="gh-growth-check-btn gh-growth-check-btn--locked" type="button" disabled>
                Growth Check not yet available
              </button>
            </div>
          <% } else { %>
            <!-- ── Harvest Assessment Form ─────────────────────────────────── -->
            <h2 class="gh-growth-check-title">Growth Check 🌾</h2>
            <p class="harvest-assess-intro">Before we look at how far you've come — answer these questions from where you are right now. Don't look back first.</p>

            <div class="harvest-progress-wrap">
              <div class="harvest-progress-bar" id="harvest-progress-bar" style="width:0%"></div>
            </div>

            <form class="harvest-form" id="harvest-form" style="margin-top:1.5rem">
              <div class="ob-questions">
                <!-- Q1–Q6: same questions as opening -->
                <% questions.slice(0, 6).forEach(function(q, idx) { %>
                <div class="ob-question" id="hq-block-<%= q.id %>">
                  <div class="ob-q-num">0<%= idx + 1 %></div>
                  <p class="ob-q-text"><%= q.text %></p>
                  <% if (q.type === 'choice') { %>
                    <div class="ob-choices">
                      <% q.choices.forEach(function(c) { %>
                        <button type="button" class="ob-choice" data-group="<%= q.field %>" data-value="<%= c.val %>">
                          <span class="ob-choice-val"><%= c.val %></span>
                          <span class="ob-choice-label"><%= c.label %></span>
                        </button>
                      <% }); %>
                    </div>
                  <% } else { %>
                    <p class="ob-rating-scale"><span><%= q.low %></span><span><%= q.high %></span></p>
                    <div class="ob-rating-row">
                      <% for (let i = 1; i <= 10; i++) { %>
                        <button type="button" class="ob-rating-btn" data-group="<%= q.field %>" data-value="<%= i %>"><%= i %></button>
                      <% } %>
                    </div>
                  <% } %>
                </div>
                <% }); %>

                <!-- Q7–Q12: harvest-specific questions -->
                <% closingQuestions.forEach(function(q, idx) { %>
                <div class="ob-question" id="hq-block-<%= q.id %>">
                  <div class="ob-q-num">0<%= idx + 7 %></div>
                  <p class="ob-q-text"><%= q.text %></p>
                  <% if (q.type === 'choice') { %>
                    <div class="ob-choices">
                      <% q.choices.forEach(function(c) { %>
                        <button type="button" class="ob-choice" data-group="<%= q.field %>" data-value="<%= c.val %>">
                          <span class="ob-choice-val"><%= c.val %></span>
                          <span class="ob-choice-label"><%= c.label %></span>
                        </button>
                      <% }); %>
                    </div>
                  <% } else { %>
                    <textarea class="ob-textarea" data-field="<%= q.field %>"
                              rows="4" placeholder="<%= q.placeholder %>"></textarea>
                  <% } %>
                </div>
                <% }); %>
              </div>

              <p class="ob-error" id="harvest-error" hidden>Please answer all questions before submitting.</p>
              <div class="ob-actions">
                <button type="button" class="ob-btn ob-btn--primary" id="harvest-submit-btn">
                  Reveal my harvest 🌾
                </button>
              </div>
            </form>

          <% } %>
        </div>
      </section>
      <% } %>

      <% } %>

    </main>
  </div>

  <script>
    // ── Facets expand/collapse (per-goal "See more / See less") ─────────────
    // Delegated so it works for every bed card without needing scoped IDs,
    // and survives any future fetch-and-swap of card markup.
    document.addEventListener('click', function (e) {
      const btn = e.target.closest('.gh-facets-toggle');
      if (!btn) return;
      const extra = btn.parentElement.querySelector('.gh-facets-extra');
      if (!extra) return;
      const opened = extra.classList.toggle('is-hidden') === false;
      btn.setAttribute('aria-expanded', opened ? 'true' : 'false');
      const text  = btn.querySelector('.gh-facets-toggle-text');
      const arrow = btn.querySelector('.gh-facets-toggle-arrow');
      if (text)  text.textContent  = opened ? 'See less' : 'See more';
      if (arrow) arrow.textContent = opened ? '↑' : '↓';
    });

    // ── Edit existing goal ───────────────────────────────────────────────────
    function openEdit(data) {
      const n = data.n;
      const hasFacets = data.soil || data.seed || data.water || data.bloom;
      // Legacy goals (only feeling/looks_like): best-effort map onto seed + bloom.
      document.getElementById('gh-ef-soil-'  + n).value = hasFacets ? data.soil  : '';
      document.getElementById('gh-ef-seed-'  + n).value = hasFacets ? data.seed  : (data.feeling    || '');
      document.getElementById('gh-ef-water-' + n).value = hasFacets ? data.water : '';
      document.getElementById('gh-ef-bloom-' + n).value = hasFacets ? data.bloom : (data.looks_like || '');
      document.getElementById('gh-view-' + n).classList.add('is-hidden');
      document.getElementById('gh-edit-' + n).classList.remove('is-hidden');
    }

    function cancelEdit(n) {
      document.getElementById('gh-view-' + n).classList.remove('is-hidden');
      document.getElementById('gh-edit-' + n).classList.add('is-hidden');
    }

    async function saveEdit(seedId, n) {
      const soil  = document.getElementById('gh-ef-soil-'  + n).value.trim();
      const seed  = document.getElementById('gh-ef-seed-'  + n).value.trim();
      const water = document.getElementById('gh-ef-water-' + n).value.trim();
      const bloom = document.getElementById('gh-ef-bloom-' + n).value.trim();
      if (!soil || !seed || !water || !bloom) {
        alert('Please fill in all four fields before saving.');
        return;
      }
      const btn = document.querySelector('#gh-edit-' + n + ' .gh-save-btn');
      btn.disabled = true; btn.textContent = 'Saving…';
      const res = await fetch('/api/greenhouse/update', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ seedId, soil, seed, water, bloom })
      });
      if (res.ok) {
        window.location.reload();
      } else {
        btn.disabled = false; btn.textContent = 'Save';
        alert('Could not save. Please try again.');
      }
    }

    // ── Keep goal ────────────────────────────────────────────────────────────
    async function keepGoal(goalId, n) {
      const res = await fetch('/api/goals/' + goalId + '/keep', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kept: true })
      });
      if (res.ok) {
        document.getElementById('gh-actions-' + n).classList.add('is-hidden');
        document.getElementById('gh-kept-' + n).classList.remove('is-hidden');
      } else {
        alert('Could not save. Please try again.');
      }
    }

    async function unkeepGoal(goalId, n) {
      const res = await fetch('/api/goals/' + goalId + '/keep', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kept: false })
      });
      if (res.ok) {
        document.getElementById('gh-kept-' + n).classList.add('is-hidden');
        document.getElementById('gh-actions-' + n).classList.remove('is-hidden');
      } else {
        alert('Could not save. Please try again.');
      }
    }

    // ── Replace goal ─────────────────────────────────────────────────────────
    function openReplace(n) {
      document.getElementById('gh-actions-' + n).classList.add('is-hidden');
      document.getElementById('gh-replace-' + n).classList.remove('is-hidden');
    }

    function cancelReplace(n) {
      document.getElementById('gh-replace-' + n).classList.add('is-hidden');
      document.getElementById('gh-actions-' + n).classList.remove('is-hidden');
    }

    async function saveReplace(n) {
      const soil  = document.getElementById('gh-rf-soil-'  + n).value.trim();
      const seed  = document.getElementById('gh-rf-seed-'  + n).value.trim();
      const water = document.getElementById('gh-rf-water-' + n).value.trim();
      const bloom = document.getElementById('gh-rf-bloom-' + n).value.trim();
      if (!soil || !seed || !water || !bloom) {
        document.getElementById('gh-rf-soil-' + n).focus();
        alert('Please fill in all four fields before planting.');
        return;
      }
      const btn = document.querySelector('#gh-replace-' + n + ' .gh-save-btn');
      btn.disabled = true; btn.textContent = 'Planting…';
      const res = await fetch('/api/greenhouse/replace', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ seedNumber: n, soil, seed, water, bloom })
      });
      if (res.ok) {
        window.location.reload();
      } else {
        btn.disabled = false; btn.textContent = 'Plant this goal 🌱';
        alert('Could not save. Please try again.');
      }
    }

    // ── Harvest form ─────────────────────────────────────────────────────────
    const harvestData = {};
    const HARVEST_REQUIRED = ['q1_choice','q2_rating','q3_choice','q4_rating','q5_choice','q6_rating'];

    document.querySelectorAll('#harvest-form .ob-choice').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#harvest-form .ob-choice[data-group="' + btn.dataset.group + '"]')
          .forEach(b => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        harvestData[btn.dataset.group] = btn.dataset.value;
        updateHarvestProgress();
      });
    });

    document.querySelectorAll('#harvest-form .ob-rating-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#harvest-form .ob-rating-btn[data-group="' + btn.dataset.group + '"]')
          .forEach(b => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        harvestData[btn.dataset.group] = parseInt(btn.dataset.value);
        updateHarvestProgress();
      });
    });

    document.querySelectorAll('#harvest-form .ob-textarea').forEach(ta => {
      ta.addEventListener('input', () => { harvestData[ta.dataset.field] = ta.value; updateHarvestProgress(); });
    });

    function updateHarvestProgress() {
      const filled = HARVEST_REQUIRED.filter(k => harvestData[k] || harvestData[k] === 0).length;
      const pct = (filled / HARVEST_REQUIRED.length * 100).toFixed(0);
      const bar = document.getElementById('harvest-progress-bar');
      if (bar) bar.style.width = pct + '%';
    }

    const harvestSubmitBtn = document.getElementById('harvest-submit-btn');
    if (harvestSubmitBtn) {
      harvestSubmitBtn.addEventListener('click', async () => {
        const errEl = document.getElementById('harvest-error');
        errEl.hidden = true;
        document.querySelectorAll('#harvest-form .ob-textarea').forEach(ta => {
          harvestData[ta.dataset.field] = ta.value.trim();
        });
        for (const key of HARVEST_REQUIRED) {
          if (!harvestData[key] && harvestData[key] !== 0) {
            errEl.hidden = false;
            document.getElementById('hq-block-' + key.split('_')[0])?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }
        }
        harvestSubmitBtn.disabled = true;
        harvestSubmitBtn.textContent = 'Submitting…';
        const res = await fetch('/api/harvest', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(harvestData)
        });
        if (res.ok) {
          window.location.reload();
        } else {
          harvestSubmitBtn.disabled = false;
          harvestSubmitBtn.textContent = 'Reveal my harvest 🌾';
          const data = await res.json();
          errEl.textContent = data.error || 'Something went wrong.';
          errEl.hidden = false;
        }
      });
    }

    // ── Full harvest answers toggle ───────────────────────────────────────────
    const fullAnswersToggle = document.getElementById('gh-full-answers-toggle');
    if (fullAnswersToggle) {
      fullAnswersToggle.addEventListener('click', () => {
        const el = document.getElementById('gh-full-answers');
        const isHidden = el.classList.contains('is-hidden');
        el.classList.toggle('is-hidden');
        fullAnswersToggle.textContent = isHidden
          ? 'Hide full harvest answers ↑'
          : 'Read my full harvest answers →';
      });
    }
  </script>
</body>
</html>
