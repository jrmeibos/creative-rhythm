<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <%- include('partials/fb-pixel') %>
  <link rel="stylesheet" href="/css/signup.css">
  <style>
    .sg-video { position: relative; width: 100%; max-width: 640px; margin: 1.5rem auto 0; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: #100F10; }
    .sg-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  </style>
</head>
<body class="signup-body">

  <main class="sg-page">

    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <header class="sg-hero">
      <a href="https://www.meibostouch.com/the-creatives-garden"
         target="_blank" rel="noopener" class="sg-logo-link"
         aria-label="The Creative's Garden — visit the course page on meibostouch.com">
        <img src="/images/brand/The Creative's Garden Icon with Text_1.svg"
             alt="The Creative's Garden" class="sg-logo">
      </a>
      <p class="sg-eyebrow">The 3-week challenge · Starts January 5<% if (locals.full) { %> · Full<% } %></p>
      <h1 class="sg-hero-title">Grow in private.<br>Bloom when you're ready.</h1>
      <p class="sg-hero-sub">
        The Creative's Garden is a content creation course for creatives who want
        to share their work online — but freeze, overthink, or burn out trying.
        It starts with a three-week experiment: show up in front of a camera once
        every day for three weeks.
      </p>
      <% if (locals.full) { %>
        <a href="#signup" class="btn btn-primary sg-hero-cta">See the waitlist →</a>
      <% } else { %>
        <a href="#signup" class="btn btn-primary sg-hero-cta">Join the challenge →</a>
      <% } %>
      <p class="sg-signin-line">
        Already have an account?
        <a href="/<%= returnTo ? '?returnTo=' + encodeURIComponent(returnTo) : '' %>" class="sg-link">Sign in</a>
      </p>
    </header>

    <!-- ── Signup form (top) ────────────────────────────────────────────── -->
    <section class="sg-section sg-signup" id="signup">
      <%- include('partials/signup-form', { sfx: '-top', showError: true }) %>
    </section>

    <!-- ── Why this works (Julia's experience + three gardeners' journeys) ── -->
    <section class="sg-section">
      <p class="sg-eyebrow sg-eyebrow--sage">Does this really work?</p>
      <h2 class="sg-section-title">What three weeks can do</h2>
      <p class="sg-note" style="margin:0 auto">
        A little on why this works — from my own experience, and the journeys of three gardeners who went through it.
      </p>
      <div class="sg-video">
        <iframe
          src="https://www.youtube.com/embed/qprPPoxPmDw"
          title="Why this works — real journeys"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
    </section>

    <!-- ── This is for you if ───────────────────────────────────────────── -->
    <section class="sg-section">
      <h2 class="sg-section-title">This is for you if…</h2>
      <ul class="sg-list">
        <li>You post in anxious bursts, go quiet for weeks, then feel guilty about the silence.</li>
        <li>You have plenty of ideas. Until it's time to share, that is. Then, your mind goes blank.</li>
        <li>You can hype up everyone else's work, but freeze the second it's your own.</li>
        <li>You're worn out from performing for the algorithm, and want your creation practice to feel like it's yours.</li>
      </ul>
      <p class="sg-note">
        If that sounds familiar, it's not a discipline problem. When being seen
        doesn't feel safe, showing up consistently is hard. So here, in the Garden,
        we'll start somewhere gentler.
      </p>
    </section>

    <!-- ── How the challenge works ──────────────────────────────────────── -->
    <section class="sg-section sg-section--tinted">
      <p class="sg-eyebrow sg-eyebrow--sage">What does it entail?</p>
      <h2 class="sg-section-title">How the three-week challenge works</h2>
      <p class="sg-body">
        It begins with one small ritual: a daily private video recording — just
        you, talking to the camera.
      </p>
      <p class="sg-body">
        Come as you are; Pajamas and fancy outfits welcome alike. Nobody watches
        these but you (and even that's optional).
      </p>
      <ul class="sg-checklist">
        <li>Record 3–5 minutes daily</li>
        <li>Then, log your recording in the online platform</li>
      </ul>
      <p class="sg-body">
        That's the whole practice: three weeks of showing up to a conversation with
        yourself with curiosity, to see what unblocks.
      </p>
    </section>

    <!-- ── What's included ──────────────────────────────────────────────── -->
    <section class="sg-section">
      <h2 class="sg-section-title">What's included</h2>
      <div class="sg-grid">
        <div class="sg-card">
          <h3 class="sg-card-title">Three weeks of guided practice</h3>
          <p>Weekly group calls so you always have a next step. Meetings will be recorded in case you can't make it.</p>
        </div>
        <div class="sg-card">
          <h3 class="sg-card-title">Your own private platform</h3>
          <p>A personal login with optional daily prompts, where you log each recording and watch what shifts.</p>
        </div>
        <div class="sg-card">
          <h3 class="sg-card-title">Grow in community</h3>
          <p>Connect with peers going through the same process on the group Discord.</p>
        </div>
        <div class="sg-card">
          <h3 class="sg-card-title">Optional homework</h3>
          <p>Included is a free resource called "Seed Packets" to help you hone in on your unique curiosities and get clear on what's genuinely yours to say.</p>
        </div>
      </div>
    </section>

    <!-- ── The deal (price) ─────────────────────────────────────────────── -->
    <section class="sg-section sg-section--tinted">
      <p class="sg-eyebrow sg-eyebrow--sage">The deal</p>
      <h2 class="sg-section-title">It's $199</h2>
      <p class="sg-body">
        I'm charging for this beta because I know you're more likely to do the
        work when you've got a little skin in the game.
      </p>
      <p class="sg-body">
        I'm genuinely curious whether this process works for other people, and
        you'd be helping me figure out what works and what doesn't.
      </p>
    </section>

    <!-- ── Signup form (bottom) ─────────────────────────────────────────── -->
    <section class="sg-section sg-signup">
      <%- include('partials/signup-form', { sfx: '', showError: false }) %>
    </section>

    <footer class="sg-footer">
      A content creation course by
      <a href="https://www.meibostouch.com/the-creatives-garden" target="_blank" rel="noopener" class="sg-link">The Meibos Touch</a>.
      <br>
      <a href="/privacy" class="sg-link">Privacy Policy</a> ·
      <a href="/terms" class="sg-link">Terms</a> ·
      <a href="/accessibility" class="sg-link">Accessibility</a><% if (locals.facebookPixelId) { %> ·
      <a href="#" data-cg-consent-reopen class="sg-link">Cookie preferences</a><% } %>
    </footer>

  </main>

  <script>
    // Pass the user's IANA timezone so their course_start_date matches their
    // wall clock. Server falls back to America/Denver if empty/unrecognized.
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (tz) document.querySelectorAll('input[name="timezone"]').forEach(function (el) { el.value = tz; });
    } catch (_) { /* no-op — server fallback handles it */ }
  </script>

  <script>
    // Waitlist forms (shown only when the cohort is full). Posts to /api/waitlist,
    // which tags the contact in Mailchimp. The form appears at the top and bottom
    // of the page, so wire every copy; no-op when none are present.
    (function () {
      var forms = document.querySelectorAll('.sg-waitlist-form');
      if (!forms.length) return;
      forms.forEach(function (form) {
        var btn   = form.querySelector('.sg-waitlist-btn');
        var input = form.querySelector('.sg-waitlist-email');
        var msg   = form.querySelector('.sg-waitlist-msg');

        function show(text, ok) {
          msg.hidden = false;
          msg.textContent = text;
          msg.style.color = ok ? '' : '#b00020';
        }

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = (input.value || '').trim();
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            show('Please enter a valid email address.', false);
            return;
          }
          btn.disabled = true;
          fetch('/api/waitlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ email: email })
          })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
            .then(function (res) {
              btn.disabled = false;
              if (res.ok && res.d && res.d.ok) {
                form.reset();
                show('You’re on the list — I’ll be in touch. 🌱', true);
              } else {
                show((res.d && res.d.error) || 'Something went wrong — please try again.', false);
              }
            })
            .catch(function () {
              btn.disabled = false;
              show('Could not reach the server — please try again.', false);
            });
        });
      });
    })();
  </script>

</body>
</html>
