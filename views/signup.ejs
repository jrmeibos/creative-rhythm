<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-body">

  <div class="login-layout">

    <!-- Left brand panel -->
    <div class="login-brand">
      <a href="https://www.meibostouch.com/the-creatives-garden"
         target="_blank" rel="noopener"
         class="login-brand-link"
         aria-label="The Creative's Garden — visit the course page on meibostouch.com">
        <img
          src="/images/brand/Stacked_Logo.png"
          alt=""
          class="login-brand-icon">
      </a>
      <p class="login-attribution login-attribution--on-brand">
        <a href="https://www.meibostouch.com/the-creatives-garden"
           target="_blank" rel="noopener"
           class="login-attribution-link">A content creation course by The Meibos Touch</a>
      </p>
    </div>

    <!-- Right form panel -->
    <div class="login-form-panel">
      <div class="login-form-inner">

        <a href="https://www.meibostouch.com/the-creatives-garden"
           target="_blank" rel="noopener"
           class="login-logo-link"
           aria-label="The Creative's Garden — visit the course page on meibostouch.com">
          <img
            src="/images/brand/The Creative's Garden Icon with Text_1.svg"
            alt=""
            class="login-logo">
        </a>

        <p class="login-form-eyebrow">Start with Winter — free</p>
        <h2 class="login-form-title">Create your account</h2>

        <% if (error) { %>
          <div class="login-error" role="alert">
            <%= error %>
          </div>
        <% } %>

        <form action="/signup" method="POST" class="login-form" novalidate>
          <div class="form-group">
            <label for="name" class="form-label">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              class="form-input"
              placeholder="Your name"
              autocomplete="name"
              value="<%= name %>"
              required>
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder="you@example.com"
              autocomplete="email"
              value="<%= email %>"
              required>
          </div>

          <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              class="form-input"
              placeholder="At least 8 characters"
              autocomplete="new-password"
              required>
            <p class="login-help" style="margin-top:0.4rem;font-size:0.78rem">
              Minimum 8 characters. Include a number or symbol.
            </p>
          </div>

          <!-- Timezone is detected client-side (see script below) and posted as
               a hidden field. Server falls back to America/Denver if empty. -->
          <input type="hidden" id="timezone" name="timezone" value="">
          <% if (returnTo) { %>
            <input type="hidden" name="returnTo" value="<%= returnTo %>">
          <% } %>

          <button type="submit" class="btn btn-primary btn-full">
            Create account →
          </button>
        </form>

        <p class="login-forgot">
          Already have an account? <a href="/<%= returnTo ? '?returnTo=' + encodeURIComponent(returnTo) : '' %>" class="login-forgot-link">Sign in</a>
        </p>

        <p class="login-help">
          Signing up starts your free three-week Winter journey. You can continue
          into the full 12-week course any time.
        </p>

      </div>
    </div>

  </div>

  <script>
    // Pass the user's IANA timezone to the server so their course_start_date
    // matches their wall clock. Falls back to America/Denver server-side if
    // this is empty or unrecognized.
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (tz) document.getElementById('timezone').value = tz;
    } catch (_) { /* no-op — fallback handles it */ }
  </script>

</body>
</html>
