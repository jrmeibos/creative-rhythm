<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/profile.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content" id="main">

      <header class="dash-header">
        <div class="dash-greeting">
          <h1 class="dash-greeting-text"><%= user.name.split(' ')[0] %>'s Profile</h1>
        </div>
      </header>

      <!-- ── Account ────────────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Account</h2>
        </div>
        <div class="profile-info-card">
          <div class="profile-avatar <%= user.current_season ? 'season-avatar--' + user.current_season : '' %>">
            <%= user.avatar_initial || user.name.charAt(0).toUpperCase() %>
          </div>
          <div class="profile-info-details">
            <span class="profile-info-name"><%= user.name %></span>
            <span class="profile-info-email"><%= user.email %></span>
          </div>
        </div>
      </section>

      <!-- ── Current Season ─────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your Current Season</h2>
        </div>
        <%
          const seasonDefs = [
            { key: 'spring', name: 'Spring', category: 'Prioritizing Curiosity' },
            { key: 'summer', name: 'Summer', category: 'Creation Mode' },
            { key: 'autumn', name: 'Autumn', category: 'Sharing is Caring' },
            { key: 'winter', name: 'Winter', category: 'Time to Connect' }
          ];
        %>
        <div class="season-cards" id="season-cards">
          <% for (const s of seasonDefs) { %>
            <button class="season-card season-card--<%= s.key %> <%= user.current_season === s.key ? 'is-selected' : '' %>"
                    data-season="<%= s.key %>" type="button" aria-pressed="<%= user.current_season === s.key %>">
              <span class="season-card-emoji"><%- include('partials/season-icon', { season: s.key, size: 40 }) %></span>
              <span class="season-card-name"><%= s.name %></span>
              <span class="season-card-category"><%= s.category %></span>
              <span class="season-card-check" aria-hidden="true">✓</span>
            </button>
          <% } %>
        </div>
      </section>

    </main>
  </div>

  <script>
    // ── Season picker ──────────────────────────────────────────────────────────
    document.querySelectorAll('.season-card').forEach(card => {
      card.addEventListener('click', async () => {
        const season = card.dataset.season;
        const already = card.classList.contains('is-selected');
        const res = await fetch('/api/season', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ season: already ? null : season })
        });
        if (!res.ok) return;
        document.querySelectorAll('.season-card').forEach(c => {
          c.classList.remove('is-selected'); c.setAttribute('aria-pressed', 'false');
        });
        if (!already) { card.classList.add('is-selected'); card.setAttribute('aria-pressed', 'true'); }
      });
    });
  </script>

</body>
</html>
