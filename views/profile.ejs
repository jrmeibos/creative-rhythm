<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/profile.css">
  <!-- Settings sections (reminders, timezone, notifications, privacy) merged in
       from the former /account page use acct-* styles. -->
  <link rel="stylesheet" href="/css/account.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content" id="main">

      <header class="dash-header">
        <div class="dash-greeting">
          <h1 class="dash-greeting-text"><%= user.name.split(' ')[0] %>'s Profile</h1>
        </div>
      </header>

      <!-- ── Account ────────────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Account</h2>
        </div>
        <div class="profile-info-card">
          <div class="profile-avatar-wrap" id="profile-avatar-wrap">
            <% if (profile.profile_photo) { %>
              <img src="<%= profile.profile_photo %>" class="profile-avatar profile-avatar--photo" alt="">
            <% } else { %>
              <div class="profile-avatar <%= profile.current_season ? 'season-avatar--' + profile.current_season : '' %>" id="profile-avatar-initials">
                <%= profile.avatar_initial || profile.name.charAt(0).toUpperCase() %>
              </div>
            <% } %>
          </div>
          <div class="profile-info-details">
            <span class="profile-info-name" id="profile-display-name"><%= profile.name %></span>
            <span class="profile-info-email" id="profile-display-email"><%= profile.email %></span>
          </div>
        </div>

        <div class="profile-edit-controls">

          <!-- Edit name -->
          <div class="profile-edit-item">
            <button class="profile-edit-link" type="button" data-section="name" onclick="toggleEdit('name')">Edit name</button>
            <div class="profile-inline-form" id="edit-name-form">
              <input type="text" class="profile-inline-input" id="name-input"
                     value="<%= profile.name %>" placeholder="Display name" maxlength="100">
              <div class="profile-inline-actions">
                <button class="profile-inline-save" type="button" onclick="saveName()">Save</button>
                <button class="profile-inline-cancel" type="button" onclick="closeSection('name')">Cancel</button>
              </div>
              <p class="profile-inline-error" id="name-error" hidden></p>
              <p class="profile-inline-saved" id="name-saved" hidden>Saved 🌿</p>
            </div>
          </div>

          <!-- Edit email -->
          <div class="profile-edit-item">
            <button class="profile-edit-link" type="button" data-section="email" onclick="toggleEdit('email')">Edit email</button>
            <div class="profile-inline-form" id="edit-email-form">
              <input type="password" class="profile-inline-input" id="email-current-pw"
                     placeholder="Current password" autocomplete="current-password">
              <input type="email" class="profile-inline-input" id="email-new"
                     placeholder="New email address" autocomplete="email">
              <div class="profile-inline-actions">
                <button class="profile-inline-save" type="button" onclick="saveEmail()">Save</button>
                <button class="profile-inline-cancel" type="button" onclick="closeSection('email')">Cancel</button>
              </div>
              <p class="profile-inline-error" id="email-error" hidden></p>
              <p class="profile-inline-saved" id="email-saved" hidden>Saved 🌿</p>
            </div>
          </div>

          <!-- Change password -->
          <div class="profile-edit-item">
            <button class="profile-edit-link" type="button" data-section="password" onclick="toggleEdit('password')">Change password</button>
            <div class="profile-inline-form" id="edit-password-form">
              <input type="password" class="profile-inline-input" id="pw-current"
                     placeholder="Current password" autocomplete="current-password">
              <input type="password" class="profile-inline-input" id="pw-new"
                     placeholder="New password (8+ characters)" autocomplete="new-password">
              <input type="password" class="profile-inline-input" id="pw-confirm"
                     placeholder="Confirm new password" autocomplete="new-password">
              <div class="profile-inline-actions">
                <button class="profile-inline-save" type="button" onclick="savePassword()">Save</button>
                <button class="profile-inline-cancel" type="button" onclick="closeSection('password')">Cancel</button>
              </div>
              <p class="profile-inline-error" id="pw-error" hidden></p>
              <p class="profile-inline-saved" id="pw-saved" hidden>Password updated 🌿</p>
            </div>
          </div>

          <!-- Profile picture -->
          <div class="profile-edit-item">
            <button class="profile-edit-link" type="button" data-section="photo" onclick="toggleEdit('photo')">Update profile picture</button>
            <div class="profile-inline-form" id="edit-photo-form">
              <input type="file" class="profile-inline-file" id="photo-file-input"
                     accept="image/jpeg,image/png,image/gif,image/webp">
              <div class="profile-inline-actions">
                <button class="profile-inline-save" type="button" onclick="savePhoto()">Upload</button>
                <button class="profile-inline-cancel" type="button" onclick="closeSection('photo')">Cancel</button>
                <% if (profile.profile_photo) { %>
                  <button class="profile-inline-remove" type="button" onclick="removePhoto()">Remove current picture</button>
                <% } %>
              </div>
              <p class="profile-inline-error" id="photo-error" hidden></p>
              <p class="profile-inline-saved" id="photo-saved" hidden>Photo updated 🌿</p>
            </div>
          </div>

        </div>
      </section>

      <!-- ── Current Season — only shown when the student can actually pick.
           Pre-Week-4 trial students see nothing here at all; the selector
           appears the moment they're eligible (Week 4 or an upgrade). -->
      <% if (locals.canPickSeason) { %>
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your Current Season</h2>
        </div>
        <p class="season-picker-help">
          Your season shapes what the platform shows you. Change it anytime.
        </p>
        <%
          const seasonDefs = [
            { key: 'winter', name: 'Winter', category: 'Connect to yourself' },
            { key: 'spring', name: 'Spring', category: 'Review your recordings' },
            { key: 'summer', name: 'Summer', category: 'Creation Mode' },
            { key: 'autumn', name: 'Autumn', category: 'Sharing is Caring' }
          ];
        %>
        <div class="season-cards" id="season-cards">
          <% for (const s of seasonDefs) { %>
            <button class="season-card season-card--<%= s.key %> <%= user.current_season === s.key ? 'is-selected' : '' %>"
                    data-season="<%= s.key %>" type="button"
                    aria-pressed="<%= user.current_season === s.key %>">
              <span class="season-card-emoji"><%- include('partials/season-icon', { season: s.key, size: 40 }) %></span>
              <span class="season-card-name"><%= s.name %></span>
              <span class="season-card-category"><%= s.category %></span>
              <span class="season-card-check" aria-hidden="true">✓</span>
            </button>
          <% } %>
        </div>
      </section>
      <% } %>

      <!-- ── Daily Reminder ────────────────────────────────────────────────── -->
      <%
        // Pre-render the time picker options here so the inline JS doesn't
        // have to. Storing the hour as 0–23 keeps timezone math simple; the
        // display labels are the conventional 12-hour clock for legibility.
        const currentHour = (typeof profile.daily_reminder_hour === 'number') ? profile.daily_reminder_hour : 8;
        const reminderEnabled = profile.daily_reminder_enabled === 1;
        const HOURS = Array.from({ length: 24 }, (_, h) => {
          const ampm = h < 12 ? 'AM' : 'PM';
          const display = h === 0 ? 12 : (h > 12 ? h - 12 : h);
          return { value: h, label: `${display}:00 ${ampm}` };
        });
      %>
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Daily Reminder</h2>
        </div>
        <div class="acct-card">
          <p class="acct-section-subtitle">
            Get one gentle nudge per day to log your reflection — at a time you choose.
            Receive it as a phone notification (you'll need to install the app first) or
            by email (works anywhere, no install needed). Pick either or both below.
          </p>

          <!-- Install guide: how to add the site as an app on iPhone + Android.
               Auto-expands on a phone that hasn't installed it yet (see JS). -->
          <details class="acct-install-card" id="install-guide">
            <summary class="acct-install-summary">📲 How to install this as an app — needed for phone notifications</summary>
            <div class="acct-install-body">
              <p>Phone notifications only reach you when <em>The Creative's Garden</em> is installed to your home screen.</p>

              <p class="acct-install-os-title"><strong>iPhone &amp; iPad — using Safari</strong></p>
              <ol>
                <li>Open this site in <em>Safari</em> (not Chrome)</li>
                <li>Tap the <em>Share</em> button — the square with an upward arrow</li>
                <li>Scroll down and tap <em>Add to Home Screen</em></li>
                <li>Tap <em>Add</em>, then open the app from your home screen</li>
              </ol>

              <p class="acct-install-os-title"><strong>Android — using Chrome</strong></p>
              <ol>
                <li>Open this site in <em>Chrome</em></li>
                <li>Tap the <em>⋮</em> menu in the top-right</li>
                <li>Tap <em>Install app</em> (or <em>Add to Home screen</em>)</li>
                <li>Confirm, then open the app from your home screen</li>
              </ol>

              <p class="acct-install-note">
                Then come back here and tap "Enable on this device." Prefer not to install?
                Turn on <strong>email reminders</strong> below instead — those work anywhere.
              </p>
            </div>
          </details>

          <!-- Master toggle: cron checks this column before sending -->
          <div class="acct-toggle-row">
            <div class="acct-toggle-text">
              <strong>Send me a daily reminder</strong>
              <span>You can turn this off any time.</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-daily_reminder" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-daily-reminder"
                      aria-pressed="<%= reminderEnabled ? 'true' : 'false' %>"
                      type="button" onclick="toggleDailyReminder(this)">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>

          <!-- Time picker: hidden when master toggle is off -->
          <div class="acct-reminder-time" id="reminder-time-row"<%= reminderEnabled ? '' : ' hidden' %>>
            <label class="acct-label" for="reminder-hour-select">Send it at</label>
            <select class="acct-input acct-select" id="reminder-hour-select" onchange="saveReminderHour(this)">
              <% for (const h of HOURS) { %>
                <option value="<%= h.value %>"<%= h.value === currentHour ? ' selected' : '' %>><%= h.label %></option>
              <% } %>
            </select>
            <span class="acct-reminder-tz">in your timezone (<%= profile.timezone || 'America/Denver' %>)</span>
          </div>

          <p class="acct-reminder-channels-label">How would you like to receive it?</p>

          <!-- Per-device enable: separate concept from the master toggle because -->
          <!-- browser push permission lives on the device, not the account.       -->
          <div class="acct-device-row">
            <div class="acct-device-state">
              <strong id="device-status-label">Not enabled on this device</strong>
              <span id="device-status-hint">Tap below to allow notifications in this browser.</span>
            </div>
            <button class="acct-save-btn" id="enable-device-btn" type="button" onclick="enableOnDevice()">Enable on this device</button>
            <button class="acct-text-btn" id="disable-device-btn" type="button" onclick="disableOnDevice()" hidden>Disable on this device</button>
          </div>

          <!-- Email channel: independent of push, sent by the daily cron via
               Resend. Turning it on also flips the master toggle on (see JS). -->
          <div class="acct-toggle-row acct-toggle-row--last">
            <div class="acct-toggle-text">
              <strong>Email me the reminder</strong>
              <span>Get the daily nudge in your inbox — no app install needed.</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-reminder_email_enabled" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-reminder_email_enabled"
                      aria-pressed="<%= profile.reminder_email_enabled ? 'true' : 'false' %>"
                      type="button" onclick="toggleEmailReminder(this)">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>
          <p class="acct-status acct-status--error" id="reminder-error" hidden></p>
        </div>
      </section>

      <!-- ── Weekly Reminder ───────────────────────────────────────────────── -->
      <%
        const weeklyHour    = (typeof profile.weekly_reminder_hour === 'number') ? profile.weekly_reminder_hour : 9;
        const weeklyEnabled = profile.weekly_reminder_enabled === 1;
      %>
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Weekly Reminder</h2>
        </div>
        <div class="acct-card">
          <p class="acct-section-subtitle">
            A gentle nudge every <strong>Monday</strong> to set your weekly intentions.
          </p>

          <!-- Master toggle -->
          <div class="acct-toggle-row">
            <div class="acct-toggle-text">
              <strong>Remind me to set my weekly intentions</strong>
              <span>Sent every Monday. Turn this off any time.</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-weekly_reminder" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-weekly-reminder"
                      aria-pressed="<%= weeklyEnabled ? 'true' : 'false' %>"
                      type="button" onclick="toggleWeeklyReminder(this)">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>

          <!-- Time picker: hidden when the toggle is off -->
          <div class="acct-reminder-time" id="weekly-time-row"<%= weeklyEnabled ? '' : ' hidden' %>>
            <label class="acct-label" for="weekly-hour-select">Monday at</label>
            <select class="acct-input acct-select" id="weekly-hour-select" onchange="saveWeeklyReminderHour(this)">
              <% for (const h of HOURS) { %>
                <option value="<%= h.value %>"<%= h.value === weeklyHour ? ' selected' : '' %>><%= h.label %></option>
              <% } %>
            </select>
            <span class="acct-reminder-tz">in your timezone (<%= profile.timezone || 'America/Denver' %>)</span>
          </div>

          <p class="acct-reminder-channels-label">How would you like to receive it?</p>

          <!-- Push uses the same registered devices as the daily reminder -->
          <div class="acct-device-row">
            <div class="acct-device-state">
              <strong>On your enabled devices</strong>
              <span>Sent to the phone/desktop you enabled for the daily reminder above.</span>
            </div>
          </div>

          <!-- Email channel (independent boolean) -->
          <div class="acct-toggle-row acct-toggle-row--last">
            <div class="acct-toggle-text">
              <strong>Email me this reminder</strong>
              <span>Get the Monday nudge in your inbox — no app install needed.</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-weekly_reminder_email" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-weekly_reminder_email"
                      aria-pressed="<%= profile.weekly_reminder_email ? 'true' : 'false' %>"
                      type="button" onclick="toggleWeeklyEmail(this)">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Timezone ──────────────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Your Timezone</h2>
        </div>
        <div class="acct-card">
          <div class="acct-form acct-form--inline">
            <div class="acct-field-group">
              <label class="acct-label" for="timezone-select">Timezone</label>
              <select class="acct-input acct-select" id="timezone-select">
                <% for (const tz of timezones) { %>
                  <option value="<%= tz.value %>"<%= (profile.timezone || 'America/Denver') === tz.value ? ' selected' : '' %>>
                    <%= tz.label %>
                  </option>
                <% } %>
              </select>
            </div>
            <div class="acct-form-footer">
              <button class="acct-save-btn" type="button" onclick="saveTimezone()">Save Timezone</button>
              <span class="acct-status" id="tz-status"></span>
            </div>
          </div>
        </div>
      </section>

      <%# ── Notifications section hidden until delivery is built ──────────────
          The New Lessons / Community Activity / Weekly Reminder toggles had no
          sender wired up (nothing read notify_* to actually notify anyone), so
          showing them promised notifications students would never receive.
          Removed pending real delivery. The notify_* columns + preference
          whitelist stay in place, so restoring this section (see git history
          for commit "Merge Account page into Profile") is drop-in. %>

      <!-- ── Privacy ───────────────────────────────────────────────────────── -->
      <section class="dash-section">
        <div class="dash-section-header">
          <h2 class="dash-section-title">Privacy</h2>
        </div>
        <div class="acct-card">
          <p class="acct-section-subtitle">Control what others in the course can see.</p>

          <div class="acct-toggle-row">
            <div class="acct-toggle-text">
              <strong>Show my weekly intentions to the community</strong>
              <span>Your goal status dots are visible on the community page</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-community_goals_public" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-community_goals_public"
                      aria-pressed="<%= profile.community_goals_public !== 0 ? 'true' : 'false' %>"
                      type="button" onclick="togglePref(this, 'community_goals_public')">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>

          <div class="acct-toggle-row acct-toggle-row--last">
            <div class="acct-toggle-text">
              <strong>Show my current season to the community</strong>
              <span>Your season icon appears next to your name on the community page</span>
            </div>
            <div class="acct-toggle-right">
              <span class="acct-toggle-saved" id="saved-community_season_public" hidden>Saved ✓</span>
              <button class="acct-toggle" id="toggle-community_season_public"
                      aria-pressed="<%= profile.community_season_public !== 0 ? 'true' : 'false' %>"
                      type="button" onclick="togglePref(this, 'community_season_public')">
                <span class="acct-toggle-track"><span class="acct-toggle-thumb"></span></span>
              </button>
            </div>
          </div>
        </div>
      </section>

    </main>
  </div>

  <script>
    // ── Season picker ──────────────────────────────────────────────────────────
    document.querySelectorAll('.season-card').forEach(card => {
      card.addEventListener('click', async () => {
        const season = card.dataset.season;
        const already = card.classList.contains('is-selected');
        const res = await fetch('/api/season', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ season: already ? null : season })
        });
        if (!res.ok) return;
        document.querySelectorAll('.season-card').forEach(c => {
          c.classList.remove('is-selected'); c.setAttribute('aria-pressed', 'false');
        });
        if (!already) { card.classList.add('is-selected'); card.setAttribute('aria-pressed', 'true'); }
      });
    });

    // ── Account edit controls ─────────────────────────────────────────────────
    function closeSection(name) {
      const form = document.getElementById(`edit-${name}-form`);
      const btn  = document.querySelector(`.profile-edit-link[data-section="${name}"]`);
      if (form) form.classList.remove('section-open');
      if (btn)  btn.classList.remove('is-open');
    }

    function toggleEdit(name) {
      const form   = document.getElementById(`edit-${name}-form`);
      const wasOpen = form.classList.contains('section-open');
      document.querySelectorAll('.profile-inline-form').forEach(f => f.classList.remove('section-open'));
      document.querySelectorAll('.profile-edit-link').forEach(b => b.classList.remove('is-open'));
      if (!wasOpen) {
        form.classList.add('section-open');
        document.querySelector(`.profile-edit-link[data-section="${name}"]`).classList.add('is-open');
      }
    }

    async function apiPost(url, body) {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      return { ok: res.ok, data: await res.json() };
    }

    function showError(id, msg) {
      const el = document.getElementById(id);
      el.textContent = msg;
      el.hidden = false;
    }

    function showSaved(id, onDone) {
      const el = document.getElementById(id);
      el.hidden = false;
      setTimeout(() => { el.hidden = true; if (onDone) onDone(); }, 2000);
    }

    async function saveName() {
      const name = document.getElementById('name-input').value.trim();
      document.getElementById('name-error').hidden = true;
      if (!name) return showError('name-error', 'Name cannot be empty.');
      const { ok, data } = await apiPost('/api/profile/name', { display_name: name });
      if (!ok) return showError('name-error', data.error || 'Something went wrong.');
      document.getElementById('profile-display-name').textContent = name;
      const initEl = document.getElementById('profile-avatar-initials');
      if (initEl) initEl.textContent = data.avatar_initial;
      showSaved('name-saved', () => closeSection('name'));
    }

    async function saveEmail() {
      const pw = document.getElementById('email-current-pw').value;
      const email = document.getElementById('email-new').value.trim();
      document.getElementById('email-error').hidden = true;
      if (!pw || !email) return showError('email-error', 'All fields are required.');
      const { ok, data } = await apiPost('/api/profile/email', { current_password: pw, new_email: email });
      if (!ok) return showError('email-error', data.error || 'Something went wrong.');
      document.getElementById('profile-display-email').textContent = email;
      document.getElementById('email-current-pw').value = '';
      document.getElementById('email-new').value = '';
      showSaved('email-saved', () => closeSection('email'));
    }

    async function savePassword() {
      const current = document.getElementById('pw-current').value;
      const newPw   = document.getElementById('pw-new').value;
      const confirm = document.getElementById('pw-confirm').value;
      document.getElementById('pw-error').hidden = true;
      if (!current || !newPw || !confirm) return showError('pw-error', 'All fields are required.');
      if (newPw !== confirm) return showError('pw-error', 'New passwords do not match.');
      const { ok, data } = await apiPost('/api/account/password', {
        current_password: current, new_password: newPw, confirm_password: confirm
      });
      if (!ok) return showError('pw-error', data.error || 'Something went wrong.');
      ['pw-current','pw-new','pw-confirm'].forEach(id => document.getElementById(id).value = '');
      showSaved('pw-saved', () => closeSection('password'));
    }

    async function savePhoto() {
      const fileInput = document.getElementById('photo-file-input');
      document.getElementById('photo-error').hidden = true;
      if (!fileInput.files[0]) return showError('photo-error', 'Please select a file.');
      const file = fileInput.files[0];
      if (file.size > 2 * 1024 * 1024) return showError('photo-error', 'File must be under 2MB.');
      if (!['image/jpeg','image/png','image/gif','image/webp'].includes(file.type)) {
        return showError('photo-error', 'Only JPG, PNG, GIF, and WebP files are allowed.');
      }
      const formData = new FormData();
      formData.append('photo', file);
      const res = await fetch('/api/account/photo', { method: 'POST', body: formData });
      const data = await res.json();
      if (!res.ok) return showError('photo-error', data.error || 'Upload failed.');
      window.location.reload();
    }

    async function removePhoto() {
      const res = await fetch('/api/account/photo', { method: 'DELETE' });
      if (!res.ok) return;
      const initial = '<%= profile.avatar_initial || profile.name.charAt(0).toUpperCase() %>';
      const season  = '<%= profile.current_season || "" %>';
      const cls = `profile-avatar${season ? ' season-avatar--' + season : ''}`;
      document.getElementById('profile-avatar-wrap').innerHTML =
        `<div class="${cls}" id="profile-avatar-initials">${initial}</div>`;
      toggleEdit('photo');
    }

    // ── Status helper for the merged settings sections ─────────────────────────
    function showStatus(el, msg, isError) {
      el.textContent = msg;
      el.className = 'acct-status ' + (isError ? 'acct-status--error' : 'acct-status--ok');
      el.hidden = false;
      if (!isError) setTimeout(() => { el.hidden = true; el.textContent = ''; }, 3500);
    }

    // ── Timezone ───────────────────────────────────────────────────────────────
    async function saveTimezone() {
      const timezone = document.getElementById('timezone-select').value;
      const statusEl = document.getElementById('tz-status');
      const res = await fetch('/api/account/timezone', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ timezone })
      });
      if (res.ok) {
        showStatus(statusEl, 'Saved. ✓', false);
      } else {
        const data = await res.json();
        showStatus(statusEl, data.error, true);
      }
    }

    // ── Notification / privacy preference toggles ──────────────────────────────
    async function togglePref(btn, key) {
      const wasOn = btn.getAttribute('aria-pressed') === 'true';
      const nowOn = !wasOn;
      btn.setAttribute('aria-pressed', String(nowOn));
      const savedEl = document.getElementById(`saved-${key}`);
      const res = await fetch('/api/account/preference', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key, value: nowOn })
      });
      if (res.ok) {
        if (savedEl) {
          savedEl.hidden = false;
          setTimeout(() => { savedEl.hidden = true; }, 2000);
        }
      } else {
        btn.setAttribute('aria-pressed', String(wasOn));
      }
    }

    // Email reminder channel. Persists the preference, then — if turning it on
    // while the master reminder is off — flips the master on too, since the
    // cron only sends to users with the master toggle enabled.
    async function toggleEmailReminder(btn) {
      const wasOn = btn.getAttribute('aria-pressed') === 'true';
      const nowOn = !wasOn;
      btn.setAttribute('aria-pressed', String(nowOn));
      const savedEl = document.getElementById('saved-reminder_email_enabled');
      const res = await fetch('/api/account/preference', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'reminder_email_enabled', value: nowOn })
      });
      if (!res.ok) { btn.setAttribute('aria-pressed', String(wasOn)); return; }
      if (savedEl) { savedEl.hidden = false; setTimeout(() => { savedEl.hidden = true; }, 2000); }

      if (nowOn) {
        const masterBtn = document.getElementById('toggle-daily-reminder');
        if (masterBtn && masterBtn.getAttribute('aria-pressed') !== 'true') {
          masterBtn.setAttribute('aria-pressed', 'true');
          document.getElementById('reminder-time-row').hidden = false;
          await fetch('/api/account/daily-reminder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled: true })
          });
        }
      }
    }

    // ── Daily Reminder ─────────────────────────────────────────────────────────
    // Two-axis state model:
    //   • Master toggle (`daily_reminder_enabled`) — server-side per-user flag
    //     the cron checks before sending. Persists across devices.
    //   • Per-device push subscription — browser-level permission + endpoint
    //     stored in push_subscriptions. One row per device/browser install.
    // The "Enable on this device" button grants permission, subscribes, AND
    // turns on the master toggle in one tap.
    const reminderErrEl = document.getElementById('reminder-error');

    async function toggleDailyReminder(btn) {
      const wasOn = btn.getAttribute('aria-pressed') === 'true';
      const nowOn = !wasOn;
      btn.setAttribute('aria-pressed', String(nowOn));
      document.getElementById('reminder-time-row').hidden = !nowOn;
      const savedEl = document.getElementById('saved-daily_reminder');
      const res = await fetch('/api/account/daily-reminder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: nowOn })
      });
      if (res.ok) {
        if (savedEl) { savedEl.hidden = false; setTimeout(() => savedEl.hidden = true, 2000); }
      } else {
        btn.setAttribute('aria-pressed', String(wasOn));
        document.getElementById('reminder-time-row').hidden = !wasOn;
      }
    }

    async function saveReminderHour(sel) {
      await fetch('/api/account/daily-reminder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hour: parseInt(sel.value, 10) })
      });
    }

    // ── Weekly Reminder ─────────────────────────────────────────────────────────
    async function toggleWeeklyReminder(btn) {
      const wasOn = btn.getAttribute('aria-pressed') === 'true';
      const nowOn = !wasOn;
      btn.setAttribute('aria-pressed', String(nowOn));
      document.getElementById('weekly-time-row').hidden = !nowOn;
      const savedEl = document.getElementById('saved-weekly_reminder');
      const res = await fetch('/api/account/weekly-reminder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: nowOn })
      });
      if (res.ok) {
        if (savedEl) { savedEl.hidden = false; setTimeout(() => savedEl.hidden = true, 2000); }
      } else {
        btn.setAttribute('aria-pressed', String(wasOn));
        document.getElementById('weekly-time-row').hidden = !wasOn;
      }
    }

    async function saveWeeklyReminderHour(sel) {
      await fetch('/api/account/weekly-reminder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hour: parseInt(sel.value, 10) })
      });
    }

    // Weekly email channel. Like the daily one, turning it on also flips the
    // weekly master on so an email-only student isn't skipped.
    async function toggleWeeklyEmail(btn) {
      const wasOn = btn.getAttribute('aria-pressed') === 'true';
      const nowOn = !wasOn;
      btn.setAttribute('aria-pressed', String(nowOn));
      const savedEl = document.getElementById('saved-weekly_reminder_email');
      const res = await fetch('/api/account/preference', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'weekly_reminder_email', value: nowOn })
      });
      if (!res.ok) { btn.setAttribute('aria-pressed', String(wasOn)); return; }
      if (savedEl) { savedEl.hidden = false; setTimeout(() => { savedEl.hidden = true; }, 2000); }

      if (nowOn) {
        const masterBtn = document.getElementById('toggle-weekly-reminder');
        if (masterBtn && masterBtn.getAttribute('aria-pressed') !== 'true') {
          masterBtn.setAttribute('aria-pressed', 'true');
          document.getElementById('weekly-time-row').hidden = false;
          await fetch('/api/account/weekly-reminder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled: true })
          });
        }
      }
    }

    // Convert a base64url-encoded VAPID key into the Uint8Array subscribe() wants.
    function urlBase64ToUint8Array(s) {
      const padding = '='.repeat((4 - s.length % 4) % 4);
      const base64 = (s + padding).replace(/-/g, '+').replace(/_/g, '/');
      const raw = atob(base64);
      const out = new Uint8Array(raw.length);
      for (let i = 0; i < raw.length; ++i) out[i] = raw.charCodeAt(i);
      return out;
    }

    function showReminderError(msg) {
      reminderErrEl.textContent = msg;
      reminderErrEl.hidden = false;
    }

    function setDeviceUiEnabled(isEnabled) {
      document.getElementById('device-status-label').textContent =
        isEnabled ? 'Enabled on this device' : 'Not enabled on this device';
      document.getElementById('device-status-hint').textContent = isEnabled
        ? "You'll get the daily reminder here."
        : 'Tap below to allow notifications in this browser.';
      document.getElementById('enable-device-btn').hidden  = isEnabled;
      document.getElementById('disable-device-btn').hidden = !isEnabled;
    }

    async function enableOnDevice() {
      reminderErrEl.hidden = true;
      if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) {
        return showReminderError('This browser does not support push notifications.');
      }

      // Permission has to be requested from a user gesture — we are inside one.
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        return showReminderError('Permission denied. You can enable it in your browser settings.');
      }

      // Pull the VAPID public key fresh — handles the case where the server
      // rotated keys since the last visit.
      const keyRes = await fetch('/api/push/vapid-public-key');
      if (!keyRes.ok) {
        return showReminderError('Notifications are not configured on the server yet.');
      }
      const { key } = await keyRes.json();

      const reg = await navigator.serviceWorker.ready;
      let sub;
      try {
        sub = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(key),
        });
      } catch (e) {
        return showReminderError('Could not subscribe: ' + (e.message || e));
      }

      const res = await fetch('/api/push/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subscription: sub.toJSON() })
      });
      if (!res.ok) {
        return showReminderError('Could not save the subscription.');
      }

      // If the master toggle is off, flip it on — enabling a device but having
      // the cron skip you would be confusing.
      const masterBtn = document.getElementById('toggle-daily-reminder');
      if (masterBtn.getAttribute('aria-pressed') !== 'true') {
        masterBtn.setAttribute('aria-pressed', 'true');
        document.getElementById('reminder-time-row').hidden = false;
        await fetch('/api/account/daily-reminder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ enabled: true })
        });
      }
      setDeviceUiEnabled(true);
    }

    async function disableOnDevice() {
      reminderErrEl.hidden = true;
      if (!('serviceWorker' in navigator)) return;
      const reg = await navigator.serviceWorker.ready;
      const sub = await reg.pushManager.getSubscription();
      if (sub) {
        // Tell the server first, then unsubscribe locally.
        await fetch('/api/push/unsubscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: sub.endpoint })
        });
        await sub.unsubscribe();
      }
      setDeviceUiEnabled(false);
    }

    // On page load, reconcile UI with reality: does this browser have an active
    // subscription? + is this an iOS Safari that needs the install guidance?
    (async () => {
      const isMobile = /iPad|iPhone|iPod|Android/.test(navigator.userAgent) && !window.MSStream;
      const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
      // Auto-expand the install steps on a phone that hasn't installed the app yet.
      if (isMobile && !isStandalone) {
        const guide = document.getElementById('install-guide');
        if (guide) guide.open = true;
      }

      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        // Leave the button visible — clicking it shows a friendly unsupported message.
        return;
      }
      try {
        const reg = await navigator.serviceWorker.ready;
        const sub = await reg.pushManager.getSubscription();
        setDeviceUiEnabled(!!sub);
      } catch (_) { /* no-op */ }
    })();
  </script>

</body>
</html>
