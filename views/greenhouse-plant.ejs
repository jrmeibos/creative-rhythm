<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/greenhouse.css">
  <link rel="stylesheet" href="/css/lessons.css">
  <link rel="stylesheet" href="/css/onboarding.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content" id="main">

      <a href="/greenhouse" class="lesson-back">← Back to Greenhouse</a>

      <div class="gh-plant-form">
        <h1 class="gh-plant-title">Plant a goal in Bed <%= bed %></h1>

        <div class="ob-seeds">
          <div class="ob-seed-card gh-plant-card">
            <div class="ob-seed-field">
              <label class="ob-seed-label" for="gp-soil">🪴 The Soil — Where you're starting</label>
              <p class="ob-seed-prompt">Start by naming the feeling, experience, or pattern you hope to shift away from.</p>
              <p class="ob-seed-example">ex) Freezing when it's time to share my work and second-guessing every post.</p>
              <textarea id="gp-soil" class="ob-seed-textarea" rows="3"></textarea>
            </div>
            <div class="ob-seed-field">
              <label class="ob-seed-label" for="gp-seed">🌱 The Seed — What you're growing</label>
              <p class="ob-seed-prompt">What's a change you want to work towards? Name the feeling or way of being you're reaching for.</p>
              <p class="ob-seed-example">ex) Sharing feels comfortable, fun, and sometimes even exciting.</p>
              <textarea id="gp-seed" class="ob-seed-textarea" rows="3"></textarea>
            </div>
            <div class="ob-seed-field">
              <label class="ob-seed-label" for="gp-water">💧 The Water — How you'll tend it</label>
              <p class="ob-seed-prompt">What does this change ask from you?</p>
              <p class="ob-seed-example">ex) Building a few drafts through the month so there's a buffer to draw from.</p>
              <textarea id="gp-water" class="ob-seed-textarea" rows="3"></textarea>
            </div>
            <div class="ob-seed-field">
              <label class="ob-seed-label" for="gp-bloom">🌸 The Bloom — What success looks like</label>
              <p class="ob-seed-prompt">Picture a regular day once this change has taken root. What are you doing differently?</p>
              <p class="ob-seed-example">ex) I share my work with a relaxed sense of purpose.</p>
              <textarea id="gp-bloom" class="ob-seed-textarea" rows="3"></textarea>
            </div>
          </div>
        </div>

        <p class="ob-error" id="plant-error" hidden>Please fill in all four fields before planting.</p>
        <div class="ob-actions">
          <button class="ob-btn ob-btn--primary" id="plant-btn" onclick="plantGoal(<%= bed %>)">Plant this goal →</button>
        </div>
      </div>

    </main>
  </div>

  <script>
    async function plantGoal(bed) {
      const soil  = document.getElementById('gp-soil').value.trim();
      const seed  = document.getElementById('gp-seed').value.trim();
      const water = document.getElementById('gp-water').value.trim();
      const bloom = document.getElementById('gp-bloom').value.trim();
      const errEl = document.getElementById('plant-error');
      errEl.hidden = true;

      if (!soil || !seed || !water || !bloom) {
        errEl.textContent = 'Please fill in all four fields before planting.';
        errEl.hidden = false;
        return;
      }

      const btn = document.getElementById('plant-btn');
      btn.disabled = true;
      btn.textContent = 'Planting…';

      const res = await fetch('/api/greenhouse/plant-bed', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bed, soil, seed, water, bloom })
      });

      if (res.ok) {
        window.location.href = '/greenhouse';
      } else {
        btn.disabled = false;
        btn.textContent = 'Plant this goal →';
        errEl.textContent = 'Something went wrong. Please try again.';
        errEl.hidden = false;
      }
    }
  </script>
</body>
</html>
