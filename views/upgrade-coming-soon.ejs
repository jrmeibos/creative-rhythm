<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/upgrade.css">
  <style>
    .cs-seasons { margin: 2.5rem 0 1rem; }
    .cs-seasons-title { font-family: var(--font-display); font-size: 1.9rem; color: var(--color-ink-stained); margin: 0 0 0.6rem; font-weight: 400; }
    .cs-seasons-intro { font-family: var(--font-body); font-size: 1.02rem; line-height: 1.7; color: rgba(16,15,16,0.72); margin: 0 0 1.5rem; max-width: 640px; }
    .cs-seasons-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    .cs-season-card { border-radius: 14px; overflow: hidden; border: 1px solid rgba(16,15,16,0.08); background: var(--color-blank-page); display: flex; flex-direction: column; }
    .cs-season-head { padding: 0.85rem 1rem; display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; color: var(--color-ink-stained); }
    .cs-season-head--winter { background: #76856C; }
    .cs-season-head--spring { background: #D8B0AB; }
    .cs-season-head--summer { background: #F6C95C; }
    .cs-season-head--autumn { background: #a990a4; }
    .cs-season-emoji { font-size: 1.15rem; line-height: 1; }
    .cs-season-name { font-family: var(--font-display); font-size: 1.05rem; font-weight: 400; }
    .cs-season-body { font-family: var(--font-body); font-size: 0.92rem; line-height: 1.6; color: var(--color-ink-stained); padding: 0.9rem 1rem 1.1rem; margin: 0; }
    .cs-seasons-close { font-family: var(--font-body); font-size: 1.02rem; line-height: 1.7; color: rgba(16,15,16,0.78); margin: 1.5rem 0 0.75rem; max-width: 760px; }
    .cs-seasons-cta { font-family: var(--font-body); font-size: 1rem; margin: 0.5rem 0 0; }
    .cs-seasons-cta a { color: var(--color-bloem); font-weight: 600; text-decoration: underline; }
    @media (max-width: 900px) { .cs-seasons-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .cs-seasons-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body class="app-body<%= locals.user ? '' : ' up-body--anon' %>">
  <div class="app-layout">
    <% if (locals.user) { %>
      <%- include('partials/sidebar') %>
    <% } else { %>
      <!-- Anonymous top bar — most visitors here arrive from an ad or the
           meibostouch.com course page, signed out. -->
      <nav class="up-anon-nav" aria-label="Sign in or sign up">
        <a href="https://www.meibostouch.com/the-creatives-garden"
           target="_blank" rel="noopener" class="up-anon-brand"
           aria-label="The Creative's Garden — course page">
          <img src="/images/brand/The Creative's Garden Icon with Text_1.svg"
               alt="The Creative's Garden" class="up-anon-brand-logo">
        </a>
        <div class="up-anon-nav-actions">
          <a href="/?returnTo=%2Fupgrade" class="up-anon-nav-link">Sign in</a>
          <a href="/signup" class="up-anon-nav-cta">Join the experiment →</a>
        </div>
      </nav>
    <% } %>

    <main class="main-content<%= locals.user ? '' : ' main-content--anon' %>">

      <% if (locals.user) { %>
        <a href="/dashboard" class="cm-back-link" style="display:inline-block; margin: 1.5rem 0 1rem;">← Back to dashboard</a>
      <% } %>

      <header class="up-header">
        <h1 class="up-title">The Creative's Garden</h1>
        <p class="up-subtitle">
          Soul-led visibility for creative entrepreneurs: showing up online
          as yourself, without burning out.
        </p>
      </header>

      <!-- ─── The 3-week challenge ───────────────────────────────────────── -->
      <section class="up-trial-banner" aria-labelledby="cs-trial-title">
        <div class="up-trial-copy">
          <p class="up-trial-eyebrow">Unblock your fears around being seen and heard</p>
          <h2 class="up-trial-title" id="cs-trial-title">Join the 3-week challenge</h2>
          <p class="up-trial-body">
            What would happen if you showed up on camera for yourself first? In
            this experiment, we'll do three weeks of daily recording to see what
            unblocks. It's $199.
          </p>
        </div>
        <div class="up-trial-cta-wrap">
          <% if (!locals.user) { %>
            <a href="/signup" class="up-btn up-btn--primary up-btn--trial">Join the challenge →</a>
          <% } else { %>
            <span class="up-trial-chip">You're in for the 3-week challenge</span>
            <a href="/dashboard" class="up-trial-fineprint" style="text-decoration:underline">Go to your dashboard →</a>
          <% } %>
        </div>
      </section>

      <!-- ─── This is just the beginning ─────────────────────────────────── -->
      <section class="cs-seasons" aria-labelledby="cs-seasons-title">
        <h2 class="cs-seasons-title" id="cs-seasons-title">This is just the beginning</h2>
        <p class="cs-seasons-intro">
          These three weeks are the first season of The Creative's Garden. If you
          want to see what grows from them, here's where the garden is headed:
        </p>

        <% const csSeasons = [
          { key: 'winter', emoji: '❄️', name: 'Record · Winter', body: "By the end, you'll have a whole bed of cuttings — weeks of recordings and notes about what you really think. Thoughts that are really, truly yours." },
          { key: 'spring', emoji: '🌸', name: 'Watch · Spring',  body: "Watch a few past recordings and practice deciding what's just for you and what might be worth sharing." },
          { key: 'summer', emoji: '☀️', name: 'Create · Summer', body: "Create something from your ideas, editing a few, with no pressure to post." },
          { key: 'autumn', emoji: '🍂', name: 'Share · Autumn',  body: "It's fall — we share our harvest. Here, we'll start sharing our creations with the group or online." }
        ]; %>
        <div class="cs-seasons-grid">
          <% csSeasons.forEach(function(s) { %>
            <div class="cs-season-card">
              <div class="cs-season-head cs-season-head--<%= s.key %>">
                <span class="cs-season-emoji"><%= s.emoji %></span>
                <span class="cs-season-name"><%= s.name %></span>
              </div>
              <p class="cs-season-body"><%= s.body %></p>
            </div>
          <% }); %>
        </div>

        <p class="cs-seasons-close">
          The idea is to practice visibility in small, bite-sized chunks. Each part
          of online visibility has its own challenges. If you want to keep going
          after the challenge, we can explore working together one-on-one — and
          while I already hope to keep you, there's no pressure either way.
        </p>

        <p class="cs-seasons-cta">
          Curious about working together?
          <a href="mailto:julia@meibostouch.com?subject=Working%20together%20%E2%80%94%20The%20Creative%27s%20Garden">Reach out to Julia →</a>
        </p>
      </section>

      <footer class="cs-footer">
        <p>
          Questions? <a href="https://www.meibostouch.com/the-creatives-garden" target="_blank" rel="noopener">Visit the course page</a>
          or reach out to Julia directly.
        </p>
      </footer>
    </main>
  </div>

</body>
</html>
