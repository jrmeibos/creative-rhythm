<% if (locals.facebookPixelId) { %>
<%
  /* Meta (Facebook) Pixel + geo-aware consent — PUBLIC /signup page ONLY.

     Deliberately NOT included from partials/head.ejs: it must never load on
     authenticated app pages, which carry students' sensitive onboarding data.

     Two consent modes:
       - optin  (GDPR/UK/EEA): nothing loads until the visitor clicks Accept.
       - optout (elsewhere):   the pixel loads on arrival; a notice offers an
                               easy opt-out.
     Region resolution: the server sets `pixelConsentMode` when a trustworthy
     country header exists (none on Railway today, so it is null). When null,
     the client falls back to a timezone heuristic: America/* and US-Pacific
     zones get opt-out; EVERYWHERE else — all of Europe/EEA/UK however the zone
     is spelled, plus anything we cannot classify — defaults to strict opt-in.

     No <noscript> pixel fallback: it would fetch from Meta before any opt-in
     decision. We fire PageView only; keep Automatic Advanced Matching OFF in
     Meta Events Manager so emails / form fields are never sent. */
%>
<style>
  .cg-consent {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 9999;
    background: #FAFAFA; border-top: 1px solid rgba(16,15,16,0.12);
    box-shadow: 0 -6px 24px rgba(16,15,16,0.08);
    padding: 1rem 1.1rem; font-size: 0.9rem; color: #100F10;
  }
  .cg-consent-inner {
    max-width: 900px; margin: 0 auto; display: flex; gap: 1rem;
    align-items: center; justify-content: space-between; flex-wrap: wrap;
  }
  .cg-consent-text { margin: 0; flex: 1 1 320px; line-height: 1.5; }
  .cg-consent-text a { color: #705C6C; text-decoration: underline; }
  .cg-consent-actions { display: flex; gap: 0.6rem; flex: 0 0 auto; }
  .cg-consent-btn {
    font: inherit; cursor: pointer; padding: 0.55rem 1.15rem;
    border-radius: 999px; border: 1px solid #705C6C; line-height: 1;
  }
  .cg-consent-btn--solid { background: #705C6C; color: #FAFAFA; }
  .cg-consent-btn--solid:hover { background: #574557; border-color: #574557; }
  .cg-consent-btn--ghost { background: transparent; color: #705C6C; }
  .cg-consent-btn--ghost:hover { background: rgba(112,92,108,0.08); }
  .cg-consent-btn:focus-visible { outline: 2px solid #705C6C; outline-offset: 2px; }
  @media (max-width: 560px) {
    .cg-consent-inner { justify-content: stretch; }
    .cg-consent-actions { width: 100%; }
    .cg-consent-btn { flex: 1 1 0; }
  }
</style>

<div id="cg-consent" class="cg-consent" role="region" aria-label="Cookie consent" hidden>
  <div class="cg-consent-inner">
    <p class="cg-consent-text" id="cg-consent-text"></p>
    <div class="cg-consent-actions">
      <button type="button" id="cg-consent-deny"  class="cg-consent-btn cg-consent-btn--ghost"></button>
      <button type="button" id="cg-consent-allow" class="cg-consent-btn cg-consent-btn--solid"></button>
    </div>
  </div>
</div>

<script>
(function () {
  var PIXEL_ID    = <%- JSON.stringify(String(facebookPixelId)) %>;
  var SERVER_MODE = <%- JSON.stringify(locals.pixelConsentMode || null) %>;
  var KEY = 'cg_meta_consent_v1';
  var banner = document.getElementById('cg-consent');

  var COPY = {
    optin: {
      html: 'We’d like to use the Meta (Facebook) pixel on this page to see how well our ads work. It’s optional — nothing loads unless you say yes. Read our <a href="/privacy">Privacy&nbsp;Policy</a>.',
      deny: 'Decline', allow: 'Accept'
    },
    optout: {
      html: 'We use the Meta (Facebook) pixel on this page to measure how well our ads work. You can opt out anytime. Read our <a href="/privacy">Privacy&nbsp;Policy</a>.',
      deny: 'Opt out', allow: 'Got it'
    }
  };

  function loadPixel() {
    if (window.fbq) return;
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', PIXEL_ID);
    fbq('track', 'PageView');
  }

  function get() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
  function set(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }

  // Region → mode. Server wins when it actually knows the country; otherwise a
  // timezone heuristic that leans strict (opt-in) whenever unsure.
  function resolveMode() {
    if (SERVER_MODE === 'optin' || SERVER_MODE === 'optout') return SERVER_MODE;
    var tz = '';
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; }
    catch (e) { return 'optin'; }
    if (/^America\//.test(tz) || tz === 'Pacific/Honolulu') return 'optout';
    return 'optin';
  }
  var mode = resolveMode();

  function showBanner() {
    if (!banner) return;
    var c = COPY[mode];
    document.getElementById('cg-consent-text').innerHTML = c.html;
    document.getElementById('cg-consent-deny').textContent  = c.deny;
    document.getElementById('cg-consent-allow').textContent = c.allow;
    banner.hidden = false;
  }

  // Apply any stored decision first; it always overrides the regional default.
  var choice = get();
  if (choice === 'granted') {
    loadPixel();
  } else if (choice === 'denied') {
    /* respect it — load nothing, show nothing */
  } else {
    // No decision yet. Opt-out regions load now and offer a way out; opt-in
    // regions load nothing until the visitor accepts.
    if (mode === 'optout') loadPixel();
    showBanner();
  }

  function decide(v) {
    set(v);
    if (banner) banner.hidden = true;
    if (v === 'granted') loadPixel();
    // A later 'denied' does not need to unload an already-running pixel: we
    // only ever fire one PageView, so nothing further would be sent anyway.
    // The stored 'denied' keeps it off on every future visit.
  }
  var allow = document.getElementById('cg-consent-allow');
  var deny  = document.getElementById('cg-consent-deny');
  if (allow) allow.addEventListener('click', function () { decide('granted'); });
  if (deny)  deny.addEventListener('click', function () { decide('denied'); });

  // Withdraw/change consent from any element marked data-cg-consent-reopen
  // (e.g. the "Cookie preferences" footer link): clear the stored choice and
  // re-show the banner in the current region's mode.
  document.addEventListener('click', function (e) {
    var t = e.target && e.target.closest ? e.target.closest('[data-cg-consent-reopen]') : null;
    if (!t) return;
    e.preventDefault();
    try { localStorage.removeItem(KEY); } catch (_) {}
    showBanner();
  });
})();
</script>
<% } %>
