<!-- Cultivated Ideas — the Cultivate pile → format ideas. Moved here from the
     old /summer page; renders at the bottom of the Propagation Table. Reads
     cuttings / formats / makesByCutting from the render locals. The old
     /summer/make/* endpoints still back the picker/toggle/remove actions. -->
<section class="pt-cultivated" id="cultivated-ideas">
  <header class="summer-header">
    <h2 class="summer-title">Cultivated Ideas</h2>
    <p class="summer-intro">
      Every cutting you've marked Cultivate lives here. For each one, try
      out format ideas — a written post, a talk-to-camera video, a quote
      graphic. Mark an idea as created once you've actually made it, and
      it'll be ready to share.
    </p>
    <p class="summer-links">
      <a href="/grove" class="summer-link">Share the Bounty →</a>
      <span class="summer-links-sep" aria-hidden="true"> · </span>
      <a href="/summer/formats" class="summer-link">Manage formats →</a>
    </p>
  </header>

  <% if (cuttings.length === 0) { %>

    <div class="summer-empty">
      <p class="summer-empty-headline">Your Cultivate pile is empty.</p>
      <p class="summer-empty-body">
        When you head to <a href="/tending">Tending</a> and mark a cutting
        🪴 <strong>Cultivate</strong>, it'll show up here so you can make
        something from it.
      </p>
    </div>

  <% } else { %>

    <%
      // Split the Cultivate pile so finished cuttings don't clutter the
      // working list. "Made" = has at least one idea marked created.
      const readyCuttings = [];
      const madeCuttings  = [];
      cuttings.forEach(function (c) {
        const ex = makesByCutting.get(c.id) || [];
        (ex.some(function (m) { return m.created; }) ? madeCuttings : readyCuttings).push(c);
      });
    %>

    <% if (readyCuttings.length > 0) { %>
      <ul class="summer-cuttings">
        <% readyCuttings.forEach(function (c) { %>
          <%- include('cultivated-cutting', { c: c, existing: (makesByCutting.get(c.id) || []), formats: formats }) %>
        <% }); %>
      </ul>
    <% } else { %>
      <div class="summer-empty">
        <p class="summer-empty-headline">You've made something from all of them.</p>
        <p class="summer-empty-body">
          Everything in your Cultivate pile has been turned into something —
          nice work. New cuttings you mark 🪴 <strong>Cultivate</strong> in
          <a href="/tending">Tending</a> will show up here to make.
        </p>
      </div>
    <% } %>

    <% if (madeCuttings.length > 0) { %>
      <section class="summer-made-section">
        <h3 class="summer-made-title">
          Already made <span class="summer-made-count"><%= madeCuttings.length %></span>
        </h3>
        <p class="summer-made-intro">
          These have been turned into something and are tucked out of the way.
          You can still add more ideas, or unmark one to bring it back up.
        </p>
        <ul class="summer-cuttings summer-cuttings--made">
          <% madeCuttings.forEach(function (c) { %>
            <%- include('cultivated-cutting', { c: c, existing: (makesByCutting.get(c.id) || []), formats: formats }) %>
          <% }); %>
        </ul>
      </section>
    <% } %>

  <% } %>
</section>

<script>
  (function () {
    // Save is allowed with a format OR just a note — enable it whenever either
    // is present, so an idea can be jotted before a format is chosen.
    function updateSaveState(picker) {
      const saveTarget = picker.querySelector('[data-summer-make-save]');
      if (!saveTarget) return;
      const hasFormat = !!picker.querySelector('.summer-format-chip.is-selected');
      const ta = picker.querySelector('.summer-make-picker-note');
      const hasNote = !!(ta && ta.value.trim());
      saveTarget.disabled = !(hasFormat || hasNote);
    }

    // Typing a note (with no format picked) should enable Save too.
    document.addEventListener('input', function (e) {
      const ta = e.target.closest('.summer-make-picker-note');
      if (ta) {
        const picker = ta.closest('[data-summer-make-picker]');
        if (picker) updateSaveState(picker);
      }
    });

    // Open / close inline pickers + save / toggle / delete format ideas.
    // Delegated on document so cuttings added later still work.
    document.addEventListener('click', function (e) {
      const openBtn = e.target.closest('[data-summer-make]');
      if (openBtn) {
        const id = openBtn.getAttribute('data-cutting-id');
        const picker = document.querySelector('[data-summer-make-picker="' + id + '"]');
        if (picker) {
          picker.hidden = false;
          updateSaveState(picker);
          const ta = picker.querySelector('.summer-make-picker-note');
          if (ta) ta.focus();
        }
        return;
      }

      const cancelBtn = e.target.closest('[data-summer-make-cancel]');
      if (cancelBtn) {
        const picker = cancelBtn.closest('[data-summer-make-picker]');
        if (picker) picker.hidden = true;
        return;
      }

      // Selecting a format highlights it and enables Save — it no longer saves
      // on click. An explicit Save button commits, so a typed note is never
      // lost and there's an obvious way to finish.
      const fmtBtn = e.target.closest('[data-summer-format]');
      if (fmtBtn) {
        const picker = fmtBtn.closest('[data-summer-make-picker]');
        const wasSelected = fmtBtn.classList.contains('is-selected');
        picker.querySelectorAll('.summer-format-chip').forEach(function (b) {
          b.classList.remove('is-selected');
          b.setAttribute('aria-pressed', 'false');
        });
        if (!wasSelected) {
          fmtBtn.classList.add('is-selected');
          fmtBtn.setAttribute('aria-pressed', 'true');
        }
        updateSaveState(picker);
        const errEl = picker.querySelector('.summer-make-picker-error');
        if (errEl) errEl.hidden = true;
        return;
      }

      // Save the selected format + note as an idea. A format is optional — a
      // note on its own saves a formatless "No format yet" idea.
      const saveBtn = e.target.closest('[data-summer-make-save]');
      if (saveBtn) {
        const picker    = saveBtn.closest('[data-summer-make-picker]');
        const cuttingId = picker.getAttribute('data-summer-make-picker');
        const selected  = picker.querySelector('.summer-format-chip.is-selected');
        const ta        = picker.querySelector('.summer-make-picker-note');
        const note      = ta ? ta.value.trim() : '';
        const errEl     = picker.querySelector('.summer-make-picker-error');
        if (!selected && !note) {
          if (errEl) { errEl.textContent = 'Pick a format or add a note.'; errEl.hidden = false; }
          return;
        }
        const formatId  = selected ? selected.getAttribute('data-summer-format') : null;
        const createdCb = picker.querySelector('[data-summer-make-created]');
        const created   = createdCb ? !!createdCb.checked : false;
        saveBtn.disabled = true;
        picker.querySelectorAll('.summer-format-chip').forEach(function (b) { b.disabled = true; });

        fetch('/summer/make/' + encodeURIComponent(cuttingId), {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ formatId: formatId, note: note, created: created }),
        }).then(function (r) {
          if (!r.ok) throw new Error('save failed');
          window.location.reload();
        }).catch(function () {
          if (errEl) { errEl.textContent = 'Could not save. Try again.'; errEl.hidden = false; }
          saveBtn.disabled = false;
          picker.querySelectorAll('.summer-format-chip').forEach(function (b) { b.disabled = false; });
        });
        return;
      }

      const toggleBtn = e.target.closest('[data-summer-toggle]');
      if (toggleBtn) {
        const makeId  = toggleBtn.getAttribute('data-make-id');
        const wasOn   = toggleBtn.getAttribute('data-created') === '1';
        const nextOn  = !wasOn;
        toggleBtn.disabled = true;
        fetch('/summer/make/' + encodeURIComponent(makeId) + '/toggle-created', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ created: nextOn }),
        }).then(function (r) {
          if (!r.ok) throw new Error('toggle failed');
          window.location.reload();
        }).catch(function () {
          toggleBtn.disabled = false;
          alert('Could not update. Try again.');
        });
        return;
      }

      const rmBtn = e.target.closest('[data-summer-remove]');
      if (rmBtn) {
        const makeId = rmBtn.getAttribute('data-make-id');
        const name   = rmBtn.getAttribute('data-name');
        if (!confirm('Delete "' + name + '"? This removes the format idea.')) return;
        rmBtn.disabled = true;
        fetch('/summer/make/' + encodeURIComponent(makeId) + '/delete', {
          method: 'POST', credentials: 'same-origin',
        }).then(function (r) {
          if (!r.ok) throw new Error();
          window.location.reload();
        }).catch(function () {
          rmBtn.disabled = false;
          alert('Could not delete. Try again.');
        });
      }
    });
  })();
</script>
