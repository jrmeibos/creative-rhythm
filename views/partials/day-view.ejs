<!-- Day-view fragment.
     Rendered both by GET /dashboard (inside the persistent #dayview-container)
     and by GET /dashboard/day (alone, as the fetch-and-swap response body).
     One source, two consumers — keep markup identical to either.

     Locals expected:
       dayview        — { dayNumber, dateStr, dateLabel, isToday, season,
                          seasonLabel, aboutText, topic, cuttings,
                          prevDate, nextDate }
       cuttingPrompts — the three reflection field definitions
                        (also available via app.locals)

     data-viewed-date on the outer wrapper is the source of truth for the
     client controller (save POST + popstate replay). -->
<div class="dayview-fragment" data-viewed-date="<%= dayview.dateStr %>">

  <header class="dayview-header">
    <% if (dayview.prevDate) { %>
      <a href="?day=<%= dayview.prevDate %>"
         class="dayview-nav"
         data-day-nav="<%= dayview.prevDate %>"
         aria-label="Previous day">‹</a>
    <% } else { %>
      <span class="dayview-nav dayview-nav--disabled" aria-hidden="true">‹</span>
    <% } %>

    <div class="dayview-day-label">
      <% if (dayview.dayNumber) { %><span class="dayview-day-num">Day <%= dayview.dayNumber %></span> · <% } %>
      <span class="dayview-date"><%= dayview.dateLabel %></span>
      <% if (dayview.isToday) { %><span class="dayview-today-tag">today</span><% } %>
    </div>

    <% if (dayview.nextDate) { %>
      <a href="?day=<%= dayview.nextDate %>"
         class="dayview-nav"
         data-day-nav="<%= dayview.nextDate %>"
         aria-label="Next day">›</a>
    <% } else { %>
      <span class="dayview-nav dayview-nav--disabled" aria-hidden="true">›</span>
    <% } %>
  </header>

  <% if (dayview.seasonLabel || dayview.aboutText || dayview.topic) { %>
    <%# Weeks 1–3 are the free Winter block — reframe the "about" toggle around
        the daily recording rather than the season. %>
    <% const aboutLabel = (dayview.season === 'winter') ? 'About the daily recording' : 'About this season'; %>
    <div class="dayview-season-row">
      <% if (dayview.seasonLabel) { %>
        <span class="recording-card-season"><%= dayview.seasonLabel.toUpperCase() %></span>
      <% } %>
      <% if (dayview.aboutText) { %>
        <button type="button"
                class="recording-about-toggle"
                id="dayview-about-toggle"
                data-label="<%= aboutLabel %>"
                aria-controls="dayview-about-panel"
                aria-expanded="false"><%= aboutLabel %> ↓</button>
      <% } %>
      <% if (dayview.topic) { %>
        <button type="button"
                class="recording-about-toggle"
                id="dayview-topic-toggle"
                aria-controls="dayview-topic-panel"
                aria-expanded="false">Want an idea of what to talk about today? ↓</button>
      <% } %>
    </div>
    <% if (dayview.aboutText) { %>
      <div id="dayview-about-panel" class="recording-about-panel is-hidden">
        <p><%= dayview.aboutText %></p>
      </div>
    <% } %>
    <% if (dayview.topic) { %>
      <div id="dayview-topic-panel" class="recording-about-panel is-hidden">
        <p class="recording-card-prompt">"<%= dayview.topic %>"</p>
      </div>
    <% } %>
  <% } %>

  <%# Shared "How to do the daily recording" toggle markup. Rendered inside each
      CTA row (to the right of the record button) so only one instance is ever
      in the DOM at a time — ids stay unique. The iframe is lazy-loaded
      (data-src → src on first open) so YouTube isn't pulled in on every day
      render or day-nav re-render. Toggle wired up in dashboard.ejs. %>

  <% if (dayview.cuttings && dayview.cuttings.length) { %>
    <% dayview.cuttings.forEach(function (c, idx) { %>
      <% const populated = cuttingPrompts.filter(p => c[p.key] != null && String(c[p.key]).trim() !== ''); %>
      <article class="dayview-entry<%= idx > 0 ? ' dayview-entry--stacked' : '' %>">
        <%# Attached recording. Playback is private: the iframe src is fetched
            from /api/video/:uid/playback, which mints a short-lived signed
            token only for the owner. Lazily loaded on click so we don't mint
            tokens for videos nobody watches. %>
        <% if (c.video_uid) { %>
          <div class="dayview-video" data-video-uid="<%= c.video_uid %>">
            <button type="button" class="dayview-video-play" data-video-play>▶ Watch this recording</button>
            <div class="dayview-video-frame" hidden></div>
            <p class="dayview-video-msg" hidden></p>
          </div>
        <% } %>
        <% populated.forEach(function (p) { %>
          <div class="dayview-field">
            <p class="dayview-field-label"><%= p.label %></p>
            <p class="dayview-field-text"><%= c[p.key] %></p>
          </div>
        <% }); %>
      </article>
    <% }); %>

    <div class="dayview-cta-row">
      <button type="button" class="recording-card-btn-secondary" id="dayview-add-btn">+ Log another</button>
      <button type="button" class="recording-about-toggle"
              id="dayview-howto-toggle" aria-controls="dayview-howto-panel"
              aria-expanded="false">How to do the daily recording ↓</button>
    </div>
  <% } else { %>
    <div class="dayview-empty-box">
      <svg class="dayview-empty-icon" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
        <path d="m15 5 4 4"/>
      </svg>
      <p class="dayview-empty">
        <% if (dayview.isToday) { %>
          Recorded your video? Log it here.
        <% } else { %>
          Nothing logged for this day. You can still add one.
        <% } %>
      </p>
      <p class="dayview-empty-sub">
        Record a short video on your phone or camera first. Then log it here.
      </p>
      <div class="dayview-cta-row">
        <button type="button" class="recording-card-btn" id="dayview-add-btn">Log today's recording</button>
        <button type="button" class="recording-about-toggle"
                id="dayview-howto-toggle" aria-controls="dayview-howto-panel"
                aria-expanded="false">How to do the daily recording ↓</button>
      </div>
    </div>
  <% } %>

  <%# Single lazy-loaded video panel, shared by whichever CTA-row toggle rendered. %>
  <div id="dayview-howto-panel" class="recording-about-panel is-hidden">
    <div class="recording-howto-video">
      <iframe
        data-src="https://www.youtube.com/embed/_eZRUVOSv4Q"
        title="How to do the daily recording"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  </div>

  <div class="dayview-form is-hidden" id="dayview-form">
    <p class="dayview-form-intro">A few notes on the video you just recorded —</p>

    <%# Video upload — admin-only experiment for now (res.locals.canUploadVideo).
        The file goes browser -> Cloudflare directly; we only keep the uid. %>
    <% if (locals.canUploadVideo) { %>
      <div class="dayview-video-upload" id="dayview-video-upload">
        <label class="dayview-video-label" for="dayview-video-input">
          Add your video <span class="dayview-video-optional">(optional)</span>
        </label>
        <input type="file" id="dayview-video-input" accept="video/*" class="dayview-video-input">
        <div class="dayview-video-progress" id="dayview-video-progress" hidden>
          <div class="dayview-video-bar"><span id="dayview-video-bar-fill"></span></div>
          <span class="dayview-video-pct" id="dayview-video-pct">0%</span>
        </div>
        <p class="dayview-video-status" id="dayview-video-status" hidden></p>
        <input type="hidden" id="dayview-video-uid" value="">
      </div>
    <% } %>
    <% cuttingPrompts.forEach(function (p) { %>
      <div class="recording-reflect-field">
        <label class="recording-reflect-q" for="dayview-input-<%= p.key %>"><%= p.label %></label>
        <% if (p.help) { %><p class="recording-reflect-help"><%= p.help %></p><% } %>
        <textarea id="dayview-input-<%= p.key %>"
                  class="recording-reflect-textarea"
                  data-cutting-key="<%= p.key %>"
                  rows="3"></textarea>
      </div>
    <% }); %>
    <div class="recording-reflect-actions">
      <button type="button" class="recording-card-btn" id="dayview-save">Save</button>
      <button type="button" class="recording-card-btn-secondary" id="dayview-cancel">Cancel</button>
      <span id="dayview-saved" class="recording-backdate-saved" hidden>Saved 🌿</span>
    </div>
  </div>

</div>
