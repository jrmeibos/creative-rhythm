<%
  // Per-WEEK privacy control for weekly intentions, near the intention cards
  // on the dashboard (current week) and /goals (the viewed week). Writes a
  // per-week override via POST /api/goals/share; the community page reads it,
  // falling back to the user's default when a week isn't explicitly set.
  //   shareThisWeek  — effective on/off for this week (boolean)
  //   weekStart      — the week this toggle controls (YYYY-MM-DD)
  var sharing   = (typeof shareThisWeek === 'undefined') ? true : shareThisWeek;
  var weekValue = (typeof weekStart === 'undefined') ? '' : weekStart;
%>
<div class="share-intentions" data-week="<%= weekValue %>">
  <div class="share-intentions-text">
    <strong class="share-intentions-title">Share my intentions with the community this week</strong>
    <span class="share-intentions-sub">When on, this week's goal progress shows on the community page. Turn it off to keep this week private.</span>
  </div>
  <div class="share-intentions-right">
    <span class="share-intentions-saved" hidden>Saved ✓</span>
    <button type="button"
            class="share-intentions-toggle<%= sharing ? ' is-on' : '' %>"
            aria-pressed="<%= sharing ? 'true' : 'false' %>"
            aria-label="Share my intentions with the community this week">
      <span class="share-intentions-track"><span class="share-intentions-thumb"></span></span>
    </button>
  </div>
</div>
<script>
  // Wire every share-intentions toggle on the page exactly once. Each posts
  // its own week; reverts the switch on a failed/errored save so the UI
  // never lies about state.
  document.querySelectorAll('.share-intentions').forEach(function (root) {
    if (root.dataset.wired) return;
    root.dataset.wired = '1';
    var btn   = root.querySelector('.share-intentions-toggle');
    var saved = root.querySelector('.share-intentions-saved');
    var week  = root.dataset.week;
    btn.addEventListener('click', async function () {
      var wasOn = btn.getAttribute('aria-pressed') === 'true';
      var nowOn = !wasOn;
      btn.setAttribute('aria-pressed', String(nowOn));
      btn.classList.toggle('is-on', nowOn);
      try {
        var res = await fetch('/api/goals/share', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ weekStart: week, shared: nowOn })
        });
        if (!res.ok) throw new Error('save failed');
        if (saved) { saved.hidden = false; setTimeout(function () { saved.hidden = true; }, 2000); }
      } catch (e) {
        btn.setAttribute('aria-pressed', String(wasOn));
        btn.classList.toggle('is-on', wasOn);
      }
    });
  });
</script>
