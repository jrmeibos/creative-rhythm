<!-- Make Something: The Propagation Table — the unified making hub. Shows in
     the making seasons (Summer + Autumn, i.e. locals.showSummer). Combines what
     used to be two cards ("Make Something" → /summer and "The Propagation
     Table"): the guided challenge and the Cultivate pile now live together on
     /greenhouse/propagation-table. -->
<% if (locals.showSummer) { %>
<section class="dash-section gh-cuttings-section gh-cuttings-section--summer">
  <h2 class="gh-cuttings-section-title">Make Something: The Propagation Table</h2>
  <p class="gh-cuttings-section-body">
    Turn everything you've filmed this season into shareable content — a guided
    challenge from a simple post all the way to your own TED talk, with your
    Cultivate pile right there to build from.
  </p>
  <img class="gh-cuttings-section-art"
       src="/images/propagation-table.svg"
       alt="" width="1250" height="508" style="max-width: 300px;">
  <a href="/greenhouse/propagation-table" class="gh-cuttings-section-btn">Open the Propagation Table</a>
</section>
<% } %>
