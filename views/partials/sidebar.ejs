<aside class="sidebar">
  <div class="sidebar-inner">

    <div class="sidebar-logo-wrap">
      <a href="/dashboard" class="sidebar-logo-link">
        <img
          src="/images/logo/Main_Logo__Bloem1500x.png"
          alt="The Creative's Garden"
          class="sidebar-logo-img"
          onerror="this.style.display='none'; document.getElementById('sidebar-logo-text').style.display='block'">
        <span id="sidebar-logo-text" class="sidebar-logo-text" style="display:none">The Creative's Garden</span>
      </a>
    </div>

    <div class="sidebar-user">
      <a href="/profile" class="sidebar-avatar-link" title="My Profile" aria-label="My Profile">
        <% if (user.profile_photo) { %>
          <img src="<%= user.profile_photo %>" class="sidebar-avatar sidebar-avatar--photo" alt="">
        <% } else { %>
          <div class="sidebar-avatar<%= user.current_season ? ' season-avatar--' + user.current_season : '' %>">
            <%= user.avatar_initial || user.name.charAt(0).toUpperCase() %>
          </div>
        <% } %>
      </a>
      <div class="sidebar-user-info">
        <span class="sidebar-user-name"><%= user.name %></span>
        <span class="sidebar-user-role"><%= user.role === 'admin' ? 'Curator' : 'Gardener' %></span>
      </div>
    </div>

    <nav class="sidebar-nav" aria-label="Main navigation">
      <ul>
        <li class="sidebar-nav-item <%= page === 'dashboard' ? 'active' : '' %>">
          <a href="/dashboard">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
              <rect x="1" y="1" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <rect x="9.5" y="1" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <rect x="1" y="9.5" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <rect x="9.5" y="9.5" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            Dashboard
          </a>
        </li>
        <li class="sidebar-nav-item goals-nav <%= page === 'goals' ? 'active' : '' %>">
          <a href="/goals">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="7.5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="8.5" cy="8.5" r="4" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
            </svg>
            My Goals
          </a>
        </li>
        <li class="sidebar-nav-item calendar-nav <%= page === 'calendar' ? 'active' : '' %>">
          <a href="/calendar">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
              <rect x="1.5" y="3" width="14" height="13" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M1.5 7h14" stroke="currentColor" stroke-width="1.4"/>
              <path d="M5 1.5v3M12 1.5v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <rect x="4" y="10" width="2" height="2" rx="0.4" fill="currentColor"/>
              <rect x="7.5" y="10" width="2" height="2" rx="0.4" fill="currentColor"/>
              <rect x="11" y="10" width="2" height="2" rx="0.4" fill="currentColor"/>
            </svg>
            Calendar
          </a>
        </li>
        <li class="sidebar-nav-item <%= page === 'lessons' ? 'active' : '' %>">
          <a href="/lessons">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
              <path d="M3 3C3 2.45 3.45 2 4 2H14V15H4C3.45 15 3 14.55 3 14V3Z" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3 13.5C3 12.95 3.45 12.5 4 12.5H14" stroke="currentColor" stroke-width="1.5"/>
              <line x1="6.5" y1="5.5" x2="11.5" y2="5.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              <line x1="6.5" y1="8.5" x2="11.5" y2="8.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            Field Notes
          </a>
        </li>
        <li class="sidebar-nav-item <%= page === 'community' ? 'active' : '' %>">
          <a href="/community">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
              <circle cx="8.5" cy="5.5" r="2.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M2.5 15.5C2.5 12.46 5.19 10 8.5 10s6 2.46 6 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="14" cy="5" r="1.8" stroke="currentColor" stroke-width="1.3"/>
              <path d="M12.5 10.5C13.8 10.9 15 12.1 15.5 13.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            Community
          </a>
        </li>
        <li class="sidebar-nav-item <%= page === 'resources' ? 'active' : '' %>">
          <a href="/resources">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
              <path d="M2 5A1.5 1.5 0 013.5 3.5H7L8.5 5.5H14A1.5 1.5 0 0115.5 7v6A1.5 1.5 0 0114 14.5H3A1.5 1.5 0 011.5 13V5z" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            Resources
          </a>
        </li>
        <li class="sidebar-nav-item <%= page === 'greenhouse' ? 'active' : '' %>">
          <a href="/greenhouse">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
              <path d="M8.5 15V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M8.5 10C8.5 10 6 8.5 5 6c1.5 0 3 0.8 3.5 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8.5 7.5C8.5 7.5 11 6 12 3.5c-1.5 0-3 0.8-3.5 2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M5.5 15h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            The Greenhouse
          </a>
        </li>
        <% if (user.role === 'admin') { %>
        <li class="sidebar-nav-divider"></li>
        <li class="sidebar-nav-item admin-nav <%= page === 'admin' ? 'active' : '' %>">
          <a href="/admin">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="2.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M8.5 1.5v2M8.5 13.5v2M1.5 8.5h2M13.5 8.5h2M3.6 3.6l1.4 1.4M12 12l1.4 1.4M13.4 3.6L12 5M5 12l-1.4 1.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            Admin
          </a>
        </li>
        <% } %>
      </ul>
    </nav>

    <div class="sidebar-footer">
      <a href="/logout" class="sidebar-logout">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M5.5 13H2.5A1.5 1.5 0 011 11.5v-8A1.5 1.5 0 012.5 2H5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M10 10.5L13.5 7.5L10 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="13.5" y1="7.5" x2="5.5" y2="7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Sign out
      </a>
    </div>

  </div>
</aside>
