<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/calendar.css">
</head>
<body class="app-body">

  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">

      <header class="cal-page-header">
        <div>
          <h1 class="cal-page-title">Your 12-Week Journey</h1>
          <p class="cal-page-sub">Plan ahead, reflect back, tend the garden.</p>
        </div>
      </header>

      <!-- 12-week tile grid -->
      <div class="cal-grid">
        <% for (const w of weeks) { %>
          <button
            class="cal-tile <%= w.isCurrentWeek ? 'cal-tile--current' : w.isPastWeek ? 'cal-tile--past' : 'cal-tile--future' %>"
            data-week="<%= w.weekStart %>"
            type="button"
            aria-expanded="false">

            <div class="cal-tile-head">
              <span class="cal-tile-name"><%= w.weekName %></span>
              <% if (w.isCurrentWeek) { %><span class="cal-tile-badge">Current</span><% } %>
              <% if (w.allGoalsSet) { %><span class="cal-tile-sparkle" aria-hidden="true">✨</span><% } %>
            </div>

            <p class="cal-tile-range"><%= w.dateRange %></p>

            <div class="cal-tile-dots" aria-hidden="true">
              <span class="cal-dot cal-dot--curiosity <%= w.goalsExist.curiosity ? 'is-set' : '' %>"></span>
              <span class="cal-dot cal-dot--create <%= w.goalsExist.create ? 'is-set' : '' %>"></span>
              <span class="cal-dot cal-dot--share <%= w.goalsExist.share ? 'is-set' : '' %>"></span>
              <span class="cal-dot cal-dot--connect <%= w.goalsExist.connect ? 'is-set' : '' %>"></span>
            </div>

            <% if (w.isIntegration) { %>
              <span class="cal-tile-intg">Integration Week</span>
            <% } %>
          </button>
        <% } %>
      </div>

      <!-- Expanded detail drawer -->
      <div class="cal-drawer" id="cal-drawer" hidden>

        <div class="cal-drawer-header">
          <div>
            <h2 class="cal-drawer-title" id="cal-drawer-title"></h2>
            <p class="cal-drawer-range" id="cal-drawer-range"></p>
          </div>
          <button class="cal-drawer-close" id="cal-drawer-close" aria-label="Close week view">×</button>
        </div>

        <% for (const w of weeks) { %>
          <div class="cal-panel" data-week="<%= w.weekStart %>" hidden>

            <!-- Integration toggle -->
            <div class="cal-integration-row">
              <label class="integration-toggle-label" style="background:transparent; border:none; padding:0 0 1rem;">
                <span class="integration-toggle-text">
                  <strong>Integration Week</strong>
                  <span>Rest, reflect, and let things settle</span>
                </span>
                <button
                  class="integration-toggle-btn cal-integration-btn <%= w.isIntegration ? 'is-active' : '' %>"
                  data-week="<%= w.weekStart %>"
                  data-active="<%= w.isIntegration ? 'true' : 'false' %>"
                  type="button"
                  aria-pressed="<%= w.isIntegration ? 'true' : 'false' %>">
                  <span class="integration-toggle-track">
                    <span class="integration-toggle-thumb"></span>
                  </span>
                  <%= w.isIntegration ? 'On' : 'Off' %>
                </button>
              </label>
            </div>

            <% if (w.isIntegration) { %>
              <!-- Integration week view -->
              <div class="integration-week-card">
                <div class="integration-week-icon">○</div>
                <div style="flex:1">
                  <h3 class="integration-week-title">Integration Week</h3>
                  <p class="integration-week-text" style="margin-bottom:1rem">
                    This is your integration week. What are you noticing? What do you want to carry into next week?
                  </p>
                  <% const intgRefl = w.goalsMap.curiosity?.reflection || ''; %>
                  <textarea class="cal-integration-textarea goal-full-textarea checkin-textarea"
                            data-week="<%= w.weekStart %>"
                            data-category="curiosity"
                            placeholder="Write your reflections here..."
                            rows="4"><%= intgRefl %></textarea>
                </div>
              </div>

            <% } else { %>
              <!-- Goal cards for this week -->
              <%
                const calCats = [
                  { key: 'curiosity', label: 'Curiosity', description: "Feed your artist's soul" },
                  { key: 'create',    label: 'Create',    description: 'Make the thing' },
                  { key: 'share',     label: 'Share',     description: 'Put it into the world' },
                  { key: 'connect',   label: 'Connect',   description: 'Reach outward' }
                ];
              %>
              <div class="goals-grid">
                <% for (const cat of calCats) { %>
                  <% const goal = w.goalsMap[cat.key] || {}; %>
                  <% const gd   = w.goalsData[cat.key]; %>
                  <% const hasContent = !!(gd.items && gd.items.length > 0); %>

                  <div class="goal-card goal-card--<%= cat.key %> <%= goal.completed ? 'is-complete' : '' %>"
                       data-category="<%= cat.key %>"
                       data-description="<%= cat.description %>">

                    <div class="goal-card-header">
                      <div class="goal-card-header-left">
                        <span class="goal-card-label"><%= cat.label %></span>
                        <span class="goal-card-desc"><%= cat.description %></span>
                      </div>
                      <label class="goal-card-check-wrap" title="Mark complete">
                        <input type="checkbox" class="goal-card-checkbox"
                               data-week="<%= w.weekStart %>"
                               data-category="<%= cat.key %>"
                               <%= goal.completed ? 'checked' : '' %>>
                        <span class="goal-card-check-visual" aria-hidden="true"></span>
                      </label>
                    </div>

                    <div class="goal-checklist-always-edit" data-week="<%= w.weekStart %>" data-category="<%= cat.key %>">
                      <ul class="goal-checklist-input-list">
                        <% if (gd.items && gd.items.length) { %>
                          <% gd.items.forEach(function(item) { %>
                            <li class="goal-checklist-edit-row <%= item.checked ? 'is-checked' : '' %>">
                              <label class="goal-checklist-check-wrap">
                                <input type="checkbox" class="goal-checklist-checkbox goal-item-cb" <%= item.checked ? 'checked' : '' %>>
                                <span class="goal-checklist-check-visual"></span>
                              </label>
                              <input type="text" class="goal-checklist-edit-input" value="<%= item.text %>" placeholder="Add item...">
                            </li>
                          <% }); %>
                        <% } else { %>
                          <li class="goal-checklist-edit-row">
                            <label class="goal-checklist-check-wrap">
                              <input type="checkbox" class="goal-checklist-checkbox goal-item-cb">
                              <span class="goal-checklist-check-visual"></span>
                            </label>
                            <input type="text" class="goal-checklist-edit-input" placeholder="Add item...">
                          </li>
                        <% } %>
                      </ul>
                    </div>

                  </div>
                <% } %>
              </div>
            <% } %>

            <% if (w.isPastCourseWeek) { %>
            <section class="weekly-reflection" data-week="<%= w.weekStart %>">
              <h3 class="weekly-reflection-title">This Week's Reflection</h3>
              <p class="weekly-reflection-prompt">Looking back — how did this week go?</p>
              <textarea
                class="weekly-reflection-textarea"
                placeholder="What worked? What didn't? What surprised you?"
                rows="5"><%= w.reflection ? w.reflection.text : '' %></textarea>
              <div class="reflection-controls">
                <label class="cohort-toggle">
                  <input type="checkbox" class="cohort-toggle-cb"
                         <%= w.reflection && w.reflection.shared_with_cohort ? 'checked' : '' %>>
                  <span>Share with my cohort 🌿</span>
                </label>
                <button class="save-weekly-reflection" type="button">Save reflection</button>
              </div>
              <p class="reflection-helper">When shared, your reflection appears on your community card for this week.</p>
              <p class="reflection-saved-msg" hidden>Saved 🌿</p>
            </section>
            <% } %>

          </div>
        <% } %>

      </div><!-- .cal-drawer -->

    </main>
  </div>

  <script src="/js/dashboard-cards.js"></script>
  <script src="/js/calendar.js"></script>

</body>
</html>
