<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/greenhouse.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content" id="main">

      <a href="/greenhouse" class="lesson-back">← Back to Greenhouse</a>

      <header class="cuttings-header">
        <h1 class="cuttings-title">Cuttings</h1>
        <p class="cuttings-intro">Small things you noticed, gathered as you tended your practice.</p>
      </header>

      <% if (locals.emptyExportNotice) { %>
        <p class="cuttings-export-notice">Nothing to export yet — your cuttings will appear here as you record.</p>
      <% } %>

      <% if (totalCount === 0) { %>

        <!-- ── Whole-page empty state (no cuttings at all) ──────────── -->
        <section class="cuttings-empty">
          <p class="cuttings-empty-text">
            Nothing gathered yet. After you record, you can note what you noticed — and it'll be kept here.
          </p>
        </section>

      <% } else { %>

        <%
          // href helper: builds a /greenhouse/cuttings URL with the given
          // sort/status/rating, omitting any that are default so
          // /greenhouse/cuttings stays the canonical "all" URL. Each
          // toolbar control passes ONE next-value and inherits the other
          // two from the current request — so clicking flips just that
          // dimension.
          function urlWith(nextSort, nextStatus, nextRating) {
            const params = [];
            if (nextSort && nextSort !== 'newest') params.push('sort='   + encodeURIComponent(nextSort));
            if (nextStatus)                         params.push('status=' + encodeURIComponent(nextStatus));
            if (nextRating)                         params.push('rating=' + encodeURIComponent(nextRating));
            return params.length ? '?' + params.join('&') : '/greenhouse/cuttings';
          }
          // Chip href: if the chip's value is already the active filter,
          // clicking clears it. Otherwise it becomes the new selection.
          function statusChipHref(v) { return urlWith(sort, status === v ? null : v, rating); }
          function ratingChipHref(v) { return urlWith(sort, status, rating === v ? null : v); }
          function chipCls(active)   { return 'cuttings-chip' + (active ? ' is-active' : ''); }
        %>

        <!-- ── Controls (collapsible <details>) ─────────────────────────
             Collapsed by default so the header doesn't crowd the archive.
             Auto-opens when any filter is active (status || rating) so
             students don't wonder why a cutting seems to be "missing." -->
        <details class="cuttings-controls-wrap"<%= (status || rating) ? ' open' : '' %>>
          <summary class="cuttings-controls-summary">
            <span class="cuttings-controls-summary-title">Sort and Filter</span>
            <% if (status || rating) { %>
              <span class="cuttings-controls-summary-count">
                <%= (status ? 1 : 0) + (rating ? 1 : 0) %> active
              </span>
            <% } %>
            <span class="cuttings-controls-summary-chevron" aria-hidden="true">▾</span>
          </summary>
        <div class="cuttings-controls" role="group" aria-label="Sort and filter cuttings">

          <!-- Sort: segmented [Newest | Oldest] pill toggle -->
          <div class="cuttings-control-row cuttings-control-row--sort">
            <span class="cuttings-control-label">Sort</span>
            <div class="cuttings-segmented" role="group" aria-label="Sort order">
              <a href="<%= urlWith('newest', status, rating) %>"
                 class="cuttings-segmented-btn <%= sort === 'newest' ? 'is-active' : '' %>"
                 aria-pressed="<%= sort === 'newest' %>">Newest</a>
              <a href="<%= urlWith('oldest', status, rating) %>"
                 class="cuttings-segmented-btn <%= sort === 'oldest' ? 'is-active' : '' %>"
                 aria-pressed="<%= sort === 'oldest' %>">Oldest</a>
            </div>
          </div>

          <!-- Status: chip group, single-select within, click active to clear -->
          <div class="cuttings-control-row cuttings-control-row--chips">
            <span class="cuttings-control-label">Status</span>
            <div class="cuttings-chips" role="group" aria-label="Filter by status">
              <a href="<%= statusChipHref('watched')    %>" class="<%= chipCls(status === 'watched')    %>">Watched</a>
              <a href="<%= statusChipHref('unwatched')  %>" class="<%= chipCls(status === 'unwatched')  %>">Unwatched</a>
              <a href="<%= statusChipHref('edited')     %>" class="<%= chipCls(status === 'edited')     %>">Edited</a>
              <a href="<%= statusChipHref('not-edited') %>" class="<%= chipCls(status === 'not-edited') %>">Not edited</a>
            </div>
          </div>

          <!-- Rating: chip group, independent of Status -->
          <div class="cuttings-control-row cuttings-control-row--chips">
            <span class="cuttings-control-label">Rating</span>
            <div class="cuttings-chips" role="group" aria-label="Filter by rating">
              <a href="<%= ratingChipHref('keep-growing') %>" class="<%= chipCls(rating === 'keep-growing') %>">🪴 Keep growing</a>
              <a href="<%= ratingChipHref('return-later') %>" class="<%= chipCls(rating === 'return-later') %>">🌱 Return to later</a>
              <a href="<%= ratingChipHref('compost')      %>" class="<%= chipCls(rating === 'compost')      %>">🗑️ Compost</a>
            </div>
          </div>

          <!-- Clear-all link — appears only when any filter is active -->
          <% if (status || rating) { %>
            <div class="cuttings-control-row cuttings-control-row--clear">
              <a href="<%= urlWith(sort, null, null) %>" class="cuttings-clear-link">Clear filters</a>
            </div>
          <% } %>
        </div>
        </details>

        <% if (filteredCount === 0) { %>

          <!-- ── Filter-result empty state (cuttings exist but none match) -->
          <section class="cuttings-empty cuttings-empty--filter">
            <p class="cuttings-empty-text">Nothing matches that combination.</p>
            <p class="cuttings-empty-sub">
              <a href="<%= urlWith(sort, null, null) %>" class="cuttings-control-link">Clear filters</a>
            </p>
          </section>

        <% } else { %>

        <% seasonGroups.forEach(function (group) { %>
          <section class="cuttings-season-group cuttings-season-group--<%= group.season || 'other' %>">
            <header class="cuttings-season-header">
              <h2 class="cuttings-season-label"><%= group.label %></h2>
              <% if (group.descriptor) { %>
                <p class="cuttings-season-descriptor"><%= group.descriptor %></p>
              <% } %>
            </header>

            <%
              // Group entries by recorded_date — multiple cuttings on the
              // same day stack under one date label. Entries within group.entries
              // are already ordered earliest-written-first within a day by the
              // DB query (ORDER BY recorded_date DESC, created_at ASC), so a
              // simple reduce preserves that order.
              const dayBuckets = [];
              const dayIndex   = {};
              group.entries.forEach(function (c) {
                // recorded_date is the source of truth; fall back to
                // DATE(created_at) for any malformed legacy row.
                let dayKey = c.recorded_date;
                if (!dayKey && c.created_at) {
                  dayKey = c.created_at.slice(0, 10);
                }
                if (!dayKey) dayKey = '?';
                if (dayIndex[dayKey] == null) {
                  let dayLabel = dayKey;
                  try {
                    const d = new Date(dayKey + 'T00:00:00');
                    dayLabel = d.toLocaleDateString('en-US', {
                      weekday: 'long', month: 'long', day: 'numeric',
                    });
                  } catch (_) { /* keep raw */ }
                  dayIndex[dayKey] = dayBuckets.length;
                  dayBuckets.push({ dayKey, dayLabel, items: [] });
                }
                dayBuckets[dayIndex[dayKey]].items.push(c);
              });
            %>

            <ul class="cuttings-list">
              <% dayBuckets.forEach(function (day) { %>
                <li class="cutting-day">
                  <p class="cutting-date"><%= day.dayLabel %></p>
                  <% day.items.forEach(function (c, ci) { %>
                    <%
                      const populatedFields = cuttingPrompts.filter(function (p) {
                        const v = c[p.key];
                        return v != null && String(v).trim() !== '';
                      });
                    %>
                    <%
                      // Tending-rating pill — mirrors the button labels on
                      // /tending. DB category 'archive' still maps to the
                      // Compost UI label; only the visual name is changing.
                      const tendingLabels = {
                        keep_growing: { emoji: '🪴', text: 'Keep growing' },
                        return_later: { emoji: '🌱', text: 'Return to later' },
                        archive:      { emoji: '🗑️', text: 'Compost' },
                      };
                      const tending = c.tending_category ? tendingLabels[c.tending_category] : null;
                    %>
                    <article class="cutting-entry<%= day.items.length > 1 ? ' cutting-entry--stacked' : '' %>">
                      <div class="cutting-tending">
                        <% if (tending) { %>
                          <a href="<%= urlWith(sort, status, c.tending_category === 'archive' ? 'compost' : c.tending_category.replace('_','-')) %>"
                             class="cutting-tending-badge cutting-tending-badge--<%= c.tending_category %>">
                            <span aria-hidden="true"><%= tending.emoji %></span>
                            <%= tending.text %>
                          </a>
                          <button type="button" class="cutting-tending-edit-btn"
                                  data-cutting-edit data-cutting-id="<%= c.id %>">Change</button>
                        <% } else { %>
                          <button type="button" class="cutting-tending-edit-btn cutting-tending-edit-btn--empty"
                                  data-cutting-edit data-cutting-id="<%= c.id %>">+ Rate &amp; note</button>
                        <% } %>
                      </div>
                      <% populatedFields.forEach(function (p) { %>
                        <div class="cutting-field">
                          <p class="cutting-field-label"><%= p.label %></p>
                          <p class="cutting-text"><%= c[p.key] %></p>
                        </div>
                      <% }); %>
                      <% if (tending && c.tending_reflection) { %>
                        <div class="cutting-field cutting-field--tending-reflection">
                          <p class="cutting-field-label">Note from Self</p>
                          <p class="cutting-text"><%= c.tending_reflection %></p>
                        </div>
                      <% } %>
                      <div class="cutting-tending-editor" hidden data-cutting-editor="<%= c.id %>">
                        <label class="cutting-field-label" for="cutting-note-<%= c.id %>">
                          Note (optional — save even without one)
                        </label>
                        <textarea class="cutting-tending-editor-textarea"
                                  id="cutting-note-<%= c.id %>"
                                  rows="3"
                                  placeholder="A note from the Gardener."><%= c.tending_reflection || '' %></textarea>
                        <div class="cutting-tending-editor-cats" role="group" aria-label="Rate this cutting">
                          <button type="button" class="cutting-tending-editor-cat" data-category="keep_growing">🪴 Keep growing</button>
                          <button type="button" class="cutting-tending-editor-cat" data-category="return_later">🌱 Return to later</button>
                          <!-- data-category stays 'archive' — the DB value doesn't change, only the label -->
                          <button type="button" class="cutting-tending-editor-cat" data-category="archive">🗑️ Compost</button>
                        </div>
                        <div class="cutting-tending-editor-footer">
                          <button type="button" class="cutting-tending-editor-cancel" data-cutting-editor-cancel>Cancel</button>
                          <p class="cutting-tending-editor-error" hidden></p>
                        </div>
                      </div>
                      <div class="cutting-marks" data-cutting-id="<%= c.id %>">
                        <div class="cutting-marks-group">
                          <button type="button"
                                  class="cutting-mark-btn <%= c.watched ? 'is-on' : '' %>"
                                  data-mark="watched"
                                  aria-pressed="<%= c.watched ? 'true' : 'false' %>">
                            <span class="cutting-mark-icon" aria-hidden="true">✓</span>
                            <span class="cutting-mark-label">Watched</span>
                          </button>
                          <button type="button"
                                  class="cutting-mark-btn <%= c.edited ? 'is-on' : '' %>"
                                  data-mark="edited"
                                  aria-pressed="<%= c.edited ? 'true' : 'false' %>">
                            <span class="cutting-mark-icon" aria-hidden="true">✓</span>
                            <span class="cutting-mark-label">Edited</span>
                          </button>
                        </div>
                        <button type="button" class="cutting-delete-btn" data-action="delete">Delete</button>
                      </div>
                    </article>
                  <% }); %>
                </li>
              <% }); %>
            </ul>
          </section>
        <% }); %>

        <footer class="cuttings-footer">
          <a href="/greenhouse/cuttings/export" class="cuttings-export-link">
            Download your cuttings as a PDF ↓
          </a>
        </footer>

        <% } %><!-- end filteredCount > 0 branch -->

      <% } %><!-- end totalCount > 0 branch -->

    </main>
  </div>

  <script>
    // Cuttings watched/edited toggle. Delegated so it works for every entry
    // without per-card IDs. Flips the .is-on class + aria-pressed optimistically;
    // on a failed POST, reverts the visual state and surfaces an alert.
    document.addEventListener('click', function (e) {
      const btn = e.target.closest('.cutting-mark-btn');
      if (!btn) return;
      const row = btn.closest('.cutting-marks');
      if (!row) return;
      const cuttingId = row.getAttribute('data-cutting-id');
      const mark = btn.getAttribute('data-mark');
      const willBeOn = !btn.classList.contains('is-on');
      btn.disabled = true;
      btn.classList.toggle('is-on', willBeOn);
      btn.setAttribute('aria-pressed', willBeOn ? 'true' : 'false');
      fetch('/greenhouse/cuttings/' + encodeURIComponent(cuttingId) + '/mark', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ mark: mark, value: willBeOn ? 1 : 0 })
      }).then(function (r) {
        if (!r.ok) throw new Error('save failed');
      }).catch(function () {
        // Revert
        btn.classList.toggle('is-on', !willBeOn);
        btn.setAttribute('aria-pressed', !willBeOn ? 'true' : 'false');
        alert('Could not save. Please try again.');
      }).finally(function () {
        btn.disabled = false;
      });
    });

    // Cuttings delete. Confirm in the browser, POST, reload on success so the
    // view re-renders cleanly (empty days/seasons fall away automatically).
    document.addEventListener('click', function (e) {
      const btn = e.target.closest('.cutting-delete-btn');
      if (!btn) return;
      const row = btn.closest('.cutting-marks');
      if (!row) return;
      const cuttingId = row.getAttribute('data-cutting-id');
      if (!confirm("Delete this cutting? This can't be undone.")) return;
      btn.disabled = true;
      fetch('/greenhouse/cuttings/' + encodeURIComponent(cuttingId) + '/delete', {
        method: 'POST'
      }).then(function (r) {
        if (!r.ok) throw new Error('delete failed');
        window.location.reload();
      }).catch(function () {
        btn.disabled = false;
        alert('Could not delete. Please try again.');
      });
    });

    // ── Tending: change rating / add or update reflection ────────────────
    // Clicking a category on the inline editor POSTs a new curation event
    // (history-preserving) and reloads so the filter/badge/reflection all
    // reconcile without hand-syncing DOM. Cancel just hides the editor.
    document.addEventListener('click', function (e) {
      const openBtn = e.target.closest('[data-cutting-edit]');
      if (openBtn) {
        const id = openBtn.getAttribute('data-cutting-id');
        const editor = document.querySelector('[data-cutting-editor="' + id + '"]');
        if (editor) {
          editor.hidden = false;
          const ta = editor.querySelector('.cutting-tending-editor-textarea');
          if (ta) ta.focus();
        }
        return;
      }

      const cancelBtn = e.target.closest('[data-cutting-editor-cancel]');
      if (cancelBtn) {
        const editor = cancelBtn.closest('[data-cutting-editor]');
        if (editor) editor.hidden = true;
        return;
      }

      const catBtn = e.target.closest('.cutting-tending-editor-cat');
      if (catBtn) {
        const editor = catBtn.closest('[data-cutting-editor]');
        if (!editor) return;
        const cuttingId = editor.getAttribute('data-cutting-editor');
        const category  = catBtn.getAttribute('data-category');
        const ta        = editor.querySelector('.cutting-tending-editor-textarea');
        const reflection = ta ? ta.value.trim() : '';
        const errEl     = editor.querySelector('.cutting-tending-editor-error');
        editor.querySelectorAll('.cutting-tending-editor-cat').forEach(function (b) { b.disabled = true; });
        fetch('/tending/curate/' + encodeURIComponent(cuttingId), {
          method:      'POST',
          credentials: 'same-origin',
          headers:     { 'Content-Type': 'application/json' },
          body:        JSON.stringify({ category: category, reflection: reflection }),
        }).then(function (r) {
          if (!r.ok) throw new Error('save failed');
          window.location.reload();
        }).catch(function () {
          if (errEl) { errEl.textContent = 'Could not save. Try again.'; errEl.hidden = false; }
          editor.querySelectorAll('.cutting-tending-editor-cat').forEach(function (b) { b.disabled = false; });
        });
      }
    });
  </script>
</body>
</html>
