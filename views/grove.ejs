<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/grove.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content" id="main">

      <%- include('partials/garden-tabs', { gardenTab: 'share' }) %>

      <a href="/greenhouse" class="lesson-back">← Back to Greenhouse</a>

      <header class="grove-header">
        <h1 class="grove-title">Share the Bounty</h1>
        <p class="grove-intro">
          These are the projects you've marked as <em>created</em> in The
          Greenhouse. The thing is, you still get to decide what you share
          and what you don't. This is a space to choose which of your bounty
          to send out — and which was just for you.
        </p>
        <% if (locals.communityDiscordUrl) { %>
          <p class="grove-discord-callout">
            <span aria-hidden="true">💬</span>
            Want a safer way to start than public posting? Consider sharing it in the
            <a href="<%= locals.communityDiscordUrl %>" target="_blank" rel="noopener">community chat on Discord</a>.
          </p>
        <% } %>
      </header>

      <%
        // A creation contributes a flower to the bouquet when it has
        // ANY share activity — a public link OR a cohort share — and
        // isn't marked just-for-me. stem_variant is set on the first
        // share of either kind; if it's null for a legacy row, fall
        // back to a stable per-make choice.
        const stemEntries = entries.filter(function (e) {
          const hasLinks = (linksByMake.get(e.make_id) || []).length > 0;
          const hasCohortShare = !!e.cohort_shared;
          return (hasLinks || hasCohortShare) && !e.just_for_me;
        });
        const stemCount = stemEntries.length;
      %>

      <div class="grove-layout">
        <aside class="grove-bouquet-aside" aria-hidden="true">
          <div class="grove-bouquet-sticky">
            <div class="grove-bouquet-stack" data-stem-count="<%= stemCount %>">
              <!-- Back of the wrap — always rendered so the paper is
                   visible behind and between the flower stems. In the
                   empty state it's the only image shown; when stems are
                   present, the front piece sits over the lower half and
                   only the pointy top of the back peeks up between the
                   blooms. -->
              <img class="grove-bouquet-back" src="/images/grove/bouquet-full.svg" alt="">
              <% if (stemCount > 0) { %>
                <%
                  // Real-bouquet layout: all stems come from ~the same base
                  // point (tiny per-stem horizontal jitter for organic feel),
                  // and fan out widely so flower heads sweep past the wrap
                  // sides. Fan step shrinks as more stems join so they
                  // distribute evenly within the fan.
                  const fanRange = 30; // total degrees, split symmetrically
                  const fanStep  = fanRange / Math.max(stemCount - 1, 1);
                  // How wide the stem ends spread across the tied bottom.
                  // Capped at 34px total so even at high stem counts the
                  // bunch stays inside the wrap's narrow tied portion.
                  const endSpread    = Math.min(34, 3 * stemCount);
                  const endSpreadStep = endSpread / Math.max(stemCount - 1, 1);
                  // Precompute per-stem layout so the flower up top and the
                  // matching stem-end below the wrap share the same tilt/dx.
                  // Also track how many times each variant has appeared so
                  // even occurrences render mirrored — repeats look distinct.
                  var variantCounts = {};
                  var stemLayouts = stemEntries.map(function (e, i) {
                    var variant = e.stem_variant || (((e.make_id * 7) % 12) + 1);
                    var vKey    = String(variant);
                    variantCounts[vKey] = (variantCounts[vKey] || 0) + 1;
                    var occurrence = variantCounts[vKey];
                    var baseTilt = (i - (stemCount - 1) / 2) * fanStep;
                    var tiltJitter = ((e.make_id * 11) % 5) - 2;
                    var endDxBase = (i - (stemCount - 1) / 2) * endSpreadStep;
                    var endDxJitter = ((e.make_id * 5) % 5) - 2;
                    return {
                      entry:   e,
                      variant: vKey.padStart(2, '0'),
                      tilt:    Math.round(baseTilt + tiltJitter),
                      dx:      ((e.make_id * 7) % 7) - 3,
                      endDx:   Math.round(endDxBase + endDxJitter),
                      zi:      stemCount - i,
                      endLen:  55 + ((e.make_id * 13) % 20),  // 55-74px
                      flip:    (occurrence % 2 === 0) ? -1 : 1,
                    };
                  });
                %>
                <!-- Stems wrapped in a masked layer so anything rendered
                     outside the wrap silhouette (e.g. leaves poking past
                     the tied bottom's narrow sides) is clipped. The mask
                     uses bouquet-full.svg's alpha — stems appear only
                     where paper exists. -->
                <div class="grove-bouquet-stems-layer">
                <% stemLayouts.forEach(function (L) { %>
                  <img class="grove-bouquet-stem"
                       src="/images/grove/stems/stem-<%= L.variant %>.svg"
                       data-make-id="<%= L.entry.make_id %>"
                       style="--dx: <%= L.dx %>px; --tilt: <%= L.tilt %>deg; --flip: <%= L.flip %>; z-index: <%= L.zi %>;"
                       alt="">
                <% }); %>
                </div>
                <img class="grove-bouquet-front" src="/images/grove/bouquet-front.svg" alt="">
              <% } %>
            </div>
            <% if (stemCount > 0) { %>
              <!-- Stem ends poking out below the wrap. Each end mirrors
                   its matching flower stem's tilt/dx so the two visually
                   line up on the same axis through the tie. The rotation
                   is inverted so the end continues the flower's line
                   downward (flower up-right → stem end down-left). -->
              <div class="grove-bouquet-stem-ends-layer" aria-hidden="true">
                <% stemLayouts.forEach(function (L) { %>
                  <span class="grove-bouquet-stem-end"
                        style="--dx: <%= L.endDx %>px; --tilt: <%= L.tilt %>deg; height: <%= L.endLen %>px;"></span>
                <% }); %>
              </div>
            <% } %>
            <p class="grove-bouquet-caption">
              <% if (stemCount === 0) { %>
                A wrap waiting for your first bloom.
              <% } else if (stemCount === 1) { %>
                1 bloom in your bouquet.
              <% } else { %>
                <%= stemCount %> blooms in your bouquet.
              <% } %>
            </p>
          </div>
        </aside>

        <div class="grove-content">

      <% if (entries.length === 0) { %>

        <section class="grove-empty">
          <p class="grove-empty-headline">Nothing here yet.</p>
          <p class="grove-empty-body">
            When you head into Summer and make something from a cutting in your
            <a href="/greenhouse/cuttings?rating=keep-growing">Cultivate</a> pile,
            it'll grow here.
          </p>
        </section>

      <% } else { %>

        <%
          // Split created makes by share state so the working list only shows
          // what's still on deck. isShared = has a public link OR a cohort
          // share. Buckets are exhaustive and mutually exclusive.
          function isShared(e) {
            return (linksByMake.get(e.make_id) || []).length > 0 || !!e.cohort_shared;
          }
          const onDeckEntries    = [];
          const sharedEntries    = [];
          const justForMeEntries = [];
          entries.forEach(function (e) {
            // "Just for me" wins over share state, so Already-shared matches
            // exactly the pieces that bloom in the bouquet (which excludes
            // just-for-me). A private piece is never counted as shared.
            if (e.just_for_me)    justForMeEntries.push(e);
            else if (isShared(e)) sharedEntries.push(e);
            else                  onDeckEntries.push(e);
          });
          const cdu = locals.communityDiscordUrl || '';
        %>

        <!-- ── On deck to share — created, not yet shared ───────────────── -->
        <section class="grove-section grove-section--ondeck">
          <div class="grove-section-head">
            <h2 class="grove-section-title">On deck to share</h2>
            <p class="grove-section-intro">
              Made and ready to go out. Once you've posted one, add its link —
              it moves down to Already shared and blooms in your bouquet.
            </p>
          </div>
          <% if (onDeckEntries.length > 0) { %>
            <ul class="grove-list">
              <% onDeckEntries.forEach(function (e) { %>
                <%- include('partials/grove-entry', { e: e, linksByMake: linksByMake, communityDiscordUrl: cdu }) %>
              <% }); %>
            </ul>
          <% } else { %>
            <p class="grove-section-empty">
              Nothing waiting here — everything you've made has been shared. 🌸
            </p>
          <% } %>
        </section>

        <!-- ── Already shared — has a public link or cohort share ───────── -->
        <% if (sharedEntries.length > 0) { %>
          <section class="grove-section grove-section--shared">
            <div class="grove-section-head">
              <h2 class="grove-section-title">
                Already shared <span class="grove-section-count"><%= sharedEntries.length %></span>
              </h2>
              <p class="grove-section-intro">Out in the world — each one a bloom in your bouquet.</p>
            </div>
            <ul class="grove-list">
              <% sharedEntries.forEach(function (e) { %>
                <%- include('partials/grove-entry', { e: e, linksByMake: linksByMake, communityDiscordUrl: cdu }) %>
              <% }); %>
            </ul>
          </section>
        <% } %>

        <!-- ── Just for you — created but kept private ──────────────────── -->
        <% if (justForMeEntries.length > 0) { %>
          <section class="grove-section grove-section--jfm">
            <div class="grove-section-head">
              <h2 class="grove-section-title">
                Just for you <span class="grove-section-count"><%= justForMeEntries.length %></span>
              </h2>
              <p class="grove-section-intro">Made, but you've chosen to keep these to yourself.</p>
            </div>
            <ul class="grove-list">
              <% justForMeEntries.forEach(function (e) { %>
                <%- include('partials/grove-entry', { e: e, linksByMake: linksByMake, communityDiscordUrl: cdu }) %>
              <% }); %>
            </ul>
          </section>
        <% } %>

        <script>
          (function () {
            // Toggle just-for-me on/off. Reload to reconcile the greyed-
            // out disabled state + hide any add-link form that was open.
            document.addEventListener('click', function (e) {
              const jfmBtn = e.target.closest('[data-grove-jfm]');
              if (jfmBtn) {
                const makeId = jfmBtn.getAttribute('data-make-id');
                const nextOn = jfmBtn.getAttribute('data-value') !== '1';
                jfmBtn.disabled = true;
                fetch('/grove/make/' + encodeURIComponent(makeId) + '/just-for-me', {
                  method: 'POST', credentials: 'same-origin',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ justForMe: nextOn }),
                }).then(function (r) {
                  if (!r.ok) throw new Error();
                  window.location.reload();
                }).catch(function () {
                  jfmBtn.disabled = false;
                  alert('Could not update. Try again.');
                });
                return;
              }

              const openBtn = e.target.closest('[data-grove-link-open]');
              if (openBtn) {
                const makeId = openBtn.getAttribute('data-make-id');
                const form   = document.querySelector('[data-grove-link-form="' + makeId + '"]');
                if (form) {
                  form.hidden = false;
                  form.querySelector('input[name="label"]').focus();
                }
                return;
              }

              const cancelBtn = e.target.closest('[data-grove-link-cancel]');
              if (cancelBtn) {
                const form = cancelBtn.closest('[data-grove-link-form]');
                if (form) form.hidden = true;
                return;
              }

              const saveBtn = e.target.closest('[data-grove-link-save]');
              if (saveBtn) {
                const form   = saveBtn.closest('[data-grove-link-form]');
                const makeId = form.getAttribute('data-grove-link-form');
                const url    = form.querySelector('input[name="url"]').value.trim();
                const label  = form.querySelector('input[name="label"]').value.trim();
                const errEl  = form.querySelector('.grove-entry-link-form-error');
                if (!url) { errEl.textContent = 'A URL is required.'; errEl.hidden = false; return; }
                saveBtn.disabled = true;
                fetch('/grove/link/' + encodeURIComponent(makeId), {
                  method: 'POST', credentials: 'same-origin',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ url: url, label: label }),
                }).then(function (r) { return r.json().then(function (d) { return { r: r, d: d }; }); })
                  .then(function (o) {
                    if (!o.r.ok || !o.d.ok) throw new Error(o.d && o.d.error);
                    // Server assigns a stemVariant only on the make's first
                    // link — the "bloom" moment. Stash the make id so the
                    // page-load handler below can animate the new flower in.
                    if (o.d.stemVariant) {
                      try { localStorage.setItem('grove_just_bloomed', String(makeId)); } catch (_) {}
                    }
                    window.location.reload();
                  })
                  .catch(function (err) {
                    errEl.textContent = (err && err.message) || 'Could not save. Try again.';
                    errEl.hidden = false;
                    saveBtn.disabled = false;
                  });
                return;
              }

              const rmBtn = e.target.closest('[data-grove-link-remove]');
              if (rmBtn) {
                const linkId = rmBtn.getAttribute('data-link-id');
                if (!confirm('Remove this link?')) return;
                rmBtn.disabled = true;
                fetch('/grove/link/' + encodeURIComponent(linkId) + '/delete', {
                  method: 'POST', credentials: 'same-origin',
                }).then(function (r) {
                  if (!r.ok) throw new Error();
                  window.location.reload();
                }).catch(function () {
                  rmBtn.disabled = false;
                  alert('Could not remove. Try again.');
                });
                return;
              }

              // Cohort share — open the inline form.
              const cohortOpen = e.target.closest('[data-grove-cohort-open]');
              if (cohortOpen) {
                const makeId = cohortOpen.getAttribute('data-make-id');
                const form   = document.querySelector('[data-grove-cohort-form="' + makeId + '"]');
                if (form) {
                  form.hidden = false;
                  const urlInput = form.querySelector('input[name="discord_url"]');
                  if (urlInput) urlInput.focus();
                }
                return;
              }

              // Cohort share — cancel form.
              const cohortCancel = e.target.closest('[data-grove-cohort-cancel]');
              if (cohortCancel) {
                const form = cohortCancel.closest('[data-grove-cohort-form]');
                if (form) form.hidden = true;
                return;
              }

              // Cohort share — save (marks shared + records optional
              // Discord URL). Server assigns stemVariant on first share.
              const cohortSave = e.target.closest('[data-grove-cohort-save]');
              if (cohortSave) {
                const form = cohortSave.closest('[data-grove-cohort-form]');
                const makeId = cohortSave.getAttribute('data-make-id');
                const url    = form.querySelector('input[name="discord_url"]').value.trim();
                const errEl  = form.querySelector('.grove-entry-cohort-form-error');
                cohortSave.disabled = true;
                fetch('/grove/make/' + encodeURIComponent(makeId) + '/cohort-share', {
                  method: 'POST', credentials: 'same-origin',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ shared: true, discord_url: url }),
                }).then(function (r) { return r.json().then(function (d) { return { r: r, d: d }; }); })
                  .then(function (o) {
                    if (!o.r.ok || !o.d.ok) throw new Error(o.d && o.d.error);
                    if (o.d.stemVariant) {
                      try { localStorage.setItem('grove_just_bloomed', String(makeId)); } catch (_) {}
                    }
                    window.location.reload();
                  })
                  .catch(function (err) {
                    errEl.textContent = (err && err.message) || 'Could not save. Try again.';
                    errEl.hidden = false;
                    cohortSave.disabled = false;
                  });
                return;
              }

              // Cohort share — undo (un-share). Stem stays; only the
              // shared state clears so the entry drops from the bouquet.
              const cohortUndo = e.target.closest('[data-grove-cohort-undo]');
              if (cohortUndo) {
                const makeId = cohortUndo.getAttribute('data-make-id');
                if (!confirm('Un-share this from the cohort?')) return;
                cohortUndo.disabled = true;
                fetch('/grove/make/' + encodeURIComponent(makeId) + '/cohort-share', {
                  method: 'POST', credentials: 'same-origin',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ shared: false }),
                }).then(function (r) {
                  if (!r.ok) throw new Error();
                  window.location.reload();
                }).catch(function () {
                  cohortUndo.disabled = false;
                  alert('Could not update. Try again.');
                });
                return;
              }

              // Per-entry share reflection ("what was it like to share this?").
              const shareOpen = e.target.closest('[data-grove-share-open]');
              if (shareOpen) {
                const makeId = shareOpen.getAttribute('data-make-id');
                const form   = document.querySelector('[data-grove-share-form="' + makeId + '"]');
                const view   = document.querySelector('[data-grove-share-view="' + makeId + '"]');
                if (view) view.hidden = true;
                if (shareOpen.classList.contains('grove-entry-share-note-add-btn')) shareOpen.hidden = true;
                if (form) {
                  form.hidden = false;
                  const ta = form.querySelector('[data-share-note-input]');
                  if (ta) ta.focus();
                }
                return;
              }

              const shareCancel = e.target.closest('[data-grove-share-cancel]');
              if (shareCancel) {
                window.location.reload();
                return;
              }

              const shareSave = e.target.closest('[data-grove-share-save]');
              if (shareSave) {
                const makeId = shareSave.getAttribute('data-make-id');
                const form   = shareSave.closest('[data-grove-share-form]');
                const ta     = form.querySelector('[data-share-note-input]');
                const errEl  = form.querySelector('.grove-entry-share-note-error');
                const note   = ta ? ta.value : '';
                shareSave.disabled = true;
                fetch('/grove/make/' + encodeURIComponent(makeId) + '/share-note', {
                  method: 'POST', credentials: 'same-origin',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ note: note }),
                }).then(function (r) {
                  if (!r.ok) throw new Error();
                  window.location.reload();
                }).catch(function () {
                  if (errEl) { errEl.textContent = 'Could not save. Try again.'; errEl.hidden = false; }
                  shareSave.disabled = false;
                });
              }
            });
          })();
        </script>

      <% } %>

        </div>
      </div>

      <!-- Bouquet bloom-in animation. Runs on every /grove load so the
           empty-state page can still recover if someone reloads before
           the animation completes. -->
      <script>
        (function () {
          try {
            const bloomedId = localStorage.getItem('grove_just_bloomed');
            if (!bloomedId) return;
            localStorage.removeItem('grove_just_bloomed');
            const stem = document.querySelector(
              '.grove-bouquet-stem[data-make-id="' + bloomedId + '"]'
            );
            if (stem) stem.classList.add('is-just-bloomed');
          } catch (_) {}
        })();
      </script>

    </main>
  </div>
</body>
</html>
