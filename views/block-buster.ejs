<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/block-buster.css">
</head>
<body class="app-body">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content">

      <%
        // Each category gets its own brand color + readable ink. These block
        // categories are distinct from the four intention categories, so the
        // ink choices follow brand usage per swatch (dark on gold/rose/share,
        // white on the darker sage/bloem).
        const CAT_COLORS = {
          'blank-page':      { bg: '#F6C95C', ink: '#100F10' },
          'overwhelm':       { bg: '#D8B0AB', ink: '#100F10' },
          'critic-clash':    { bg: '#a990a4', ink: '#100F10' },
          'burnout':         { bg: '#76856C', ink: '#FAFAFA' },
          'comparison-trap': { bg: '#705C6C', ink: '#FAFAFA' },
        };
        const catColor = (slug) => CAT_COLORS[slug] || { bg: '#705C6C', ink: '#FAFAFA' };
        const visibleCount = (cat) => cat.blocks.filter(b => !b.hidden).length;
      %>

      <a href="/resources" class="cm-back-link" style="display:inline-block; margin: 1.5rem 0 1rem;">← Back to Resources</a>

      <header class="bb-header">
        <div class="bb-header-text">
          <span class="bb-eyebrow">Your unstuck toolkit</span>
          <h1 class="bb-title">The Creative Block Buster</h1>
          <p class="bb-subtitle">
            First, name what is feeling sticky today. Then, find the block that
            fits in the list below. You'll find suggestions through each block to
            try and navigate through. But nobody knows better than you! Add your
            own blocks as well as your own ways through. As you learn what works,
            this becomes a refined toolkit of your own creation. Return here when
            you feel stuck.
          </p>
        </div>
        <img class="bb-header-art" src="/images/block-buster.svg"
             alt="A tumbling tower of wooden building blocks" width="150" height="191">
      </header>

      <!-- Busted tally + Breakthroughs log link -->
      <div class="bb-tally-row">
        <p class="bb-tally" id="bb-tally" <% if (!bustedCount) { %>hidden<% } %>>
          <span class="bb-tally-burst" aria-hidden="true">💥</span>
          You've had <strong id="bb-tally-count"><%= bustedCount %></strong>
          <span id="bb-tally-noun"><%= bustedCount === 1 ? 'breakthrough' : 'breakthroughs' %></span> so far. Keep going.
        </p>
        <a href="/block-buster/breakthroughs" class="bb-breakthroughs-link">See your Breakthroughs →</a>
      </div>

      <!-- Search -->
      <div class="bb-search">
        <span class="bb-search-icon" aria-hidden="true">⌕</span>
        <input type="search" id="bb-search-input" class="bb-search-input"
               placeholder="What are you stuck on? e.g. “too tired,” “editing,” “what will people think”"
               autocomplete="off" aria-label="Search creative blocks">
      </div>

      <!-- No-match prompt (revealed by search when nothing matches) -->
      <div class="bb-nomatch" id="bb-nomatch" hidden>
        <p class="bb-nomatch-text">No block matches “<span id="bb-nomatch-query"></span>” yet.</p>
        <button type="button" class="bb-nomatch-btn" id="bb-nomatch-add">Add it as your own block →</button>
      </div>

      <!-- Category chooser — each category rides a literal block that rotates
           face-on when you hover it (or when it's the selected filter). -->
      <p class="bb-chooser-hint">Hover a block to turn it face-on — tap to open it.</p>
      <div class="bb-chooser" id="bb-chooser" role="group" aria-label="Filter by category">
        <button type="button" class="bb-chooser-card bb-chooser-card--all bb-chooser-card--active"
                data-cat="all" aria-pressed="true">
          <span class="bb-cube">
            <span class="bb-face bb-face--top" aria-hidden="true"></span>
            <span class="bb-face bb-face--side" aria-hidden="true"></span>
            <span class="bb-face bb-face--front">
              <span class="bb-chooser-name">All blocks</span>
              <span class="bb-chooser-meta">Everything</span>
            </span>
          </span>
        </button>
        <% categories.forEach(function(cat) { const c = catColor(cat.slug); %>
          <button type="button" class="bb-chooser-card" data-cat="<%= cat.slug %>"
                  aria-pressed="false"
                  style="--cat: <%= c.bg %>; --cat-ink: <%= c.ink %>;">
            <span class="bb-cube">
              <span class="bb-face bb-face--top" aria-hidden="true">
                <span class="bb-chooser-count" data-cat-count="<%= cat.slug %>"><%= visibleCount(cat) %></span>
              </span>
              <span class="bb-face bb-face--side" aria-hidden="true"></span>
              <span class="bb-face bb-face--front">
                <span class="bb-chooser-name"><%= cat.name %></span>
                <span class="bb-chooser-meta"><%= cat.descriptor %></span>
              </span>
            </span>
          </button>
        <% }); %>
      </div>

      <% const hiddenCount = categories.reduce((n, c) => n + c.blocks.filter(b => b.hidden).length, 0); %>
      <div class="bb-showhidden-row">
        <button type="button" id="bb-showhidden-toggle" class="bb-showhidden-toggle" aria-pressed="false"
                <% if (!hiddenCount) { %>hidden<% } %>>
          Show hidden blocks (<span id="bb-hidden-count"><%= hiddenCount %></span>)
        </button>
      </div>

      <!-- Categories → blocks -->
      <div class="bb-categories" id="bb-categories">
        <% categories.forEach(function(cat) { const c = catColor(cat.slug); %>
          <section class="bb-category" data-cat="<%= cat.slug %>"
                   style="--cat: <%= c.bg %>; --cat-ink: <%= c.ink %>;">
            <div class="bb-category-head">
              <span class="bb-category-name"><%= cat.name %></span>
              <span class="bb-category-descriptor"><%= cat.descriptor %></span>
            </div>

            <div class="bb-category-blocks">
              <% cat.blocks.forEach(function(b) { %>
                <div class="bb-block <%= b.hidden ? 'bb-block--hidden' : '' %>"
                     data-key="<%= b.key %>"
                     data-custom="<%= b.isCustom %>"
                     <% if (b.isCustom) { %>data-block-id="<%= b.customId %>"<% } %>
                     data-title="<%= b.title.toLowerCase() %>">
                  <button type="button" class="bb-block-trigger" aria-expanded="false">
                    <span class="bb-block-title">
                      <%= b.title %><% if (b.isCustom) { %> <span class="bb-yours-tag">yours</span><% } %>
                    </span>
                    <span class="bb-bust-count" title="Times you've busted this block" <% if (!b.bustCount) { %>hidden<% } %>>
                      💥 busted <span class="bb-bust-count-n"><%= b.bustCount %></span>×
                    </span>
                    <span class="bb-block-chevron" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg>
                    </span>
                  </button>

                  <div class="bb-block-body" hidden>
                    <div class="bb-tryflow">
                      <!-- Step 1 · pick a way through to try -->
                      <div class="bb-options-wrap">
                        <p class="bb-then-label">Ways through <span class="bb-then-hint">— pick one to try</span></p>
                        <ul class="bb-options">
                          <% b.defaultOptions.forEach(function(opt) { %>
                            <li class="bb-option bb-option--default">
                              <span class="bb-option-text"><%= opt %></span>
                              <button type="button" class="bb-try">Try this</button>
                            </li>
                          <% }); %>
                          <% b.addedOptions.forEach(function(opt) { %>
                            <li class="bb-option bb-option--mine" data-option-id="<%= opt.id %>">
                              <span class="bb-option-text"><%= opt.text %></span>
                              <button type="button" class="bb-try">Try this</button>
                              <button type="button" class="bb-option-remove bb-delete-option" title="Remove this" aria-label="Remove this">×</button>
                            </li>
                          <% }); %>
                        </ul>

                        <form class="bb-add-option">
                          <input type="text" class="bb-add-option-input" placeholder="Add your own way through…" maxlength="300" autocomplete="off">
                          <button type="submit" class="bb-add-option-btn">Add</button>
                        </form>
                      </div>

                      <!-- Step 2 · reflect, then complete -->
                      <div class="bb-reflect" hidden>
                        <button type="button" class="bb-reflect-back">← Back to ways through</button>
                        <p class="bb-reflect-chosen">You're trying: <span class="bb-reflect-chosen-text"></span></p>
                        <label class="bb-reflect-label">
                          How did it go? <span class="bb-reflect-optional">optional, but worth writing</span>
                        </label>
                        <textarea class="bb-reflect-input" rows="4" maxlength="2000"
                                  placeholder="Write about how this way through worked for you…"></textarea>
                        <button type="button" class="bb-reflect-complete">Complete — bust this block 💥</button>
                      </div>
                    </div>

                    <div class="bb-block-manage">
                      <% if (b.isCustom) { %>
                        <button type="button" class="bb-icon-btn bb-delete-block">Delete this block</button>
                      <% } else if (b.hidden) { %>
                        <button type="button" class="bb-icon-btn bb-unhide-block">Unhide this block</button>
                      <% } else { %>
                        <button type="button" class="bb-icon-btn bb-hide-block">Hide this block</button>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </section>
        <% }); %>
      </div>

      <!-- Add your own block -->
      <section class="bb-newblock">
        <h2 class="bb-newblock-title">Add your own block</h2>
        <p class="bb-newblock-hint">Facing something that isn't here? Name it, choose where it fits, then add your own ways through.</p>
        <form class="bb-newblock-form" id="bb-newblock-form">
          <input type="text" id="bb-newblock-input" class="bb-newblock-input" placeholder="e.g. “I keep second-guessing every caption”" maxlength="200" autocomplete="off">
          <select id="bb-newblock-category" class="bb-newblock-select" aria-label="Category">
            <option value="" disabled selected>Choose a category…</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat.slug %>"><%= cat.name %></option>
            <% }); %>
          </select>
          <button type="submit" class="bb-newblock-btn">Add block</button>
        </form>
      </section>

    </main>
  </div>

  <script src="/js/block-buster.js"></script>
</body>
</html>
